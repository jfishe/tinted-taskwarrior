# tinted-taskwarrior
# Scheme name: Serendipity Midnight
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Scheme: base16-serendipity-midnight (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6b6d7c
color.label.sort=rgb235  # #94b8ff
color.alternate=on gray2  # #1c1e2d
color.header=rgb235  # #94b8ff
color.footnote=rgb544  # #f8d2c9
color.warning=gray2 on rgb325  # #151726 on #a78bfa
color.error=rgb522  # #ee8679
color.debug=rgb544  # #f8d2c9

# Task state
color.completed=gray10  # #6b6d7c
color.deleted=gray10  # #6b6d7c
color.active=gray2 on rgb134  # #151726 on #5ba2d0
color.recurring=rgb544  # #f8d2c9
color.scheduled=rgb235  # #94b8ff
color.until=
color.blocked=gray10  # #6b6d7c
color.blocking=gray2 on rgb325  # #151726 on #a78bfa

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb522  # #ee8679
color.uda.priority.M=rgb325  # #a78bfa
color.uda.priority.L=rgb235  # #94b8ff

# Tags
color.tag.next=rgb325  # #a78bfa
color.tag.none=
color.tagged=

# Due
color.due=rgb325  # #a78bfa
color.due.today=rgb522  # #ee8679
color.overdue=rgb522  # #ee8679

# Report: burndown
color.burndown.done=gray2 on rgb134  # #151726 on #5ba2d0
color.burndown.pending=gray2 on rgb522  # #151726 on #ee8679
color.burndown.started=gray2 on rgb325  # #151726 on #a78bfa

# Report: history
color.history.add=gray2 on rgb522  # #151726 on #ee8679
color.history.delete=gray2 on rgb325  # #151726 on #a78bfa
color.history.done=gray2 on rgb134  # #151726 on #5ba2d0

# Report: summary
color.summary.background=on gray2  # #1c1e2d
color.summary.bar=gray2 on rgb134  # #151726 on #5ba2d0

# Command: calendar
color.calendar.due=gray2 on rgb325  # #151726 on #a78bfa
color.calendar.due.today=gray2 on rgb522  # #151726 on #ee8679
color.calendar.holiday=gray2 on rgb325  # #151726 on #a78bfa
color.calendar.overdue=gray2 on rgb522  # #151726 on #ee8679
color.calendar.scheduled=gray2 on rgb235  # #151726 on #94b8ff
color.calendar.today=gray2 on rgb544  # #151726 on #f8d2c9
color.calendar.weekend=gray10  # #6b6d7c
color.calendar.weeknumber=gray10  # #6b6d7c

# Command: sync
color.sync.added=rgb134  # #5ba2d0
color.sync.changed=rgb325  # #a78bfa
color.sync.rejected=rgb522  # #ee8679

# Command: undo
color.undo.after=rgb134  # #5ba2d0
color.undo.before=rgb522  # #ee8679
