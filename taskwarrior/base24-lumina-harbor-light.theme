# tinted-taskwarrior
# Scheme name: Lumina Harbor Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-harbor-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray20  # #dad2c6
color.label.sort=rgb013  # #0468a4
color.alternate=on gray23  # #f6eee1
color.header=rgb013  # #0468a4
color.footnote=rgb011  # #046871
color.warning=gray23 on rgb310  # #fbf5ec on #a25f06
color.error=rgb200  # #8c1c1d
color.debug=rgb011  # #046871

# Task state
color.completed=gray20  # #dad2c6
color.deleted=gray20  # #dad2c6
color.active=gray23 on rgb021  # #fbf5ec on #19784d
color.recurring=rgb011  # #046871
color.scheduled=rgb013  # #0468a4
color.until=
color.blocked=gray20  # #dad2c6
color.blocking=gray23 on rgb113  # #fbf5ec on #6758a8

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #9f501d
color.uda.priority.M=rgb310  # #a25f06
color.uda.priority.L=rgb013  # #0468a4

# Tags
color.tag.next=rgb113  # #6758a8
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #a25f06
color.due.today=rgb310  # #9f501d
color.overdue=rgb200  # #8c1c1d

# Report: burndown
color.burndown.done=gray23 on rgb021  # #fbf5ec on #19784d
color.burndown.pending=gray23 on rgb200  # #fbf5ec on #8c1c1d
color.burndown.started=gray23 on rgb310  # #fbf5ec on #a25f06

# Report: history
color.history.add=gray23 on rgb200  # #fbf5ec on #8c1c1d
color.history.delete=gray23 on rgb310  # #fbf5ec on #a25f06
color.history.done=gray23 on rgb021  # #fbf5ec on #19784d

# Report: summary
color.summary.background=on gray23  # #f6eee1
color.summary.bar=gray23 on rgb021  # #fbf5ec on #19784d

# Command: calendar
color.calendar.due=gray23 on rgb310  # #fbf5ec on #a25f06
color.calendar.due.today=gray23 on rgb310  # #fbf5ec on #9f501d
color.calendar.holiday=gray23 on rgb113  # #fbf5ec on #6758a8
color.calendar.overdue=gray23 on rgb200  # #fbf5ec on #8c1c1d
color.calendar.scheduled=gray23 on rgb013  # #fbf5ec on #0468a4
color.calendar.today=gray23 on rgb011  # #fbf5ec on #046871
color.calendar.weekend=gray20  # #dad2c6
color.calendar.weeknumber=gray20  # #dad2c6

# Command: sync
color.sync.added=rgb021  # #19784d
color.sync.changed=rgb310  # #a25f06
color.sync.rejected=rgb200  # #8c1c1d

# Command: undo
color.undo.after=rgb021  # #19784d
color.undo.before=rgb200  # #8c1c1d
