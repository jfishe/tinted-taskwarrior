# tinted-taskwarrior
# Scheme name: Tango Adapted
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-tango-adapted (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray20  # #cccccc
color.label.sort=rgb035  # #00a1ff
color.alternate=on gray23  # #f1f1f1
color.header=rgb035  # #00a1ff
color.footnote=rgb044  # #00d0d6
color.warning=rgb555 on rgb540  # #feffff on #efca00
color.error=rgb500  # #ff0000
color.debug=rgb044  # #00d0d6

# Task state
color.completed=gray20  # #cccccc
color.deleted=gray20  # #cccccc
color.active=rgb555 on rgb140  # #feffff on #59d500
color.recurring=rgb044  # #00d0d6
color.scheduled=rgb035  # #00a1ff
color.until=
color.blocked=gray20  # #cccccc
color.blocking=rgb555 on rgb424  # #feffff on #c17ecb

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #ef9b00
color.uda.priority.M=rgb540  # #efca00
color.uda.priority.L=rgb035  # #00a1ff

# Tags
color.tag.next=rgb424  # #c17ecb
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #efca00
color.due.today=rgb530  # #ef9b00
color.overdue=rgb500  # #ff0000

# Report: burndown
color.burndown.done=rgb555 on rgb140  # #feffff on #59d500
color.burndown.pending=rgb555 on rgb500  # #feffff on #ff0000
color.burndown.started=rgb555 on rgb540  # #feffff on #efca00

# Report: history
color.history.add=rgb555 on rgb500  # #feffff on #ff0000
color.history.delete=rgb555 on rgb540  # #feffff on #efca00
color.history.done=rgb555 on rgb140  # #feffff on #59d500

# Report: summary
color.summary.background=on gray23  # #f1f1f1
color.summary.bar=rgb555 on rgb140  # #feffff on #59d500

# Command: calendar
color.calendar.due=rgb555 on rgb540  # #feffff on #efca00
color.calendar.due.today=rgb555 on rgb530  # #feffff on #ef9b00
color.calendar.holiday=rgb555 on rgb424  # #feffff on #c17ecb
color.calendar.overdue=rgb555 on rgb500  # #feffff on #ff0000
color.calendar.scheduled=rgb555 on rgb035  # #feffff on #00a1ff
color.calendar.today=rgb555 on rgb044  # #feffff on #00d0d6
color.calendar.weekend=gray20  # #cccccc
color.calendar.weeknumber=gray20  # #cccccc

# Command: sync
color.sync.added=rgb140  # #59d500
color.sync.changed=rgb540  # #efca00
color.sync.rejected=rgb500  # #ff0000

# Command: undo
color.undo.after=rgb140  # #59d500
color.undo.before=rgb500  # #ff0000
