# tinted-taskwarrior
# Scheme name: Obsidian
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-obsidian (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6e6e6e
color.label.sort=rgb035  # #399bda
color.alternate=on gray0  # #000000
color.header=rgb035  # #399bda
color.footnote=rgb033  # #00bbbb
color.warning=gray4 on rgb345  # #273032 on #a0d6ff
color.error=rgb300  # #a50001
color.debug=rgb033  # #00bbbb

# Task state
color.completed=gray10  # #6e6e6e
color.deleted=gray10  # #6e6e6e
color.active=gray4 on rgb030  # #273032 on #00bb00
color.recurring=rgb033  # #00bbbb
color.scheduled=rgb035  # #399bda
color.until=
color.blocked=gray10  # #6e6e6e
color.blocking=gray4 on rgb303  # #273032 on #bb00bb

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb540  # #fecc22
color.uda.priority.M=rgb345  # #a0d6ff
color.uda.priority.L=rgb035  # #399bda

# Tags
color.tag.next=rgb303  # #bb00bb
color.tag.none=
color.tagged=

# Due
color.due=rgb345  # #a0d6ff
color.due.today=rgb540  # #fecc22
color.overdue=rgb300  # #a50001

# Report: burndown
color.burndown.done=gray4 on rgb030  # #273032 on #00bb00
color.burndown.pending=gray4 on rgb300  # #273032 on #a50001
color.burndown.started=gray4 on rgb345  # #273032 on #a0d6ff

# Report: history
color.history.add=gray4 on rgb300  # #273032 on #a50001
color.history.delete=gray4 on rgb345  # #273032 on #a0d6ff
color.history.done=gray4 on rgb030  # #273032 on #00bb00

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray4 on rgb030  # #273032 on #00bb00

# Command: calendar
color.calendar.due=gray4 on rgb345  # #273032 on #a0d6ff
color.calendar.due.today=gray4 on rgb540  # #273032 on #fecc22
color.calendar.holiday=gray4 on rgb303  # #273032 on #bb00bb
color.calendar.overdue=gray4 on rgb300  # #273032 on #a50001
color.calendar.scheduled=gray4 on rgb035  # #273032 on #399bda
color.calendar.today=gray4 on rgb033  # #273032 on #00bbbb
color.calendar.weekend=gray10  # #6e6e6e
color.calendar.weeknumber=gray10  # #6e6e6e

# Command: sync
color.sync.added=rgb030  # #00bb00
color.sync.changed=rgb345  # #a0d6ff
color.sync.rejected=rgb300  # #a50001

# Command: undo
color.undo.after=rgb030  # #00bb00
color.undo.before=rgb300  # #a50001
