# tinted-taskwarrior
# Scheme name: Oxocarbon Dark
# Scheme author: shaunsingh/IBM, Tinted Theming (https://github.com/tinted-theming)
# Scheme: base16-oxocarbon-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #525252
color.label.sort=rgb035  # #33b1ff
color.alternate=on gray3  # #262626
color.header=rgb035  # #33b1ff
color.footnote=rgb044  # #3ddbd9
color.warning=gray1 on rgb510  # #161616 on #ff6f00
color.error=rgb412  # #ee5396
color.debug=rgb044  # #3ddbd9

# Task state
color.completed=gray7  # #525252
color.deleted=gray7  # #525252
color.active=gray1 on rgb131  # #161616 on #42be65
color.recurring=rgb044  # #3ddbd9
color.scheduled=rgb035  # #33b1ff
color.until=
color.blocked=gray7  # #525252
color.blocking=gray1 on rgb325  # #161616 on #be95ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb523  # #ff7eb6
color.uda.priority.M=rgb510  # #ff6f00
color.uda.priority.L=rgb035  # #33b1ff

# Tags
color.tag.next=rgb325  # #be95ff
color.tag.none=
color.tagged=

# Due
color.due=rgb510  # #ff6f00
color.due.today=rgb523  # #ff7eb6
color.overdue=rgb412  # #ee5396

# Report: burndown
color.burndown.done=gray1 on rgb131  # #161616 on #42be65
color.burndown.pending=gray1 on rgb412  # #161616 on #ee5396
color.burndown.started=gray1 on rgb510  # #161616 on #ff6f00

# Report: history
color.history.add=gray1 on rgb412  # #161616 on #ee5396
color.history.delete=gray1 on rgb510  # #161616 on #ff6f00
color.history.done=gray1 on rgb131  # #161616 on #42be65

# Report: summary
color.summary.background=on gray3  # #262626
color.summary.bar=gray1 on rgb131  # #161616 on #42be65

# Command: calendar
color.calendar.due=gray1 on rgb510  # #161616 on #ff6f00
color.calendar.due.today=gray1 on rgb523  # #161616 on #ff7eb6
color.calendar.holiday=gray1 on rgb325  # #161616 on #be95ff
color.calendar.overdue=gray1 on rgb412  # #161616 on #ee5396
color.calendar.scheduled=gray1 on rgb035  # #161616 on #33b1ff
color.calendar.today=gray1 on rgb044  # #161616 on #3ddbd9
color.calendar.weekend=gray7  # #525252
color.calendar.weeknumber=gray7  # #525252

# Command: sync
color.sync.added=rgb131  # #42be65
color.sync.changed=rgb510  # #ff6f00
color.sync.rejected=rgb412  # #ee5396

# Command: undo
color.undo.after=rgb131  # #42be65
color.undo.before=rgb412  # #ee5396
