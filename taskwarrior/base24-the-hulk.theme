# tinted-taskwarrior
# Scheme name: The Hulk
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-the-hulk (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #727473
color.label.sort=rgb105  # #2424f4
color.alternate=on gray2  # #1b1d1e
color.header=rgb105  # #2424f4
color.footnote=rgb023  # #378ca9
color.warning=gray2 on rgb113  # #1b1d1e on #4f6a95
color.error=rgb030  # #259d1a
color.debug=rgb023  # #378ca9

# Task state
color.completed=gray11  # #727473
color.deleted=gray11  # #727473
color.active=gray2 on rgb040  # #1b1d1e on #13ce2f
color.recurring=rgb023  # #378ca9
color.scheduled=rgb105  # #2424f4
color.until=
color.blocked=gray11  # #727473
color.blocking=gray2 on rgb101  # #1b1d1e on #641e73

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb141  # #62e456
color.uda.priority.M=rgb113  # #4f6a95
color.uda.priority.L=rgb105  # #2424f4

# Tags
color.tag.next=rgb101  # #641e73
color.tag.none=
color.tagged=

# Due
color.due=rgb113  # #4f6a95
color.due.today=rgb141  # #62e456
color.overdue=rgb030  # #259d1a

# Report: burndown
color.burndown.done=gray2 on rgb040  # #1b1d1e on #13ce2f
color.burndown.pending=gray2 on rgb030  # #1b1d1e on #259d1a
color.burndown.started=gray2 on rgb113  # #1b1d1e on #4f6a95

# Report: history
color.history.add=gray2 on rgb030  # #1b1d1e on #259d1a
color.history.delete=gray2 on rgb113  # #1b1d1e on #4f6a95
color.history.done=gray2 on rgb040  # #1b1d1e on #13ce2f

# Report: summary
color.summary.background=on gray2  # #1b1d1e
color.summary.bar=gray2 on rgb040  # #1b1d1e on #13ce2f

# Command: calendar
color.calendar.due=gray2 on rgb113  # #1b1d1e on #4f6a95
color.calendar.due.today=gray2 on rgb141  # #1b1d1e on #62e456
color.calendar.holiday=gray2 on rgb101  # #1b1d1e on #641e73
color.calendar.overdue=gray2 on rgb030  # #1b1d1e on #259d1a
color.calendar.scheduled=gray2 on rgb105  # #1b1d1e on #2424f4
color.calendar.today=gray2 on rgb023  # #1b1d1e on #378ca9
color.calendar.weekend=gray11  # #727473
color.calendar.weeknumber=gray11  # #727473

# Command: sync
color.sync.added=rgb040  # #13ce2f
color.sync.changed=rgb113  # #4f6a95
color.sync.rejected=rgb030  # #259d1a

# Command: undo
color.undo.after=rgb040  # #13ce2f
color.undo.before=rgb030  # #259d1a
