# tinted-taskwarrior
# Scheme name: Tomorrow Night
# Scheme author: Chris Kempson (http://chriskempson.com)
# Scheme: base16-tomorrow-night (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray14  # #969896
color.label.sort=rgb234  # #81a2be
color.alternate=on gray3  # #282a2e
color.header=rgb234  # #81a2be
color.footnote=rgb233  # #8abeb7
color.warning=gray2 on rgb542  # #1d1f21 on #f0c674
color.error=rgb411  # #cc6666
color.debug=rgb233  # #8abeb7

# Task state
color.completed=gray14  # #969896
color.deleted=gray14  # #969896
color.active=gray2 on rgb331  # #1d1f21 on #b5bd68
color.recurring=rgb233  # #8abeb7
color.scheduled=rgb234  # #81a2be
color.until=
color.blocked=gray14  # #969896
color.blocking=gray2 on rgb323  # #1d1f21 on #b294bb

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #de935f
color.uda.priority.M=rgb542  # #f0c674
color.uda.priority.L=rgb234  # #81a2be

# Tags
color.tag.next=rgb323  # #b294bb
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #f0c674
color.due.today=rgb421  # #de935f
color.overdue=rgb411  # #cc6666

# Report: burndown
color.burndown.done=gray2 on rgb331  # #1d1f21 on #b5bd68
color.burndown.pending=gray2 on rgb411  # #1d1f21 on #cc6666
color.burndown.started=gray2 on rgb542  # #1d1f21 on #f0c674

# Report: history
color.history.add=gray2 on rgb411  # #1d1f21 on #cc6666
color.history.delete=gray2 on rgb542  # #1d1f21 on #f0c674
color.history.done=gray2 on rgb331  # #1d1f21 on #b5bd68

# Report: summary
color.summary.background=on gray3  # #282a2e
color.summary.bar=gray2 on rgb331  # #1d1f21 on #b5bd68

# Command: calendar
color.calendar.due=gray2 on rgb542  # #1d1f21 on #f0c674
color.calendar.due.today=gray2 on rgb421  # #1d1f21 on #de935f
color.calendar.holiday=gray2 on rgb323  # #1d1f21 on #b294bb
color.calendar.overdue=gray2 on rgb411  # #1d1f21 on #cc6666
color.calendar.scheduled=gray2 on rgb234  # #1d1f21 on #81a2be
color.calendar.today=gray2 on rgb233  # #1d1f21 on #8abeb7
color.calendar.weekend=gray14  # #969896
color.calendar.weeknumber=gray14  # #969896

# Command: sync
color.sync.added=rgb331  # #b5bd68
color.sync.changed=rgb542  # #f0c674
color.sync.rejected=rgb411  # #cc6666

# Command: undo
color.undo.after=rgb331  # #b5bd68
color.undo.before=rgb411  # #cc6666
