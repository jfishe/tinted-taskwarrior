# tinted-taskwarrior
# Scheme name: PaperColor Dark
# Scheme author: Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)
# Scheme: base16-papercolor-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #585858
color.label.sort=rgb134  # #5fafd7
color.alternate=on gray5  # #363636
color.header=rgb134  # #5fafd7
color.footnote=rgb033  # #00afaf
color.warning=gray2 on rgb530  # #1c1c1c on #ffaf00
color.error=rgb513  # #ff5faf
color.debug=rgb033  # #00afaf

# Task state
color.completed=gray8  # #585858
color.deleted=gray8  # #585858
color.active=gray2 on rgb131  # #1c1c1c on #5faf5f
color.recurring=rgb033  # #00afaf
color.scheduled=rgb134  # #5fafd7
color.until=
color.blocked=gray8  # #585858
color.blocking=gray2 on rgb324  # #1c1c1c on #af87d7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb431  # #d7af5f
color.uda.priority.M=rgb530  # #ffaf00
color.uda.priority.L=rgb134  # #5fafd7

# Tags
color.tag.next=rgb324  # #af87d7
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #ffaf00
color.due.today=rgb431  # #d7af5f
color.overdue=rgb513  # #ff5faf

# Report: burndown
color.burndown.done=gray2 on rgb131  # #1c1c1c on #5faf5f
color.burndown.pending=gray2 on rgb513  # #1c1c1c on #ff5faf
color.burndown.started=gray2 on rgb530  # #1c1c1c on #ffaf00

# Report: history
color.history.add=gray2 on rgb513  # #1c1c1c on #ff5faf
color.history.delete=gray2 on rgb530  # #1c1c1c on #ffaf00
color.history.done=gray2 on rgb131  # #1c1c1c on #5faf5f

# Report: summary
color.summary.background=on gray5  # #363636
color.summary.bar=gray2 on rgb131  # #1c1c1c on #5faf5f

# Command: calendar
color.calendar.due=gray2 on rgb530  # #1c1c1c on #ffaf00
color.calendar.due.today=gray2 on rgb431  # #1c1c1c on #d7af5f
color.calendar.holiday=gray2 on rgb324  # #1c1c1c on #af87d7
color.calendar.overdue=gray2 on rgb513  # #1c1c1c on #ff5faf
color.calendar.scheduled=gray2 on rgb134  # #1c1c1c on #5fafd7
color.calendar.today=gray2 on rgb033  # #1c1c1c on #00afaf
color.calendar.weekend=gray8  # #585858
color.calendar.weeknumber=gray8  # #585858

# Command: sync
color.sync.added=rgb131  # #5faf5f
color.sync.changed=rgb530  # #ffaf00
color.sync.rejected=rgb513  # #ff5faf

# Command: undo
color.undo.after=rgb131  # #5faf5f
color.undo.before=rgb513  # #ff5faf
