# tinted-taskwarrior
# Scheme name: Evenok Dark
# Scheme author: Mekeor Melire
# Scheme: base16-evenok-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #505050
color.label.sort=rgb035  # #00aff2
color.alternate=on gray2  # #202020
color.header=rgb035  # #00aff2
color.footnote=rgb033  # #00bab3
color.warning=gray0 on rgb330  # #000000 on #b8a300
color.error=rgb512  # #f5708a
color.debug=rgb033  # #00bab3

# Task state
color.completed=gray7  # #505050
color.deleted=gray7  # #505050
color.active=gray0 on rgb131  # #000000 on #54bc5c
color.recurring=rgb033  # #00bab3
color.scheduled=rgb035  # #00aff2
color.until=
color.blocked=gray7  # #505050
color.blocking=gray0 on rgb225  # #000000 on #9095ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #ee8122
color.uda.priority.M=rgb330  # #b8a300
color.uda.priority.L=rgb035  # #00aff2

# Tags
color.tag.next=rgb225  # #9095ff
color.tag.none=
color.tagged=

# Due
color.due=rgb330  # #b8a300
color.due.today=rgb520  # #ee8122
color.overdue=rgb512  # #f5708a

# Report: burndown
color.burndown.done=gray0 on rgb131  # #000000 on #54bc5c
color.burndown.pending=gray0 on rgb512  # #000000 on #f5708a
color.burndown.started=gray0 on rgb330  # #000000 on #b8a300

# Report: history
color.history.add=gray0 on rgb512  # #000000 on #f5708a
color.history.delete=gray0 on rgb330  # #000000 on #b8a300
color.history.done=gray0 on rgb131  # #000000 on #54bc5c

# Report: summary
color.summary.background=on gray2  # #202020
color.summary.bar=gray0 on rgb131  # #000000 on #54bc5c

# Command: calendar
color.calendar.due=gray0 on rgb330  # #000000 on #b8a300
color.calendar.due.today=gray0 on rgb520  # #000000 on #ee8122
color.calendar.holiday=gray0 on rgb225  # #000000 on #9095ff
color.calendar.overdue=gray0 on rgb512  # #000000 on #f5708a
color.calendar.scheduled=gray0 on rgb035  # #000000 on #00aff2
color.calendar.today=gray0 on rgb033  # #000000 on #00bab3
color.calendar.weekend=gray7  # #505050
color.calendar.weeknumber=gray7  # #505050

# Command: sync
color.sync.added=rgb131  # #54bc5c
color.sync.changed=rgb330  # #b8a300
color.sync.rejected=rgb512  # #f5708a

# Command: undo
color.undo.after=rgb131  # #54bc5c
color.undo.before=rgb512  # #f5708a
