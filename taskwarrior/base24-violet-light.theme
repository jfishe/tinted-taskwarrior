# tinted-taskwarrior
# Scheme name: Violet Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-violet-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #686a6a
color.label.sort=rgb024  # #2e8bce
color.alternate=on gray8  # #56595c
color.header=rgb024  # #2e8bce
color.footnote=rgb033  # #32a198
color.warning=rgb554 on rgb024  # #fcf4dc on #2075c7
color.error=rgb400  # #c94c22
color.debug=rgb033  # #32a198

# Task state
color.completed=gray10  # #686a6a
color.deleted=gray10  # #686a6a
color.active=rgb554 on rgb220  # #fcf4dc on #85981c
color.recurring=rgb033  # #32a198
color.scheduled=rgb024  # #2e8bce
color.until=
color.blocked=gray10  # #686a6a
color.blocking=rgb554 on rgb402  # #fcf4dc on #d13a82

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb320  # #b4881d
color.uda.priority.M=rgb024  # #2075c7
color.uda.priority.L=rgb024  # #2e8bce

# Tags
color.tag.next=rgb402  # #d13a82
color.tag.none=
color.tagged=

# Due
color.due=rgb024  # #2075c7
color.due.today=rgb320  # #b4881d
color.overdue=rgb400  # #c94c22

# Report: burndown
color.burndown.done=rgb554 on rgb220  # #fcf4dc on #85981c
color.burndown.pending=rgb554 on rgb400  # #fcf4dc on #c94c22
color.burndown.started=rgb554 on rgb024  # #fcf4dc on #2075c7

# Report: history
color.history.add=rgb554 on rgb400  # #fcf4dc on #c94c22
color.history.delete=rgb554 on rgb024  # #fcf4dc on #2075c7
color.history.done=rgb554 on rgb220  # #fcf4dc on #85981c

# Report: summary
color.summary.background=on gray8  # #56595c
color.summary.bar=rgb554 on rgb220  # #fcf4dc on #85981c

# Command: calendar
color.calendar.due=rgb554 on rgb024  # #fcf4dc on #2075c7
color.calendar.due.today=rgb554 on rgb320  # #fcf4dc on #b4881d
color.calendar.holiday=rgb554 on rgb402  # #fcf4dc on #d13a82
color.calendar.overdue=rgb554 on rgb400  # #fcf4dc on #c94c22
color.calendar.scheduled=rgb554 on rgb024  # #fcf4dc on #2e8bce
color.calendar.today=rgb554 on rgb033  # #fcf4dc on #32a198
color.calendar.weekend=gray10  # #686a6a
color.calendar.weeknumber=gray10  # #686a6a

# Command: sync
color.sync.added=rgb220  # #85981c
color.sync.changed=rgb024  # #2075c7
color.sync.rejected=rgb400  # #c94c22

# Command: undo
color.undo.after=rgb220  # #85981c
color.undo.before=rgb400  # #c94c22
