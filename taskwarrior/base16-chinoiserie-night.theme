# tinted-taskwarrior
# Scheme name: Chinoiserie Night
# Scheme author: Di Wang (https://cs.cmu.edu/~diw3)
# Scheme: base16-chinoiserie-night (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #918072
color.label.sort=rgb234  # #8fb2c9
color.alternate=on gray3  # #282828
color.header=rgb234  # #8fb2c9
color.footnote=rgb344  # #b0d5df
color.warning=gray2 on rgb541  # #1d1d1d on #f4ce69
color.error=rgb522  # #f07c82
color.debug=rgb344  # #b0d5df

# Task state
color.completed=gray12  # #918072
color.deleted=gray12  # #918072
color.active=gray2 on rgb342  # #1d1d1d on #b2cf87
color.recurring=rgb344  # #b0d5df
color.scheduled=rgb234  # #8fb2c9
color.until=
color.blocked=gray12  # #918072
color.blocking=gray2 on rgb434  # #1d1d1d on #be9db9

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #f4a83a
color.uda.priority.M=rgb541  # #f4ce69
color.uda.priority.L=rgb234  # #8fb2c9

# Tags
color.tag.next=rgb434  # #be9db9
color.tag.none=
color.tagged=

# Due
color.due=rgb541  # #f4ce69
color.due.today=rgb530  # #f4a83a
color.overdue=rgb522  # #f07c82

# Report: burndown
color.burndown.done=gray2 on rgb342  # #1d1d1d on #b2cf87
color.burndown.pending=gray2 on rgb522  # #1d1d1d on #f07c82
color.burndown.started=gray2 on rgb541  # #1d1d1d on #f4ce69

# Report: history
color.history.add=gray2 on rgb522  # #1d1d1d on #f07c82
color.history.delete=gray2 on rgb541  # #1d1d1d on #f4ce69
color.history.done=gray2 on rgb342  # #1d1d1d on #b2cf87

# Report: summary
color.summary.background=on gray3  # #282828
color.summary.bar=gray2 on rgb342  # #1d1d1d on #b2cf87

# Command: calendar
color.calendar.due=gray2 on rgb541  # #1d1d1d on #f4ce69
color.calendar.due.today=gray2 on rgb530  # #1d1d1d on #f4a83a
color.calendar.holiday=gray2 on rgb434  # #1d1d1d on #be9db9
color.calendar.overdue=gray2 on rgb522  # #1d1d1d on #f07c82
color.calendar.scheduled=gray2 on rgb234  # #1d1d1d on #8fb2c9
color.calendar.today=gray2 on rgb344  # #1d1d1d on #b0d5df
color.calendar.weekend=gray12  # #918072
color.calendar.weeknumber=gray12  # #918072

# Command: sync
color.sync.added=rgb342  # #b2cf87
color.sync.changed=rgb541  # #f4ce69
color.sync.rejected=rgb522  # #f07c82

# Command: undo
color.undo.after=rgb342  # #b2cf87
color.undo.before=rgb522  # #f07c82
