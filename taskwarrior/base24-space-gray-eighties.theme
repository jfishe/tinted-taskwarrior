# tinted-taskwarrior
# Scheme name: Space Gray Eighties
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-space-gray-eighties (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #7b7a79
color.label.sort=rgb123  # #5485c0
color.alternate=on gray1  # #15171c
color.header=rgb123  # #5485c0
color.footnote=rgb144  # #57c2c0
color.warning=gray2 on rgb124  # #212121 on #4d83d0
color.error=rgb411  # #ec5f67
color.debug=rgb144  # #57c2c0

# Task state
color.completed=gray11  # #7b7a79
color.deleted=gray11  # #7b7a79
color.active=gray2 on rgb231  # #212121 on #80a763
color.recurring=rgb144  # #57c2c0
color.scheduled=rgb123  # #5485c0
color.until=
color.blocked=gray11  # #7b7a79
color.blocking=gray2 on rgb424  # #212121 on #bf83c0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #fdc253
color.uda.priority.M=rgb124  # #4d83d0
color.uda.priority.L=rgb123  # #5485c0

# Tags
color.tag.next=rgb424  # #bf83c0
color.tag.none=
color.tagged=

# Due
color.due=rgb124  # #4d83d0
color.due.today=rgb530  # #fdc253
color.overdue=rgb411  # #ec5f67

# Report: burndown
color.burndown.done=gray2 on rgb231  # #212121 on #80a763
color.burndown.pending=gray2 on rgb411  # #212121 on #ec5f67
color.burndown.started=gray2 on rgb124  # #212121 on #4d83d0

# Report: history
color.history.add=gray2 on rgb411  # #212121 on #ec5f67
color.history.delete=gray2 on rgb124  # #212121 on #4d83d0
color.history.done=gray2 on rgb231  # #212121 on #80a763

# Report: summary
color.summary.background=on gray1  # #15171c
color.summary.bar=gray2 on rgb231  # #212121 on #80a763

# Command: calendar
color.calendar.due=gray2 on rgb124  # #212121 on #4d83d0
color.calendar.due.today=gray2 on rgb530  # #212121 on #fdc253
color.calendar.holiday=gray2 on rgb424  # #212121 on #bf83c0
color.calendar.overdue=gray2 on rgb411  # #212121 on #ec5f67
color.calendar.scheduled=gray2 on rgb123  # #212121 on #5485c0
color.calendar.today=gray2 on rgb144  # #212121 on #57c2c0
color.calendar.weekend=gray11  # #7b7a79
color.calendar.weeknumber=gray11  # #7b7a79

# Command: sync
color.sync.added=rgb231  # #80a763
color.sync.changed=rgb124  # #4d83d0
color.sync.rejected=rgb411  # #ec5f67

# Command: undo
color.undo.after=rgb231  # #80a763
color.undo.before=rgb411  # #ec5f67
