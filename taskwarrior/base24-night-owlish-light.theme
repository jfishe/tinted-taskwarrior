# tinted-taskwarrior
# Scheme name: Night Owlish Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-night-owlish-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray17  # #b1b4b4
color.label.sort=rgb124  # #4876d6
color.alternate=on gray22  # #e5e6e6
color.header=rgb124  # #4876d6
color.footnote=rgb021  # #08916a
color.warning=rgb555 on rgb440  # #ffffff on #dac801
color.error=rgb411  # #d3423e
color.debug=rgb021  # #08916a

# Task state
color.completed=gray17  # #b1b4b4
color.deleted=gray17  # #b1b4b4
color.active=rgb555 on rgb033  # #ffffff on #2aa298
color.recurring=rgb021  # #08916a
color.scheduled=rgb124  # #4876d6
color.until=
color.blocked=gray17  # #b1b4b4
color.blocking=rgb555 on gray6  # #ffffff on #403f53

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb430  # #daaa01
color.uda.priority.M=rgb440  # #dac801
color.uda.priority.L=rgb124  # #4876d6

# Tags
color.tag.next=gray6  # #403f53
color.tag.none=
color.tagged=

# Due
color.due=rgb440  # #dac801
color.due.today=rgb430  # #daaa01
color.overdue=rgb411  # #d3423e

# Report: burndown
color.burndown.done=rgb555 on rgb033  # #ffffff on #2aa298
color.burndown.pending=rgb555 on rgb411  # #ffffff on #d3423e
color.burndown.started=rgb555 on rgb440  # #ffffff on #dac801

# Report: history
color.history.add=rgb555 on rgb411  # #ffffff on #d3423e
color.history.delete=rgb555 on rgb440  # #ffffff on #dac801
color.history.done=rgb555 on rgb033  # #ffffff on #2aa298

# Report: summary
color.summary.background=on gray22  # #e5e6e6
color.summary.bar=rgb555 on rgb033  # #ffffff on #2aa298

# Command: calendar
color.calendar.due=rgb555 on rgb440  # #ffffff on #dac801
color.calendar.due.today=rgb555 on rgb430  # #ffffff on #daaa01
color.calendar.holiday=rgb555 on gray6  # #ffffff on #403f53
color.calendar.overdue=rgb555 on rgb411  # #ffffff on #d3423e
color.calendar.scheduled=rgb555 on rgb124  # #ffffff on #4876d6
color.calendar.today=rgb555 on rgb021  # #ffffff on #08916a
color.calendar.weekend=gray17  # #b1b4b4
color.calendar.weeknumber=gray17  # #b1b4b4

# Command: sync
color.sync.added=rgb033  # #2aa298
color.sync.changed=rgb440  # #dac801
color.sync.rejected=rgb411  # #d3423e

# Command: undo
color.undo.after=rgb033  # #2aa298
color.undo.before=rgb411  # #d3423e
