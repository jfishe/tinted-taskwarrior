# tinted-taskwarrior
# Scheme name: Moonlight
# Scheme author: Jeremy Swinarton (https://github.com/jswinarton)
# Scheme: base16-moonlight (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb124  # #748cd6
color.label.sort=rgb055  # #40ffff
color.alternate=on rgb112  # #403c64
color.header=rgb055  # #40ffff
color.footnote=rgb045  # #04d1f9
color.warning=gray3 on rgb542  # #212337 on #ffc777
color.error=rgb512  # #ff5370
color.debug=rgb045  # #04d1f9

# Task state
color.completed=rgb124  # #748cd6
color.deleted=rgb124  # #748cd6
color.active=gray3 on rgb054  # #212337 on #2df4c0
color.recurring=rgb045  # #04d1f9
color.scheduled=rgb055  # #40ffff
color.until=
color.blocked=rgb124  # #748cd6
color.blocking=gray3 on rgb324  # #212337 on #b994f1

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb522  # #f67f81
color.uda.priority.M=rgb542  # #ffc777
color.uda.priority.L=rgb055  # #40ffff

# Tags
color.tag.next=rgb324  # #b994f1
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ffc777
color.due.today=rgb522  # #f67f81
color.overdue=rgb512  # #ff5370

# Report: burndown
color.burndown.done=gray3 on rgb054  # #212337 on #2df4c0
color.burndown.pending=gray3 on rgb512  # #212337 on #ff5370
color.burndown.started=gray3 on rgb542  # #212337 on #ffc777

# Report: history
color.history.add=gray3 on rgb512  # #212337 on #ff5370
color.history.delete=gray3 on rgb542  # #212337 on #ffc777
color.history.done=gray3 on rgb054  # #212337 on #2df4c0

# Report: summary
color.summary.background=on rgb112  # #403c64
color.summary.bar=gray3 on rgb054  # #212337 on #2df4c0

# Command: calendar
color.calendar.due=gray3 on rgb542  # #212337 on #ffc777
color.calendar.due.today=gray3 on rgb522  # #212337 on #f67f81
color.calendar.holiday=gray3 on rgb324  # #212337 on #b994f1
color.calendar.overdue=gray3 on rgb512  # #212337 on #ff5370
color.calendar.scheduled=gray3 on rgb055  # #212337 on #40ffff
color.calendar.today=gray3 on rgb045  # #212337 on #04d1f9
color.calendar.weekend=rgb124  # #748cd6
color.calendar.weeknumber=rgb124  # #748cd6

# Command: sync
color.sync.added=rgb054  # #2df4c0
color.sync.changed=rgb542  # #ffc777
color.sync.rejected=rgb512  # #ff5370

# Command: undo
color.undo.after=rgb054  # #2df4c0
color.undo.before=rgb512  # #ff5370
