# tinted-taskwarrior
# Scheme name: Ocean
# Scheme author: Chris Kempson (http://chriskempson.com)
# Scheme: base16-ocean (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #65737e
color.label.sort=rgb234  # #8fa1b3
color.alternate=on gray5  # #343d46
color.header=rgb234  # #8fa1b3
color.footnote=rgb233  # #96b5b4
color.warning=gray4 on rgb542  # #2b303b on #ebcb8b
color.error=rgb311  # #bf616a
color.debug=rgb233  # #96b5b4

# Task state
color.completed=gray11  # #65737e
color.deleted=gray11  # #65737e
color.active=gray4 on rgb232  # #2b303b on #a3be8c
color.recurring=rgb233  # #96b5b4
color.scheduled=rgb234  # #8fa1b3
color.until=
color.blocked=gray11  # #65737e
color.blocking=gray4 on rgb323  # #2b303b on #b48ead

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #d08770
color.uda.priority.M=rgb542  # #ebcb8b
color.uda.priority.L=rgb234  # #8fa1b3

# Tags
color.tag.next=rgb323  # #b48ead
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ebcb8b
color.due.today=rgb421  # #d08770
color.overdue=rgb311  # #bf616a

# Report: burndown
color.burndown.done=gray4 on rgb232  # #2b303b on #a3be8c
color.burndown.pending=gray4 on rgb311  # #2b303b on #bf616a
color.burndown.started=gray4 on rgb542  # #2b303b on #ebcb8b

# Report: history
color.history.add=gray4 on rgb311  # #2b303b on #bf616a
color.history.delete=gray4 on rgb542  # #2b303b on #ebcb8b
color.history.done=gray4 on rgb232  # #2b303b on #a3be8c

# Report: summary
color.summary.background=on gray5  # #343d46
color.summary.bar=gray4 on rgb232  # #2b303b on #a3be8c

# Command: calendar
color.calendar.due=gray4 on rgb542  # #2b303b on #ebcb8b
color.calendar.due.today=gray4 on rgb421  # #2b303b on #d08770
color.calendar.holiday=gray4 on rgb323  # #2b303b on #b48ead
color.calendar.overdue=gray4 on rgb311  # #2b303b on #bf616a
color.calendar.scheduled=gray4 on rgb234  # #2b303b on #8fa1b3
color.calendar.today=gray4 on rgb233  # #2b303b on #96b5b4
color.calendar.weekend=gray11  # #65737e
color.calendar.weeknumber=gray11  # #65737e

# Command: sync
color.sync.added=rgb232  # #a3be8c
color.sync.changed=rgb542  # #ebcb8b
color.sync.rejected=rgb311  # #bf616a

# Command: undo
color.undo.after=rgb232  # #a3be8c
color.undo.before=rgb311  # #bf616a
