# tinted-taskwarrior
# Scheme name: Lumina Quartz Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-quartz-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb444  # #d2d4d9
color.label.sort=rgb013  # #446894
color.alternate=on gray23  # #eef0f5
color.header=rgb013  # #446894
color.footnote=rgb012  # #007092
color.warning=rgb555 on rgb310  # #f5f7fa on #9a642c
color.error=rgb200  # #7d2b28
color.debug=rgb012  # #007092

# Task state
color.completed=rgb444  # #d2d4d9
color.deleted=rgb444  # #d2d4d9
color.active=rgb555 on rgb021  # #f5f7fa on #217550
color.recurring=rgb012  # #007092
color.scheduled=rgb013  # #446894
color.until=
color.blocked=rgb444  # #d2d4d9
color.blocking=rgb555 on rgb213  # #f5f7fa on #7653a5

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #874c2a
color.uda.priority.M=rgb310  # #9a642c
color.uda.priority.L=rgb013  # #446894

# Tags
color.tag.next=rgb213  # #7653a5
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #9a642c
color.due.today=rgb310  # #874c2a
color.overdue=rgb200  # #7d2b28

# Report: burndown
color.burndown.done=rgb555 on rgb021  # #f5f7fa on #217550
color.burndown.pending=rgb555 on rgb200  # #f5f7fa on #7d2b28
color.burndown.started=rgb555 on rgb310  # #f5f7fa on #9a642c

# Report: history
color.history.add=rgb555 on rgb200  # #f5f7fa on #7d2b28
color.history.delete=rgb555 on rgb310  # #f5f7fa on #9a642c
color.history.done=rgb555 on rgb021  # #f5f7fa on #217550

# Report: summary
color.summary.background=on gray23  # #eef0f5
color.summary.bar=rgb555 on rgb021  # #f5f7fa on #217550

# Command: calendar
color.calendar.due=rgb555 on rgb310  # #f5f7fa on #9a642c
color.calendar.due.today=rgb555 on rgb310  # #f5f7fa on #874c2a
color.calendar.holiday=rgb555 on rgb213  # #f5f7fa on #7653a5
color.calendar.overdue=rgb555 on rgb200  # #f5f7fa on #7d2b28
color.calendar.scheduled=rgb555 on rgb013  # #f5f7fa on #446894
color.calendar.today=rgb555 on rgb012  # #f5f7fa on #007092
color.calendar.weekend=rgb444  # #d2d4d9
color.calendar.weeknumber=rgb444  # #d2d4d9

# Command: sync
color.sync.added=rgb021  # #217550
color.sync.changed=rgb310  # #9a642c
color.sync.rejected=rgb200  # #7d2b28

# Command: undo
color.undo.after=rgb021  # #217550
color.undo.before=rgb200  # #7d2b28
