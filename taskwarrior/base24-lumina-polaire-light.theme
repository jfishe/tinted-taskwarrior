# tinted-taskwarrior
# Scheme name: Lumina Polaire Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-polaire-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb444  # #cbd7d9
color.label.sort=rgb112  # #3e5372
color.alternate=on gray23  # #e7f3f5
color.header=rgb112  # #3e5372
color.footnote=rgb012  # #06677c
color.warning=rgb555 on rgb310  # #f0f9fa on #965a1c
color.error=rgb200  # #882322
color.debug=rgb012  # #06677c

# Task state
color.completed=rgb444  # #cbd7d9
color.deleted=rgb444  # #cbd7d9
color.active=rgb555 on rgb021  # #f0f9fa on #327645
color.recurring=rgb012  # #06677c
color.scheduled=rgb112  # #3e5372
color.until=
color.blocked=rgb444  # #cbd7d9
color.blocking=rgb555 on rgb113  # #f0f9fa on #6754bb

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #8d481c
color.uda.priority.M=rgb310  # #965a1c
color.uda.priority.L=rgb112  # #3e5372

# Tags
color.tag.next=rgb113  # #6754bb
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #965a1c
color.due.today=rgb310  # #8d481c
color.overdue=rgb200  # #882322

# Report: burndown
color.burndown.done=rgb555 on rgb021  # #f0f9fa on #327645
color.burndown.pending=rgb555 on rgb200  # #f0f9fa on #882322
color.burndown.started=rgb555 on rgb310  # #f0f9fa on #965a1c

# Report: history
color.history.add=rgb555 on rgb200  # #f0f9fa on #882322
color.history.delete=rgb555 on rgb310  # #f0f9fa on #965a1c
color.history.done=rgb555 on rgb021  # #f0f9fa on #327645

# Report: summary
color.summary.background=on gray23  # #e7f3f5
color.summary.bar=rgb555 on rgb021  # #f0f9fa on #327645

# Command: calendar
color.calendar.due=rgb555 on rgb310  # #f0f9fa on #965a1c
color.calendar.due.today=rgb555 on rgb310  # #f0f9fa on #8d481c
color.calendar.holiday=rgb555 on rgb113  # #f0f9fa on #6754bb
color.calendar.overdue=rgb555 on rgb200  # #f0f9fa on #882322
color.calendar.scheduled=rgb555 on rgb112  # #f0f9fa on #3e5372
color.calendar.today=rgb555 on rgb012  # #f0f9fa on #06677c
color.calendar.weekend=rgb444  # #cbd7d9
color.calendar.weeknumber=rgb444  # #cbd7d9

# Command: sync
color.sync.added=rgb021  # #327645
color.sync.changed=rgb310  # #965a1c
color.sync.rejected=rgb200  # #882322

# Command: undo
color.undo.after=rgb021  # #327645
color.undo.before=rgb200  # #882322
