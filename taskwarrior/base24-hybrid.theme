# tinted-taskwarrior
# Scheme name: Hybrid
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-hybrid (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray6  # #434446
color.label.sort=rgb123  # #6d90b0
color.alternate=on gray4  # #2a2e33
color.header=rgb123  # #6d90b0
color.footnote=rgb133  # #7fbeb3
color.warning=gray1 on rgb013  # #161718 on #4b6b88
color.error=rgb311  # #b74d50
color.debug=rgb133  # #7fbeb3

# Task state
color.completed=gray6  # #434446
color.deleted=gray6  # #434446
color.active=gray1 on rgb331  # #161718 on #b3be5a
color.recurring=rgb133  # #7fbeb3
color.scheduled=rgb123  # #6d90b0
color.until=
color.blocked=gray6  # #434446
color.blocking=gray1 on rgb323  # #161718 on #a07eab

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb431  # #e3b55e
color.uda.priority.M=rgb013  # #4b6b88
color.uda.priority.L=rgb123  # #6d90b0

# Tags
color.tag.next=rgb323  # #a07eab
color.tag.none=
color.tagged=

# Due
color.due=rgb013  # #4b6b88
color.due.today=rgb431  # #e3b55e
color.overdue=rgb311  # #b74d50

# Report: burndown
color.burndown.done=gray1 on rgb331  # #161718 on #b3be5a
color.burndown.pending=gray1 on rgb311  # #161718 on #b74d50
color.burndown.started=gray1 on rgb013  # #161718 on #4b6b88

# Report: history
color.history.add=gray1 on rgb311  # #161718 on #b74d50
color.history.delete=gray1 on rgb013  # #161718 on #4b6b88
color.history.done=gray1 on rgb331  # #161718 on #b3be5a

# Report: summary
color.summary.background=on gray4  # #2a2e33
color.summary.bar=gray1 on rgb331  # #161718 on #b3be5a

# Command: calendar
color.calendar.due=gray1 on rgb013  # #161718 on #4b6b88
color.calendar.due.today=gray1 on rgb431  # #161718 on #e3b55e
color.calendar.holiday=gray1 on rgb323  # #161718 on #a07eab
color.calendar.overdue=gray1 on rgb311  # #161718 on #b74d50
color.calendar.scheduled=gray1 on rgb123  # #161718 on #6d90b0
color.calendar.today=gray1 on rgb133  # #161718 on #7fbeb3
color.calendar.weekend=gray6  # #434446
color.calendar.weeknumber=gray6  # #434446

# Command: sync
color.sync.added=rgb331  # #b3be5a
color.sync.changed=rgb013  # #4b6b88
color.sync.rejected=rgb311  # #b74d50

# Command: undo
color.undo.after=rgb331  # #b3be5a
color.undo.before=rgb311  # #b74d50
