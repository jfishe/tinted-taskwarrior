# tinted-taskwarrior
# Scheme name: Vesper
# Scheme author: FormalSnake (https://github.com/formalsnake)
# Scheme: base16-vesper (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray4  # #333333
color.label.sort=rgb233  # #8eaaaa
color.alternate=on gray3  # #232323
color.header=rgb233  # #8eaaaa
color.footnote=rgb132  # #60a592
color.warning=gray1 on rgb543  # #101010 on #ffc799
color.error=rgb411  # #de6e6e
color.debug=rgb132  # #60a592

# Task state
color.completed=gray4  # #333333
color.deleted=gray4  # #333333
color.active=gray1 on rgb122  # #101010 on #5f8787
color.recurring=rgb132  # #60a592
color.scheduled=rgb233  # #8eaaaa
color.until=
color.blocked=gray4  # #333333
color.blocking=gray1 on rgb422  # #101010 on #d69094

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb432  # #dab083
color.uda.priority.M=rgb543  # #ffc799
color.uda.priority.L=rgb233  # #8eaaaa

# Tags
color.tag.next=rgb422  # #d69094
color.tag.none=
color.tagged=

# Due
color.due=rgb543  # #ffc799
color.due.today=rgb432  # #dab083
color.overdue=rgb411  # #de6e6e

# Report: burndown
color.burndown.done=gray1 on rgb122  # #101010 on #5f8787
color.burndown.pending=gray1 on rgb411  # #101010 on #de6e6e
color.burndown.started=gray1 on rgb543  # #101010 on #ffc799

# Report: history
color.history.add=gray1 on rgb411  # #101010 on #de6e6e
color.history.delete=gray1 on rgb543  # #101010 on #ffc799
color.history.done=gray1 on rgb122  # #101010 on #5f8787

# Report: summary
color.summary.background=on gray3  # #232323
color.summary.bar=gray1 on rgb122  # #101010 on #5f8787

# Command: calendar
color.calendar.due=gray1 on rgb543  # #101010 on #ffc799
color.calendar.due.today=gray1 on rgb432  # #101010 on #dab083
color.calendar.holiday=gray1 on rgb422  # #101010 on #d69094
color.calendar.overdue=gray1 on rgb411  # #101010 on #de6e6e
color.calendar.scheduled=gray1 on rgb233  # #101010 on #8eaaaa
color.calendar.today=gray1 on rgb132  # #101010 on #60a592
color.calendar.weekend=gray4  # #333333
color.calendar.weeknumber=gray4  # #333333

# Command: sync
color.sync.added=rgb122  # #5f8787
color.sync.changed=rgb543  # #ffc799
color.sync.rejected=rgb411  # #de6e6e

# Command: undo
color.undo.after=rgb122  # #5f8787
color.undo.before=rgb411  # #de6e6e
