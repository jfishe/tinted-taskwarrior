# tinted-taskwarrior
# Scheme name: WWDC17 Light
# Scheme author: jfishe (generated by colortemplate2tinty)
# Scheme: base16-wwdc17-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb222  # #888888
color.label.sort=rgb122  # #527f8f
color.alternate=on gray23  # #f0f0f0
color.header=rgb122  # #527f8f
color.footnote=rgb034  # #159ccc
color.warning=rgb555 on rgb430  # #fafafa on #e1ad0b
color.error=rgb500  # #e8503f
color.debug=rgb034  # #159ccc

# Task state
color.completed=rgb222  # #888888
color.deleted=rgb222  # #888888
color.active=rgb555 on rgb022  # #fafafa on #00998c
color.recurring=rgb034  # #159ccc
color.scheduled=rgb122  # #527f8f
color.until=
color.blocked=rgb222  # #888888
color.blocking=rgb555 on rgb501  # #fafafa on #db2d45

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb420  # #d87900
color.uda.priority.M=rgb430  # #e1ad0b
color.uda.priority.L=rgb122  # #527f8f

# Tags
color.tag.next=rgb501  # #db2d45
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #e1ad0b
color.due.today=rgb420  # #d87900
color.overdue=rgb500  # #e8503f

# Report: burndown
color.burndown.done=rgb555 on rgb022  # #fafafa on #00998c
color.burndown.pending=rgb555 on rgb500  # #fafafa on #e8503f
color.burndown.started=rgb555 on rgb430  # #fafafa on #e1ad0b

# Report: history
color.history.add=rgb555 on rgb500  # #fafafa on #e8503f
color.history.delete=rgb555 on rgb430  # #fafafa on #e1ad0b
color.history.done=rgb555 on rgb022  # #fafafa on #00998c

# Report: summary
color.summary.background=on gray23  # #f0f0f0
color.summary.bar=rgb555 on rgb022  # #fafafa on #00998c

# Command: calendar
color.calendar.due=rgb555 on rgb430  # #fafafa on #e1ad0b
color.calendar.due.today=rgb555 on rgb420  # #fafafa on #d87900
color.calendar.holiday=rgb555 on rgb501  # #fafafa on #db2d45
color.calendar.overdue=rgb555 on rgb500  # #fafafa on #e8503f
color.calendar.scheduled=rgb555 on rgb122  # #fafafa on #527f8f
color.calendar.today=rgb555 on rgb034  # #fafafa on #159ccc
color.calendar.weekend=rgb222  # #888888
color.calendar.weeknumber=rgb222  # #888888

# Command: sync
color.sync.added=rgb022  # #00998c
color.sync.changed=rgb430  # #e1ad0b
color.sync.rejected=rgb500  # #e8503f

# Command: undo
color.undo.after=rgb022  # #00998c
color.undo.before=rgb500  # #e8503f
