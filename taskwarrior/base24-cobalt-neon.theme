# tinted-taskwarrior
# Scheme name: Cobalt Neon
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-cobalt-neon (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb542  # #eeca92
color.label.sort=rgb252  # #8ff586
color.alternate=on gray3  # #142630
color.header=rgb252  # #8ff586
color.footnote=rgb252  # #8ff586
color.warning=gray3 on rgb124  # #142838 on #3c7dd2
color.error=rgb500  # #ff2320
color.debug=rgb252  # #8ff586

# Task state
color.completed=rgb542  # #eeca92
color.deleted=rgb542  # #eeca92
color.active=gray3 on rgb135  # #142838 on #3aa5ff
color.recurring=rgb252  # #8ff586
color.scheduled=rgb252  # #8ff586
color.until=
color.blocked=rgb542  # #eeca92
color.blocking=gray3 on rgb203  # #142838 on #781aa0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb441  # #e9e75c
color.uda.priority.M=rgb124  # #3c7dd2
color.uda.priority.L=rgb252  # #8ff586

# Tags
color.tag.next=rgb203  # #781aa0
color.tag.none=
color.tagged=

# Due
color.due=rgb124  # #3c7dd2
color.due.today=rgb441  # #e9e75c
color.overdue=rgb500  # #ff2320

# Report: burndown
color.burndown.done=gray3 on rgb135  # #142838 on #3aa5ff
color.burndown.pending=gray3 on rgb500  # #142838 on #ff2320
color.burndown.started=gray3 on rgb124  # #142838 on #3c7dd2

# Report: history
color.history.add=gray3 on rgb500  # #142838 on #ff2320
color.history.delete=gray3 on rgb124  # #142838 on #3c7dd2
color.history.done=gray3 on rgb135  # #142838 on #3aa5ff

# Report: summary
color.summary.background=on gray3  # #142630
color.summary.bar=gray3 on rgb135  # #142838 on #3aa5ff

# Command: calendar
color.calendar.due=gray3 on rgb124  # #142838 on #3c7dd2
color.calendar.due.today=gray3 on rgb441  # #142838 on #e9e75c
color.calendar.holiday=gray3 on rgb203  # #142838 on #781aa0
color.calendar.overdue=gray3 on rgb500  # #142838 on #ff2320
color.calendar.scheduled=gray3 on rgb252  # #142838 on #8ff586
color.calendar.today=gray3 on rgb252  # #142838 on #8ff586
color.calendar.weekend=rgb542  # #eeca92
color.calendar.weeknumber=rgb542  # #eeca92

# Command: sync
color.sync.added=rgb135  # #3aa5ff
color.sync.changed=rgb124  # #3c7dd2
color.sync.rejected=rgb500  # #ff2320

# Command: undo
color.undo.after=rgb135  # #3aa5ff
color.undo.before=rgb500  # #ff2320
