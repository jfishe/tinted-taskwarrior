# tinted-taskwarrior
# Scheme name: Paul Millr
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-paul-millr (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7b7b7b
color.label.sort=rgb014  # #386bd7
color.alternate=on gray3  # #2a2a2a
color.header=rgb014  # #386bd7
color.footnote=rgb245  # #66ccff
color.warning=gray0 on rgb125  # #000000 on #709aed
color.error=rgb500  # #ff0000
color.debug=rgb245  # #66ccff

# Task state
color.completed=gray12  # #7b7b7b
color.deleted=gray12  # #7b7b7b
color.active=gray0 on rgb250  # #000000 on #79ff0f
color.recurring=rgb245  # #66ccff
color.scheduled=rgb014  # #386bd7
color.until=
color.blocked=gray12  # #7b7b7b
color.blocking=gray0 on rgb313  # #000000 on #b349be

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb430  # #e7bf00
color.uda.priority.M=rgb125  # #709aed
color.uda.priority.L=rgb014  # #386bd7

# Tags
color.tag.next=rgb313  # #b349be
color.tag.none=
color.tagged=

# Due
color.due=rgb125  # #709aed
color.due.today=rgb430  # #e7bf00
color.overdue=rgb500  # #ff0000

# Report: burndown
color.burndown.done=gray0 on rgb250  # #000000 on #79ff0f
color.burndown.pending=gray0 on rgb500  # #000000 on #ff0000
color.burndown.started=gray0 on rgb125  # #000000 on #709aed

# Report: history
color.history.add=gray0 on rgb500  # #000000 on #ff0000
color.history.delete=gray0 on rgb125  # #000000 on #709aed
color.history.done=gray0 on rgb250  # #000000 on #79ff0f

# Report: summary
color.summary.background=on gray3  # #2a2a2a
color.summary.bar=gray0 on rgb250  # #000000 on #79ff0f

# Command: calendar
color.calendar.due=gray0 on rgb125  # #000000 on #709aed
color.calendar.due.today=gray0 on rgb430  # #000000 on #e7bf00
color.calendar.holiday=gray0 on rgb313  # #000000 on #b349be
color.calendar.overdue=gray0 on rgb500  # #000000 on #ff0000
color.calendar.scheduled=gray0 on rgb014  # #000000 on #386bd7
color.calendar.today=gray0 on rgb245  # #000000 on #66ccff
color.calendar.weekend=gray12  # #7b7b7b
color.calendar.weeknumber=gray12  # #7b7b7b

# Command: sync
color.sync.added=rgb250  # #79ff0f
color.sync.changed=rgb125  # #709aed
color.sync.rejected=rgb500  # #ff0000

# Command: undo
color.undo.after=rgb250  # #79ff0f
color.undo.before=rgb500  # #ff0000
