# tinted-taskwarrior
# Scheme name: Windows NT Light
# Scheme author: Fergus Collins (https://github.com/ferguscollins)
# Scheme: base16-windows-nt-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray18  # #c0c0c0
color.label.sort=rgb102  # #000080
color.alternate=on gray23  # #eaeaea
color.header=rgb102  # #000080
color.footnote=rgb022  # #008080
color.warning=rgb555 on rgb220  # #ffffff on #808000
color.error=rgb200  # #800000
color.debug=rgb022  # #008080

# Task state
color.completed=gray18  # #c0c0c0
color.deleted=gray18  # #c0c0c0
color.active=rgb555 on rgb020  # #ffffff on #008000
color.recurring=rgb022  # #008080
color.scheduled=rgb102  # #000080
color.until=
color.blocked=gray18  # #c0c0c0
color.blocking=rgb555 on rgb202  # #ffffff on #800080

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb550  # #ffff00
color.uda.priority.M=rgb220  # #808000
color.uda.priority.L=rgb102  # #000080

# Tags
color.tag.next=rgb202  # #800080
color.tag.none=
color.tagged=

# Due
color.due=rgb220  # #808000
color.due.today=rgb550  # #ffff00
color.overdue=rgb200  # #800000

# Report: burndown
color.burndown.done=rgb555 on rgb020  # #ffffff on #008000
color.burndown.pending=rgb555 on rgb200  # #ffffff on #800000
color.burndown.started=rgb555 on rgb220  # #ffffff on #808000

# Report: history
color.history.add=rgb555 on rgb200  # #ffffff on #800000
color.history.delete=rgb555 on rgb220  # #ffffff on #808000
color.history.done=rgb555 on rgb020  # #ffffff on #008000

# Report: summary
color.summary.background=on gray23  # #eaeaea
color.summary.bar=rgb555 on rgb020  # #ffffff on #008000

# Command: calendar
color.calendar.due=rgb555 on rgb220  # #ffffff on #808000
color.calendar.due.today=rgb555 on rgb550  # #ffffff on #ffff00
color.calendar.holiday=rgb555 on rgb202  # #ffffff on #800080
color.calendar.overdue=rgb555 on rgb200  # #ffffff on #800000
color.calendar.scheduled=rgb555 on rgb102  # #ffffff on #000080
color.calendar.today=rgb555 on rgb022  # #ffffff on #008080
color.calendar.weekend=gray18  # #c0c0c0
color.calendar.weeknumber=gray18  # #c0c0c0

# Command: sync
color.sync.added=rgb020  # #008000
color.sync.changed=rgb220  # #808000
color.sync.rejected=rgb200  # #800000

# Command: undo
color.undo.after=rgb020  # #008000
color.undo.before=rgb200  # #800000
