# tinted-taskwarrior
# Scheme name: Stranger Theme Hawkins
# Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
# Scheme: base16-stranger-theme-hawkins (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb321  # #9e8766
color.label.sort=rgb323  # #b48ead
color.alternate=on gray5  # #40362c
color.header=rgb323  # #b48ead
color.footnote=rgb233  # #88c0d0
color.warning=gray3 on rgb542  # #2c2218 on #ebcb8b
color.error=rgb311  # #bf616a
color.debug=rgb233  # #88c0d0

# Task state
color.completed=rgb321  # #9e8766
color.deleted=rgb321  # #9e8766
color.active=gray3 on rgb232  # #2c2218 on #a3be8c
color.recurring=rgb233  # #88c0d0
color.scheduled=rgb323  # #b48ead
color.until=
color.blocked=rgb321  # #9e8766
color.blocking=gray3 on rgb432  # #2c2218 on #d4a574

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #d08770
color.uda.priority.M=rgb542  # #ebcb8b
color.uda.priority.L=rgb323  # #b48ead

# Tags
color.tag.next=rgb432  # #d4a574
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ebcb8b
color.due.today=rgb421  # #d08770
color.overdue=rgb311  # #bf616a

# Report: burndown
color.burndown.done=gray3 on rgb232  # #2c2218 on #a3be8c
color.burndown.pending=gray3 on rgb311  # #2c2218 on #bf616a
color.burndown.started=gray3 on rgb542  # #2c2218 on #ebcb8b

# Report: history
color.history.add=gray3 on rgb311  # #2c2218 on #bf616a
color.history.delete=gray3 on rgb542  # #2c2218 on #ebcb8b
color.history.done=gray3 on rgb232  # #2c2218 on #a3be8c

# Report: summary
color.summary.background=on gray5  # #40362c
color.summary.bar=gray3 on rgb232  # #2c2218 on #a3be8c

# Command: calendar
color.calendar.due=gray3 on rgb542  # #2c2218 on #ebcb8b
color.calendar.due.today=gray3 on rgb421  # #2c2218 on #d08770
color.calendar.holiday=gray3 on rgb432  # #2c2218 on #d4a574
color.calendar.overdue=gray3 on rgb311  # #2c2218 on #bf616a
color.calendar.scheduled=gray3 on rgb323  # #2c2218 on #b48ead
color.calendar.today=gray3 on rgb233  # #2c2218 on #88c0d0
color.calendar.weekend=rgb321  # #9e8766
color.calendar.weeknumber=rgb321  # #9e8766

# Command: sync
color.sync.added=rgb232  # #a3be8c
color.sync.changed=rgb542  # #ebcb8b
color.sync.rejected=rgb311  # #bf616a

# Command: undo
color.undo.after=rgb232  # #a3be8c
color.undo.before=rgb311  # #bf616a
