# tinted-taskwarrior
# Scheme name: Tokyo City Light
# Scheme author: Michaël Ball
# Scheme: base16-tokyo-city-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray15  # #9699a3
color.label.sort=rgb013  # #34548a
color.alternate=on gray23  # #f6f6f8
color.header=rgb013  # #34548a
color.footnote=gray7  # #4c505e
color.warning=rgb555 on gray7  # #fbfbfd on #4c505e
color.error=rgb211  # #8c4351
color.debug=gray7  # #4c505e

# Task state
color.completed=gray15  # #9699a3
color.deleted=gray15  # #9699a3
color.active=rgb555 on rgb010  # #fbfbfd on #485e30
color.recurring=gray7  # #4c505e
color.scheduled=rgb013  # #34548a
color.until=
color.blocked=gray15  # #9699a3
color.blocking=rgb555 on rgb112  # #fbfbfd on #5a4a78

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #965027
color.uda.priority.M=gray7  # #4c505e
color.uda.priority.L=rgb013  # #34548a

# Tags
color.tag.next=rgb112  # #5a4a78
color.tag.none=
color.tagged=

# Due
color.due=gray7  # #4c505e
color.due.today=rgb310  # #965027
color.overdue=rgb211  # #8c4351

# Report: burndown
color.burndown.done=rgb555 on rgb010  # #fbfbfd on #485e30
color.burndown.pending=rgb555 on rgb211  # #fbfbfd on #8c4351
color.burndown.started=rgb555 on gray7  # #fbfbfd on #4c505e

# Report: history
color.history.add=rgb555 on rgb211  # #fbfbfd on #8c4351
color.history.delete=rgb555 on gray7  # #fbfbfd on #4c505e
color.history.done=rgb555 on rgb010  # #fbfbfd on #485e30

# Report: summary
color.summary.background=on gray23  # #f6f6f8
color.summary.bar=rgb555 on rgb010  # #fbfbfd on #485e30

# Command: calendar
color.calendar.due=rgb555 on gray7  # #fbfbfd on #4c505e
color.calendar.due.today=rgb555 on rgb310  # #fbfbfd on #965027
color.calendar.holiday=rgb555 on rgb112  # #fbfbfd on #5a4a78
color.calendar.overdue=rgb555 on rgb211  # #fbfbfd on #8c4351
color.calendar.scheduled=rgb555 on rgb013  # #fbfbfd on #34548a
color.calendar.today=rgb555 on gray7  # #fbfbfd on #4c505e
color.calendar.weekend=gray15  # #9699a3
color.calendar.weeknumber=gray15  # #9699a3

# Command: sync
color.sync.added=rgb010  # #485e30
color.sync.changed=gray7  # #4c505e
color.sync.rejected=rgb211  # #8c4351

# Command: undo
color.undo.after=rgb010  # #485e30
color.undo.before=rgb211  # #8c4351
