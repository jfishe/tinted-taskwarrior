# tinted-taskwarrior
# Scheme name: Molokai
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-molokai (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6e6e6e
color.label.sort=rgb024  # #0f7fcf
color.alternate=on gray1  # #121212
color.header=rgb024  # #0f7fcf
color.footnote=rgb134  # #42a7cf
color.warning=gray1 on rgb035  # #121212 on #00afff
color.error=rgb501  # #fa2573
color.debug=rgb134  # #42a7cf

# Task state
color.completed=gray10  # #6e6e6e
color.deleted=gray10  # #6e6e6e
color.active=gray1 on rgb240  # #121212 on #97e123
color.recurring=rgb134  # #42a7cf
color.scheduled=rgb024  # #0f7fcf
color.until=
color.blocked=gray10  # #6e6e6e
color.blocking=gray1 on rgb205  # #121212 on #8700ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb441  # #dfd460
color.uda.priority.M=rgb035  # #00afff
color.uda.priority.L=rgb024  # #0f7fcf

# Tags
color.tag.next=rgb205  # #8700ff
color.tag.none=
color.tagged=

# Due
color.due=rgb035  # #00afff
color.due.today=rgb441  # #dfd460
color.overdue=rgb501  # #fa2573

# Report: burndown
color.burndown.done=gray1 on rgb240  # #121212 on #97e123
color.burndown.pending=gray1 on rgb501  # #121212 on #fa2573
color.burndown.started=gray1 on rgb035  # #121212 on #00afff

# Report: history
color.history.add=gray1 on rgb501  # #121212 on #fa2573
color.history.delete=gray1 on rgb035  # #121212 on #00afff
color.history.done=gray1 on rgb240  # #121212 on #97e123

# Report: summary
color.summary.background=on gray1  # #121212
color.summary.bar=gray1 on rgb240  # #121212 on #97e123

# Command: calendar
color.calendar.due=gray1 on rgb035  # #121212 on #00afff
color.calendar.due.today=gray1 on rgb441  # #121212 on #dfd460
color.calendar.holiday=gray1 on rgb205  # #121212 on #8700ff
color.calendar.overdue=gray1 on rgb501  # #121212 on #fa2573
color.calendar.scheduled=gray1 on rgb024  # #121212 on #0f7fcf
color.calendar.today=gray1 on rgb134  # #121212 on #42a7cf
color.calendar.weekend=gray10  # #6e6e6e
color.calendar.weeknumber=gray10  # #6e6e6e

# Command: sync
color.sync.added=rgb240  # #97e123
color.sync.changed=rgb035  # #00afff
color.sync.rejected=rgb501  # #fa2573

# Command: undo
color.undo.after=rgb240  # #97e123
color.undo.before=rgb501  # #fa2573
