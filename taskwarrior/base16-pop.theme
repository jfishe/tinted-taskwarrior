# tinted-taskwarrior
# Scheme name: Pop
# Scheme author: Chris Kempson (http://chriskempson.com)
# Scheme: base16-pop (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #505050
color.label.sort=rgb013  # #0e5a94
color.alternate=on gray2  # #202020
color.header=rgb013  # #0e5a94
color.footnote=rgb033  # #00aabb
color.warning=gray0 on rgb540  # #000000 on #f8ca12
color.error=rgb402  # #eb008a
color.debug=rgb033  # #00aabb

# Task state
color.completed=gray7  # #505050
color.deleted=gray7  # #505050
color.active=gray0 on rgb131  # #000000 on #37b349
color.recurring=rgb033  # #00aabb
color.scheduled=rgb013  # #0e5a94
color.until=
color.blocked=gray7  # #505050
color.blocking=gray0 on rgb302  # #000000 on #b31e8d

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #f29333
color.uda.priority.M=rgb540  # #f8ca12
color.uda.priority.L=rgb013  # #0e5a94

# Tags
color.tag.next=rgb302  # #b31e8d
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #f8ca12
color.due.today=rgb520  # #f29333
color.overdue=rgb402  # #eb008a

# Report: burndown
color.burndown.done=gray0 on rgb131  # #000000 on #37b349
color.burndown.pending=gray0 on rgb402  # #000000 on #eb008a
color.burndown.started=gray0 on rgb540  # #000000 on #f8ca12

# Report: history
color.history.add=gray0 on rgb402  # #000000 on #eb008a
color.history.delete=gray0 on rgb540  # #000000 on #f8ca12
color.history.done=gray0 on rgb131  # #000000 on #37b349

# Report: summary
color.summary.background=on gray2  # #202020
color.summary.bar=gray0 on rgb131  # #000000 on #37b349

# Command: calendar
color.calendar.due=gray0 on rgb540  # #000000 on #f8ca12
color.calendar.due.today=gray0 on rgb520  # #000000 on #f29333
color.calendar.holiday=gray0 on rgb302  # #000000 on #b31e8d
color.calendar.overdue=gray0 on rgb402  # #000000 on #eb008a
color.calendar.scheduled=gray0 on rgb013  # #000000 on #0e5a94
color.calendar.today=gray0 on rgb033  # #000000 on #00aabb
color.calendar.weekend=gray7  # #505050
color.calendar.weeknumber=gray7  # #505050

# Command: sync
color.sync.added=rgb131  # #37b349
color.sync.changed=rgb540  # #f8ca12
color.sync.rejected=rgb402  # #eb008a

# Command: undo
color.undo.after=rgb131  # #37b349
color.undo.before=rgb402  # #eb008a
