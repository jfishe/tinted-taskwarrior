# tinted-taskwarrior
# Scheme name: Brasa
# Scheme author: Teshre
# Scheme: base16-brasa (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb211  # #7a6150
color.label.sort=rgb335  # #9aa6e0
color.alternate=on gray2  # #2b1c14
color.header=rgb335  # #9aa6e0
color.footnote=rgb144  # #6bc8b8
color.warning=gray1 on rgb530  # #1a0f0a on #f0b23a
color.error=rgb511  # #f2685a
color.debug=rgb144  # #6bc8b8

# Task state
color.completed=rgb211  # #7a6150
color.deleted=rgb211  # #7a6150
color.active=gray1 on rgb441  # #1a0f0a on #b8c24a
color.recurring=rgb144  # #6bc8b8
color.scheduled=rgb335  # #9aa6e0
color.until=
color.blocked=rgb211  # #7a6150
color.blocking=gray1 on rgb523  # #1a0f0a on #e68aa2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb521  # #ff7a4d
color.uda.priority.M=rgb530  # #f0b23a
color.uda.priority.L=rgb335  # #9aa6e0

# Tags
color.tag.next=rgb523  # #e68aa2
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #f0b23a
color.due.today=rgb521  # #ff7a4d
color.overdue=rgb511  # #f2685a

# Report: burndown
color.burndown.done=gray1 on rgb441  # #1a0f0a on #b8c24a
color.burndown.pending=gray1 on rgb511  # #1a0f0a on #f2685a
color.burndown.started=gray1 on rgb530  # #1a0f0a on #f0b23a

# Report: history
color.history.add=gray1 on rgb511  # #1a0f0a on #f2685a
color.history.delete=gray1 on rgb530  # #1a0f0a on #f0b23a
color.history.done=gray1 on rgb441  # #1a0f0a on #b8c24a

# Report: summary
color.summary.background=on gray2  # #2b1c14
color.summary.bar=gray1 on rgb441  # #1a0f0a on #b8c24a

# Command: calendar
color.calendar.due=gray1 on rgb530  # #1a0f0a on #f0b23a
color.calendar.due.today=gray1 on rgb521  # #1a0f0a on #ff7a4d
color.calendar.holiday=gray1 on rgb523  # #1a0f0a on #e68aa2
color.calendar.overdue=gray1 on rgb511  # #1a0f0a on #f2685a
color.calendar.scheduled=gray1 on rgb335  # #1a0f0a on #9aa6e0
color.calendar.today=gray1 on rgb144  # #1a0f0a on #6bc8b8
color.calendar.weekend=rgb211  # #7a6150
color.calendar.weeknumber=rgb211  # #7a6150

# Command: sync
color.sync.added=rgb441  # #b8c24a
color.sync.changed=rgb530  # #f0b23a
color.sync.rejected=rgb511  # #f2685a

# Command: undo
color.undo.after=rgb441  # #b8c24a
color.undo.before=rgb511  # #f2685a
