# tinted-taskwarrior
# Scheme name: Qualia
# Scheme author: isaacwhanson
# Scheme: base16-qualia (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray6  # #454545
color.label.sort=rgb144  # #50cacd
color.alternate=on gray6  # #454545
color.header=rgb144  # #50cacd
color.footnote=rgb442  # #c8c874
color.warning=gray1 on rgb434  # #101010 on #e6a3dc
color.error=rgb533  # #efa6a2
color.debug=rgb442  # #c8c874

# Task state
color.completed=gray6  # #454545
color.deleted=gray6  # #454545
color.active=gray1 on rgb242  # #101010 on #80c990
color.recurring=rgb442  # #c8c874
color.scheduled=rgb144  # #50cacd
color.until=
color.blocked=gray6  # #454545
color.blocking=gray1 on rgb432  # #101010 on #e0af85

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb335  # #a3b8ef
color.uda.priority.M=rgb434  # #e6a3dc
color.uda.priority.L=rgb144  # #50cacd

# Tags
color.tag.next=rgb432  # #e0af85
color.tag.none=
color.tagged=

# Due
color.due=rgb434  # #e6a3dc
color.due.today=rgb335  # #a3b8ef
color.overdue=rgb533  # #efa6a2

# Report: burndown
color.burndown.done=gray1 on rgb242  # #101010 on #80c990
color.burndown.pending=gray1 on rgb533  # #101010 on #efa6a2
color.burndown.started=gray1 on rgb434  # #101010 on #e6a3dc

# Report: history
color.history.add=gray1 on rgb533  # #101010 on #efa6a2
color.history.delete=gray1 on rgb434  # #101010 on #e6a3dc
color.history.done=gray1 on rgb242  # #101010 on #80c990

# Report: summary
color.summary.background=on gray6  # #454545
color.summary.bar=gray1 on rgb242  # #101010 on #80c990

# Command: calendar
color.calendar.due=gray1 on rgb434  # #101010 on #e6a3dc
color.calendar.due.today=gray1 on rgb335  # #101010 on #a3b8ef
color.calendar.holiday=gray1 on rgb432  # #101010 on #e0af85
color.calendar.overdue=gray1 on rgb533  # #101010 on #efa6a2
color.calendar.scheduled=gray1 on rgb144  # #101010 on #50cacd
color.calendar.today=gray1 on rgb442  # #101010 on #c8c874
color.calendar.weekend=gray6  # #454545
color.calendar.weeknumber=gray6  # #454545

# Command: sync
color.sync.added=rgb242  # #80c990
color.sync.changed=rgb434  # #e6a3dc
color.sync.rejected=rgb533  # #efa6a2

# Command: undo
color.undo.after=rgb242  # #80c990
color.undo.before=rgb533  # #efa6a2
