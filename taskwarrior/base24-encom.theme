# tinted-taskwarrior
# Scheme name: ENCOM
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-encom (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6e6e6e
color.label.sort=rgb025  # #0081ff
color.alternate=on gray0  # #000000
color.header=rgb025  # #0081ff
color.footnote=rgb022  # #008b8b
color.warning=gray0 on rgb105  # #000000 on #0000ff
color.error=rgb300  # #9f0000
color.debug=rgb022  # #008b8b

# Task state
color.completed=gray10  # #6e6e6e
color.deleted=gray10  # #6e6e6e
color.active=gray0 on rgb020  # #000000 on #008b00
color.recurring=rgb022  # #008b8b
color.scheduled=rgb025  # #0081ff
color.until=
color.blocked=gray10  # #6e6e6e
color.blocking=gray0 on rgb304  # #000000 on #bc00ca

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb540  # #ffcf00
color.uda.priority.M=rgb105  # #0000ff
color.uda.priority.L=rgb025  # #0081ff

# Tags
color.tag.next=rgb304  # #bc00ca
color.tag.none=
color.tagged=

# Due
color.due=rgb105  # #0000ff
color.due.today=rgb540  # #ffcf00
color.overdue=rgb300  # #9f0000

# Report: burndown
color.burndown.done=gray0 on rgb020  # #000000 on #008b00
color.burndown.pending=gray0 on rgb300  # #000000 on #9f0000
color.burndown.started=gray0 on rgb105  # #000000 on #0000ff

# Report: history
color.history.add=gray0 on rgb300  # #000000 on #9f0000
color.history.delete=gray0 on rgb105  # #000000 on #0000ff
color.history.done=gray0 on rgb020  # #000000 on #008b00

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray0 on rgb020  # #000000 on #008b00

# Command: calendar
color.calendar.due=gray0 on rgb105  # #000000 on #0000ff
color.calendar.due.today=gray0 on rgb540  # #000000 on #ffcf00
color.calendar.holiday=gray0 on rgb304  # #000000 on #bc00ca
color.calendar.overdue=gray0 on rgb300  # #000000 on #9f0000
color.calendar.scheduled=gray0 on rgb025  # #000000 on #0081ff
color.calendar.today=gray0 on rgb022  # #000000 on #008b8b
color.calendar.weekend=gray10  # #6e6e6e
color.calendar.weeknumber=gray10  # #6e6e6e

# Command: sync
color.sync.added=rgb020  # #008b00
color.sync.changed=rgb105  # #0000ff
color.sync.rejected=rgb300  # #9f0000

# Command: undo
color.undo.after=rgb020  # #008b00
color.undo.before=rgb300  # #9f0000
