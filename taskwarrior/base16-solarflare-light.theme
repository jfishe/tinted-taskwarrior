# tinted-taskwarrior
# Scheme name: Solar Flare Light
# Scheme author: Chuck Harmston (https://chuck.harmston.ch)
# Scheme: base16-solarflare-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray14  # #85939e
color.label.sort=rgb034  # #33b5e1
color.alternate=on gray23  # #e8e9ed
color.header=rgb034  # #33b5e1
color.footnote=rgb143  # #52cbb0
color.warning=rgb555 on rgb430  # #f5f7fa on #e4b51c
color.error=rgb511  # #ef5253
color.debug=rgb143  # #52cbb0

# Task state
color.completed=gray14  # #85939e
color.deleted=gray14  # #85939e
color.active=rgb555 on rgb241  # #f5f7fa on #7cc844
color.recurring=rgb143  # #52cbb0
color.scheduled=rgb034  # #33b5e1
color.until=
color.blocked=gray14  # #85939e
color.blocking=rgb555 on rgb314  # #f5f7fa on #a363d5

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb510  # #e66b2b
color.uda.priority.M=rgb430  # #e4b51c
color.uda.priority.L=rgb034  # #33b5e1

# Tags
color.tag.next=rgb314  # #a363d5
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #e4b51c
color.due.today=rgb510  # #e66b2b
color.overdue=rgb511  # #ef5253

# Report: burndown
color.burndown.done=rgb555 on rgb241  # #f5f7fa on #7cc844
color.burndown.pending=rgb555 on rgb511  # #f5f7fa on #ef5253
color.burndown.started=rgb555 on rgb430  # #f5f7fa on #e4b51c

# Report: history
color.history.add=rgb555 on rgb511  # #f5f7fa on #ef5253
color.history.delete=rgb555 on rgb430  # #f5f7fa on #e4b51c
color.history.done=rgb555 on rgb241  # #f5f7fa on #7cc844

# Report: summary
color.summary.background=on gray23  # #e8e9ed
color.summary.bar=rgb555 on rgb241  # #f5f7fa on #7cc844

# Command: calendar
color.calendar.due=rgb555 on rgb430  # #f5f7fa on #e4b51c
color.calendar.due.today=rgb555 on rgb510  # #f5f7fa on #e66b2b
color.calendar.holiday=rgb555 on rgb314  # #f5f7fa on #a363d5
color.calendar.overdue=rgb555 on rgb511  # #f5f7fa on #ef5253
color.calendar.scheduled=rgb555 on rgb034  # #f5f7fa on #33b5e1
color.calendar.today=rgb555 on rgb143  # #f5f7fa on #52cbb0
color.calendar.weekend=gray14  # #85939e
color.calendar.weeknumber=gray14  # #85939e

# Command: sync
color.sync.added=rgb241  # #7cc844
color.sync.changed=rgb430  # #e4b51c
color.sync.rejected=rgb511  # #ef5253

# Command: undo
color.undo.after=rgb241  # #7cc844
color.undo.before=rgb511  # #ef5253
