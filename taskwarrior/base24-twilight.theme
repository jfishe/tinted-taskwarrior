# tinted-taskwarrior
# Scheme name: Twilight
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-twilight (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #5c5c51
color.label.sort=gray6  # #444649
color.alternate=on gray1  # #141414
color.header=gray6  # #444649
color.footnote=gray12  # #778284
color.warning=gray1 on rgb111  # #141414 on #5a5d61
color.error=rgb410  # #c06c43
color.debug=gray12  # #778284

# Task state
color.completed=gray8  # #5c5c51
color.deleted=gray8  # #5c5c51
color.active=gray1 on rgb331  # #141414 on #afb979
color.recurring=gray12  # #778284
color.scheduled=gray6  # #444649
color.until=
color.blocked=gray8  # #5c5c51
color.blocking=gray1 on rgb331  # #141414 on #b4be7b

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb431  # #c2a86c
color.uda.priority.M=rgb111  # #5a5d61
color.uda.priority.L=gray6  # #444649

# Tags
color.tag.next=rgb331  # #b4be7b
color.tag.none=
color.tagged=

# Due
color.due=rgb111  # #5a5d61
color.due.today=rgb431  # #c2a86c
color.overdue=rgb410  # #c06c43

# Report: burndown
color.burndown.done=gray1 on rgb331  # #141414 on #afb979
color.burndown.pending=gray1 on rgb410  # #141414 on #c06c43
color.burndown.started=gray1 on rgb111  # #141414 on #5a5d61

# Report: history
color.history.add=gray1 on rgb410  # #141414 on #c06c43
color.history.delete=gray1 on rgb111  # #141414 on #5a5d61
color.history.done=gray1 on rgb331  # #141414 on #afb979

# Report: summary
color.summary.background=on gray1  # #141414
color.summary.bar=gray1 on rgb331  # #141414 on #afb979

# Command: calendar
color.calendar.due=gray1 on rgb111  # #141414 on #5a5d61
color.calendar.due.today=gray1 on rgb431  # #141414 on #c2a86c
color.calendar.holiday=gray1 on rgb331  # #141414 on #b4be7b
color.calendar.overdue=gray1 on rgb410  # #141414 on #c06c43
color.calendar.scheduled=gray1 on gray6  # #141414 on #444649
color.calendar.today=gray1 on gray12  # #141414 on #778284
color.calendar.weekend=gray8  # #5c5c51
color.calendar.weeknumber=gray8  # #5c5c51

# Command: sync
color.sync.added=rgb331  # #afb979
color.sync.changed=rgb111  # #5a5d61
color.sync.rejected=rgb410  # #c06c43

# Command: undo
color.undo.after=rgb331  # #afb979
color.undo.before=rgb410  # #c06c43
