# tinted-taskwarrior
# Scheme name: Stranger Theme Dimension X
# Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
# Scheme: base16-stranger-theme-dimension-x (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb322  # #9a7c7c
color.label.sort=rgb414  # #c678dd
color.alternate=on gray4  # #322e2e
color.header=rgb414  # #c678dd
color.footnote=rgb233  # #7fb5b0
color.warning=gray2 on rgb432  # #1e1a1a on #d19a66
color.error=rgb511  # #ff6b6b
color.debug=rgb233  # #7fb5b0

# Task state
color.completed=rgb322  # #9a7c7c
color.deleted=rgb322  # #9a7c7c
color.active=gray2 on rgb232  # #1e1a1a on #8fae7e
color.recurring=rgb233  # #7fb5b0
color.scheduled=rgb414  # #c678dd
color.until=
color.blocked=rgb322  # #9a7c7c
color.blocking=gray2 on rgb513  # #1e1a1a on #ff55aa

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb511  # #ff6b6b
color.uda.priority.M=rgb432  # #d19a66
color.uda.priority.L=rgb414  # #c678dd

# Tags
color.tag.next=rgb513  # #ff55aa
color.tag.none=
color.tagged=

# Due
color.due=rgb432  # #d19a66
color.due.today=rgb511  # #ff6b6b
color.overdue=rgb511  # #ff6b6b

# Report: burndown
color.burndown.done=gray2 on rgb232  # #1e1a1a on #8fae7e
color.burndown.pending=gray2 on rgb511  # #1e1a1a on #ff6b6b
color.burndown.started=gray2 on rgb432  # #1e1a1a on #d19a66

# Report: history
color.history.add=gray2 on rgb511  # #1e1a1a on #ff6b6b
color.history.delete=gray2 on rgb432  # #1e1a1a on #d19a66
color.history.done=gray2 on rgb232  # #1e1a1a on #8fae7e

# Report: summary
color.summary.background=on gray4  # #322e2e
color.summary.bar=gray2 on rgb232  # #1e1a1a on #8fae7e

# Command: calendar
color.calendar.due=gray2 on rgb432  # #1e1a1a on #d19a66
color.calendar.due.today=gray2 on rgb511  # #1e1a1a on #ff6b6b
color.calendar.holiday=gray2 on rgb513  # #1e1a1a on #ff55aa
color.calendar.overdue=gray2 on rgb511  # #1e1a1a on #ff6b6b
color.calendar.scheduled=gray2 on rgb414  # #1e1a1a on #c678dd
color.calendar.today=gray2 on rgb233  # #1e1a1a on #7fb5b0
color.calendar.weekend=rgb322  # #9a7c7c
color.calendar.weeknumber=rgb322  # #9a7c7c

# Command: sync
color.sync.added=rgb232  # #8fae7e
color.sync.changed=rgb432  # #d19a66
color.sync.rejected=rgb511  # #ff6b6b

# Command: undo
color.undo.after=rgb232  # #8fae7e
color.undo.before=rgb511  # #ff6b6b
