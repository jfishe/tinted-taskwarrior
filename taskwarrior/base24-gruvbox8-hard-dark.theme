# tinted-taskwarrior
# Scheme name: Gruvbox 8 Hard Dark
# Scheme author: jfishe (generated by colortemplate2tinty)
# Scheme: base24-gruvbox8-hard-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb222  # #928374
color.label.sort=rgb122  # #458588
color.alternate=on gray5  # #3c3836
color.header=rgb122  # #458588
color.footnote=rgb131  # #689d6a
color.warning=gray2 on rgb420  # #1d2021 on #d79921
color.error=rgb400  # #cc241d
color.debug=rgb131  # #689d6a

# Task state
color.completed=rgb222  # #928374
color.deleted=rgb222  # #928374
color.active=gray2 on rgb220  # #1d2021 on #98971a
color.recurring=rgb131  # #689d6a
color.scheduled=rgb122  # #458588
color.until=
color.blocked=rgb222  # #928374
color.blocking=gray2 on rgb312  # #1d2021 on #b16286

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #fe8019
color.uda.priority.M=rgb420  # #d79921
color.uda.priority.L=rgb122  # #458588

# Tags
color.tag.next=rgb312  # #b16286
color.tag.none=
color.tagged=

# Due
color.due=rgb420  # #d79921
color.due.today=rgb520  # #fe8019
color.overdue=rgb400  # #cc241d

# Report: burndown
color.burndown.done=gray2 on rgb220  # #1d2021 on #98971a
color.burndown.pending=gray2 on rgb400  # #1d2021 on #cc241d
color.burndown.started=gray2 on rgb420  # #1d2021 on #d79921

# Report: history
color.history.add=gray2 on rgb400  # #1d2021 on #cc241d
color.history.delete=gray2 on rgb420  # #1d2021 on #d79921
color.history.done=gray2 on rgb220  # #1d2021 on #98971a

# Report: summary
color.summary.background=on gray5  # #3c3836
color.summary.bar=gray2 on rgb220  # #1d2021 on #98971a

# Command: calendar
color.calendar.due=gray2 on rgb420  # #1d2021 on #d79921
color.calendar.due.today=gray2 on rgb520  # #1d2021 on #fe8019
color.calendar.holiday=gray2 on rgb312  # #1d2021 on #b16286
color.calendar.overdue=gray2 on rgb400  # #1d2021 on #cc241d
color.calendar.scheduled=gray2 on rgb122  # #1d2021 on #458588
color.calendar.today=gray2 on rgb131  # #1d2021 on #689d6a
color.calendar.weekend=rgb222  # #928374
color.calendar.weeknumber=rgb222  # #928374

# Command: sync
color.sync.added=rgb220  # #98971a
color.sync.changed=rgb420  # #d79921
color.sync.rejected=rgb400  # #cc241d

# Command: undo
color.undo.after=rgb220  # #98971a
color.undo.before=rgb400  # #cc241d
