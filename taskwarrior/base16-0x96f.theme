# tinted-taskwarrior
# Scheme name: 0x96f
# Scheme author: Filip Janevski (https://0x96f.dev/theme)
# Scheme: base16-0x96f (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray9  # #676567
color.label.sort=rgb045  # #49cae4
color.alternate=on gray5  # #3b393c
color.header=rgb045  # #49cae4
color.footnote=rgb344  # #aee8f4
color.warning=gray3 on rgb541  # #262427 on #ffca58
color.error=rgb511  # #ff7272
color.debug=rgb344  # #aee8f4

# Task state
color.completed=gray9  # #676567
color.deleted=gray9  # #676567
color.active=gray3 on rgb341  # #262427 on #bcdf59
color.recurring=rgb344  # #aee8f4
color.scheduled=rgb045  # #49cae4
color.until=
color.blocked=gray9  # #676567
color.blocking=gray3 on rgb224  # #262427 on #a093e2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #fc9d6f
color.uda.priority.M=rgb541  # #ffca58
color.uda.priority.L=rgb045  # #49cae4

# Tags
color.tag.next=rgb224  # #a093e2
color.tag.none=
color.tagged=

# Due
color.due=rgb541  # #ffca58
color.due.today=rgb532  # #fc9d6f
color.overdue=rgb511  # #ff7272

# Report: burndown
color.burndown.done=gray3 on rgb341  # #262427 on #bcdf59
color.burndown.pending=gray3 on rgb511  # #262427 on #ff7272
color.burndown.started=gray3 on rgb541  # #262427 on #ffca58

# Report: history
color.history.add=gray3 on rgb511  # #262427 on #ff7272
color.history.delete=gray3 on rgb541  # #262427 on #ffca58
color.history.done=gray3 on rgb341  # #262427 on #bcdf59

# Report: summary
color.summary.background=on gray5  # #3b393c
color.summary.bar=gray3 on rgb341  # #262427 on #bcdf59

# Command: calendar
color.calendar.due=gray3 on rgb541  # #262427 on #ffca58
color.calendar.due.today=gray3 on rgb532  # #262427 on #fc9d6f
color.calendar.holiday=gray3 on rgb224  # #262427 on #a093e2
color.calendar.overdue=gray3 on rgb511  # #262427 on #ff7272
color.calendar.scheduled=gray3 on rgb045  # #262427 on #49cae4
color.calendar.today=gray3 on rgb344  # #262427 on #aee8f4
color.calendar.weekend=gray9  # #676567
color.calendar.weeknumber=gray9  # #676567

# Command: sync
color.sync.added=rgb341  # #bcdf59
color.sync.changed=rgb541  # #ffca58
color.sync.rejected=rgb511  # #ff7272

# Command: undo
color.undo.after=rgb341  # #bcdf59
color.undo.before=rgb511  # #ff7272
