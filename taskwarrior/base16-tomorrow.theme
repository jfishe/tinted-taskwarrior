# tinted-taskwarrior
# Scheme name: Tomorrow
# Scheme author: Chris Kempson (http://chriskempson.com)
# Scheme: base16-tomorrow (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray17  # #b4b7b4
color.label.sort=rgb013  # #4271ae
color.alternate=on gray22  # #e0e0e0
color.header=rgb013  # #4271ae
color.footnote=rgb133  # #3e999f
color.warning=rgb555 on rgb430  # #ffffff on #eab700
color.error=rgb400  # #c82829
color.debug=rgb133  # #3e999f

# Task state
color.completed=gray17  # #b4b7b4
color.deleted=gray17  # #b4b7b4
color.active=rgb555 on rgb120  # #ffffff on #718c00
color.recurring=rgb133  # #3e999f
color.scheduled=rgb013  # #4271ae
color.until=
color.blocked=gray17  # #b4b7b4
color.blocking=rgb555 on rgb213  # #ffffff on #8959a8

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #f5871f
color.uda.priority.M=rgb430  # #eab700
color.uda.priority.L=rgb013  # #4271ae

# Tags
color.tag.next=rgb213  # #8959a8
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #eab700
color.due.today=rgb520  # #f5871f
color.overdue=rgb400  # #c82829

# Report: burndown
color.burndown.done=rgb555 on rgb120  # #ffffff on #718c00
color.burndown.pending=rgb555 on rgb400  # #ffffff on #c82829
color.burndown.started=rgb555 on rgb430  # #ffffff on #eab700

# Report: history
color.history.add=rgb555 on rgb400  # #ffffff on #c82829
color.history.delete=rgb555 on rgb430  # #ffffff on #eab700
color.history.done=rgb555 on rgb120  # #ffffff on #718c00

# Report: summary
color.summary.background=on gray22  # #e0e0e0
color.summary.bar=rgb555 on rgb120  # #ffffff on #718c00

# Command: calendar
color.calendar.due=rgb555 on rgb430  # #ffffff on #eab700
color.calendar.due.today=rgb555 on rgb520  # #ffffff on #f5871f
color.calendar.holiday=rgb555 on rgb213  # #ffffff on #8959a8
color.calendar.overdue=rgb555 on rgb400  # #ffffff on #c82829
color.calendar.scheduled=rgb555 on rgb013  # #ffffff on #4271ae
color.calendar.today=rgb555 on rgb133  # #ffffff on #3e999f
color.calendar.weekend=gray17  # #b4b7b4
color.calendar.weeknumber=gray17  # #b4b7b4

# Command: sync
color.sync.added=rgb120  # #718c00
color.sync.changed=rgb430  # #eab700
color.sync.rejected=rgb400  # #c82829

# Command: undo
color.undo.after=rgb120  # #718c00
color.undo.before=rgb400  # #c82829
