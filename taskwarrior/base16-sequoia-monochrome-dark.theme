# tinted-taskwarrior
# Scheme name: Sequoia Monochrome Dark
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Scheme: base16-sequoia-monochrome-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray6  # #43444d
color.label.sort=rgb223  # #7c829d
color.alternate=on gray1  # #111216
color.header=rgb223  # #7c829d
color.footnote=gray18  # #b6bac8
color.warning=gray1 on rgb444  # #0f1014 on #d3d5de
color.error=rgb334  # #999eb2
color.debug=gray18  # #b6bac8

# Task state
color.completed=gray6  # #43444d
color.deleted=gray6  # #43444d
color.active=gray1 on rgb112  # #0f1014 on #626983
color.recurring=gray18  # #b6bac8
color.scheduled=rgb223  # #7c829d
color.until=
color.blocked=gray6  # #43444d
color.blocking=gray1 on rgb444  # #0f1014 on #d3d5de

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb334  # #999eb2
color.uda.priority.M=rgb444  # #d3d5de
color.uda.priority.L=rgb223  # #7c829d

# Tags
color.tag.next=rgb444  # #d3d5de
color.tag.none=
color.tagged=

# Due
color.due=rgb444  # #d3d5de
color.due.today=rgb334  # #999eb2
color.overdue=rgb334  # #999eb2

# Report: burndown
color.burndown.done=gray1 on rgb112  # #0f1014 on #626983
color.burndown.pending=gray1 on rgb334  # #0f1014 on #999eb2
color.burndown.started=gray1 on rgb444  # #0f1014 on #d3d5de

# Report: history
color.history.add=gray1 on rgb334  # #0f1014 on #999eb2
color.history.delete=gray1 on rgb444  # #0f1014 on #d3d5de
color.history.done=gray1 on rgb112  # #0f1014 on #626983

# Report: summary
color.summary.background=on gray1  # #111216
color.summary.bar=gray1 on rgb112  # #0f1014 on #626983

# Command: calendar
color.calendar.due=gray1 on rgb444  # #0f1014 on #d3d5de
color.calendar.due.today=gray1 on rgb334  # #0f1014 on #999eb2
color.calendar.holiday=gray1 on rgb444  # #0f1014 on #d3d5de
color.calendar.overdue=gray1 on rgb334  # #0f1014 on #999eb2
color.calendar.scheduled=gray1 on rgb223  # #0f1014 on #7c829d
color.calendar.today=gray1 on gray18  # #0f1014 on #b6bac8
color.calendar.weekend=gray6  # #43444d
color.calendar.weeknumber=gray6  # #43444d

# Command: sync
color.sync.added=rgb112  # #626983
color.sync.changed=rgb444  # #d3d5de
color.sync.rejected=rgb334  # #999eb2

# Command: undo
color.undo.after=rgb112  # #626983
color.undo.before=rgb334  # #999eb2
