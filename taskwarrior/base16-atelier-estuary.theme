# tinted-taskwarrior
# Scheme name: Atelier Estuary
# Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
# Scheme: base16-atelier-estuary (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6c6b5a
color.label.sort=rgb031  # #36a166
color.alternate=on gray4  # #302f27
color.header=rgb031  # #36a166
color.footnote=rgb131  # #5b9d48
color.warning=gray3 on rgb330  # #22221b on #a5980d
color.error=rgb410  # #ba6236
color.debug=rgb131  # #5b9d48

# Task state
color.completed=gray10  # #6c6b5a
color.deleted=gray10  # #6c6b5a
color.active=gray3 on rgb120  # #22221b on #7d9726
color.recurring=rgb131  # #5b9d48
color.scheduled=rgb031  # #36a166
color.until=
color.blocked=gray10  # #6c6b5a
color.blocking=gray3 on rgb122  # #22221b on #5f9182

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #ae7313
color.uda.priority.M=rgb330  # #a5980d
color.uda.priority.L=rgb031  # #36a166

# Tags
color.tag.next=rgb122  # #5f9182
color.tag.none=
color.tagged=

# Due
color.due=rgb330  # #a5980d
color.due.today=rgb310  # #ae7313
color.overdue=rgb410  # #ba6236

# Report: burndown
color.burndown.done=gray3 on rgb120  # #22221b on #7d9726
color.burndown.pending=gray3 on rgb410  # #22221b on #ba6236
color.burndown.started=gray3 on rgb330  # #22221b on #a5980d

# Report: history
color.history.add=gray3 on rgb410  # #22221b on #ba6236
color.history.delete=gray3 on rgb330  # #22221b on #a5980d
color.history.done=gray3 on rgb120  # #22221b on #7d9726

# Report: summary
color.summary.background=on gray4  # #302f27
color.summary.bar=gray3 on rgb120  # #22221b on #7d9726

# Command: calendar
color.calendar.due=gray3 on rgb330  # #22221b on #a5980d
color.calendar.due.today=gray3 on rgb310  # #22221b on #ae7313
color.calendar.holiday=gray3 on rgb122  # #22221b on #5f9182
color.calendar.overdue=gray3 on rgb410  # #22221b on #ba6236
color.calendar.scheduled=gray3 on rgb031  # #22221b on #36a166
color.calendar.today=gray3 on rgb131  # #22221b on #5b9d48
color.calendar.weekend=gray10  # #6c6b5a
color.calendar.weeknumber=gray10  # #6c6b5a

# Command: sync
color.sync.added=rgb120  # #7d9726
color.sync.changed=rgb330  # #a5980d
color.sync.rejected=rgb410  # #ba6236

# Command: undo
color.undo.after=rgb120  # #7d9726
color.undo.before=rgb410  # #ba6236
