# tinted-taskwarrior
# Scheme name: Rippedcasts
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-rippedcasts (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7c7c7c
color.label.sort=rgb233  # #75a5b0
color.alternate=on gray0  # #000000
color.header=rgb233  # #75a5b0
color.footnote=rgb112  # #59647e
color.warning=gray3 on rgb233  # #2b2b2b on #86bdc9
color.error=rgb432  # #cdaf95
color.debug=rgb112  # #59647e

# Task state
color.completed=gray12  # #7c7c7c
color.deleted=gray12  # #7c7c7c
color.active=gray3 on rgb351  # #2b2b2b on #a7ff60
color.recurring=rgb112  # #59647e
color.scheduled=rgb233  # #75a5b0
color.until=
color.blocked=gray12  # #7c7c7c
color.blocking=gray3 on rgb515  # #2b2b2b on #ff73fd

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb330  # #bfbb1f
color.uda.priority.M=rgb233  # #86bdc9
color.uda.priority.L=rgb233  # #75a5b0

# Tags
color.tag.next=rgb515  # #ff73fd
color.tag.none=
color.tagged=

# Due
color.due=rgb233  # #86bdc9
color.due.today=rgb330  # #bfbb1f
color.overdue=rgb432  # #cdaf95

# Report: burndown
color.burndown.done=gray3 on rgb351  # #2b2b2b on #a7ff60
color.burndown.pending=gray3 on rgb432  # #2b2b2b on #cdaf95
color.burndown.started=gray3 on rgb233  # #2b2b2b on #86bdc9

# Report: history
color.history.add=gray3 on rgb432  # #2b2b2b on #cdaf95
color.history.delete=gray3 on rgb233  # #2b2b2b on #86bdc9
color.history.done=gray3 on rgb351  # #2b2b2b on #a7ff60

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray3 on rgb351  # #2b2b2b on #a7ff60

# Command: calendar
color.calendar.due=gray3 on rgb233  # #2b2b2b on #86bdc9
color.calendar.due.today=gray3 on rgb330  # #2b2b2b on #bfbb1f
color.calendar.holiday=gray3 on rgb515  # #2b2b2b on #ff73fd
color.calendar.overdue=gray3 on rgb432  # #2b2b2b on #cdaf95
color.calendar.scheduled=gray3 on rgb233  # #2b2b2b on #75a5b0
color.calendar.today=gray3 on rgb112  # #2b2b2b on #59647e
color.calendar.weekend=gray12  # #7c7c7c
color.calendar.weeknumber=gray12  # #7c7c7c

# Command: sync
color.sync.added=rgb351  # #a7ff60
color.sync.changed=rgb233  # #86bdc9
color.sync.rejected=rgb432  # #cdaf95

# Command: undo
color.undo.after=rgb351  # #a7ff60
color.undo.before=rgb432  # #cdaf95
