# tinted-taskwarrior
# Scheme name: Gruvbox Light
# Scheme author: Tinted Theming (https://github.com/tinted-theming), morhetz (https://github.com/morhetz/gruvbox)
# Scheme: base16-gruvbox-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb332  # #bdae93
color.label.sort=rgb122  # #458588
color.alternate=on rgb443  # #ebdbb2
color.header=rgb122  # #458588
color.footnote=rgb131  # #689d6a
color.warning=rgb554 on rgb420  # #fbf1c7 on #d79921
color.error=rgb400  # #cc241d
color.debug=rgb131  # #689d6a

# Task state
color.completed=rgb332  # #bdae93
color.deleted=rgb332  # #bdae93
color.active=rgb554 on rgb220  # #fbf1c7 on #98971a
color.recurring=rgb131  # #689d6a
color.scheduled=rgb122  # #458588
color.until=
color.blocked=rgb332  # #bdae93
color.blocking=rgb554 on rgb312  # #fbf1c7 on #b16286

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #d65d0e
color.uda.priority.M=rgb420  # #d79921
color.uda.priority.L=rgb122  # #458588

# Tags
color.tag.next=rgb312  # #b16286
color.tag.none=
color.tagged=

# Due
color.due=rgb420  # #d79921
color.due.today=rgb410  # #d65d0e
color.overdue=rgb400  # #cc241d

# Report: burndown
color.burndown.done=rgb554 on rgb220  # #fbf1c7 on #98971a
color.burndown.pending=rgb554 on rgb400  # #fbf1c7 on #cc241d
color.burndown.started=rgb554 on rgb420  # #fbf1c7 on #d79921

# Report: history
color.history.add=rgb554 on rgb400  # #fbf1c7 on #cc241d
color.history.delete=rgb554 on rgb420  # #fbf1c7 on #d79921
color.history.done=rgb554 on rgb220  # #fbf1c7 on #98971a

# Report: summary
color.summary.background=on rgb443  # #ebdbb2
color.summary.bar=rgb554 on rgb220  # #fbf1c7 on #98971a

# Command: calendar
color.calendar.due=rgb554 on rgb420  # #fbf1c7 on #d79921
color.calendar.due.today=rgb554 on rgb410  # #fbf1c7 on #d65d0e
color.calendar.holiday=rgb554 on rgb312  # #fbf1c7 on #b16286
color.calendar.overdue=rgb554 on rgb400  # #fbf1c7 on #cc241d
color.calendar.scheduled=rgb554 on rgb122  # #fbf1c7 on #458588
color.calendar.today=rgb554 on rgb131  # #fbf1c7 on #689d6a
color.calendar.weekend=rgb332  # #bdae93
color.calendar.weeknumber=rgb332  # #bdae93

# Command: sync
color.sync.added=rgb220  # #98971a
color.sync.changed=rgb420  # #d79921
color.sync.rejected=rgb400  # #cc241d

# Command: undo
color.undo.after=rgb220  # #98971a
color.undo.before=rgb400  # #cc241d
