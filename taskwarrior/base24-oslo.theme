# tinted-taskwarrior
# Scheme name: Oslo
# Scheme author: xscriptor (https://github.com/xscriptor)
# Scheme: base24-oslo (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #6c727f
color.label.sort=rgb135  # #4aa5f0
color.alternate=on gray7  # #474c59
color.header=rgb135  # #4aa5f0
color.footnote=rgb133  # #42b3c2
color.warning=gray6 on rgb421  # #3f4451 on #d18f52
color.error=rgb411  # #e05561
color.debug=rgb133  # #42b3c2

# Task state
color.completed=gray11  # #6c727f
color.deleted=gray11  # #6c727f
color.active=gray6 on rgb231  # #3f4451 on #8cc265
color.recurring=rgb133  # #42b3c2
color.scheduled=rgb135  # #4aa5f0
color.until=
color.blocked=gray11  # #6c727f
color.blocking=gray6 on rgb314  # #3f4451 on #c162de

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #d8725a
color.uda.priority.M=rgb421  # #d18f52
color.uda.priority.L=rgb135  # #4aa5f0

# Tags
color.tag.next=rgb314  # #c162de
color.tag.none=
color.tagged=

# Due
color.due=rgb421  # #d18f52
color.due.today=rgb421  # #d8725a
color.overdue=rgb411  # #e05561

# Report: burndown
color.burndown.done=gray6 on rgb231  # #3f4451 on #8cc265
color.burndown.pending=gray6 on rgb411  # #3f4451 on #e05561
color.burndown.started=gray6 on rgb421  # #3f4451 on #d18f52

# Report: history
color.history.add=gray6 on rgb411  # #3f4451 on #e05561
color.history.delete=gray6 on rgb421  # #3f4451 on #d18f52
color.history.done=gray6 on rgb231  # #3f4451 on #8cc265

# Report: summary
color.summary.background=on gray7  # #474c59
color.summary.bar=gray6 on rgb231  # #3f4451 on #8cc265

# Command: calendar
color.calendar.due=gray6 on rgb421  # #3f4451 on #d18f52
color.calendar.due.today=gray6 on rgb421  # #3f4451 on #d8725a
color.calendar.holiday=gray6 on rgb314  # #3f4451 on #c162de
color.calendar.overdue=gray6 on rgb411  # #3f4451 on #e05561
color.calendar.scheduled=gray6 on rgb135  # #3f4451 on #4aa5f0
color.calendar.today=gray6 on rgb133  # #3f4451 on #42b3c2
color.calendar.weekend=gray11  # #6c727f
color.calendar.weeknumber=gray11  # #6c727f

# Command: sync
color.sync.added=rgb231  # #8cc265
color.sync.changed=rgb421  # #d18f52
color.sync.rejected=rgb411  # #e05561

# Command: undo
color.undo.after=rgb231  # #8cc265
color.undo.before=rgb411  # #e05561
