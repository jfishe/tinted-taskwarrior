# tinted-taskwarrior
# Scheme name: WWDC16 Dark
# Scheme author: jfishe (generated by colortemplate2tinty)
# Scheme: tinted8-wwdc16-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray14  # #949494
color.label.sort=rgb014  # #4670d8
color.alternate=on gray5  # #353547
color.header=rgb014  # #4670d8
color.footnote=rgb122  # #64878f
color.warning=gray4 on rgb421  # #292c36 on #c98351
color.error=rgb411  # #e64547
color.debug=rgb122  # #64878f

# Task state
color.completed=gray14  # #949494
color.deleted=gray14  # #949494
color.active=gray4 on rgb131  # #292c36 on #42a647
color.recurring=rgb122  # #64878f
color.scheduled=rgb014  # #4670d8
color.until=
color.blocked=gray14  # #949494
color.blocking=gray4 on rgb413  # #292c36 on #d24e9b

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #c96f51
color.uda.priority.M=rgb421  # #c98351
color.uda.priority.L=rgb014  # #4670d8

# Tags
color.tag.next=rgb413  # #d24e9b
color.tag.none=
color.tagged=

# Due
color.due=rgb421  # #c98351
color.due.today=rgb421  # #c96f51
color.overdue=rgb411  # #e64547

# Report: burndown
color.burndown.done=gray4 on rgb131  # #292c36 on #42a647
color.burndown.pending=gray4 on rgb411  # #292c36 on #e64547
color.burndown.started=gray4 on rgb421  # #292c36 on #c98351

# Report: history
color.history.add=gray4 on rgb411  # #292c36 on #e64547
color.history.delete=gray4 on rgb421  # #292c36 on #c98351
color.history.done=gray4 on rgb131  # #292c36 on #42a647

# Report: summary
color.summary.background=on gray5  # #353547
color.summary.bar=gray4 on rgb131  # #292c36 on #42a647

# Command: calendar
color.calendar.due=gray4 on rgb421  # #292c36 on #c98351
color.calendar.due.today=gray4 on rgb421  # #292c36 on #c96f51
color.calendar.holiday=gray4 on rgb413  # #292c36 on #d24e9b
color.calendar.overdue=gray4 on rgb411  # #292c36 on #e64547
color.calendar.scheduled=gray4 on rgb014  # #292c36 on #4670d8
color.calendar.today=gray4 on rgb122  # #292c36 on #64878f
color.calendar.weekend=gray14  # #949494
color.calendar.weeknumber=gray14  # #949494

# Command: sync
color.sync.added=rgb131  # #42a647
color.sync.changed=rgb421  # #c98351
color.sync.rejected=rgb411  # #e64547

# Command: undo
color.undo.after=rgb131  # #42a647
color.undo.before=rgb411  # #e64547
