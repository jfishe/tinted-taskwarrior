# tinted-taskwarrior
# Scheme name: Zenbones
# Scheme author: mcchrish
# Scheme: base16-zenbones (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb421  # #b77e64
color.label.sort=rgb424  # #cf86c1
color.alternate=on rgb512  # #de6e7c
color.header=rgb424  # #cf86c1
color.footnote=rgb134  # #61abda
color.warning=gray2 on rgb231  # #191919 on #8bae68
color.error=gray5  # #3d3839
color.debug=rgb134  # #61abda

# Task state
color.completed=rgb421  # #b77e64
color.deleted=rgb421  # #b77e64
color.active=gray2 on rgb421  # #191919 on #d68c67
color.recurring=rgb134  # #61abda
color.scheduled=rgb424  # #cf86c1
color.until=
color.blocked=rgb421  # #b77e64
color.blocking=gray2 on rgb133  # #191919 on #65b8c1

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb422  # #e8838f
color.uda.priority.M=rgb231  # #8bae68
color.uda.priority.L=rgb424  # #cf86c1

# Tags
color.tag.next=rgb133  # #65b8c1
color.tag.none=
color.tagged=

# Due
color.due=rgb231  # #8bae68
color.due.today=rgb422  # #e8838f
color.overdue=gray5  # #3d3839

# Report: burndown
color.burndown.done=gray2 on rgb421  # #191919 on #d68c67
color.burndown.pending=gray2 on gray5  # #191919 on #3d3839
color.burndown.started=gray2 on rgb231  # #191919 on #8bae68

# Report: history
color.history.add=gray2 on gray5  # #191919 on #3d3839
color.history.delete=gray2 on rgb231  # #191919 on #8bae68
color.history.done=gray2 on rgb421  # #191919 on #d68c67

# Report: summary
color.summary.background=on rgb512  # #de6e7c
color.summary.bar=gray2 on rgb421  # #191919 on #d68c67

# Command: calendar
color.calendar.due=gray2 on rgb231  # #191919 on #8bae68
color.calendar.due.today=gray2 on rgb422  # #191919 on #e8838f
color.calendar.holiday=gray2 on rgb133  # #191919 on #65b8c1
color.calendar.overdue=gray2 on gray5  # #191919 on #3d3839
color.calendar.scheduled=gray2 on rgb424  # #191919 on #cf86c1
color.calendar.today=gray2 on rgb134  # #191919 on #61abda
color.calendar.weekend=rgb421  # #b77e64
color.calendar.weeknumber=rgb421  # #b77e64

# Command: sync
color.sync.added=rgb421  # #d68c67
color.sync.changed=rgb231  # #8bae68
color.sync.rejected=gray5  # #3d3839

# Command: undo
color.undo.after=rgb421  # #d68c67
color.undo.before=gray5  # #3d3839
