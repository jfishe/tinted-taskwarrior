# tinted-taskwarrior
# Scheme name: Idle Toes
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-idle-toes (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #797979
color.label.sort=rgb025  # #4098ff
color.alternate=on gray4  # #323232
color.header=rgb025  # #4098ff
color.footnote=rgb345  # #bed6ff
color.warning=gray4 on rgb135  # #323232 on #5eb7f7
color.error=rgb411  # #d25252
color.debug=rgb345  # #bed6ff

# Task state
color.completed=gray11  # #797979
color.deleted=gray11  # #797979
color.active=gray4 on rgb241  # #323232 on #7fe173
color.recurring=rgb345  # #bed6ff
color.scheduled=rgb025  # #4098ff
color.until=
color.blocked=gray11  # #797979
color.blocking=gray4 on rgb525  # #323232 on #f57fff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb542  # #ffc66d
color.uda.priority.M=rgb135  # #5eb7f7
color.uda.priority.L=rgb025  # #4098ff

# Tags
color.tag.next=rgb525  # #f57fff
color.tag.none=
color.tagged=

# Due
color.due=rgb135  # #5eb7f7
color.due.today=rgb542  # #ffc66d
color.overdue=rgb411  # #d25252

# Report: burndown
color.burndown.done=gray4 on rgb241  # #323232 on #7fe173
color.burndown.pending=gray4 on rgb411  # #323232 on #d25252
color.burndown.started=gray4 on rgb135  # #323232 on #5eb7f7

# Report: history
color.history.add=gray4 on rgb411  # #323232 on #d25252
color.history.delete=gray4 on rgb135  # #323232 on #5eb7f7
color.history.done=gray4 on rgb241  # #323232 on #7fe173

# Report: summary
color.summary.background=on gray4  # #323232
color.summary.bar=gray4 on rgb241  # #323232 on #7fe173

# Command: calendar
color.calendar.due=gray4 on rgb135  # #323232 on #5eb7f7
color.calendar.due.today=gray4 on rgb542  # #323232 on #ffc66d
color.calendar.holiday=gray4 on rgb525  # #323232 on #f57fff
color.calendar.overdue=gray4 on rgb411  # #323232 on #d25252
color.calendar.scheduled=gray4 on rgb025  # #323232 on #4098ff
color.calendar.today=gray4 on rgb345  # #323232 on #bed6ff
color.calendar.weekend=gray11  # #797979
color.calendar.weeknumber=gray11  # #797979

# Command: sync
color.sync.added=rgb241  # #7fe173
color.sync.changed=rgb135  # #5eb7f7
color.sync.rejected=rgb411  # #d25252

# Command: undo
color.undo.after=rgb241  # #7fe173
color.undo.before=rgb411  # #d25252
