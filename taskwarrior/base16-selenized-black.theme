# tinted-taskwarrior
# Scheme name: selenized-black
# Scheme author: Jan Warchol (https://github.com/jan-warchol/selenized) / adapted to base16 by ali
# Scheme: base16-selenized-black (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #777777
color.label.sort=rgb025  # #368aeb
color.alternate=on gray3  # #252525
color.header=rgb025  # #368aeb
color.footnote=rgb044  # #3fc5b7
color.warning=gray2 on rgb430  # #181818 on #dbb32d
color.error=rgb411  # #ed4a46
color.debug=rgb044  # #3fc5b7

# Task state
color.completed=gray11  # #777777
color.deleted=gray11  # #777777
color.active=gray2 on rgb130  # #181818 on #70b433
color.recurring=rgb044  # #3fc5b7
color.scheduled=rgb025  # #368aeb
color.until=
color.blocked=gray11  # #777777
color.blocking=gray2 on rgb324  # #181818 on #a580e2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #e67f43
color.uda.priority.M=rgb430  # #dbb32d
color.uda.priority.L=rgb025  # #368aeb

# Tags
color.tag.next=rgb324  # #a580e2
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #dbb32d
color.due.today=rgb421  # #e67f43
color.overdue=rgb411  # #ed4a46

# Report: burndown
color.burndown.done=gray2 on rgb130  # #181818 on #70b433
color.burndown.pending=gray2 on rgb411  # #181818 on #ed4a46
color.burndown.started=gray2 on rgb430  # #181818 on #dbb32d

# Report: history
color.history.add=gray2 on rgb411  # #181818 on #ed4a46
color.history.delete=gray2 on rgb430  # #181818 on #dbb32d
color.history.done=gray2 on rgb130  # #181818 on #70b433

# Report: summary
color.summary.background=on gray3  # #252525
color.summary.bar=gray2 on rgb130  # #181818 on #70b433

# Command: calendar
color.calendar.due=gray2 on rgb430  # #181818 on #dbb32d
color.calendar.due.today=gray2 on rgb421  # #181818 on #e67f43
color.calendar.holiday=gray2 on rgb324  # #181818 on #a580e2
color.calendar.overdue=gray2 on rgb411  # #181818 on #ed4a46
color.calendar.scheduled=gray2 on rgb025  # #181818 on #368aeb
color.calendar.today=gray2 on rgb044  # #181818 on #3fc5b7
color.calendar.weekend=gray11  # #777777
color.calendar.weeknumber=gray11  # #777777

# Command: sync
color.sync.added=rgb130  # #70b433
color.sync.changed=rgb430  # #dbb32d
color.sync.rejected=rgb411  # #ed4a46

# Command: undo
color.undo.after=rgb130  # #70b433
color.undo.before=rgb411  # #ed4a46
