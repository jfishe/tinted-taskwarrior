# tinted-taskwarrior
# Scheme name: London Tube
# Scheme author: Jan T. Sott
# Scheme: base16-tube (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #737171
color.label.sort=rgb035  # #009ddc
color.alternate=on rgb013  # #1c3f95
color.header=rgb035  # #009ddc
color.footnote=rgb243  # #85cebc
color.warning=gray2 on rgb540  # #231f20 on #ffd204
color.error=rgb500  # #ee2e24
color.debug=rgb243  # #85cebc

# Task state
color.completed=gray11  # #737171
color.deleted=gray11  # #737171
color.active=gray2 on rgb020  # #231f20 on #00853e
color.recurring=rgb243  # #85cebc
color.scheduled=rgb035  # #009ddc
color.until=
color.blocked=gray11  # #737171
color.blocking=gray2 on rgb201  # #231f20 on #98005d

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb523  # #f386a1
color.uda.priority.M=rgb540  # #ffd204
color.uda.priority.L=rgb035  # #009ddc

# Tags
color.tag.next=rgb201  # #98005d
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #ffd204
color.due.today=rgb523  # #f386a1
color.overdue=rgb500  # #ee2e24

# Report: burndown
color.burndown.done=gray2 on rgb020  # #231f20 on #00853e
color.burndown.pending=gray2 on rgb500  # #231f20 on #ee2e24
color.burndown.started=gray2 on rgb540  # #231f20 on #ffd204

# Report: history
color.history.add=gray2 on rgb500  # #231f20 on #ee2e24
color.history.delete=gray2 on rgb540  # #231f20 on #ffd204
color.history.done=gray2 on rgb020  # #231f20 on #00853e

# Report: summary
color.summary.background=on rgb013  # #1c3f95
color.summary.bar=gray2 on rgb020  # #231f20 on #00853e

# Command: calendar
color.calendar.due=gray2 on rgb540  # #231f20 on #ffd204
color.calendar.due.today=gray2 on rgb523  # #231f20 on #f386a1
color.calendar.holiday=gray2 on rgb201  # #231f20 on #98005d
color.calendar.overdue=gray2 on rgb500  # #231f20 on #ee2e24
color.calendar.scheduled=gray2 on rgb035  # #231f20 on #009ddc
color.calendar.today=gray2 on rgb243  # #231f20 on #85cebc
color.calendar.weekend=gray11  # #737171
color.calendar.weeknumber=gray11  # #737171

# Command: sync
color.sync.added=rgb020  # #00853e
color.sync.changed=rgb540  # #ffd204
color.sync.rejected=rgb500  # #ee2e24

# Command: undo
color.undo.after=rgb020  # #00853e
color.undo.before=rgb500  # #ee2e24
