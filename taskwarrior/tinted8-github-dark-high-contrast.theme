# tinted-taskwarrior
# Scheme name: Github Dark High Contrast
# Scheme author: Tinted Theming (https://github.com/tinted-theming)
# Scheme: tinted8-github-dark-high-contrast (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #656c76
color.label.sort=rgb135  # #71b7ff
color.alternate=on gray7  # #484e55
color.header=rgb135  # #71b7ff
color.footnote=rgb144  # #39c5cf
color.warning=gray0 on rgb530  # #010409 on #f0b72f
color.error=rgb522  # #ff9492
color.debug=rgb144  # #39c5cf

# Task state
color.completed=gray10  # #656c76
color.deleted=gray10  # #656c76
color.active=gray0 on rgb041  # #010409 on #28d751
color.recurring=rgb144  # #39c5cf
color.scheduled=rgb135  # #71b7ff
color.until=
color.blocked=gray10  # #656c76
color.blocking=gray0 on rgb435  # #010409 on #cb9eff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #ffb757
color.uda.priority.M=rgb530  # #f0b72f
color.uda.priority.L=rgb135  # #71b7ff

# Tags
color.tag.next=rgb435  # #cb9eff
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #f0b72f
color.due.today=rgb531  # #ffb757
color.overdue=rgb522  # #ff9492

# Report: burndown
color.burndown.done=gray0 on rgb041  # #010409 on #28d751
color.burndown.pending=gray0 on rgb522  # #010409 on #ff9492
color.burndown.started=gray0 on rgb530  # #010409 on #f0b72f

# Report: history
color.history.add=gray0 on rgb522  # #010409 on #ff9492
color.history.delete=gray0 on rgb530  # #010409 on #f0b72f
color.history.done=gray0 on rgb041  # #010409 on #28d751

# Report: summary
color.summary.background=on gray7  # #484e55
color.summary.bar=gray0 on rgb041  # #010409 on #28d751

# Command: calendar
color.calendar.due=gray0 on rgb530  # #010409 on #f0b72f
color.calendar.due.today=gray0 on rgb531  # #010409 on #ffb757
color.calendar.holiday=gray0 on rgb435  # #010409 on #cb9eff
color.calendar.overdue=gray0 on rgb522  # #010409 on #ff9492
color.calendar.scheduled=gray0 on rgb135  # #010409 on #71b7ff
color.calendar.today=gray0 on rgb144  # #010409 on #39c5cf
color.calendar.weekend=gray10  # #656c76
color.calendar.weeknumber=gray10  # #656c76

# Command: sync
color.sync.added=rgb041  # #28d751
color.sync.changed=rgb530  # #f0b72f
color.sync.rejected=rgb522  # #ff9492

# Command: undo
color.undo.after=rgb041  # #28d751
color.undo.before=rgb522  # #ff9492
