# tinted-taskwarrior
# Scheme name: Piatto Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-piatto-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray19  # #c1c1c1
color.label.sort=rgb013  # #3c5ea8
color.alternate=on gray23  # #f1f1f1
color.header=rgb013  # #3c5ea8
color.footnote=rgb022  # #1e7878
color.warning=rgb555 on rgb430  # #ffffff on #cda434
color.error=rgb301  # #b23771
color.debug=rgb022  # #1e7878

# Task state
color.completed=gray19  # #c1c1c1
color.deleted=gray19  # #c1c1c1
color.active=rgb555 on rgb120  # #ffffff on #66781e
color.recurring=rgb022  # #1e7878
color.scheduled=rgb013  # #3c5ea8
color.until=
color.blocked=gray19  # #c1c1c1
color.blocking=rgb555 on rgb313  # #ffffff on #a454b2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #cd6f34
color.uda.priority.M=rgb430  # #cda434
color.uda.priority.L=rgb013  # #3c5ea8

# Tags
color.tag.next=rgb313  # #a454b2
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #cda434
color.due.today=rgb410  # #cd6f34
color.overdue=rgb301  # #b23771

# Report: burndown
color.burndown.done=rgb555 on rgb120  # #ffffff on #66781e
color.burndown.pending=rgb555 on rgb301  # #ffffff on #b23771
color.burndown.started=rgb555 on rgb430  # #ffffff on #cda434

# Report: history
color.history.add=rgb555 on rgb301  # #ffffff on #b23771
color.history.delete=rgb555 on rgb430  # #ffffff on #cda434
color.history.done=rgb555 on rgb120  # #ffffff on #66781e

# Report: summary
color.summary.background=on gray23  # #f1f1f1
color.summary.bar=rgb555 on rgb120  # #ffffff on #66781e

# Command: calendar
color.calendar.due=rgb555 on rgb430  # #ffffff on #cda434
color.calendar.due.today=rgb555 on rgb410  # #ffffff on #cd6f34
color.calendar.holiday=rgb555 on rgb313  # #ffffff on #a454b2
color.calendar.overdue=rgb555 on rgb301  # #ffffff on #b23771
color.calendar.scheduled=rgb555 on rgb013  # #ffffff on #3c5ea8
color.calendar.today=rgb555 on rgb022  # #ffffff on #1e7878
color.calendar.weekend=gray19  # #c1c1c1
color.calendar.weeknumber=gray19  # #c1c1c1

# Command: sync
color.sync.added=rgb120  # #66781e
color.sync.changed=rgb430  # #cda434
color.sync.rejected=rgb301  # #b23771

# Command: undo
color.undo.after=rgb120  # #66781e
color.undo.before=rgb301  # #b23771
