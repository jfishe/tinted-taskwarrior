# tinted-taskwarrior
# Scheme name: Synth Midnight Terminal Dark
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Scheme: base16-synth-midnight-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray6  # #474849
color.label.sort=rgb035  # #03aeff
color.alternate=on gray2  # #1a1b1c
color.header=rgb035  # #03aeff
color.footnote=rgb055  # #42fff9
color.warning=gray0 on rgb441  # #050608 on #c9d364
color.error=rgb401  # #b53b50
color.debug=rgb055  # #42fff9

# Task state
color.completed=gray6  # #474849
color.deleted=gray6  # #474849
color.active=gray0 on rgb041  # #050608 on #06ea61
color.recurring=rgb055  # #42fff9
color.scheduled=rgb035  # #03aeff
color.until=
color.blocked=gray6  # #474849
color.blocking=gray0 on rgb414  # #050608 on #ea5ce2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #ea770d
color.uda.priority.M=rgb441  # #c9d364
color.uda.priority.L=rgb035  # #03aeff

# Tags
color.tag.next=rgb414  # #ea5ce2
color.tag.none=
color.tagged=

# Due
color.due=rgb441  # #c9d364
color.due.today=rgb520  # #ea770d
color.overdue=rgb401  # #b53b50

# Report: burndown
color.burndown.done=gray0 on rgb041  # #050608 on #06ea61
color.burndown.pending=gray0 on rgb401  # #050608 on #b53b50
color.burndown.started=gray0 on rgb441  # #050608 on #c9d364

# Report: history
color.history.add=gray0 on rgb401  # #050608 on #b53b50
color.history.delete=gray0 on rgb441  # #050608 on #c9d364
color.history.done=gray0 on rgb041  # #050608 on #06ea61

# Report: summary
color.summary.background=on gray2  # #1a1b1c
color.summary.bar=gray0 on rgb041  # #050608 on #06ea61

# Command: calendar
color.calendar.due=gray0 on rgb441  # #050608 on #c9d364
color.calendar.due.today=gray0 on rgb520  # #050608 on #ea770d
color.calendar.holiday=gray0 on rgb414  # #050608 on #ea5ce2
color.calendar.overdue=gray0 on rgb401  # #050608 on #b53b50
color.calendar.scheduled=gray0 on rgb035  # #050608 on #03aeff
color.calendar.today=gray0 on rgb055  # #050608 on #42fff9
color.calendar.weekend=gray6  # #474849
color.calendar.weeknumber=gray6  # #474849

# Command: sync
color.sync.added=rgb041  # #06ea61
color.sync.changed=rgb441  # #c9d364
color.sync.rejected=rgb401  # #b53b50

# Command: undo
color.undo.after=rgb041  # #06ea61
color.undo.before=rgb401  # #b53b50
