# tinted-taskwarrior
# Scheme name: Humanoid light
# Scheme author: Thomas (tasmo) Friese
# Scheme: base16-humanoid-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray18  # #c0c0bd
color.label.sort=rgb024  # #0082c9
color.alternate=on gray23  # #efefe9
color.header=rgb024  # #0082c9
color.footnote=rgb022  # #008e8e
color.warning=rgb555 on rgb530  # #f8f8f2 on #ffb627
color.error=rgb300  # #b0151a
color.debug=rgb022  # #008e8e

# Task state
color.completed=gray18  # #c0c0bd
color.deleted=gray18  # #c0c0bd
color.active=rgb555 on rgb020  # #f8f8f2 on #388e3c
color.recurring=rgb022  # #008e8e
color.scheduled=rgb024  # #0082c9
color.until=
color.blocked=gray18  # #c0c0bd
color.blocking=rgb555 on rgb102  # #f8f8f2 on #700f98

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb500  # #ff3d00
color.uda.priority.M=rgb530  # #ffb627
color.uda.priority.L=rgb024  # #0082c9

# Tags
color.tag.next=rgb102  # #700f98
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #ffb627
color.due.today=rgb500  # #ff3d00
color.overdue=rgb300  # #b0151a

# Report: burndown
color.burndown.done=rgb555 on rgb020  # #f8f8f2 on #388e3c
color.burndown.pending=rgb555 on rgb300  # #f8f8f2 on #b0151a
color.burndown.started=rgb555 on rgb530  # #f8f8f2 on #ffb627

# Report: history
color.history.add=rgb555 on rgb300  # #f8f8f2 on #b0151a
color.history.delete=rgb555 on rgb530  # #f8f8f2 on #ffb627
color.history.done=rgb555 on rgb020  # #f8f8f2 on #388e3c

# Report: summary
color.summary.background=on gray23  # #efefe9
color.summary.bar=rgb555 on rgb020  # #f8f8f2 on #388e3c

# Command: calendar
color.calendar.due=rgb555 on rgb530  # #f8f8f2 on #ffb627
color.calendar.due.today=rgb555 on rgb500  # #f8f8f2 on #ff3d00
color.calendar.holiday=rgb555 on rgb102  # #f8f8f2 on #700f98
color.calendar.overdue=rgb555 on rgb300  # #f8f8f2 on #b0151a
color.calendar.scheduled=rgb555 on rgb024  # #f8f8f2 on #0082c9
color.calendar.today=rgb555 on rgb022  # #f8f8f2 on #008e8e
color.calendar.weekend=gray18  # #c0c0bd
color.calendar.weeknumber=gray18  # #c0c0bd

# Command: sync
color.sync.added=rgb020  # #388e3c
color.sync.changed=rgb530  # #ffb627
color.sync.rejected=rgb300  # #b0151a

# Command: undo
color.undo.after=rgb020  # #388e3c
color.undo.before=rgb300  # #b0151a
