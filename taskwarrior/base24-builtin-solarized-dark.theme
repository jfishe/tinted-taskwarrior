# tinted-taskwarrior
# Scheme name: Builtin Solarized Dark
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-builtin-solarized-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb011  # #3b5a5d
color.label.sort=rgb024  # #268bd2
color.alternate=on gray4  # #073642
color.header=rgb024  # #268bd2
color.footnote=rgb033  # #2aa198
color.warning=gray3 on gray14  # #002b36 on #839496
color.error=rgb400  # #dc322f
color.debug=rgb033  # #2aa198

# Task state
color.completed=rgb011  # #3b5a5d
color.deleted=rgb011  # #3b5a5d
color.active=gray3 on rgb230  # #002b36 on #859900
color.recurring=rgb033  # #2aa198
color.scheduled=rgb024  # #268bd2
color.until=
color.blocked=rgb011  # #3b5a5d
color.blocking=gray3 on rgb402  # #002b36 on #d33682

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb320  # #b58900
color.uda.priority.M=gray14  # #839496
color.uda.priority.L=rgb024  # #268bd2

# Tags
color.tag.next=rgb402  # #d33682
color.tag.none=
color.tagged=

# Due
color.due=gray14  # #839496
color.due.today=rgb320  # #b58900
color.overdue=rgb400  # #dc322f

# Report: burndown
color.burndown.done=gray3 on rgb230  # #002b36 on #859900
color.burndown.pending=gray3 on rgb400  # #002b36 on #dc322f
color.burndown.started=gray3 on gray14  # #002b36 on #839496

# Report: history
color.history.add=gray3 on rgb400  # #002b36 on #dc322f
color.history.delete=gray3 on gray14  # #002b36 on #839496
color.history.done=gray3 on rgb230  # #002b36 on #859900

# Report: summary
color.summary.background=on gray4  # #073642
color.summary.bar=gray3 on rgb230  # #002b36 on #859900

# Command: calendar
color.calendar.due=gray3 on gray14  # #002b36 on #839496
color.calendar.due.today=gray3 on rgb320  # #002b36 on #b58900
color.calendar.holiday=gray3 on rgb402  # #002b36 on #d33682
color.calendar.overdue=gray3 on rgb400  # #002b36 on #dc322f
color.calendar.scheduled=gray3 on rgb024  # #002b36 on #268bd2
color.calendar.today=gray3 on rgb033  # #002b36 on #2aa198
color.calendar.weekend=rgb011  # #3b5a5d
color.calendar.weeknumber=rgb011  # #3b5a5d

# Command: sync
color.sync.added=rgb230  # #859900
color.sync.changed=gray14  # #839496
color.sync.rejected=rgb400  # #dc322f

# Command: undo
color.undo.after=rgb230  # #859900
color.undo.before=rgb400  # #dc322f
