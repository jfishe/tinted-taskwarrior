# shellcheck shell=bash
# direnv: inside this repo, `task` uses the demo rc and database only.
# Overrides any TASKRC/TASKDATA inherited from elsewhere (e.g. ~/vimwiki/.env).
export TASKRC="$PWD/demo/taskrc"
export TASKDATA="$PWD/demo/data"
[ -e demo/current.theme ] || : > demo/current.theme
demo/holidays.sh demo/holidays.rc
