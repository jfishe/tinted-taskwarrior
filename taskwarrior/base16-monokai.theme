# tinted-taskwarrior
# Scheme name: Monokai
# Scheme author: Wimer Hazenberg (http://www.monokai.nl)
# Scheme: base16-monokai (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #75715e
color.label.sort=rgb045  # #66d9ef
color.alternate=on gray5  # #383830
color.header=rgb045  # #66d9ef
color.footnote=rgb355  # #a1efe4
color.warning=gray3 on rgb431  # #272822 on #f4bf75
color.error=rgb501  # #f92672
color.debug=rgb355  # #a1efe4

# Task state
color.completed=gray10  # #75715e
color.deleted=gray10  # #75715e
color.active=gray3 on rgb240  # #272822 on #a6e22e
color.recurring=rgb355  # #a1efe4
color.scheduled=rgb045  # #66d9ef
color.until=
color.blocked=gray10  # #75715e
color.blocking=gray3 on rgb325  # #272822 on #ae81ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #fd971f
color.uda.priority.M=rgb431  # #f4bf75
color.uda.priority.L=rgb045  # #66d9ef

# Tags
color.tag.next=rgb325  # #ae81ff
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #f4bf75
color.due.today=rgb520  # #fd971f
color.overdue=rgb501  # #f92672

# Report: burndown
color.burndown.done=gray3 on rgb240  # #272822 on #a6e22e
color.burndown.pending=gray3 on rgb501  # #272822 on #f92672
color.burndown.started=gray3 on rgb431  # #272822 on #f4bf75

# Report: history
color.history.add=gray3 on rgb501  # #272822 on #f92672
color.history.delete=gray3 on rgb431  # #272822 on #f4bf75
color.history.done=gray3 on rgb240  # #272822 on #a6e22e

# Report: summary
color.summary.background=on gray5  # #383830
color.summary.bar=gray3 on rgb240  # #272822 on #a6e22e

# Command: calendar
color.calendar.due=gray3 on rgb431  # #272822 on #f4bf75
color.calendar.due.today=gray3 on rgb520  # #272822 on #fd971f
color.calendar.holiday=gray3 on rgb325  # #272822 on #ae81ff
color.calendar.overdue=gray3 on rgb501  # #272822 on #f92672
color.calendar.scheduled=gray3 on rgb045  # #272822 on #66d9ef
color.calendar.today=gray3 on rgb355  # #272822 on #a1efe4
color.calendar.weekend=gray10  # #75715e
color.calendar.weeknumber=gray10  # #75715e

# Command: sync
color.sync.added=rgb240  # #a6e22e
color.sync.changed=rgb431  # #f4bf75
color.sync.rejected=rgb501  # #f92672

# Command: undo
color.undo.after=rgb240  # #a6e22e
color.undo.before=rgb501  # #f92672
