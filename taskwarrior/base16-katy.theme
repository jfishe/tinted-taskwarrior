# tinted-taskwarrior
# Scheme name: Katy
# Scheme author: George Essig (https://github.com/gessig)
# Scheme: base16-katy (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #676e95
color.label.sort=rgb235  # #82aaff
color.alternate=on rgb112  # #444267
color.header=rgb235  # #82aaff
color.footnote=rgb234  # #83b7e5
color.warning=gray4 on rgb431  # #292d3e on #e0a557
color.error=rgb124  # #6e98e1
color.debug=rgb234  # #83b7e5

# Task state
color.completed=rgb112  # #676e95
color.deleted=rgb112  # #676e95
color.active=gray4 on rgb131  # #292d3e on #78c06e
color.recurring=rgb234  # #83b7e5
color.scheduled=rgb235  # #82aaff
color.until=
color.blocked=rgb112  # #676e95
color.blocking=gray4 on rgb425  # #292d3e on #c792ea

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb521  # #f78c6c
color.uda.priority.M=rgb431  # #e0a557
color.uda.priority.L=rgb235  # #82aaff

# Tags
color.tag.next=rgb425  # #c792ea
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #e0a557
color.due.today=rgb521  # #f78c6c
color.overdue=rgb124  # #6e98e1

# Report: burndown
color.burndown.done=gray4 on rgb131  # #292d3e on #78c06e
color.burndown.pending=gray4 on rgb124  # #292d3e on #6e98e1
color.burndown.started=gray4 on rgb431  # #292d3e on #e0a557

# Report: history
color.history.add=gray4 on rgb124  # #292d3e on #6e98e1
color.history.delete=gray4 on rgb431  # #292d3e on #e0a557
color.history.done=gray4 on rgb131  # #292d3e on #78c06e

# Report: summary
color.summary.background=on rgb112  # #444267
color.summary.bar=gray4 on rgb131  # #292d3e on #78c06e

# Command: calendar
color.calendar.due=gray4 on rgb431  # #292d3e on #e0a557
color.calendar.due.today=gray4 on rgb521  # #292d3e on #f78c6c
color.calendar.holiday=gray4 on rgb425  # #292d3e on #c792ea
color.calendar.overdue=gray4 on rgb124  # #292d3e on #6e98e1
color.calendar.scheduled=gray4 on rgb235  # #292d3e on #82aaff
color.calendar.today=gray4 on rgb234  # #292d3e on #83b7e5
color.calendar.weekend=rgb112  # #676e95
color.calendar.weeknumber=rgb112  # #676e95

# Command: sync
color.sync.added=rgb131  # #78c06e
color.sync.changed=rgb431  # #e0a557
color.sync.rejected=rgb124  # #6e98e1

# Command: undo
color.undo.after=rgb131  # #78c06e
color.undo.before=rgb124  # #6e98e1
