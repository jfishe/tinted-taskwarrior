# tinted-taskwarrior
# Scheme name: Sequoia Retro Light
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Scheme: base16-sequoia-retro-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #565760
color.label.sort=rgb012  # #456a82
color.alternate=on gray22  # #e2e3e8
color.header=rgb012  # #456a82
color.footnote=rgb210  # #8a6539
color.warning=gray23 on rgb400  # #edeef2 on #bf5238
color.error=rgb122  # #5f7982
color.debug=rgb210  # #8a6539

# Task state
color.completed=gray8  # #565760
color.deleted=gray8  # #565760
color.active=gray23 on rgb121  # #edeef2 on #4a704e
color.recurring=rgb210  # #8a6539
color.scheduled=rgb012  # #456a82
color.until=
color.blocked=gray8  # #565760
color.blocking=gray23 on rgb400  # #edeef2 on #bf5238

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb122  # #5f7982
color.uda.priority.M=rgb400  # #bf5238
color.uda.priority.L=rgb012  # #456a82

# Tags
color.tag.next=rgb400  # #bf5238
color.tag.none=
color.tagged=

# Due
color.due=rgb400  # #bf5238
color.due.today=rgb122  # #5f7982
color.overdue=rgb122  # #5f7982

# Report: burndown
color.burndown.done=gray23 on rgb121  # #edeef2 on #4a704e
color.burndown.pending=gray23 on rgb122  # #edeef2 on #5f7982
color.burndown.started=gray23 on rgb400  # #edeef2 on #bf5238

# Report: history
color.history.add=gray23 on rgb122  # #edeef2 on #5f7982
color.history.delete=gray23 on rgb400  # #edeef2 on #bf5238
color.history.done=gray23 on rgb121  # #edeef2 on #4a704e

# Report: summary
color.summary.background=on gray22  # #e2e3e8
color.summary.bar=gray23 on rgb121  # #edeef2 on #4a704e

# Command: calendar
color.calendar.due=gray23 on rgb400  # #edeef2 on #bf5238
color.calendar.due.today=gray23 on rgb122  # #edeef2 on #5f7982
color.calendar.holiday=gray23 on rgb400  # #edeef2 on #bf5238
color.calendar.overdue=gray23 on rgb122  # #edeef2 on #5f7982
color.calendar.scheduled=gray23 on rgb012  # #edeef2 on #456a82
color.calendar.today=gray23 on rgb210  # #edeef2 on #8a6539
color.calendar.weekend=gray8  # #565760
color.calendar.weeknumber=gray8  # #565760

# Command: sync
color.sync.added=rgb121  # #4a704e
color.sync.changed=rgb400  # #bf5238
color.sync.rejected=rgb122  # #5f7982

# Command: undo
color.undo.after=rgb121  # #4a704e
color.undo.before=rgb122  # #5f7982
