# tinted-taskwarrior
# Scheme name: Gruvbox light, hard
# Scheme author: Dawid Kurek (dawikur@gmail.com), morhetz (https://github.com/morhetz/gruvbox)
# Scheme: base16-gruvbox-light-hard (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb332  # #bdae93
color.label.sort=rgb011  # #076678
color.alternate=on rgb443  # #ebdbb2
color.header=rgb011  # #076678
color.footnote=rgb021  # #427b58
color.warning=rgb554 on rgb420  # #f9f5d7 on #b57614
color.error=rgb300  # #9d0006
color.debug=rgb021  # #427b58

# Task state
color.completed=rgb332  # #bdae93
color.deleted=rgb332  # #bdae93
color.active=rgb554 on rgb220  # #f9f5d7 on #79740e
color.recurring=rgb021  # #427b58
color.scheduled=rgb011  # #076678
color.until=
color.blocked=rgb332  # #bdae93
color.blocking=rgb554 on rgb302  # #f9f5d7 on #8f3f71

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb300  # #af3a03
color.uda.priority.M=rgb420  # #b57614
color.uda.priority.L=rgb011  # #076678

# Tags
color.tag.next=rgb302  # #8f3f71
color.tag.none=
color.tagged=

# Due
color.due=rgb420  # #b57614
color.due.today=rgb300  # #af3a03
color.overdue=rgb300  # #9d0006

# Report: burndown
color.burndown.done=rgb554 on rgb220  # #f9f5d7 on #79740e
color.burndown.pending=rgb554 on rgb300  # #f9f5d7 on #9d0006
color.burndown.started=rgb554 on rgb420  # #f9f5d7 on #b57614

# Report: history
color.history.add=rgb554 on rgb300  # #f9f5d7 on #9d0006
color.history.delete=rgb554 on rgb420  # #f9f5d7 on #b57614
color.history.done=rgb554 on rgb220  # #f9f5d7 on #79740e

# Report: summary
color.summary.background=on rgb443  # #ebdbb2
color.summary.bar=rgb554 on rgb220  # #f9f5d7 on #79740e

# Command: calendar
color.calendar.due=rgb554 on rgb420  # #f9f5d7 on #b57614
color.calendar.due.today=rgb554 on rgb300  # #f9f5d7 on #af3a03
color.calendar.holiday=rgb554 on rgb302  # #f9f5d7 on #8f3f71
color.calendar.overdue=rgb554 on rgb300  # #f9f5d7 on #9d0006
color.calendar.scheduled=rgb554 on rgb011  # #f9f5d7 on #076678
color.calendar.today=rgb554 on rgb021  # #f9f5d7 on #427b58
color.calendar.weekend=rgb332  # #bdae93
color.calendar.weeknumber=rgb332  # #bdae93

# Command: sync
color.sync.added=rgb220  # #79740e
color.sync.changed=rgb420  # #b57614
color.sync.rejected=rgb300  # #9d0006

# Command: undo
color.undo.after=rgb220  # #79740e
color.undo.before=rgb300  # #9d0006
