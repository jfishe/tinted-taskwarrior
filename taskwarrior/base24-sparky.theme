# tinted-taskwarrior
# Scheme name: Sparky
# Scheme author: Leila Sother (https://github.com/mixcoac)
# Scheme: base24-sparky (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb011  # #003b49
color.label.sort=rgb024  # #4698cb
color.alternate=on gray4  # #00313c
color.header=rgb024  # #4698cb
color.footnote=rgb044  # #2dccd3
color.warning=gray3 on rgb540  # #072b31 on #fbdd40
color.error=rgb511  # #ff585d
color.debug=rgb044  # #2dccd3

# Task state
color.completed=rgb011  # #003b49
color.deleted=rgb011  # #003b49
color.active=gray3 on rgb241  # #072b31 on #78d64b
color.recurring=rgb044  # #2dccd3
color.scheduled=rgb024  # #4698cb
color.until=
color.blocked=rgb011  # #003b49
color.blocking=gray3 on rgb434  # #072b31 on #d59ed7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #ff8f1c
color.uda.priority.M=rgb540  # #fbdd40
color.uda.priority.L=rgb024  # #4698cb

# Tags
color.tag.next=rgb434  # #d59ed7
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #fbdd40
color.due.today=rgb520  # #ff8f1c
color.overdue=rgb511  # #ff585d

# Report: burndown
color.burndown.done=gray3 on rgb241  # #072b31 on #78d64b
color.burndown.pending=gray3 on rgb511  # #072b31 on #ff585d
color.burndown.started=gray3 on rgb540  # #072b31 on #fbdd40

# Report: history
color.history.add=gray3 on rgb511  # #072b31 on #ff585d
color.history.delete=gray3 on rgb540  # #072b31 on #fbdd40
color.history.done=gray3 on rgb241  # #072b31 on #78d64b

# Report: summary
color.summary.background=on gray4  # #00313c
color.summary.bar=gray3 on rgb241  # #072b31 on #78d64b

# Command: calendar
color.calendar.due=gray3 on rgb540  # #072b31 on #fbdd40
color.calendar.due.today=gray3 on rgb520  # #072b31 on #ff8f1c
color.calendar.holiday=gray3 on rgb434  # #072b31 on #d59ed7
color.calendar.overdue=gray3 on rgb511  # #072b31 on #ff585d
color.calendar.scheduled=gray3 on rgb024  # #072b31 on #4698cb
color.calendar.today=gray3 on rgb044  # #072b31 on #2dccd3
color.calendar.weekend=rgb011  # #003b49
color.calendar.weeknumber=rgb011  # #003b49

# Command: sync
color.sync.added=rgb241  # #78d64b
color.sync.changed=rgb540  # #fbdd40
color.sync.rejected=rgb511  # #ff585d

# Command: undo
color.undo.after=rgb241  # #78d64b
color.undo.before=rgb511  # #ff585d
