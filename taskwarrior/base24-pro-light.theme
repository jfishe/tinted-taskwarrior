# tinted-taskwarrior
# Scheme name: Pro Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-pro-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray20  # #cccccc
color.label.sort=rgb125  # #3a75ff
color.alternate=on gray23  # #f1f1f1
color.header=rgb125  # #3a75ff
color.footnote=rgb144  # #4ed1dd
color.warning=rgb555 on rgb441  # #feffff on #c5c340
color.error=rgb500  # #e4492b
color.debug=rgb144  # #4ed1dd

# Task state
color.completed=gray20  # #cccccc
color.deleted=gray20  # #cccccc
color.active=rgb555 on rgb141  # #feffff on #50d048
color.recurring=rgb144  # #4ed1dd
color.scheduled=rgb125  # #3a75ff
color.until=
color.blocked=gray20  # #cccccc
color.blocking=rgb555 on rgb515  # #feffff on #ec65e7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb420  # #c58e40
color.uda.priority.M=rgb441  # #c5c340
color.uda.priority.L=rgb125  # #3a75ff

# Tags
color.tag.next=rgb515  # #ec65e7
color.tag.none=
color.tagged=

# Due
color.due=rgb441  # #c5c340
color.due.today=rgb420  # #c58e40
color.overdue=rgb500  # #e4492b

# Report: burndown
color.burndown.done=rgb555 on rgb141  # #feffff on #50d048
color.burndown.pending=rgb555 on rgb500  # #feffff on #e4492b
color.burndown.started=rgb555 on rgb441  # #feffff on #c5c340

# Report: history
color.history.add=rgb555 on rgb500  # #feffff on #e4492b
color.history.delete=rgb555 on rgb441  # #feffff on #c5c340
color.history.done=rgb555 on rgb141  # #feffff on #50d048

# Report: summary
color.summary.background=on gray23  # #f1f1f1
color.summary.bar=rgb555 on rgb141  # #feffff on #50d048

# Command: calendar
color.calendar.due=rgb555 on rgb441  # #feffff on #c5c340
color.calendar.due.today=rgb555 on rgb420  # #feffff on #c58e40
color.calendar.holiday=rgb555 on rgb515  # #feffff on #ec65e7
color.calendar.overdue=rgb555 on rgb500  # #feffff on #e4492b
color.calendar.scheduled=rgb555 on rgb125  # #feffff on #3a75ff
color.calendar.today=rgb555 on rgb144  # #feffff on #4ed1dd
color.calendar.weekend=gray20  # #cccccc
color.calendar.weeknumber=gray20  # #cccccc

# Command: sync
color.sync.added=rgb141  # #50d048
color.sync.changed=rgb441  # #c5c340
color.sync.rejected=rgb500  # #e4492b

# Command: undo
color.undo.after=rgb141  # #50d048
color.undo.before=rgb500  # #e4492b
