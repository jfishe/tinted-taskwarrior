# tinted-taskwarrior
# Scheme name: Desert
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-desert (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #7d776c
color.label.sort=rgb420  # #cd853f
color.alternate=on gray7  # #4d4d4d
color.header=rgb420  # #cd853f
color.footnote=rgb533  # #ffa0a0
color.warning=gray4 on rgb245  # #333333 on #87ceff
color.error=rgb500  # #ff2b2b
color.debug=rgb533  # #ffa0a0

# Task state
color.completed=gray11  # #7d776c
color.deleted=gray11  # #7d776c
color.active=gray4 on rgb252  # #333333 on #98fb98
color.recurring=rgb533  # #ffa0a0
color.scheduled=rgb420  # #cd853f
color.until=
color.blocked=gray11  # #7d776c
color.blocking=gray4 on rgb543  # #333333 on #ffdead

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb442  # #f0e68c
color.uda.priority.M=rgb245  # #87ceff
color.uda.priority.L=rgb420  # #cd853f

# Tags
color.tag.next=rgb543  # #ffdead
color.tag.none=
color.tagged=

# Due
color.due=rgb245  # #87ceff
color.due.today=rgb442  # #f0e68c
color.overdue=rgb500  # #ff2b2b

# Report: burndown
color.burndown.done=gray4 on rgb252  # #333333 on #98fb98
color.burndown.pending=gray4 on rgb500  # #333333 on #ff2b2b
color.burndown.started=gray4 on rgb245  # #333333 on #87ceff

# Report: history
color.history.add=gray4 on rgb500  # #333333 on #ff2b2b
color.history.delete=gray4 on rgb245  # #333333 on #87ceff
color.history.done=gray4 on rgb252  # #333333 on #98fb98

# Report: summary
color.summary.background=on gray7  # #4d4d4d
color.summary.bar=gray4 on rgb252  # #333333 on #98fb98

# Command: calendar
color.calendar.due=gray4 on rgb245  # #333333 on #87ceff
color.calendar.due.today=gray4 on rgb442  # #333333 on #f0e68c
color.calendar.holiday=gray4 on rgb543  # #333333 on #ffdead
color.calendar.overdue=gray4 on rgb500  # #333333 on #ff2b2b
color.calendar.scheduled=gray4 on rgb420  # #333333 on #cd853f
color.calendar.today=gray4 on rgb533  # #333333 on #ffa0a0
color.calendar.weekend=gray11  # #7d776c
color.calendar.weeknumber=gray11  # #7d776c

# Command: sync
color.sync.added=rgb252  # #98fb98
color.sync.changed=rgb245  # #87ceff
color.sync.rejected=rgb500  # #ff2b2b

# Command: undo
color.undo.after=rgb252  # #98fb98
color.undo.before=rgb500  # #ff2b2b
