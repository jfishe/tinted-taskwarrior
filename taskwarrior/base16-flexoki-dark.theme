# tinted-taskwarrior
# Scheme name: Flexoki Dark
# Scheme author: Steph Ango (https://github.com/kepano/flexoki)
# Scheme: base16-flexoki-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #575653
color.label.sort=rgb024  # #4385be
color.alternate=on gray2  # #1c1b1a
color.header=rgb024  # #4385be
color.footnote=rgb033  # #3aa99f
color.warning=gray1 on rgb430  # #100f0f on #d0a215
color.error=rgb411  # #d14d41
color.debug=rgb033  # #3aa99f

# Task state
color.completed=gray8  # #575653
color.deleted=gray8  # #575653
color.active=gray1 on rgb230  # #100f0f on #879a39
color.recurring=rgb033  # #3aa99f
color.scheduled=rgb024  # #4385be
color.until=
color.blocked=gray8  # #575653
color.blocking=gray1 on rgb224  # #100f0f on #8b7ec8

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #da702c
color.uda.priority.M=rgb430  # #d0a215
color.uda.priority.L=rgb024  # #4385be

# Tags
color.tag.next=rgb224  # #8b7ec8
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #d0a215
color.due.today=rgb410  # #da702c
color.overdue=rgb411  # #d14d41

# Report: burndown
color.burndown.done=gray1 on rgb230  # #100f0f on #879a39
color.burndown.pending=gray1 on rgb411  # #100f0f on #d14d41
color.burndown.started=gray1 on rgb430  # #100f0f on #d0a215

# Report: history
color.history.add=gray1 on rgb411  # #100f0f on #d14d41
color.history.delete=gray1 on rgb430  # #100f0f on #d0a215
color.history.done=gray1 on rgb230  # #100f0f on #879a39

# Report: summary
color.summary.background=on gray2  # #1c1b1a
color.summary.bar=gray1 on rgb230  # #100f0f on #879a39

# Command: calendar
color.calendar.due=gray1 on rgb430  # #100f0f on #d0a215
color.calendar.due.today=gray1 on rgb410  # #100f0f on #da702c
color.calendar.holiday=gray1 on rgb224  # #100f0f on #8b7ec8
color.calendar.overdue=gray1 on rgb411  # #100f0f on #d14d41
color.calendar.scheduled=gray1 on rgb024  # #100f0f on #4385be
color.calendar.today=gray1 on rgb033  # #100f0f on #3aa99f
color.calendar.weekend=gray8  # #575653
color.calendar.weeknumber=gray8  # #575653

# Command: sync
color.sync.added=rgb230  # #879a39
color.sync.changed=rgb430  # #d0a215
color.sync.rejected=rgb411  # #d14d41

# Command: undo
color.undo.after=rgb230  # #879a39
color.undo.before=rgb411  # #d14d41
