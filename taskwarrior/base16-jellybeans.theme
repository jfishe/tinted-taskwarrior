# tinted-taskwarrior
# Scheme name: Jellybeans
# Scheme author: FredHappyface (https://github.com/fredHappyface), converted to Base16 by https://github.com/nonetrix
# Scheme: base16-jellybeans (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray19  # #c5c5c5
color.label.sort=rgb345  # #b1d8f6
color.alternate=on gray14  # #929292
color.header=rgb345  # #b1d8f6
color.footnote=rgb033  # #1ab2a8
color.warning=gray1 on rgb542  # #121212 on #ffdca0
color.error=rgb533  # #ffa1a1
color.debug=rgb033  # #1ab2a8

# Task state
color.completed=gray19  # #c5c5c5
color.deleted=gray19  # #c5c5c5
color.active=gray1 on rgb343  # #121212 on #bddeab
color.recurring=rgb033  # #1ab2a8
color.scheduled=rgb345  # #b1d8f6
color.until=
color.blocked=gray19  # #c5c5c5
color.blocking=gray1 on rgb545  # #121212 on #fbdaff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #ffba7b
color.uda.priority.M=rgb542  # #ffdca0
color.uda.priority.L=rgb345  # #b1d8f6

# Tags
color.tag.next=rgb545  # #fbdaff
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ffdca0
color.due.today=rgb531  # #ffba7b
color.overdue=rgb533  # #ffa1a1

# Report: burndown
color.burndown.done=gray1 on rgb343  # #121212 on #bddeab
color.burndown.pending=gray1 on rgb533  # #121212 on #ffa1a1
color.burndown.started=gray1 on rgb542  # #121212 on #ffdca0

# Report: history
color.history.add=gray1 on rgb533  # #121212 on #ffa1a1
color.history.delete=gray1 on rgb542  # #121212 on #ffdca0
color.history.done=gray1 on rgb343  # #121212 on #bddeab

# Report: summary
color.summary.background=on gray14  # #929292
color.summary.bar=gray1 on rgb343  # #121212 on #bddeab

# Command: calendar
color.calendar.due=gray1 on rgb542  # #121212 on #ffdca0
color.calendar.due.today=gray1 on rgb531  # #121212 on #ffba7b
color.calendar.holiday=gray1 on rgb545  # #121212 on #fbdaff
color.calendar.overdue=gray1 on rgb533  # #121212 on #ffa1a1
color.calendar.scheduled=gray1 on rgb345  # #121212 on #b1d8f6
color.calendar.today=gray1 on rgb033  # #121212 on #1ab2a8
color.calendar.weekend=gray19  # #c5c5c5
color.calendar.weeknumber=gray19  # #c5c5c5

# Command: sync
color.sync.added=rgb343  # #bddeab
color.sync.changed=rgb542  # #ffdca0
color.sync.rejected=rgb533  # #ffa1a1

# Command: undo
color.undo.after=rgb343  # #bddeab
color.undo.before=rgb533  # #ffa1a1
