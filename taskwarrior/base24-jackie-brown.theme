# tinted-taskwarrior
# Scheme name: Jackie Brown
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-jackie-brown (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7c7c7c
color.label.sort=rgb013  # #246db2
color.alternate=on gray2  # #2c1d16
color.header=rgb013  # #246db2
color.footnote=rgb035  # #00acee
color.warning=gray2 on rgb105  # #2c1c15 on #0000ff
color.error=rgb500  # #ef5734
color.debug=rgb035  # #00acee

# Task state
color.completed=gray12  # #7c7c7c
color.deleted=gray12  # #7c7c7c
color.active=gray2 on rgb030  # #2c1c15 on #2baf2b
color.recurring=rgb035  # #00acee
color.scheduled=rgb013  # #246db2
color.until=
color.blocked=gray12  # #7c7c7c
color.blocking=gray2 on rgb414  # #2c1c15 on #cf5ec0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb330  # #bdbe00
color.uda.priority.M=rgb105  # #0000ff
color.uda.priority.L=rgb013  # #246db2

# Tags
color.tag.next=rgb414  # #cf5ec0
color.tag.none=
color.tagged=

# Due
color.due=rgb105  # #0000ff
color.due.today=rgb330  # #bdbe00
color.overdue=rgb500  # #ef5734

# Report: burndown
color.burndown.done=gray2 on rgb030  # #2c1c15 on #2baf2b
color.burndown.pending=gray2 on rgb500  # #2c1c15 on #ef5734
color.burndown.started=gray2 on rgb105  # #2c1c15 on #0000ff

# Report: history
color.history.add=gray2 on rgb500  # #2c1c15 on #ef5734
color.history.delete=gray2 on rgb105  # #2c1c15 on #0000ff
color.history.done=gray2 on rgb030  # #2c1c15 on #2baf2b

# Report: summary
color.summary.background=on gray2  # #2c1d16
color.summary.bar=gray2 on rgb030  # #2c1c15 on #2baf2b

# Command: calendar
color.calendar.due=gray2 on rgb105  # #2c1c15 on #0000ff
color.calendar.due.today=gray2 on rgb330  # #2c1c15 on #bdbe00
color.calendar.holiday=gray2 on rgb414  # #2c1c15 on #cf5ec0
color.calendar.overdue=gray2 on rgb500  # #2c1c15 on #ef5734
color.calendar.scheduled=gray2 on rgb013  # #2c1c15 on #246db2
color.calendar.today=gray2 on rgb035  # #2c1c15 on #00acee
color.calendar.weekend=gray12  # #7c7c7c
color.calendar.weeknumber=gray12  # #7c7c7c

# Command: sync
color.sync.added=rgb030  # #2baf2b
color.sync.changed=rgb105  # #0000ff
color.sync.rejected=rgb500  # #ef5734

# Command: undo
color.undo.after=rgb030  # #2baf2b
color.undo.before=rgb500  # #ef5734
