# tinted-taskwarrior
# Scheme name: Arthur
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-arthur (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray9  # #6e5d59
color.label.sort=rgb125  # #6495ed
color.alternate=on gray5  # #3d352a
color.header=rgb125  # #6495ed
color.footnote=rgb345  # #b0c4de
color.warning=gray2 on rgb245  # #1c1c1c on #87ceeb
color.error=rgb411  # #cd5c5c
color.debug=rgb345  # #b0c4de

# Task state
color.completed=gray9  # #6e5d59
color.deleted=gray9  # #6e5d59
color.active=gray2 on rgb232  # #1c1c1c on #86af80
color.recurring=rgb345  # #b0c4de
color.scheduled=rgb125  # #6495ed
color.until=
color.blocked=gray9  # #6e5d59
color.blocking=gray2 on rgb432  # #1c1c1c on #deb887

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb431  # #e8ae5b
color.uda.priority.M=rgb245  # #87ceeb
color.uda.priority.L=rgb125  # #6495ed

# Tags
color.tag.next=rgb432  # #deb887
color.tag.none=
color.tagged=

# Due
color.due=rgb245  # #87ceeb
color.due.today=rgb431  # #e8ae5b
color.overdue=rgb411  # #cd5c5c

# Report: burndown
color.burndown.done=gray2 on rgb232  # #1c1c1c on #86af80
color.burndown.pending=gray2 on rgb411  # #1c1c1c on #cd5c5c
color.burndown.started=gray2 on rgb245  # #1c1c1c on #87ceeb

# Report: history
color.history.add=gray2 on rgb411  # #1c1c1c on #cd5c5c
color.history.delete=gray2 on rgb245  # #1c1c1c on #87ceeb
color.history.done=gray2 on rgb232  # #1c1c1c on #86af80

# Report: summary
color.summary.background=on gray5  # #3d352a
color.summary.bar=gray2 on rgb232  # #1c1c1c on #86af80

# Command: calendar
color.calendar.due=gray2 on rgb245  # #1c1c1c on #87ceeb
color.calendar.due.today=gray2 on rgb431  # #1c1c1c on #e8ae5b
color.calendar.holiday=gray2 on rgb432  # #1c1c1c on #deb887
color.calendar.overdue=gray2 on rgb411  # #1c1c1c on #cd5c5c
color.calendar.scheduled=gray2 on rgb125  # #1c1c1c on #6495ed
color.calendar.today=gray2 on rgb345  # #1c1c1c on #b0c4de
color.calendar.weekend=gray9  # #6e5d59
color.calendar.weeknumber=gray9  # #6e5d59

# Command: sync
color.sync.added=rgb232  # #86af80
color.sync.changed=rgb245  # #87ceeb
color.sync.rejected=rgb411  # #cd5c5c

# Command: undo
color.undo.after=rgb232  # #86af80
color.undo.before=rgb411  # #cd5c5c
