# tinted-taskwarrior
# Scheme name: Zenburn
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-zenburn (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb233  # #8ba393
color.label.sort=rgb111  # #506070
color.alternate=on gray7  # #4d4d4d
color.header=rgb111  # #506070
color.footnote=rgb244  # #8cd0d3
color.warning=gray5 on rgb235  # #3f3f3f on #94bff3
color.error=rgb211  # #705050
color.debug=rgb244  # #8cd0d3

# Task state
color.completed=rgb233  # #8ba393
color.deleted=rgb233  # #8ba393
color.active=gray5 on rgb132  # #3f3f3f on #60b48a
color.recurring=rgb244  # #8cd0d3
color.scheduled=rgb111  # #506070
color.until=
color.blocked=rgb233  # #8ba393
color.blocking=gray5 on rgb423  # #3f3f3f on #dc8cc3

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb443  # #f0dfaf
color.uda.priority.M=rgb235  # #94bff3
color.uda.priority.L=rgb111  # #506070

# Tags
color.tag.next=rgb423  # #dc8cc3
color.tag.none=
color.tagged=

# Due
color.due=rgb235  # #94bff3
color.due.today=rgb443  # #f0dfaf
color.overdue=rgb211  # #705050

# Report: burndown
color.burndown.done=gray5 on rgb132  # #3f3f3f on #60b48a
color.burndown.pending=gray5 on rgb211  # #3f3f3f on #705050
color.burndown.started=gray5 on rgb235  # #3f3f3f on #94bff3

# Report: history
color.history.add=gray5 on rgb211  # #3f3f3f on #705050
color.history.delete=gray5 on rgb235  # #3f3f3f on #94bff3
color.history.done=gray5 on rgb132  # #3f3f3f on #60b48a

# Report: summary
color.summary.background=on gray7  # #4d4d4d
color.summary.bar=gray5 on rgb132  # #3f3f3f on #60b48a

# Command: calendar
color.calendar.due=gray5 on rgb235  # #3f3f3f on #94bff3
color.calendar.due.today=gray5 on rgb443  # #3f3f3f on #f0dfaf
color.calendar.holiday=gray5 on rgb423  # #3f3f3f on #dc8cc3
color.calendar.overdue=gray5 on rgb211  # #3f3f3f on #705050
color.calendar.scheduled=gray5 on rgb111  # #3f3f3f on #506070
color.calendar.today=gray5 on rgb244  # #3f3f3f on #8cd0d3
color.calendar.weekend=rgb233  # #8ba393
color.calendar.weeknumber=rgb233  # #8ba393

# Command: sync
color.sync.added=rgb132  # #60b48a
color.sync.changed=rgb235  # #94bff3
color.sync.rejected=rgb211  # #705050

# Command: undo
color.undo.after=rgb132  # #60b48a
color.undo.before=rgb211  # #705050
