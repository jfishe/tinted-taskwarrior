# tinted-taskwarrior
# Scheme name: Sagelight
# Scheme author: Carter Veldhuizen
# Scheme: base16-sagelight (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray18  # #b8b8b8
color.label.sort=rgb334  # #a0a7d2
color.alternate=on gray22  # #e8e8e8
color.header=rgb334  # #a0a7d2
color.footnote=rgb245  # #a2d6f5
color.warning=rgb555 on rgb541  # #f8f8f8 on #ffdc61
color.error=rgb522  # #fa8480
color.debug=rgb245  # #a2d6f5

# Task state
color.completed=gray18  # #b8b8b8
color.deleted=gray18  # #b8b8b8
color.active=rgb555 on rgb344  # #f8f8f8 on #a0d2c8
color.recurring=rgb245  # #a2d6f5
color.scheduled=rgb334  # #a0a7d2
color.until=
color.blocked=gray18  # #b8b8b8
color.blocking=rgb555 on rgb434  # #f8f8f8 on #c8a0d2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #ffaa61
color.uda.priority.M=rgb541  # #ffdc61
color.uda.priority.L=rgb334  # #a0a7d2

# Tags
color.tag.next=rgb434  # #c8a0d2
color.tag.none=
color.tagged=

# Due
color.due=rgb541  # #ffdc61
color.due.today=rgb531  # #ffaa61
color.overdue=rgb522  # #fa8480

# Report: burndown
color.burndown.done=rgb555 on rgb344  # #f8f8f8 on #a0d2c8
color.burndown.pending=rgb555 on rgb522  # #f8f8f8 on #fa8480
color.burndown.started=rgb555 on rgb541  # #f8f8f8 on #ffdc61

# Report: history
color.history.add=rgb555 on rgb522  # #f8f8f8 on #fa8480
color.history.delete=rgb555 on rgb541  # #f8f8f8 on #ffdc61
color.history.done=rgb555 on rgb344  # #f8f8f8 on #a0d2c8

# Report: summary
color.summary.background=on gray22  # #e8e8e8
color.summary.bar=rgb555 on rgb344  # #f8f8f8 on #a0d2c8

# Command: calendar
color.calendar.due=rgb555 on rgb541  # #f8f8f8 on #ffdc61
color.calendar.due.today=rgb555 on rgb531  # #f8f8f8 on #ffaa61
color.calendar.holiday=rgb555 on rgb434  # #f8f8f8 on #c8a0d2
color.calendar.overdue=rgb555 on rgb522  # #f8f8f8 on #fa8480
color.calendar.scheduled=rgb555 on rgb334  # #f8f8f8 on #a0a7d2
color.calendar.today=rgb555 on rgb245  # #f8f8f8 on #a2d6f5
color.calendar.weekend=gray18  # #b8b8b8
color.calendar.weeknumber=gray18  # #b8b8b8

# Command: sync
color.sync.added=rgb344  # #a0d2c8
color.sync.changed=rgb541  # #ffdc61
color.sync.rejected=rgb522  # #fa8480

# Command: undo
color.undo.after=rgb344  # #a0d2c8
color.undo.before=rgb522  # #fa8480
