# tinted-taskwarrior
# Scheme name: Lumina Cherenkov Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-cherenkov-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray3  # #142946
color.label.sort=rgb135  # #4ca1ff
color.alternate=on gray1  # #031530
color.header=rgb135  # #4ca1ff
color.footnote=rgb145  # #8fe7fd
color.warning=gray1 on rgb542  # #021129 on #ead293
color.error=rgb411  # #db6c64
color.debug=rgb145  # #8fe7fd

# Task state
color.completed=gray3  # #142946
color.deleted=gray3  # #142946
color.active=gray1 on rgb343  # #021129 on #9ad8a6
color.recurring=rgb145  # #8fe7fd
color.scheduled=rgb135  # #4ca1ff
color.until=
color.blocked=gray3  # #142946
color.blocking=gray1 on rgb435  # #021129 on #c7aefe

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #fba26f
color.uda.priority.M=rgb542  # #ead293
color.uda.priority.L=rgb135  # #4ca1ff

# Tags
color.tag.next=rgb435  # #c7aefe
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ead293
color.due.today=rgb532  # #fba26f
color.overdue=rgb411  # #db6c64

# Report: burndown
color.burndown.done=gray1 on rgb343  # #021129 on #9ad8a6
color.burndown.pending=gray1 on rgb411  # #021129 on #db6c64
color.burndown.started=gray1 on rgb542  # #021129 on #ead293

# Report: history
color.history.add=gray1 on rgb411  # #021129 on #db6c64
color.history.delete=gray1 on rgb542  # #021129 on #ead293
color.history.done=gray1 on rgb343  # #021129 on #9ad8a6

# Report: summary
color.summary.background=on gray1  # #031530
color.summary.bar=gray1 on rgb343  # #021129 on #9ad8a6

# Command: calendar
color.calendar.due=gray1 on rgb542  # #021129 on #ead293
color.calendar.due.today=gray1 on rgb532  # #021129 on #fba26f
color.calendar.holiday=gray1 on rgb435  # #021129 on #c7aefe
color.calendar.overdue=gray1 on rgb411  # #021129 on #db6c64
color.calendar.scheduled=gray1 on rgb135  # #021129 on #4ca1ff
color.calendar.today=gray1 on rgb145  # #021129 on #8fe7fd
color.calendar.weekend=gray3  # #142946
color.calendar.weeknumber=gray3  # #142946

# Command: sync
color.sync.added=rgb343  # #9ad8a6
color.sync.changed=rgb542  # #ead293
color.sync.rejected=rgb411  # #db6c64

# Command: undo
color.undo.after=rgb343  # #9ad8a6
color.undo.before=rgb411  # #db6c64
