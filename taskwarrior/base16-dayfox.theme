# tinted-taskwarrior
# Scheme name: dayfox
# Scheme author: EdenEast (https://github.com/EdenEast)
# Scheme: base16-dayfox (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #534c45
color.label.sort=rgb014  # #2848a9
color.alternate=on rgb444  # #dbd1dd
color.header=rgb014  # #2848a9
color.footnote=rgb022  # #287980
color.warning=gray23 on rgb310  # #f6f2ee on #ac5402
color.error=rgb300  # #a5222f
color.debug=rgb022  # #287980

# Task state
color.completed=gray7  # #534c45
color.deleted=gray7  # #534c45
color.active=gray23 on rgb021  # #f6f2ee on #396847
color.recurring=rgb022  # #287980
color.scheduled=rgb014  # #2848a9
color.until=
color.blocked=gray7  # #534c45
color.blocking=gray23 on rgb204  # #f6f2ee on #6e33ce

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb211  # #955f61
color.uda.priority.M=rgb310  # #ac5402
color.uda.priority.L=rgb014  # #2848a9

# Tags
color.tag.next=rgb204  # #6e33ce
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #ac5402
color.due.today=rgb211  # #955f61
color.overdue=rgb300  # #a5222f

# Report: burndown
color.burndown.done=gray23 on rgb021  # #f6f2ee on #396847
color.burndown.pending=gray23 on rgb300  # #f6f2ee on #a5222f
color.burndown.started=gray23 on rgb310  # #f6f2ee on #ac5402

# Report: history
color.history.add=gray23 on rgb300  # #f6f2ee on #a5222f
color.history.delete=gray23 on rgb310  # #f6f2ee on #ac5402
color.history.done=gray23 on rgb021  # #f6f2ee on #396847

# Report: summary
color.summary.background=on rgb444  # #dbd1dd
color.summary.bar=gray23 on rgb021  # #f6f2ee on #396847

# Command: calendar
color.calendar.due=gray23 on rgb310  # #f6f2ee on #ac5402
color.calendar.due.today=gray23 on rgb211  # #f6f2ee on #955f61
color.calendar.holiday=gray23 on rgb204  # #f6f2ee on #6e33ce
color.calendar.overdue=gray23 on rgb300  # #f6f2ee on #a5222f
color.calendar.scheduled=gray23 on rgb014  # #f6f2ee on #2848a9
color.calendar.today=gray23 on rgb022  # #f6f2ee on #287980
color.calendar.weekend=gray7  # #534c45
color.calendar.weeknumber=gray7  # #534c45

# Command: sync
color.sync.added=rgb021  # #396847
color.sync.changed=rgb310  # #ac5402
color.sync.rejected=rgb300  # #a5222f

# Command: undo
color.undo.after=rgb021  # #396847
color.undo.before=rgb300  # #a5222f
