# tinted-taskwarrior
# Scheme name: Everforest Dark Soft
# Scheme author: Sainnhe Park (https://github.com/sainnhe)
# Scheme: base16-everforest-dark-soft (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray13  # #859289
color.label.sort=rgb133  # #7fbbb3
color.alternate=on gray6  # #3a464c
color.header=rgb133  # #7fbbb3
color.footnote=rgb232  # #83c092
color.warning=gray5 on rgb431  # #333c43 on #dbbc7f
color.error=rgb422  # #e67e80
color.debug=rgb232  # #83c092

# Task state
color.completed=gray13  # #859289
color.deleted=gray13  # #859289
color.active=gray5 on rgb342  # #333c43 on #a7c080
color.recurring=rgb232  # #83c092
color.scheduled=rgb133  # #7fbbb3
color.until=
color.blocked=gray13  # #859289
color.blocking=gray5 on rgb423  # #333c43 on #d699b6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #e69875
color.uda.priority.M=rgb431  # #dbbc7f
color.uda.priority.L=rgb133  # #7fbbb3

# Tags
color.tag.next=rgb423  # #d699b6
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #dbbc7f
color.due.today=rgb421  # #e69875
color.overdue=rgb422  # #e67e80

# Report: burndown
color.burndown.done=gray5 on rgb342  # #333c43 on #a7c080
color.burndown.pending=gray5 on rgb422  # #333c43 on #e67e80
color.burndown.started=gray5 on rgb431  # #333c43 on #dbbc7f

# Report: history
color.history.add=gray5 on rgb422  # #333c43 on #e67e80
color.history.delete=gray5 on rgb431  # #333c43 on #dbbc7f
color.history.done=gray5 on rgb342  # #333c43 on #a7c080

# Report: summary
color.summary.background=on gray6  # #3a464c
color.summary.bar=gray5 on rgb342  # #333c43 on #a7c080

# Command: calendar
color.calendar.due=gray5 on rgb431  # #333c43 on #dbbc7f
color.calendar.due.today=gray5 on rgb421  # #333c43 on #e69875
color.calendar.holiday=gray5 on rgb423  # #333c43 on #d699b6
color.calendar.overdue=gray5 on rgb422  # #333c43 on #e67e80
color.calendar.scheduled=gray5 on rgb133  # #333c43 on #7fbbb3
color.calendar.today=gray5 on rgb232  # #333c43 on #83c092
color.calendar.weekend=gray13  # #859289
color.calendar.weeknumber=gray13  # #859289

# Command: sync
color.sync.added=rgb342  # #a7c080
color.sync.changed=rgb431  # #dbbc7f
color.sync.rejected=rgb422  # #e67e80

# Command: undo
color.undo.after=rgb342  # #a7c080
color.undo.before=rgb422  # #e67e80
