# tinted-taskwarrior
# Scheme name: Darktooth
# Scheme author: Jason Milkins (https://github.com/jasonm23)
# Scheme: base16-darktooth (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb111  # #665c54
color.label.sort=rgb011  # #0d6678
color.alternate=on gray4  # #32302f
color.header=rgb011  # #0d6678
color.footnote=rgb233  # #8ba59b
color.warning=gray2 on rgb530  # #1d2021 on #fac03b
color.error=rgb511  # #fb543f
color.debug=rgb233  # #8ba59b

# Task state
color.completed=rgb111  # #665c54
color.deleted=rgb111  # #665c54
color.active=gray2 on rgb232  # #1d2021 on #95c085
color.recurring=rgb233  # #8ba59b
color.scheduled=rgb011  # #0d6678
color.until=
color.blocked=rgb111  # #665c54
color.blocking=gray2 on rgb212  # #1d2021 on #8f4673

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #fe8625
color.uda.priority.M=rgb530  # #fac03b
color.uda.priority.L=rgb011  # #0d6678

# Tags
color.tag.next=rgb212  # #8f4673
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #fac03b
color.due.today=rgb520  # #fe8625
color.overdue=rgb511  # #fb543f

# Report: burndown
color.burndown.done=gray2 on rgb232  # #1d2021 on #95c085
color.burndown.pending=gray2 on rgb511  # #1d2021 on #fb543f
color.burndown.started=gray2 on rgb530  # #1d2021 on #fac03b

# Report: history
color.history.add=gray2 on rgb511  # #1d2021 on #fb543f
color.history.delete=gray2 on rgb530  # #1d2021 on #fac03b
color.history.done=gray2 on rgb232  # #1d2021 on #95c085

# Report: summary
color.summary.background=on gray4  # #32302f
color.summary.bar=gray2 on rgb232  # #1d2021 on #95c085

# Command: calendar
color.calendar.due=gray2 on rgb530  # #1d2021 on #fac03b
color.calendar.due.today=gray2 on rgb520  # #1d2021 on #fe8625
color.calendar.holiday=gray2 on rgb212  # #1d2021 on #8f4673
color.calendar.overdue=gray2 on rgb511  # #1d2021 on #fb543f
color.calendar.scheduled=gray2 on rgb011  # #1d2021 on #0d6678
color.calendar.today=gray2 on rgb233  # #1d2021 on #8ba59b
color.calendar.weekend=rgb111  # #665c54
color.calendar.weeknumber=rgb111  # #665c54

# Command: sync
color.sync.added=rgb232  # #95c085
color.sync.changed=rgb530  # #fac03b
color.sync.rejected=rgb511  # #fb543f

# Command: undo
color.undo.after=rgb232  # #95c085
color.undo.before=rgb511  # #fb543f
