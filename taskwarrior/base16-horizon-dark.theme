# tinted-taskwarrior
# Scheme name: Horizon Dark
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Scheme: base16-horizon-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6f6f70
color.label.sort=rgb412  # #df5273
color.alternate=on gray3  # #232530
color.header=rgb412  # #df5273
color.footnote=rgb033  # #24a8b4
color.warning=gray2 on rgb432  # #1c1e26 on #efb993
color.error=rgb501  # #e93c58
color.debug=rgb033  # #24a8b4

# Task state
color.completed=gray10  # #6f6f70
color.deleted=gray10  # #6f6f70
color.active=gray2 on rgb532  # #1c1e26 on #efaf8e
color.recurring=rgb033  # #24a8b4
color.scheduled=rgb412  # #df5273
color.until=
color.blocked=gray10  # #6f6f70
color.blocking=gray2 on rgb314  # #1c1e26 on #b072d1

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb422  # #e58d7d
color.uda.priority.M=rgb432  # #efb993
color.uda.priority.L=rgb412  # #df5273

# Tags
color.tag.next=rgb314  # #b072d1
color.tag.none=
color.tagged=

# Due
color.due=rgb432  # #efb993
color.due.today=rgb422  # #e58d7d
color.overdue=rgb501  # #e93c58

# Report: burndown
color.burndown.done=gray2 on rgb532  # #1c1e26 on #efaf8e
color.burndown.pending=gray2 on rgb501  # #1c1e26 on #e93c58
color.burndown.started=gray2 on rgb432  # #1c1e26 on #efb993

# Report: history
color.history.add=gray2 on rgb501  # #1c1e26 on #e93c58
color.history.delete=gray2 on rgb432  # #1c1e26 on #efb993
color.history.done=gray2 on rgb532  # #1c1e26 on #efaf8e

# Report: summary
color.summary.background=on gray3  # #232530
color.summary.bar=gray2 on rgb532  # #1c1e26 on #efaf8e

# Command: calendar
color.calendar.due=gray2 on rgb432  # #1c1e26 on #efb993
color.calendar.due.today=gray2 on rgb422  # #1c1e26 on #e58d7d
color.calendar.holiday=gray2 on rgb314  # #1c1e26 on #b072d1
color.calendar.overdue=gray2 on rgb501  # #1c1e26 on #e93c58
color.calendar.scheduled=gray2 on rgb412  # #1c1e26 on #df5273
color.calendar.today=gray2 on rgb033  # #1c1e26 on #24a8b4
color.calendar.weekend=gray10  # #6f6f70
color.calendar.weeknumber=gray10  # #6f6f70

# Command: sync
color.sync.added=rgb532  # #efaf8e
color.sync.changed=rgb432  # #efb993
color.sync.rejected=rgb501  # #e93c58

# Command: undo
color.undo.after=rgb532  # #efaf8e
color.undo.before=rgb501  # #e93c58
