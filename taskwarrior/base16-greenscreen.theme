# tinted-taskwarrior
# Scheme name: Green Screen
# Scheme author: Chris Kempson (http://chriskempson.com)
# Scheme: base16-greenscreen (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb020  # #007700
color.label.sort=rgb020  # #009900
color.alternate=on rgb010  # #003300
color.header=rgb020  # #009900
color.footnote=rgb010  # #005500
color.warning=gray0 on rgb020  # #001100 on #007700
color.error=rgb020  # #007700
color.debug=rgb010  # #005500

# Task state
color.completed=rgb020  # #007700
color.deleted=rgb020  # #007700
color.active=gray0 on rgb030  # #001100 on #00bb00
color.recurring=rgb010  # #005500
color.scheduled=rgb020  # #009900
color.until=
color.blocked=rgb020  # #007700
color.blocking=gray0 on rgb030  # #001100 on #00bb00

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb020  # #009900
color.uda.priority.M=rgb020  # #007700
color.uda.priority.L=rgb020  # #009900

# Tags
color.tag.next=rgb030  # #00bb00
color.tag.none=
color.tagged=

# Due
color.due=rgb020  # #007700
color.due.today=rgb020  # #009900
color.overdue=rgb020  # #007700

# Report: burndown
color.burndown.done=gray0 on rgb030  # #001100 on #00bb00
color.burndown.pending=gray0 on rgb020  # #001100 on #007700
color.burndown.started=gray0 on rgb020  # #001100 on #007700

# Report: history
color.history.add=gray0 on rgb020  # #001100 on #007700
color.history.delete=gray0 on rgb020  # #001100 on #007700
color.history.done=gray0 on rgb030  # #001100 on #00bb00

# Report: summary
color.summary.background=on rgb010  # #003300
color.summary.bar=gray0 on rgb030  # #001100 on #00bb00

# Command: calendar
color.calendar.due=gray0 on rgb020  # #001100 on #007700
color.calendar.due.today=gray0 on rgb020  # #001100 on #009900
color.calendar.holiday=gray0 on rgb030  # #001100 on #00bb00
color.calendar.overdue=gray0 on rgb020  # #001100 on #007700
color.calendar.scheduled=gray0 on rgb020  # #001100 on #009900
color.calendar.today=gray0 on rgb010  # #001100 on #005500
color.calendar.weekend=rgb020  # #007700
color.calendar.weeknumber=rgb020  # #007700

# Command: sync
color.sync.added=rgb030  # #00bb00
color.sync.changed=rgb020  # #007700
color.sync.rejected=rgb020  # #007700

# Command: undo
color.undo.after=rgb030  # #00bb00
color.undo.before=rgb020  # #007700
