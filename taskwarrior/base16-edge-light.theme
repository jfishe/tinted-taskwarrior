# tinted-taskwarrior
# Scheme name: Edge Light
# Scheme author: cjayross (https://github.com/cjayross), Tinted Theming (https://github.com/tinted-theming)
# Scheme: base16-edge-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray14  # #9197a1
color.label.sort=rgb124  # #6587bf
color.alternate=on gray22  # #e3e5e8
color.header=rgb124  # #6587bf
color.footnote=rgb133  # #509c93
color.warning=rgb555 on rgb540  # #fafafa on #ebcc1a
color.error=rgb411  # #db7070
color.debug=rgb133  # #509c93

# Task state
color.completed=gray14  # #9197a1
color.deleted=gray14  # #9197a1
color.active=rgb555 on rgb231  # #fafafa on #7c9f4b
color.recurring=rgb133  # #509c93
color.scheduled=rgb124  # #6587bf
color.until=
color.blocked=gray14  # #9197a1
color.blocking=rgb555 on rgb314  # #fafafa on #b870ce

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #eba31a
color.uda.priority.M=rgb540  # #ebcc1a
color.uda.priority.L=rgb124  # #6587bf

# Tags
color.tag.next=rgb314  # #b870ce
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #ebcc1a
color.due.today=rgb530  # #eba31a
color.overdue=rgb411  # #db7070

# Report: burndown
color.burndown.done=rgb555 on rgb231  # #fafafa on #7c9f4b
color.burndown.pending=rgb555 on rgb411  # #fafafa on #db7070
color.burndown.started=rgb555 on rgb540  # #fafafa on #ebcc1a

# Report: history
color.history.add=rgb555 on rgb411  # #fafafa on #db7070
color.history.delete=rgb555 on rgb540  # #fafafa on #ebcc1a
color.history.done=rgb555 on rgb231  # #fafafa on #7c9f4b

# Report: summary
color.summary.background=on gray22  # #e3e5e8
color.summary.bar=rgb555 on rgb231  # #fafafa on #7c9f4b

# Command: calendar
color.calendar.due=rgb555 on rgb540  # #fafafa on #ebcc1a
color.calendar.due.today=rgb555 on rgb530  # #fafafa on #eba31a
color.calendar.holiday=rgb555 on rgb314  # #fafafa on #b870ce
color.calendar.overdue=rgb555 on rgb411  # #fafafa on #db7070
color.calendar.scheduled=rgb555 on rgb124  # #fafafa on #6587bf
color.calendar.today=rgb555 on rgb133  # #fafafa on #509c93
color.calendar.weekend=gray14  # #9197a1
color.calendar.weeknumber=gray14  # #9197a1

# Command: sync
color.sync.added=rgb231  # #7c9f4b
color.sync.changed=rgb540  # #ebcc1a
color.sync.rejected=rgb411  # #db7070

# Command: undo
color.undo.after=rgb231  # #7c9f4b
color.undo.before=rgb411  # #db7070
