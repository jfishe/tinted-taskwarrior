# tinted-taskwarrior
# Scheme name: Lumina Polaire Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-polaire-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray4  # #25323b
color.label.sort=rgb345  # #aeccf2
color.alternate=on gray2  # #121f27
color.header=rgb345  # #aeccf2
color.footnote=rgb245  # #8cd9f4
color.warning=gray2 on rgb542  # #0f1a21 on #e2c682
color.error=rgb422  # #cd776f
color.debug=rgb245  # #8cd9f4

# Task state
color.completed=gray4  # #25323b
color.deleted=gray4  # #25323b
color.active=gray2 on rgb343  # #0f1a21 on #a9d6b1
color.recurring=rgb245  # #8cd9f4
color.scheduled=rgb345  # #aeccf2
color.until=
color.blocked=gray4  # #25323b
color.blocking=gray2 on rgb335  # #0f1a21 on #bfbaf7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb543  # #f4c59d
color.uda.priority.M=rgb542  # #e2c682
color.uda.priority.L=rgb345  # #aeccf2

# Tags
color.tag.next=rgb335  # #bfbaf7
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #e2c682
color.due.today=rgb543  # #f4c59d
color.overdue=rgb422  # #cd776f

# Report: burndown
color.burndown.done=gray2 on rgb343  # #0f1a21 on #a9d6b1
color.burndown.pending=gray2 on rgb422  # #0f1a21 on #cd776f
color.burndown.started=gray2 on rgb542  # #0f1a21 on #e2c682

# Report: history
color.history.add=gray2 on rgb422  # #0f1a21 on #cd776f
color.history.delete=gray2 on rgb542  # #0f1a21 on #e2c682
color.history.done=gray2 on rgb343  # #0f1a21 on #a9d6b1

# Report: summary
color.summary.background=on gray2  # #121f27
color.summary.bar=gray2 on rgb343  # #0f1a21 on #a9d6b1

# Command: calendar
color.calendar.due=gray2 on rgb542  # #0f1a21 on #e2c682
color.calendar.due.today=gray2 on rgb543  # #0f1a21 on #f4c59d
color.calendar.holiday=gray2 on rgb335  # #0f1a21 on #bfbaf7
color.calendar.overdue=gray2 on rgb422  # #0f1a21 on #cd776f
color.calendar.scheduled=gray2 on rgb345  # #0f1a21 on #aeccf2
color.calendar.today=gray2 on rgb245  # #0f1a21 on #8cd9f4
color.calendar.weekend=gray4  # #25323b
color.calendar.weeknumber=gray4  # #25323b

# Command: sync
color.sync.added=rgb343  # #a9d6b1
color.sync.changed=rgb542  # #e2c682
color.sync.rejected=rgb422  # #cd776f

# Command: undo
color.undo.after=rgb343  # #a9d6b1
color.undo.before=rgb422  # #cd776f
