# tinted-taskwarrior
# Scheme name: Ashes
# Scheme author: Jannik Siebert (https://github.com/janniks)
# Scheme: base16-ashes (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #747c84
color.label.sort=rgb323  # #ae95c7
color.alternate=on gray5  # #393f45
color.header=rgb323  # #ae95c7
color.footnote=rgb234  # #95aec7
color.warning=gray2 on rgb343  # #1c2023 on #aec795
color.error=rgb432  # #c7ae95
color.debug=rgb234  # #95aec7

# Task state
color.completed=gray12  # #747c84
color.deleted=gray12  # #747c84
color.active=gray2 on rgb243  # #1c2023 on #95c7ae
color.recurring=rgb234  # #95aec7
color.scheduled=rgb323  # #ae95c7
color.until=
color.blocked=gray12  # #747c84
color.blocking=gray2 on rgb423  # #1c2023 on #c795ae

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb443  # #c7c795
color.uda.priority.M=rgb343  # #aec795
color.uda.priority.L=rgb323  # #ae95c7

# Tags
color.tag.next=rgb423  # #c795ae
color.tag.none=
color.tagged=

# Due
color.due=rgb343  # #aec795
color.due.today=rgb443  # #c7c795
color.overdue=rgb432  # #c7ae95

# Report: burndown
color.burndown.done=gray2 on rgb243  # #1c2023 on #95c7ae
color.burndown.pending=gray2 on rgb432  # #1c2023 on #c7ae95
color.burndown.started=gray2 on rgb343  # #1c2023 on #aec795

# Report: history
color.history.add=gray2 on rgb432  # #1c2023 on #c7ae95
color.history.delete=gray2 on rgb343  # #1c2023 on #aec795
color.history.done=gray2 on rgb243  # #1c2023 on #95c7ae

# Report: summary
color.summary.background=on gray5  # #393f45
color.summary.bar=gray2 on rgb243  # #1c2023 on #95c7ae

# Command: calendar
color.calendar.due=gray2 on rgb343  # #1c2023 on #aec795
color.calendar.due.today=gray2 on rgb443  # #1c2023 on #c7c795
color.calendar.holiday=gray2 on rgb423  # #1c2023 on #c795ae
color.calendar.overdue=gray2 on rgb432  # #1c2023 on #c7ae95
color.calendar.scheduled=gray2 on rgb323  # #1c2023 on #ae95c7
color.calendar.today=gray2 on rgb234  # #1c2023 on #95aec7
color.calendar.weekend=gray12  # #747c84
color.calendar.weeknumber=gray12  # #747c84

# Command: sync
color.sync.added=rgb243  # #95c7ae
color.sync.changed=rgb343  # #aec795
color.sync.rejected=rgb432  # #c7ae95

# Command: undo
color.undo.after=rgb243  # #95c7ae
color.undo.before=rgb432  # #c7ae95
