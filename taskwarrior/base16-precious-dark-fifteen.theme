# tinted-taskwarrior
# Scheme name: Precious Dark Fifteen
# Scheme author: 4lex4 &lt;4lex49@zoho.com&gt;
# Scheme: base16-precious-dark-fifteen (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray13  # #898989
color.label.sort=rgb135  # #66b0ef
color.alternate=on gray4  # #303337
color.header=rgb135  # #66b0ef
color.footnote=rgb032  # #42bda7
color.warning=gray3 on rgb431  # #23262b on #cfa546
color.error=rgb522  # #ff8782
color.debug=rgb032  # #42bda7

# Task state
color.completed=gray13  # #898989
color.deleted=gray13  # #898989
color.active=gray3 on rgb231  # #23262b on #95b659
color.recurring=rgb032  # #42bda7
color.scheduled=rgb135  # #66b0ef
color.until=
color.blocked=gray13  # #898989
color.blocking=gray3 on rgb325  # #23262b on #b799ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #e99857
color.uda.priority.M=rgb431  # #cfa546
color.uda.priority.L=rgb135  # #66b0ef

# Tags
color.tag.next=rgb325  # #b799ff
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #cfa546
color.due.today=rgb531  # #e99857
color.overdue=rgb522  # #ff8782

# Report: burndown
color.burndown.done=gray3 on rgb231  # #23262b on #95b659
color.burndown.pending=gray3 on rgb522  # #23262b on #ff8782
color.burndown.started=gray3 on rgb431  # #23262b on #cfa546

# Report: history
color.history.add=gray3 on rgb522  # #23262b on #ff8782
color.history.delete=gray3 on rgb431  # #23262b on #cfa546
color.history.done=gray3 on rgb231  # #23262b on #95b659

# Report: summary
color.summary.background=on gray4  # #303337
color.summary.bar=gray3 on rgb231  # #23262b on #95b659

# Command: calendar
color.calendar.due=gray3 on rgb431  # #23262b on #cfa546
color.calendar.due.today=gray3 on rgb531  # #23262b on #e99857
color.calendar.holiday=gray3 on rgb325  # #23262b on #b799ff
color.calendar.overdue=gray3 on rgb522  # #23262b on #ff8782
color.calendar.scheduled=gray3 on rgb135  # #23262b on #66b0ef
color.calendar.today=gray3 on rgb032  # #23262b on #42bda7
color.calendar.weekend=gray13  # #898989
color.calendar.weeknumber=gray13  # #898989

# Command: sync
color.sync.added=rgb231  # #95b659
color.sync.changed=rgb431  # #cfa546
color.sync.rejected=rgb522  # #ff8782

# Command: undo
color.undo.after=rgb231  # #95b659
color.undo.before=rgb522  # #ff8782
