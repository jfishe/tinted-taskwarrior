# tinted-taskwarrior
# Scheme name: Zenburn
# Scheme author: elnawe
# Scheme: base16-zenburn (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6f6f6f
color.label.sort=rgb233  # #7cb8bb
color.alternate=on gray6  # #404040
color.header=rgb233  # #7cb8bb
color.footnote=rgb244  # #93e0e3
color.warning=gray5 on rgb443  # #383838 on #e0cf9f
color.error=rgb433  # #dca3a3
color.debug=rgb244  # #93e0e3

# Task state
color.completed=gray10  # #6f6f6f
color.deleted=gray10  # #6f6f6f
color.active=gray5 on rgb121  # #383838 on #5f7f5f
color.recurring=rgb244  # #93e0e3
color.scheduled=rgb233  # #7cb8bb
color.until=
color.blocked=gray10  # #6f6f6f
color.blocking=gray5 on rgb423  # #383838 on #dc8cc3

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb432  # #dfaf8f
color.uda.priority.M=rgb443  # #e0cf9f
color.uda.priority.L=rgb233  # #7cb8bb

# Tags
color.tag.next=rgb423  # #dc8cc3
color.tag.none=
color.tagged=

# Due
color.due=rgb443  # #e0cf9f
color.due.today=rgb432  # #dfaf8f
color.overdue=rgb433  # #dca3a3

# Report: burndown
color.burndown.done=gray5 on rgb121  # #383838 on #5f7f5f
color.burndown.pending=gray5 on rgb433  # #383838 on #dca3a3
color.burndown.started=gray5 on rgb443  # #383838 on #e0cf9f

# Report: history
color.history.add=gray5 on rgb433  # #383838 on #dca3a3
color.history.delete=gray5 on rgb443  # #383838 on #e0cf9f
color.history.done=gray5 on rgb121  # #383838 on #5f7f5f

# Report: summary
color.summary.background=on gray6  # #404040
color.summary.bar=gray5 on rgb121  # #383838 on #5f7f5f

# Command: calendar
color.calendar.due=gray5 on rgb443  # #383838 on #e0cf9f
color.calendar.due.today=gray5 on rgb432  # #383838 on #dfaf8f
color.calendar.holiday=gray5 on rgb423  # #383838 on #dc8cc3
color.calendar.overdue=gray5 on rgb433  # #383838 on #dca3a3
color.calendar.scheduled=gray5 on rgb233  # #383838 on #7cb8bb
color.calendar.today=gray5 on rgb244  # #383838 on #93e0e3
color.calendar.weekend=gray10  # #6f6f6f
color.calendar.weeknumber=gray10  # #6f6f6f

# Command: sync
color.sync.added=rgb121  # #5f7f5f
color.sync.changed=rgb443  # #e0cf9f
color.sync.rejected=rgb433  # #dca3a3

# Command: undo
color.undo.after=rgb121  # #5f7f5f
color.undo.before=rgb433  # #dca3a3
