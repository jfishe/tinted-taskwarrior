# tinted-taskwarrior
# Scheme name: Tokyo Night Storm
# Scheme author: Michaël Ball, based on Tokyo Night by enkia (https://github.com/enkia/tokyo-night-vscode-theme)
# Scheme: base24-tokyo-night-storm (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #444b6a
color.label.sort=rgb045  # #2ac3de
color.alternate=on gray1  # #16161e
color.header=rgb045  # #2ac3de
color.footnote=rgb355  # #b4f9f8
color.warning=gray3 on rgb034  # #24283b on #0db9d7
color.error=rgb445  # #c0caf5
color.debug=rgb355  # #b4f9f8

# Task state
color.completed=rgb112  # #444b6a
color.deleted=rgb112  # #444b6a
color.active=gray3 on rgb342  # #24283b on #9ece6a
color.recurring=rgb355  # #b4f9f8
color.scheduled=rgb045  # #2ac3de
color.until=
color.blocked=rgb112  # #444b6a
color.blocking=gray3 on rgb325  # #24283b on #bb9af7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb334  # #a9b1d6
color.uda.priority.M=rgb034  # #0db9d7
color.uda.priority.L=rgb045  # #2ac3de

# Tags
color.tag.next=rgb325  # #bb9af7
color.tag.none=
color.tagged=

# Due
color.due=rgb034  # #0db9d7
color.due.today=rgb334  # #a9b1d6
color.overdue=rgb445  # #c0caf5

# Report: burndown
color.burndown.done=gray3 on rgb342  # #24283b on #9ece6a
color.burndown.pending=gray3 on rgb445  # #24283b on #c0caf5
color.burndown.started=gray3 on rgb034  # #24283b on #0db9d7

# Report: history
color.history.add=gray3 on rgb445  # #24283b on #c0caf5
color.history.delete=gray3 on rgb034  # #24283b on #0db9d7
color.history.done=gray3 on rgb342  # #24283b on #9ece6a

# Report: summary
color.summary.background=on gray1  # #16161e
color.summary.bar=gray3 on rgb342  # #24283b on #9ece6a

# Command: calendar
color.calendar.due=gray3 on rgb034  # #24283b on #0db9d7
color.calendar.due.today=gray3 on rgb334  # #24283b on #a9b1d6
color.calendar.holiday=gray3 on rgb325  # #24283b on #bb9af7
color.calendar.overdue=gray3 on rgb445  # #24283b on #c0caf5
color.calendar.scheduled=gray3 on rgb045  # #24283b on #2ac3de
color.calendar.today=gray3 on rgb355  # #24283b on #b4f9f8
color.calendar.weekend=rgb112  # #444b6a
color.calendar.weeknumber=rgb112  # #444b6a

# Command: sync
color.sync.added=rgb342  # #9ece6a
color.sync.changed=rgb034  # #0db9d7
color.sync.rejected=rgb445  # #c0caf5

# Command: undo
color.undo.after=rgb342  # #9ece6a
color.undo.before=rgb445  # #c0caf5
