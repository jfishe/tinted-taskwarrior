# tinted-taskwarrior
# Scheme name: Porple
# Scheme author: Niek den Breeje (https://github.com/AuditeMarlow)
# Scheme: base16-porple (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #65568a
color.label.sort=rgb224  # #8485ce
color.alternate=on gray4  # #333344
color.header=rgb224  # #8485ce
color.footnote=rgb122  # #64878f
color.warning=gray4 on rgb532  # #292c36 on #efa16b
color.error=rgb511  # #f84547
color.debug=rgb122  # #64878f

# Task state
color.completed=rgb112  # #65568a
color.deleted=rgb112  # #65568a
color.active=gray4 on rgb342  # #292c36 on #95c76f
color.recurring=rgb122  # #64878f
color.scheduled=rgb224  # #8485ce
color.until=
color.blocked=rgb112  # #65568a
color.blocking=gray4 on rgb312  # #292c36 on #b74989

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #d28e5d
color.uda.priority.M=rgb532  # #efa16b
color.uda.priority.L=rgb224  # #8485ce

# Tags
color.tag.next=rgb312  # #b74989
color.tag.none=
color.tagged=

# Due
color.due=rgb532  # #efa16b
color.due.today=rgb421  # #d28e5d
color.overdue=rgb511  # #f84547

# Report: burndown
color.burndown.done=gray4 on rgb342  # #292c36 on #95c76f
color.burndown.pending=gray4 on rgb511  # #292c36 on #f84547
color.burndown.started=gray4 on rgb532  # #292c36 on #efa16b

# Report: history
color.history.add=gray4 on rgb511  # #292c36 on #f84547
color.history.delete=gray4 on rgb532  # #292c36 on #efa16b
color.history.done=gray4 on rgb342  # #292c36 on #95c76f

# Report: summary
color.summary.background=on gray4  # #333344
color.summary.bar=gray4 on rgb342  # #292c36 on #95c76f

# Command: calendar
color.calendar.due=gray4 on rgb532  # #292c36 on #efa16b
color.calendar.due.today=gray4 on rgb421  # #292c36 on #d28e5d
color.calendar.holiday=gray4 on rgb312  # #292c36 on #b74989
color.calendar.overdue=gray4 on rgb511  # #292c36 on #f84547
color.calendar.scheduled=gray4 on rgb224  # #292c36 on #8485ce
color.calendar.today=gray4 on rgb122  # #292c36 on #64878f
color.calendar.weekend=rgb112  # #65568a
color.calendar.weeknumber=rgb112  # #65568a

# Command: sync
color.sync.added=rgb342  # #95c76f
color.sync.changed=rgb532  # #efa16b
color.sync.rejected=rgb511  # #f84547

# Command: undo
color.undo.after=rgb342  # #95c76f
color.undo.before=rgb511  # #f84547
