# tinted-taskwarrior
# Scheme name: Stranger Theme The Lab
# Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
# Scheme: base24-stranger-theme-the-lab (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb123  # #73879c
color.label.sort=rgb304  # #b10dc9
color.alternate=on gray4  # #2e313a
color.header=rgb304  # #b10dc9
color.footnote=rgb044  # #39cccc
color.warning=gray2 on rgb540  # #1a1d26 on #ffdc00
color.error=rgb500  # #ff4136
color.debug=rgb044  # #39cccc

# Task state
color.completed=rgb123  # #73879c
color.deleted=rgb123  # #73879c
color.active=gray2 on rgb041  # #1a1d26 on #2ecc40
color.recurring=rgb044  # #39cccc
color.scheduled=rgb304  # #b10dc9
color.until=
color.blocked=rgb123  # #73879c
color.blocking=gray2 on rgb245  # #1a1d26 on #7fdbff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #ff851b
color.uda.priority.M=rgb540  # #ffdc00
color.uda.priority.L=rgb304  # #b10dc9

# Tags
color.tag.next=rgb245  # #7fdbff
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #ffdc00
color.due.today=rgb520  # #ff851b
color.overdue=rgb500  # #ff4136

# Report: burndown
color.burndown.done=gray2 on rgb041  # #1a1d26 on #2ecc40
color.burndown.pending=gray2 on rgb500  # #1a1d26 on #ff4136
color.burndown.started=gray2 on rgb540  # #1a1d26 on #ffdc00

# Report: history
color.history.add=gray2 on rgb500  # #1a1d26 on #ff4136
color.history.delete=gray2 on rgb540  # #1a1d26 on #ffdc00
color.history.done=gray2 on rgb041  # #1a1d26 on #2ecc40

# Report: summary
color.summary.background=on gray4  # #2e313a
color.summary.bar=gray2 on rgb041  # #1a1d26 on #2ecc40

# Command: calendar
color.calendar.due=gray2 on rgb540  # #1a1d26 on #ffdc00
color.calendar.due.today=gray2 on rgb520  # #1a1d26 on #ff851b
color.calendar.holiday=gray2 on rgb245  # #1a1d26 on #7fdbff
color.calendar.overdue=gray2 on rgb500  # #1a1d26 on #ff4136
color.calendar.scheduled=gray2 on rgb304  # #1a1d26 on #b10dc9
color.calendar.today=gray2 on rgb044  # #1a1d26 on #39cccc
color.calendar.weekend=rgb123  # #73879c
color.calendar.weeknumber=rgb123  # #73879c

# Command: sync
color.sync.added=rgb041  # #2ecc40
color.sync.changed=rgb540  # #ffdc00
color.sync.rejected=rgb500  # #ff4136

# Command: undo
color.undo.after=rgb041  # #2ecc40
color.undo.before=rgb500  # #ff4136
