# tinted-taskwarrior
# Scheme name: Terminal Basic
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-terminal-basic (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7c7c7c
color.label.sort=rgb103  # #0000b2
color.alternate=on gray0  # #000000
color.header=rgb103  # #0000b2
color.footnote=rgb033  # #00a6b2
color.warning=rgb555 on rgb105  # #ffffff on #0000ff
color.error=rgb200  # #990000
color.debug=rgb033  # #00a6b2

# Task state
color.completed=gray12  # #7c7c7c
color.deleted=gray12  # #7c7c7c
color.active=rgb555 on rgb030  # #ffffff on #00a600
color.recurring=rgb033  # #00a6b2
color.scheduled=rgb103  # #0000b2
color.until=
color.blocked=gray12  # #7c7c7c
color.blocking=rgb555 on rgb303  # #ffffff on #b200b2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb220  # #999900
color.uda.priority.M=rgb105  # #0000ff
color.uda.priority.L=rgb103  # #0000b2

# Tags
color.tag.next=rgb303  # #b200b2
color.tag.none=
color.tagged=

# Due
color.due=rgb105  # #0000ff
color.due.today=rgb220  # #999900
color.overdue=rgb200  # #990000

# Report: burndown
color.burndown.done=rgb555 on rgb030  # #ffffff on #00a600
color.burndown.pending=rgb555 on rgb200  # #ffffff on #990000
color.burndown.started=rgb555 on rgb105  # #ffffff on #0000ff

# Report: history
color.history.add=rgb555 on rgb200  # #ffffff on #990000
color.history.delete=rgb555 on rgb105  # #ffffff on #0000ff
color.history.done=rgb555 on rgb030  # #ffffff on #00a600

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=rgb555 on rgb030  # #ffffff on #00a600

# Command: calendar
color.calendar.due=rgb555 on rgb105  # #ffffff on #0000ff
color.calendar.due.today=rgb555 on rgb220  # #ffffff on #999900
color.calendar.holiday=rgb555 on rgb303  # #ffffff on #b200b2
color.calendar.overdue=rgb555 on rgb200  # #ffffff on #990000
color.calendar.scheduled=rgb555 on rgb103  # #ffffff on #0000b2
color.calendar.today=rgb555 on rgb033  # #ffffff on #00a6b2
color.calendar.weekend=gray12  # #7c7c7c
color.calendar.weeknumber=gray12  # #7c7c7c

# Command: sync
color.sync.added=rgb030  # #00a600
color.sync.changed=rgb105  # #0000ff
color.sync.rejected=rgb200  # #990000

# Command: undo
color.undo.after=rgb030  # #00a600
color.undo.before=rgb200  # #990000
