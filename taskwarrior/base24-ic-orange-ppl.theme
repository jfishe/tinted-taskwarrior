# tinted-taskwarrior
# Scheme name: IC-Orange-PPL
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-ic-orange-ppl (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb210  # #8f6c41
color.label.sort=rgb310  # #bd6c00
color.alternate=on gray0  # #000000
color.header=rgb310  # #bd6c00
color.footnote=rgb520  # #f79400
color.warning=gray3 on rgb530  # #262626 on #ffbd54
color.error=rgb400  # #c03900
color.debug=rgb520  # #f79400

# Task state
color.completed=rgb210  # #8f6c41
color.deleted=rgb210  # #8f6c41
color.active=gray3 on rgb330  # #262626 on #a3a900
color.recurring=rgb520  # #f79400
color.scheduled=rgb310  # #bd6c00
color.until=
color.blocked=rgb210  # #8f6c41
color.blocking=gray3 on rgb510  # #262626 on #fb5d00

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb430  # #caae00
color.uda.priority.M=rgb530  # #ffbd54
color.uda.priority.L=rgb310  # #bd6c00

# Tags
color.tag.next=rgb510  # #fb5d00
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #ffbd54
color.due.today=rgb430  # #caae00
color.overdue=rgb400  # #c03900

# Report: burndown
color.burndown.done=gray3 on rgb330  # #262626 on #a3a900
color.burndown.pending=gray3 on rgb400  # #262626 on #c03900
color.burndown.started=gray3 on rgb530  # #262626 on #ffbd54

# Report: history
color.history.add=gray3 on rgb400  # #262626 on #c03900
color.history.delete=gray3 on rgb530  # #262626 on #ffbd54
color.history.done=gray3 on rgb330  # #262626 on #a3a900

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray3 on rgb330  # #262626 on #a3a900

# Command: calendar
color.calendar.due=gray3 on rgb530  # #262626 on #ffbd54
color.calendar.due.today=gray3 on rgb430  # #262626 on #caae00
color.calendar.holiday=gray3 on rgb510  # #262626 on #fb5d00
color.calendar.overdue=gray3 on rgb400  # #262626 on #c03900
color.calendar.scheduled=gray3 on rgb310  # #262626 on #bd6c00
color.calendar.today=gray3 on rgb520  # #262626 on #f79400
color.calendar.weekend=rgb210  # #8f6c41
color.calendar.weeknumber=rgb210  # #8f6c41

# Command: sync
color.sync.added=rgb330  # #a3a900
color.sync.changed=rgb530  # #ffbd54
color.sync.rejected=rgb400  # #c03900

# Command: undo
color.undo.after=rgb330  # #a3a900
color.undo.before=rgb400  # #c03900
