# tinted-taskwarrior
# Scheme name: Horizon Terminal Dark
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Scheme: base16-horizon-terminal-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6f6f70
color.label.sort=rgb034  # #26bbd9
color.alternate=on gray3  # #232530
color.header=rgb034  # #26bbd9
color.footnote=rgb144  # #59e1e3
color.warning=gray2 on rgb543  # #1c1e26 on #fac29a
color.error=rgb512  # #e95678
color.debug=rgb144  # #59e1e3

# Task state
color.completed=gray10  # #6f6f70
color.deleted=gray10  # #6f6f70
color.active=gray2 on rgb042  # #1c1e26 on #29d398
color.recurring=rgb144  # #59e1e3
color.scheduled=rgb034  # #26bbd9
color.until=
color.blocked=gray10  # #6f6f70
color.blocking=gray2 on rgb513  # #1c1e26 on #ee64ac

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #fab795
color.uda.priority.M=rgb543  # #fac29a
color.uda.priority.L=rgb034  # #26bbd9

# Tags
color.tag.next=rgb513  # #ee64ac
color.tag.none=
color.tagged=

# Due
color.due=rgb543  # #fac29a
color.due.today=rgb532  # #fab795
color.overdue=rgb512  # #e95678

# Report: burndown
color.burndown.done=gray2 on rgb042  # #1c1e26 on #29d398
color.burndown.pending=gray2 on rgb512  # #1c1e26 on #e95678
color.burndown.started=gray2 on rgb543  # #1c1e26 on #fac29a

# Report: history
color.history.add=gray2 on rgb512  # #1c1e26 on #e95678
color.history.delete=gray2 on rgb543  # #1c1e26 on #fac29a
color.history.done=gray2 on rgb042  # #1c1e26 on #29d398

# Report: summary
color.summary.background=on gray3  # #232530
color.summary.bar=gray2 on rgb042  # #1c1e26 on #29d398

# Command: calendar
color.calendar.due=gray2 on rgb543  # #1c1e26 on #fac29a
color.calendar.due.today=gray2 on rgb532  # #1c1e26 on #fab795
color.calendar.holiday=gray2 on rgb513  # #1c1e26 on #ee64ac
color.calendar.overdue=gray2 on rgb512  # #1c1e26 on #e95678
color.calendar.scheduled=gray2 on rgb034  # #1c1e26 on #26bbd9
color.calendar.today=gray2 on rgb144  # #1c1e26 on #59e1e3
color.calendar.weekend=gray10  # #6f6f70
color.calendar.weeknumber=gray10  # #6f6f70

# Command: sync
color.sync.added=rgb042  # #29d398
color.sync.changed=rgb543  # #fac29a
color.sync.rejected=rgb512  # #e95678

# Command: undo
color.undo.after=rgb042  # #29d398
color.undo.before=rgb512  # #e95678
