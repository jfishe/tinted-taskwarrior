# tinted-taskwarrior
# Scheme name: Materia
# Scheme author: Defman21
# Scheme: base16-materia (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #707880
color.label.sort=rgb245  # #89ddff
color.alternate=on gray5  # #2c393f
color.header=rgb245  # #89ddff
color.footnote=rgb244  # #80cbc4
color.warning=gray4 on rgb540  # #263238 on #ffcc00
color.error=rgb411  # #ec5f67
color.debug=rgb244  # #80cbc4

# Task state
color.completed=gray11  # #707880
color.deleted=gray11  # #707880
color.active=gray4 on rgb241  # #263238 on #8bd649
color.recurring=rgb244  # #80cbc4
color.scheduled=rgb245  # #89ddff
color.until=
color.blocked=gray11  # #707880
color.blocking=gray4 on rgb235  # #263238 on #82aaff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #ea9560
color.uda.priority.M=rgb540  # #ffcc00
color.uda.priority.L=rgb245  # #89ddff

# Tags
color.tag.next=rgb235  # #82aaff
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #ffcc00
color.due.today=rgb421  # #ea9560
color.overdue=rgb411  # #ec5f67

# Report: burndown
color.burndown.done=gray4 on rgb241  # #263238 on #8bd649
color.burndown.pending=gray4 on rgb411  # #263238 on #ec5f67
color.burndown.started=gray4 on rgb540  # #263238 on #ffcc00

# Report: history
color.history.add=gray4 on rgb411  # #263238 on #ec5f67
color.history.delete=gray4 on rgb540  # #263238 on #ffcc00
color.history.done=gray4 on rgb241  # #263238 on #8bd649

# Report: summary
color.summary.background=on gray5  # #2c393f
color.summary.bar=gray4 on rgb241  # #263238 on #8bd649

# Command: calendar
color.calendar.due=gray4 on rgb540  # #263238 on #ffcc00
color.calendar.due.today=gray4 on rgb421  # #263238 on #ea9560
color.calendar.holiday=gray4 on rgb235  # #263238 on #82aaff
color.calendar.overdue=gray4 on rgb411  # #263238 on #ec5f67
color.calendar.scheduled=gray4 on rgb245  # #263238 on #89ddff
color.calendar.today=gray4 on rgb244  # #263238 on #80cbc4
color.calendar.weekend=gray11  # #707880
color.calendar.weeknumber=gray11  # #707880

# Command: sync
color.sync.added=rgb241  # #8bd649
color.sync.changed=rgb540  # #ffcc00
color.sync.rejected=rgb411  # #ec5f67

# Command: undo
color.undo.after=rgb241  # #8bd649
color.undo.before=rgb411  # #ec5f67
