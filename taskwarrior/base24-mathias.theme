# tinted-taskwarrior
# Scheme name: Mathias
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-mathias (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7c7c7c
color.label.sort=rgb425  # #c48dff
color.alternate=on gray0  # #000000
color.header=rgb425  # #c48dff
color.footnote=rgb045  # #67d9f0
color.warning=gray0 on rgb115  # #000000 on #5555ff
color.error=rgb400  # #e52222
color.debug=rgb045  # #67d9f0

# Task state
color.completed=gray12  # #7c7c7c
color.deleted=gray12  # #7c7c7c
color.active=gray0 on rgb240  # #000000 on #a6e32d
color.recurring=rgb045  # #67d9f0
color.scheduled=rgb425  # #c48dff
color.until=
color.blocked=gray12  # #7c7c7c
color.blocking=gray0 on rgb501  # #000000 on #fa2573

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #fc951e
color.uda.priority.M=rgb115  # #5555ff
color.uda.priority.L=rgb425  # #c48dff

# Tags
color.tag.next=rgb501  # #fa2573
color.tag.none=
color.tagged=

# Due
color.due=rgb115  # #5555ff
color.due.today=rgb520  # #fc951e
color.overdue=rgb400  # #e52222

# Report: burndown
color.burndown.done=gray0 on rgb240  # #000000 on #a6e32d
color.burndown.pending=gray0 on rgb400  # #000000 on #e52222
color.burndown.started=gray0 on rgb115  # #000000 on #5555ff

# Report: history
color.history.add=gray0 on rgb400  # #000000 on #e52222
color.history.delete=gray0 on rgb115  # #000000 on #5555ff
color.history.done=gray0 on rgb240  # #000000 on #a6e32d

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray0 on rgb240  # #000000 on #a6e32d

# Command: calendar
color.calendar.due=gray0 on rgb115  # #000000 on #5555ff
color.calendar.due.today=gray0 on rgb520  # #000000 on #fc951e
color.calendar.holiday=gray0 on rgb501  # #000000 on #fa2573
color.calendar.overdue=gray0 on rgb400  # #000000 on #e52222
color.calendar.scheduled=gray0 on rgb425  # #000000 on #c48dff
color.calendar.today=gray0 on rgb045  # #000000 on #67d9f0
color.calendar.weekend=gray12  # #7c7c7c
color.calendar.weeknumber=gray12  # #7c7c7c

# Command: sync
color.sync.added=rgb240  # #a6e32d
color.sync.changed=rgb115  # #5555ff
color.sync.rejected=rgb400  # #e52222

# Command: undo
color.undo.after=rgb240  # #a6e32d
color.undo.before=rgb400  # #e52222
