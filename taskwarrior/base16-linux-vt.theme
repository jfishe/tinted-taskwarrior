# tinted-taskwarrior
# Scheme name: Linux VT
# Scheme author: j-c-m (https://github.com/j-c-m/)
# Scheme: base16-linux-vt (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #555555
color.label.sort=rgb115  # #5555ff
color.alternate=on gray4  # #333333
color.header=rgb115  # #5555ff
color.footnote=rgb033  # #00aaaa
color.warning=gray0 on rgb551  # #000000 on #ffff55
color.error=rgb300  # #aa0000
color.debug=rgb033  # #00aaaa

# Task state
color.completed=gray8  # #555555
color.deleted=gray8  # #555555
color.active=gray0 on rgb030  # #000000 on #00aa00
color.recurring=rgb033  # #00aaaa
color.scheduled=rgb115  # #5555ff
color.until=
color.blocked=gray8  # #555555
color.blocking=gray0 on rgb515  # #000000 on #ff55ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb511  # #ff5555
color.uda.priority.M=rgb551  # #ffff55
color.uda.priority.L=rgb115  # #5555ff

# Tags
color.tag.next=rgb515  # #ff55ff
color.tag.none=
color.tagged=

# Due
color.due=rgb551  # #ffff55
color.due.today=rgb511  # #ff5555
color.overdue=rgb300  # #aa0000

# Report: burndown
color.burndown.done=gray0 on rgb030  # #000000 on #00aa00
color.burndown.pending=gray0 on rgb300  # #000000 on #aa0000
color.burndown.started=gray0 on rgb551  # #000000 on #ffff55

# Report: history
color.history.add=gray0 on rgb300  # #000000 on #aa0000
color.history.delete=gray0 on rgb551  # #000000 on #ffff55
color.history.done=gray0 on rgb030  # #000000 on #00aa00

# Report: summary
color.summary.background=on gray4  # #333333
color.summary.bar=gray0 on rgb030  # #000000 on #00aa00

# Command: calendar
color.calendar.due=gray0 on rgb551  # #000000 on #ffff55
color.calendar.due.today=gray0 on rgb511  # #000000 on #ff5555
color.calendar.holiday=gray0 on rgb515  # #000000 on #ff55ff
color.calendar.overdue=gray0 on rgb300  # #000000 on #aa0000
color.calendar.scheduled=gray0 on rgb115  # #000000 on #5555ff
color.calendar.today=gray0 on rgb033  # #000000 on #00aaaa
color.calendar.weekend=gray8  # #555555
color.calendar.weeknumber=gray8  # #555555

# Command: sync
color.sync.added=rgb030  # #00aa00
color.sync.changed=rgb551  # #ffff55
color.sync.rejected=rgb300  # #aa0000

# Command: undo
color.undo.after=rgb030  # #00aa00
color.undo.before=rgb300  # #aa0000
