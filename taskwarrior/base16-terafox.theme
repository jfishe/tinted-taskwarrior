# tinted-taskwarrior
# Scheme name: terafox
# Scheme author: EdenEast (https://github.com/EdenEast)
# Scheme: base16-terafox (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #4e5157
color.label.sort=rgb023  # #5a93aa
color.alternate=on gray4  # #1d3337
color.header=rgb023  # #5a93aa
color.footnote=rgb344  # #a1cdd8
color.warning=gray3 on rgb532  # #152528 on #fda47f
color.error=rgb511  # #e85c51
color.debug=rgb344  # #a1cdd8

# Task state
color.completed=gray7  # #4e5157
color.deleted=gray7  # #4e5157
color.active=gray3 on rgb233  # #152528 on #7aa4a1
color.recurring=rgb344  # #a1cdd8
color.scheduled=rgb023  # #5a93aa
color.until=
color.blocked=gray7  # #4e5157
color.blocking=gray3 on rgb312  # #152528 on #ad5c7c

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb521  # #ff8349
color.uda.priority.M=rgb532  # #fda47f
color.uda.priority.L=rgb023  # #5a93aa

# Tags
color.tag.next=rgb312  # #ad5c7c
color.tag.none=
color.tagged=

# Due
color.due=rgb532  # #fda47f
color.due.today=rgb521  # #ff8349
color.overdue=rgb511  # #e85c51

# Report: burndown
color.burndown.done=gray3 on rgb233  # #152528 on #7aa4a1
color.burndown.pending=gray3 on rgb511  # #152528 on #e85c51
color.burndown.started=gray3 on rgb532  # #152528 on #fda47f

# Report: history
color.history.add=gray3 on rgb511  # #152528 on #e85c51
color.history.delete=gray3 on rgb532  # #152528 on #fda47f
color.history.done=gray3 on rgb233  # #152528 on #7aa4a1

# Report: summary
color.summary.background=on gray4  # #1d3337
color.summary.bar=gray3 on rgb233  # #152528 on #7aa4a1

# Command: calendar
color.calendar.due=gray3 on rgb532  # #152528 on #fda47f
color.calendar.due.today=gray3 on rgb521  # #152528 on #ff8349
color.calendar.holiday=gray3 on rgb312  # #152528 on #ad5c7c
color.calendar.overdue=gray3 on rgb511  # #152528 on #e85c51
color.calendar.scheduled=gray3 on rgb023  # #152528 on #5a93aa
color.calendar.today=gray3 on rgb344  # #152528 on #a1cdd8
color.calendar.weekend=gray7  # #4e5157
color.calendar.weeknumber=gray7  # #4e5157

# Command: sync
color.sync.added=rgb233  # #7aa4a1
color.sync.changed=rgb532  # #fda47f
color.sync.rejected=rgb511  # #e85c51

# Command: undo
color.undo.after=rgb233  # #7aa4a1
color.undo.before=rgb511  # #e85c51
