# tinted-taskwarrior
# Scheme name: Night Lion V2
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-night-lion-v2 (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6e6e6e
color.label.sort=rgb145  # #63d0f0
color.alternate=on gray7  # #4c4c4c
color.header=rgb145  # #63d0f0
color.footnote=rgb044  # #00d9df
color.warning=gray1 on rgb145  # #171717 on #62cae7
color.error=rgb300  # #bb0000
color.debug=rgb044  # #00d9df

# Task state
color.completed=gray10  # #6e6e6e
color.deleted=gray10  # #6e6e6e
color.active=gray1 on rgb050  # #171717 on #03f622
color.recurring=rgb044  # #00d9df
color.scheduled=rgb145  # #63d0f0
color.until=
color.blocked=gray10  # #6e6e6e
color.blocking=gray1 on rgb414  # #171717 on #ce6fda

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb551  # #f2f067
color.uda.priority.M=rgb145  # #62cae7
color.uda.priority.L=rgb145  # #63d0f0

# Tags
color.tag.next=rgb414  # #ce6fda
color.tag.none=
color.tagged=

# Due
color.due=rgb145  # #62cae7
color.due.today=rgb551  # #f2f067
color.overdue=rgb300  # #bb0000

# Report: burndown
color.burndown.done=gray1 on rgb050  # #171717 on #03f622
color.burndown.pending=gray1 on rgb300  # #171717 on #bb0000
color.burndown.started=gray1 on rgb145  # #171717 on #62cae7

# Report: history
color.history.add=gray1 on rgb300  # #171717 on #bb0000
color.history.delete=gray1 on rgb145  # #171717 on #62cae7
color.history.done=gray1 on rgb050  # #171717 on #03f622

# Report: summary
color.summary.background=on gray7  # #4c4c4c
color.summary.bar=gray1 on rgb050  # #171717 on #03f622

# Command: calendar
color.calendar.due=gray1 on rgb145  # #171717 on #62cae7
color.calendar.due.today=gray1 on rgb551  # #171717 on #f2f067
color.calendar.holiday=gray1 on rgb414  # #171717 on #ce6fda
color.calendar.overdue=gray1 on rgb300  # #171717 on #bb0000
color.calendar.scheduled=gray1 on rgb145  # #171717 on #63d0f0
color.calendar.today=gray1 on rgb044  # #171717 on #00d9df
color.calendar.weekend=gray10  # #6e6e6e
color.calendar.weeknumber=gray10  # #6e6e6e

# Command: sync
color.sync.added=rgb050  # #03f622
color.sync.changed=rgb145  # #62cae7
color.sync.rejected=rgb300  # #bb0000

# Command: undo
color.undo.after=rgb050  # #03f622
color.undo.before=rgb300  # #bb0000
