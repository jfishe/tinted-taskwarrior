# tinted-taskwarrior
# Scheme name: Hurtado
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-hurtado (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #4e4e4e
color.label.sort=rgb013  # #486387
color.alternate=on gray8  # #575757
color.header=rgb013  # #486387
color.footnote=rgb145  # #85e9fe
color.warning=gray0 on rgb235  # #000000 on #89bdff
color.error=rgb500  # #ff1b00
color.debug=rgb145  # #85e9fe

# Task state
color.completed=gray7  # #4e4e4e
color.deleted=gray7  # #4e4e4e
color.active=gray0 on rgb341  # #000000 on #a5df55
color.recurring=rgb145  # #85e9fe
color.scheduled=rgb013  # #486387
color.until=
color.blocked=gray7  # #4e4e4e
color.blocking=gray0 on rgb515  # #000000 on #fc5ef0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb540  # #fbe74a
color.uda.priority.M=rgb235  # #89bdff
color.uda.priority.L=rgb013  # #486387

# Tags
color.tag.next=rgb515  # #fc5ef0
color.tag.none=
color.tagged=

# Due
color.due=rgb235  # #89bdff
color.due.today=rgb540  # #fbe74a
color.overdue=rgb500  # #ff1b00

# Report: burndown
color.burndown.done=gray0 on rgb341  # #000000 on #a5df55
color.burndown.pending=gray0 on rgb500  # #000000 on #ff1b00
color.burndown.started=gray0 on rgb235  # #000000 on #89bdff

# Report: history
color.history.add=gray0 on rgb500  # #000000 on #ff1b00
color.history.delete=gray0 on rgb235  # #000000 on #89bdff
color.history.done=gray0 on rgb341  # #000000 on #a5df55

# Report: summary
color.summary.background=on gray8  # #575757
color.summary.bar=gray0 on rgb341  # #000000 on #a5df55

# Command: calendar
color.calendar.due=gray0 on rgb235  # #000000 on #89bdff
color.calendar.due.today=gray0 on rgb540  # #000000 on #fbe74a
color.calendar.holiday=gray0 on rgb515  # #000000 on #fc5ef0
color.calendar.overdue=gray0 on rgb500  # #000000 on #ff1b00
color.calendar.scheduled=gray0 on rgb013  # #000000 on #486387
color.calendar.today=gray0 on rgb145  # #000000 on #85e9fe
color.calendar.weekend=gray7  # #4e4e4e
color.calendar.weeknumber=gray7  # #4e4e4e

# Command: sync
color.sync.added=rgb341  # #a5df55
color.sync.changed=rgb235  # #89bdff
color.sync.rejected=rgb500  # #ff1b00

# Command: undo
color.undo.after=rgb341  # #a5df55
color.undo.before=rgb500  # #ff1b00
