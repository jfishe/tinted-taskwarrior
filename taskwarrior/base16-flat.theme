# tinted-taskwarrior
# Scheme name: Flat
# Scheme author: Chris Kempson (http://chriskempson.com)
# Scheme: base16-flat (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray15  # #95a5a6
color.label.sort=rgb024  # #3498db
color.alternate=on rgb012  # #34495e
color.header=rgb024  # #3498db
color.footnote=rgb032  # #1abc9c
color.warning=gray5 on rgb540  # #2c3e50 on #f1c40f
color.error=rgb500  # #e74c3c
color.debug=rgb032  # #1abc9c

# Task state
color.completed=gray15  # #95a5a6
color.deleted=gray15  # #95a5a6
color.active=gray5 on rgb042  # #2c3e50 on #2ecc71
color.recurring=rgb032  # #1abc9c
color.scheduled=rgb024  # #3498db
color.until=
color.blocked=gray15  # #95a5a6
color.blocking=gray5 on rgb213  # #2c3e50 on #9b59b6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #e67e22
color.uda.priority.M=rgb540  # #f1c40f
color.uda.priority.L=rgb024  # #3498db

# Tags
color.tag.next=rgb213  # #9b59b6
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #f1c40f
color.due.today=rgb520  # #e67e22
color.overdue=rgb500  # #e74c3c

# Report: burndown
color.burndown.done=gray5 on rgb042  # #2c3e50 on #2ecc71
color.burndown.pending=gray5 on rgb500  # #2c3e50 on #e74c3c
color.burndown.started=gray5 on rgb540  # #2c3e50 on #f1c40f

# Report: history
color.history.add=gray5 on rgb500  # #2c3e50 on #e74c3c
color.history.delete=gray5 on rgb540  # #2c3e50 on #f1c40f
color.history.done=gray5 on rgb042  # #2c3e50 on #2ecc71

# Report: summary
color.summary.background=on rgb012  # #34495e
color.summary.bar=gray5 on rgb042  # #2c3e50 on #2ecc71

# Command: calendar
color.calendar.due=gray5 on rgb540  # #2c3e50 on #f1c40f
color.calendar.due.today=gray5 on rgb520  # #2c3e50 on #e67e22
color.calendar.holiday=gray5 on rgb213  # #2c3e50 on #9b59b6
color.calendar.overdue=gray5 on rgb500  # #2c3e50 on #e74c3c
color.calendar.scheduled=gray5 on rgb024  # #2c3e50 on #3498db
color.calendar.today=gray5 on rgb032  # #2c3e50 on #1abc9c
color.calendar.weekend=gray15  # #95a5a6
color.calendar.weeknumber=gray15  # #95a5a6

# Command: sync
color.sync.added=rgb042  # #2ecc71
color.sync.changed=rgb540  # #f1c40f
color.sync.rejected=rgb500  # #e74c3c

# Command: undo
color.undo.after=rgb042  # #2ecc71
color.undo.before=rgb500  # #e74c3c
