# tinted-taskwarrior
# Scheme name: Nebula
# Scheme author: Gabriel Fontes (https://github.com/Misterio77)
# Scheme: base16-nebula (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6e6f72
color.label.sort=rgb014  # #4d6bb6
color.alternate=on gray7  # #414f60
color.header=rgb014  # #4d6bb6
color.footnote=rgb011  # #226f68
color.warning=gray3 on rgb121  # #22273b on #4f9062
color.error=rgb224  # #777abc
color.debug=rgb011  # #226f68

# Task state
color.completed=gray10  # #6e6f72
color.deleted=gray10  # #6e6f72
color.active=gray3 on rgb113  # #22273b on #6562a8
color.recurring=rgb011  # #226f68
color.scheduled=rgb014  # #4d6bb6
color.until=
color.blocked=gray10  # #6e6f72
color.blocking=gray3 on rgb113  # #22273b on #716cae

# Project
color.project.none=

# Priority
color.uda.priority.H=gray14  # #94929e
color.uda.priority.M=rgb121  # #4f9062
color.uda.priority.L=rgb014  # #4d6bb6

# Tags
color.tag.next=rgb113  # #716cae
color.tag.none=
color.tagged=

# Due
color.due=rgb121  # #4f9062
color.due.today=gray14  # #94929e
color.overdue=rgb224  # #777abc

# Report: burndown
color.burndown.done=gray3 on rgb113  # #22273b on #6562a8
color.burndown.pending=gray3 on rgb224  # #22273b on #777abc
color.burndown.started=gray3 on rgb121  # #22273b on #4f9062

# Report: history
color.history.add=gray3 on rgb224  # #22273b on #777abc
color.history.delete=gray3 on rgb121  # #22273b on #4f9062
color.history.done=gray3 on rgb113  # #22273b on #6562a8

# Report: summary
color.summary.background=on gray7  # #414f60
color.summary.bar=gray3 on rgb113  # #22273b on #6562a8

# Command: calendar
color.calendar.due=gray3 on rgb121  # #22273b on #4f9062
color.calendar.due.today=gray3 on gray14  # #22273b on #94929e
color.calendar.holiday=gray3 on rgb113  # #22273b on #716cae
color.calendar.overdue=gray3 on rgb224  # #22273b on #777abc
color.calendar.scheduled=gray3 on rgb014  # #22273b on #4d6bb6
color.calendar.today=gray3 on rgb011  # #22273b on #226f68
color.calendar.weekend=gray10  # #6e6f72
color.calendar.weeknumber=gray10  # #6e6f72

# Command: sync
color.sync.added=rgb113  # #6562a8
color.sync.changed=rgb121  # #4f9062
color.sync.rejected=rgb224  # #777abc

# Command: undo
color.undo.after=rgb113  # #6562a8
color.undo.before=rgb224  # #777abc
