# tinted-taskwarrior
# Scheme name: Sequoia Moonlight Light
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Scheme: base16-sequoia-moonlight-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #565760
color.label.sort=rgb214  # #9a5fd9
color.alternate=on gray22  # #e2e3e8
color.header=rgb214  # #9a5fd9
color.footnote=rgb421  # #d9884a
color.warning=gray23 on gray10  # #edeef2 on #6a6a78
color.error=rgb413  # #c94da8
color.debug=rgb421  # #d9884a

# Task state
color.completed=gray8  # #565760
color.deleted=gray8  # #565760
color.active=gray23 on rgb124  # #edeef2 on #4a85d4
color.recurring=rgb421  # #d9884a
color.scheduled=rgb214  # #9a5fd9
color.until=
color.blocked=gray8  # #565760
color.blocking=gray23 on gray10  # #edeef2 on #6a6a78

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb413  # #c94da8
color.uda.priority.M=gray10  # #6a6a78
color.uda.priority.L=rgb214  # #9a5fd9

# Tags
color.tag.next=gray10  # #6a6a78
color.tag.none=
color.tagged=

# Due
color.due=gray10  # #6a6a78
color.due.today=rgb413  # #c94da8
color.overdue=rgb413  # #c94da8

# Report: burndown
color.burndown.done=gray23 on rgb124  # #edeef2 on #4a85d4
color.burndown.pending=gray23 on rgb413  # #edeef2 on #c94da8
color.burndown.started=gray23 on gray10  # #edeef2 on #6a6a78

# Report: history
color.history.add=gray23 on rgb413  # #edeef2 on #c94da8
color.history.delete=gray23 on gray10  # #edeef2 on #6a6a78
color.history.done=gray23 on rgb124  # #edeef2 on #4a85d4

# Report: summary
color.summary.background=on gray22  # #e2e3e8
color.summary.bar=gray23 on rgb124  # #edeef2 on #4a85d4

# Command: calendar
color.calendar.due=gray23 on gray10  # #edeef2 on #6a6a78
color.calendar.due.today=gray23 on rgb413  # #edeef2 on #c94da8
color.calendar.holiday=gray23 on gray10  # #edeef2 on #6a6a78
color.calendar.overdue=gray23 on rgb413  # #edeef2 on #c94da8
color.calendar.scheduled=gray23 on rgb214  # #edeef2 on #9a5fd9
color.calendar.today=gray23 on rgb421  # #edeef2 on #d9884a
color.calendar.weekend=gray8  # #565760
color.calendar.weeknumber=gray8  # #565760

# Command: sync
color.sync.added=rgb124  # #4a85d4
color.sync.changed=gray10  # #6a6a78
color.sync.rejected=rgb413  # #c94da8

# Command: undo
color.undo.after=rgb124  # #4a85d4
color.undo.before=rgb413  # #c94da8
