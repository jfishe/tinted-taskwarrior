# tinted-taskwarrior
# Scheme name: Heetch Light
# Scheme author: Geoffrey Teale (tealeg@gmail.com), Tinted Theming (https://github.com/tinted-theming)
# Scheme: base16-heetch-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb223  # #9c92a8
color.label.sort=rgb034  # #5ba2b6
color.alternate=on gray21  # #dedae2
color.header=rgb034  # #5ba2b6
color.footnote=rgb055  # #47f9f5
color.warning=rgb555 on rgb320  # #feffff on #bd9701
color.error=rgb501  # #f80059
color.debug=rgb055  # #47f9f5

# Task state
color.completed=rgb223  # #9c92a8
color.deleted=rgb223  # #9c92a8
color.active=rgb555 on rgb131  # #feffff on #5bb66a
color.recurring=rgb055  # #47f9f5
color.scheduled=rgb034  # #5ba2b6
color.until=
color.blocked=rgb223  # #9c92a8
color.blocking=rgb555 on rgb212  # #feffff on #8f6c97

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb401  # #bd0152
color.uda.priority.M=rgb320  # #bd9701
color.uda.priority.L=rgb034  # #5ba2b6

# Tags
color.tag.next=rgb212  # #8f6c97
color.tag.none=
color.tagged=

# Due
color.due=rgb320  # #bd9701
color.due.today=rgb401  # #bd0152
color.overdue=rgb501  # #f80059

# Report: burndown
color.burndown.done=rgb555 on rgb131  # #feffff on #5bb66a
color.burndown.pending=rgb555 on rgb501  # #feffff on #f80059
color.burndown.started=rgb555 on rgb320  # #feffff on #bd9701

# Report: history
color.history.add=rgb555 on rgb501  # #feffff on #f80059
color.history.delete=rgb555 on rgb320  # #feffff on #bd9701
color.history.done=rgb555 on rgb131  # #feffff on #5bb66a

# Report: summary
color.summary.background=on gray21  # #dedae2
color.summary.bar=rgb555 on rgb131  # #feffff on #5bb66a

# Command: calendar
color.calendar.due=rgb555 on rgb320  # #feffff on #bd9701
color.calendar.due.today=rgb555 on rgb401  # #feffff on #bd0152
color.calendar.holiday=rgb555 on rgb212  # #feffff on #8f6c97
color.calendar.overdue=rgb555 on rgb501  # #feffff on #f80059
color.calendar.scheduled=rgb555 on rgb034  # #feffff on #5ba2b6
color.calendar.today=rgb555 on rgb055  # #feffff on #47f9f5
color.calendar.weekend=rgb223  # #9c92a8
color.calendar.weeknumber=rgb223  # #9c92a8

# Command: sync
color.sync.added=rgb131  # #5bb66a
color.sync.changed=rgb320  # #bd9701
color.sync.rejected=rgb501  # #f80059

# Command: undo
color.undo.after=rgb131  # #5bb66a
color.undo.before=rgb501  # #f80059
