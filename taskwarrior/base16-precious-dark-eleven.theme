# tinted-taskwarrior
# Scheme name: Precious Dark Eleven
# Scheme author: 4lex4 &lt;4lex49@zoho.com&gt;
# Scheme: base16-precious-dark-eleven (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb222  # #858585
color.label.sort=rgb135  # #68b0ee
color.alternate=on gray3  # #292b2d
color.header=rgb135  # #68b0ee
color.footnote=rgb032  # #42bda7
color.warning=gray2 on rgb431  # #1c1e20 on #d0a543
color.error=rgb522  # #ff8782
color.debug=rgb032  # #42bda7

# Task state
color.completed=rgb222  # #858585
color.deleted=rgb222  # #858585
color.active=gray2 on rgb231  # #1c1e20 on #95b658
color.recurring=rgb032  # #42bda7
color.scheduled=rgb135  # #68b0ee
color.until=
color.blocked=rgb222  # #858585
color.blocking=gray2 on rgb325  # #1c1e20 on #b799fe

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #ea9755
color.uda.priority.M=rgb431  # #d0a543
color.uda.priority.L=rgb135  # #68b0ee

# Tags
color.tag.next=rgb325  # #b799fe
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #d0a543
color.due.today=rgb531  # #ea9755
color.overdue=rgb522  # #ff8782

# Report: burndown
color.burndown.done=gray2 on rgb231  # #1c1e20 on #95b658
color.burndown.pending=gray2 on rgb522  # #1c1e20 on #ff8782
color.burndown.started=gray2 on rgb431  # #1c1e20 on #d0a543

# Report: history
color.history.add=gray2 on rgb522  # #1c1e20 on #ff8782
color.history.delete=gray2 on rgb431  # #1c1e20 on #d0a543
color.history.done=gray2 on rgb231  # #1c1e20 on #95b658

# Report: summary
color.summary.background=on gray3  # #292b2d
color.summary.bar=gray2 on rgb231  # #1c1e20 on #95b658

# Command: calendar
color.calendar.due=gray2 on rgb431  # #1c1e20 on #d0a543
color.calendar.due.today=gray2 on rgb531  # #1c1e20 on #ea9755
color.calendar.holiday=gray2 on rgb325  # #1c1e20 on #b799fe
color.calendar.overdue=gray2 on rgb522  # #1c1e20 on #ff8782
color.calendar.scheduled=gray2 on rgb135  # #1c1e20 on #68b0ee
color.calendar.today=gray2 on rgb032  # #1c1e20 on #42bda7
color.calendar.weekend=rgb222  # #858585
color.calendar.weeknumber=rgb222  # #858585

# Command: sync
color.sync.added=rgb231  # #95b658
color.sync.changed=rgb431  # #d0a543
color.sync.rejected=rgb522  # #ff8782

# Command: undo
color.undo.after=rgb231  # #95b658
color.undo.before=rgb522  # #ff8782
