# tinted-taskwarrior
# Scheme name: Cyberdyne
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-cyberdyne (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb111  # #5e5e5e
color.label.sort=rgb013  # #0071cf
color.alternate=on gray0  # #080808
color.header=rgb013  # #0071cf
color.footnote=rgb154  # #6bffdc
color.warning=rgb101 on rgb345  # #151144 on #c1e3fe
color.error=rgb522  # #ff8272
color.debug=rgb154  # #6bffdc

# Task state
color.completed=rgb111  # #5e5e5e
color.deleted=rgb111  # #5e5e5e
color.active=rgb101 on rgb031  # #151144 on #00c172
color.recurring=rgb154  # #6bffdc
color.scheduled=rgb013  # #0071cf
color.until=
color.blocked=rgb111  # #5e5e5e
color.blocking=rgb101 on rgb525  # #151144 on #ff8ffd

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb430  # #d2a700
color.uda.priority.M=rgb345  # #c1e3fe
color.uda.priority.L=rgb013  # #0071cf

# Tags
color.tag.next=rgb525  # #ff8ffd
color.tag.none=
color.tagged=

# Due
color.due=rgb345  # #c1e3fe
color.due.today=rgb430  # #d2a700
color.overdue=rgb522  # #ff8272

# Report: burndown
color.burndown.done=rgb101 on rgb031  # #151144 on #00c172
color.burndown.pending=rgb101 on rgb522  # #151144 on #ff8272
color.burndown.started=rgb101 on rgb345  # #151144 on #c1e3fe

# Report: history
color.history.add=rgb101 on rgb522  # #151144 on #ff8272
color.history.delete=rgb101 on rgb345  # #151144 on #c1e3fe
color.history.done=rgb101 on rgb031  # #151144 on #00c172

# Report: summary
color.summary.background=on gray0  # #080808
color.summary.bar=rgb101 on rgb031  # #151144 on #00c172

# Command: calendar
color.calendar.due=rgb101 on rgb345  # #151144 on #c1e3fe
color.calendar.due.today=rgb101 on rgb430  # #151144 on #d2a700
color.calendar.holiday=rgb101 on rgb525  # #151144 on #ff8ffd
color.calendar.overdue=rgb101 on rgb522  # #151144 on #ff8272
color.calendar.scheduled=rgb101 on rgb013  # #151144 on #0071cf
color.calendar.today=rgb101 on rgb154  # #151144 on #6bffdc
color.calendar.weekend=rgb111  # #5e5e5e
color.calendar.weeknumber=rgb111  # #5e5e5e

# Command: sync
color.sync.added=rgb031  # #00c172
color.sync.changed=rgb345  # #c1e3fe
color.sync.rejected=rgb522  # #ff8272

# Command: undo
color.undo.after=rgb031  # #00c172
color.undo.before=rgb522  # #ff8272
