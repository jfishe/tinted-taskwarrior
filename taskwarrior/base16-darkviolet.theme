# tinted-taskwarrior
# Scheme name: Dark Violet
# Scheme author: ruler501 (https://github.com/ruler501/base16-darkviolet)
# Scheme: base16-darkviolet (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb102  # #593380
color.label.sort=rgb105  # #4136d9
color.alternate=on rgb101  # #231a40
color.header=rgb105  # #4136d9
color.footnote=rgb045  # #40dfff
color.warning=gray0 on rgb535  # #000000 on #f29df2
color.error=rgb305  # #a82ee6
color.debug=rgb045  # #40dfff

# Task state
color.completed=rgb102  # #593380
color.deleted=rgb102  # #593380
color.active=gray0 on rgb025  # #000000 on #4595e6
color.recurring=rgb045  # #40dfff
color.scheduled=rgb105  # #4136d9
color.until=
color.blocked=rgb102  # #593380
color.blocking=gray0 on rgb214  # #000000 on #7e5ce6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb314  # #bb66cc
color.uda.priority.M=rgb535  # #f29df2
color.uda.priority.L=rgb105  # #4136d9

# Tags
color.tag.next=rgb214  # #7e5ce6
color.tag.none=
color.tagged=

# Due
color.due=rgb535  # #f29df2
color.due.today=rgb314  # #bb66cc
color.overdue=rgb305  # #a82ee6

# Report: burndown
color.burndown.done=gray0 on rgb025  # #000000 on #4595e6
color.burndown.pending=gray0 on rgb305  # #000000 on #a82ee6
color.burndown.started=gray0 on rgb535  # #000000 on #f29df2

# Report: history
color.history.add=gray0 on rgb305  # #000000 on #a82ee6
color.history.delete=gray0 on rgb535  # #000000 on #f29df2
color.history.done=gray0 on rgb025  # #000000 on #4595e6

# Report: summary
color.summary.background=on rgb101  # #231a40
color.summary.bar=gray0 on rgb025  # #000000 on #4595e6

# Command: calendar
color.calendar.due=gray0 on rgb535  # #000000 on #f29df2
color.calendar.due.today=gray0 on rgb314  # #000000 on #bb66cc
color.calendar.holiday=gray0 on rgb214  # #000000 on #7e5ce6
color.calendar.overdue=gray0 on rgb305  # #000000 on #a82ee6
color.calendar.scheduled=gray0 on rgb105  # #000000 on #4136d9
color.calendar.today=gray0 on rgb045  # #000000 on #40dfff
color.calendar.weekend=rgb102  # #593380
color.calendar.weeknumber=rgb102  # #593380

# Command: sync
color.sync.added=rgb025  # #4595e6
color.sync.changed=rgb535  # #f29df2
color.sync.rejected=rgb305  # #a82ee6

# Command: undo
color.undo.after=rgb025  # #4595e6
color.undo.before=rgb305  # #a82ee6
