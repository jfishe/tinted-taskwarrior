# tinted-taskwarrior
# Scheme name: Adventure Time
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-adventure-time (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb124  # #7893bf
color.label.sort=rgb014  # #0f49c6
color.alternate=on gray0  # #050404
color.header=rgb014  # #0f49c6
color.footnote=rgb133  # #6fa497
color.warning=rgb101 on rgb023  # #1e1c44 on #1896c6
color.error=rgb300  # #bc0013
color.debug=rgb133  # #6fa497

# Task state
color.completed=rgb124  # #7893bf
color.deleted=rgb124  # #7893bf
color.active=rgb101 on rgb130  # #1e1c44 on #49b117
color.recurring=rgb133  # #6fa497
color.scheduled=rgb014  # #0f49c6
color.until=
color.blocked=rgb124  # #7893bf
color.blocking=rgb101 on rgb112  # #1e1c44 on #665992

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #e6741d
color.uda.priority.M=rgb023  # #1896c6
color.uda.priority.L=rgb014  # #0f49c6

# Tags
color.tag.next=rgb112  # #665992
color.tag.none=
color.tagged=

# Due
color.due=rgb023  # #1896c6
color.due.today=rgb410  # #e6741d
color.overdue=rgb300  # #bc0013

# Report: burndown
color.burndown.done=rgb101 on rgb130  # #1e1c44 on #49b117
color.burndown.pending=rgb101 on rgb300  # #1e1c44 on #bc0013
color.burndown.started=rgb101 on rgb023  # #1e1c44 on #1896c6

# Report: history
color.history.add=rgb101 on rgb300  # #1e1c44 on #bc0013
color.history.delete=rgb101 on rgb023  # #1e1c44 on #1896c6
color.history.done=rgb101 on rgb130  # #1e1c44 on #49b117

# Report: summary
color.summary.background=on gray0  # #050404
color.summary.bar=rgb101 on rgb130  # #1e1c44 on #49b117

# Command: calendar
color.calendar.due=rgb101 on rgb023  # #1e1c44 on #1896c6
color.calendar.due.today=rgb101 on rgb410  # #1e1c44 on #e6741d
color.calendar.holiday=rgb101 on rgb112  # #1e1c44 on #665992
color.calendar.overdue=rgb101 on rgb300  # #1e1c44 on #bc0013
color.calendar.scheduled=rgb101 on rgb014  # #1e1c44 on #0f49c6
color.calendar.today=rgb101 on rgb133  # #1e1c44 on #6fa497
color.calendar.weekend=rgb124  # #7893bf
color.calendar.weeknumber=rgb124  # #7893bf

# Command: sync
color.sync.added=rgb130  # #49b117
color.sync.changed=rgb023  # #1896c6
color.sync.rejected=rgb300  # #bc0013

# Command: undo
color.undo.after=rgb130  # #49b117
color.undo.before=rgb300  # #bc0013
