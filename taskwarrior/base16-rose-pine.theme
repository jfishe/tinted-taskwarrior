# tinted-taskwarrior
# Scheme name: Rosé Pine
# Scheme author: Emilia Dunfelt &lt;edun@dunfelt.se&gt;
# Scheme: base16-rose-pine (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #6e6a86
color.label.sort=rgb435  # #c4a7e7
color.alternate=on gray2  # #1f1d2e
color.header=rgb435  # #c4a7e7
color.footnote=rgb344  # #9ccfd8
color.warning=gray2 on rgb433  # #191724 on #ebbcba
color.error=rgb512  # #eb6f92
color.debug=rgb344  # #9ccfd8

# Task state
color.completed=rgb112  # #6e6a86
color.deleted=rgb112  # #6e6a86
color.active=gray2 on rgb023  # #191724 on #31748f
color.recurring=rgb344  # #9ccfd8
color.scheduled=rgb435  # #c4a7e7
color.until=
color.blocked=rgb112  # #6e6a86
color.blocking=gray2 on rgb542  # #191724 on #f6c177

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb542  # #f6c177
color.uda.priority.M=rgb433  # #ebbcba
color.uda.priority.L=rgb435  # #c4a7e7

# Tags
color.tag.next=rgb542  # #f6c177
color.tag.none=
color.tagged=

# Due
color.due=rgb433  # #ebbcba
color.due.today=rgb542  # #f6c177
color.overdue=rgb512  # #eb6f92

# Report: burndown
color.burndown.done=gray2 on rgb023  # #191724 on #31748f
color.burndown.pending=gray2 on rgb512  # #191724 on #eb6f92
color.burndown.started=gray2 on rgb433  # #191724 on #ebbcba

# Report: history
color.history.add=gray2 on rgb512  # #191724 on #eb6f92
color.history.delete=gray2 on rgb433  # #191724 on #ebbcba
color.history.done=gray2 on rgb023  # #191724 on #31748f

# Report: summary
color.summary.background=on gray2  # #1f1d2e
color.summary.bar=gray2 on rgb023  # #191724 on #31748f

# Command: calendar
color.calendar.due=gray2 on rgb433  # #191724 on #ebbcba
color.calendar.due.today=gray2 on rgb542  # #191724 on #f6c177
color.calendar.holiday=gray2 on rgb542  # #191724 on #f6c177
color.calendar.overdue=gray2 on rgb512  # #191724 on #eb6f92
color.calendar.scheduled=gray2 on rgb435  # #191724 on #c4a7e7
color.calendar.today=gray2 on rgb344  # #191724 on #9ccfd8
color.calendar.weekend=rgb112  # #6e6a86
color.calendar.weeknumber=rgb112  # #6e6a86

# Command: sync
color.sync.added=rgb023  # #31748f
color.sync.changed=rgb433  # #ebbcba
color.sync.rejected=rgb512  # #eb6f92

# Command: undo
color.undo.after=rgb023  # #31748f
color.undo.before=rgb512  # #eb6f92
