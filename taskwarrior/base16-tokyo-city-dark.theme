# tinted-taskwarrior
# Scheme name: Tokyo City Dark
# Scheme author: Michaël Ball
# Scheme: base16-tokyo-city-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb111  # #526270
color.label.sort=rgb235  # #7aa2f7
color.alternate=on gray3  # #1d252c
color.header=rgb235  # #7aa2f7
color.footnote=rgb245  # #89ddff
color.warning=gray2 on gray19  # #171d23 on #b7c5d3
color.error=rgb512  # #f7768e
color.debug=rgb245  # #89ddff

# Task state
color.completed=rgb111  # #526270
color.deleted=rgb111  # #526270
color.active=gray2 on rgb342  # #171d23 on #9ece6a
color.recurring=rgb245  # #89ddff
color.scheduled=rgb235  # #7aa2f7
color.until=
color.blocked=rgb111  # #526270
color.blocking=gray2 on rgb325  # #171d23 on #bb9af7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #ff9e64
color.uda.priority.M=gray19  # #b7c5d3
color.uda.priority.L=rgb235  # #7aa2f7

# Tags
color.tag.next=rgb325  # #bb9af7
color.tag.none=
color.tagged=

# Due
color.due=gray19  # #b7c5d3
color.due.today=rgb532  # #ff9e64
color.overdue=rgb512  # #f7768e

# Report: burndown
color.burndown.done=gray2 on rgb342  # #171d23 on #9ece6a
color.burndown.pending=gray2 on rgb512  # #171d23 on #f7768e
color.burndown.started=gray2 on gray19  # #171d23 on #b7c5d3

# Report: history
color.history.add=gray2 on rgb512  # #171d23 on #f7768e
color.history.delete=gray2 on gray19  # #171d23 on #b7c5d3
color.history.done=gray2 on rgb342  # #171d23 on #9ece6a

# Report: summary
color.summary.background=on gray3  # #1d252c
color.summary.bar=gray2 on rgb342  # #171d23 on #9ece6a

# Command: calendar
color.calendar.due=gray2 on gray19  # #171d23 on #b7c5d3
color.calendar.due.today=gray2 on rgb532  # #171d23 on #ff9e64
color.calendar.holiday=gray2 on rgb325  # #171d23 on #bb9af7
color.calendar.overdue=gray2 on rgb512  # #171d23 on #f7768e
color.calendar.scheduled=gray2 on rgb235  # #171d23 on #7aa2f7
color.calendar.today=gray2 on rgb245  # #171d23 on #89ddff
color.calendar.weekend=rgb111  # #526270
color.calendar.weeknumber=rgb111  # #526270

# Command: sync
color.sync.added=rgb342  # #9ece6a
color.sync.changed=gray19  # #b7c5d3
color.sync.rejected=rgb512  # #f7768e

# Command: undo
color.undo.after=rgb342  # #9ece6a
color.undo.before=rgb512  # #f7768e
