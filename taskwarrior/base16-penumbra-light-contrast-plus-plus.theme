# tinted-taskwarrior
# Scheme name: Penumbra Light Contrast Plus Plus
# Scheme author: Zachary Weiss (https://github.com/zacharyweiss)
# Scheme: base16-penumbra-light-contrast-plus-plus (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray21  # #dedede
color.label.sort=rgb135  # #6eb2fd
color.alternate=on rgb555  # #fff7ed
color.header=rgb135  # #6eb2fd
color.footnote=rgb045  # #00c4d7
color.warning=rgb555 on rgb331  # #fffdfb on #a9b852
color.error=rgb522  # #f58c81
color.debug=rgb045  # #00c4d7

# Task state
color.completed=gray21  # #dedede
color.deleted=gray21  # #dedede
color.active=rgb555 on rgb143  # #fffdfb on #54c794
color.recurring=rgb045  # #00c4d7
color.scheduled=rgb135  # #6eb2fd
color.until=
color.blocked=gray21  # #dedede
color.blocking=rgb555 on rgb325  # #fffdfb on #b69cf6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #e09f47
color.uda.priority.M=rgb331  # #a9b852
color.uda.priority.L=rgb135  # #6eb2fd

# Tags
color.tag.next=rgb325  # #b69cf6
color.tag.none=
color.tagged=

# Due
color.due=rgb331  # #a9b852
color.due.today=rgb531  # #e09f47
color.overdue=rgb522  # #f58c81

# Report: burndown
color.burndown.done=rgb555 on rgb143  # #fffdfb on #54c794
color.burndown.pending=rgb555 on rgb522  # #fffdfb on #f58c81
color.burndown.started=rgb555 on rgb331  # #fffdfb on #a9b852

# Report: history
color.history.add=rgb555 on rgb522  # #fffdfb on #f58c81
color.history.delete=rgb555 on rgb331  # #fffdfb on #a9b852
color.history.done=rgb555 on rgb143  # #fffdfb on #54c794

# Report: summary
color.summary.background=on rgb555  # #fff7ed
color.summary.bar=rgb555 on rgb143  # #fffdfb on #54c794

# Command: calendar
color.calendar.due=rgb555 on rgb331  # #fffdfb on #a9b852
color.calendar.due.today=rgb555 on rgb531  # #fffdfb on #e09f47
color.calendar.holiday=rgb555 on rgb325  # #fffdfb on #b69cf6
color.calendar.overdue=rgb555 on rgb522  # #fffdfb on #f58c81
color.calendar.scheduled=rgb555 on rgb135  # #fffdfb on #6eb2fd
color.calendar.today=rgb555 on rgb045  # #fffdfb on #00c4d7
color.calendar.weekend=gray21  # #dedede
color.calendar.weeknumber=gray21  # #dedede

# Command: sync
color.sync.added=rgb143  # #54c794
color.sync.changed=rgb331  # #a9b852
color.sync.rejected=rgb522  # #f58c81

# Command: undo
color.undo.after=rgb143  # #54c794
color.undo.before=rgb522  # #f58c81
