# tinted-taskwarrior
# Scheme name: PaperColor Dark
# Scheme author: Nguyen Nguyen (https://github.com/NLKNguyen/papercolor-theme)
# Scheme: base24-papercolor-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #808080
color.label.sort=rgb134  # #5fafd7
color.alternate=on gray4  # #303030
color.header=rgb134  # #5fafd7
color.footnote=rgb530  # #ffaf00
color.warning=gray2 on rgb431  # #1c1c1c on #d7af5f
color.error=rgb301  # #af005f
color.debug=rgb530  # #ffaf00

# Task state
color.completed=gray12  # #808080
color.deleted=gray12  # #808080
color.active=gray2 on rgb130  # #1c1c1c on #5faf00
color.recurring=rgb530  # #ffaf00
color.scheduled=rgb134  # #5fafd7
color.until=
color.blocked=gray12  # #808080
color.blocking=gray2 on rgb324  # #1c1c1c on #af87d7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb131  # #5faf5f
color.uda.priority.M=rgb431  # #d7af5f
color.uda.priority.L=rgb134  # #5fafd7

# Tags
color.tag.next=rgb324  # #af87d7
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #d7af5f
color.due.today=rgb131  # #5faf5f
color.overdue=rgb301  # #af005f

# Report: burndown
color.burndown.done=gray2 on rgb130  # #1c1c1c on #5faf00
color.burndown.pending=gray2 on rgb301  # #1c1c1c on #af005f
color.burndown.started=gray2 on rgb431  # #1c1c1c on #d7af5f

# Report: history
color.history.add=gray2 on rgb301  # #1c1c1c on #af005f
color.history.delete=gray2 on rgb431  # #1c1c1c on #d7af5f
color.history.done=gray2 on rgb130  # #1c1c1c on #5faf00

# Report: summary
color.summary.background=on gray4  # #303030
color.summary.bar=gray2 on rgb130  # #1c1c1c on #5faf00

# Command: calendar
color.calendar.due=gray2 on rgb431  # #1c1c1c on #d7af5f
color.calendar.due.today=gray2 on rgb131  # #1c1c1c on #5faf5f
color.calendar.holiday=gray2 on rgb324  # #1c1c1c on #af87d7
color.calendar.overdue=gray2 on rgb301  # #1c1c1c on #af005f
color.calendar.scheduled=gray2 on rgb134  # #1c1c1c on #5fafd7
color.calendar.today=gray2 on rgb530  # #1c1c1c on #ffaf00
color.calendar.weekend=gray12  # #808080
color.calendar.weeknumber=gray12  # #808080

# Command: sync
color.sync.added=rgb130  # #5faf00
color.sync.changed=rgb431  # #d7af5f
color.sync.rejected=rgb301  # #af005f

# Command: undo
color.undo.after=rgb130  # #5faf00
color.undo.before=rgb301  # #af005f
