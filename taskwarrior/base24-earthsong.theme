# tinted-taskwarrior
# Scheme name: Earthsong
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-earthsong (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #857769
color.label.sort=rgb023  # #1397b9
color.alternate=on gray1  # #111417
color.header=rgb023  # #1397b9
color.footnote=rgb121  # #4f9452
color.warning=gray3 on rgb145  # #282420 on #5ed9ff
color.error=rgb400  # #c84134
color.debug=rgb121  # #4f9452

# Task state
color.completed=gray11  # #857769
color.deleted=gray11  # #857769
color.active=gray3 on rgb241  # #282420 on #84c44b
color.recurring=rgb121  # #4f9452
color.scheduled=rgb023  # #1397b9
color.until=
color.blocked=gray11  # #857769
color.blocking=gray3 on rgb410  # #282420 on #d0623c

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #f4ae2e
color.uda.priority.M=rgb145  # #5ed9ff
color.uda.priority.L=rgb023  # #1397b9

# Tags
color.tag.next=rgb410  # #d0623c
color.tag.none=
color.tagged=

# Due
color.due=rgb145  # #5ed9ff
color.due.today=rgb530  # #f4ae2e
color.overdue=rgb400  # #c84134

# Report: burndown
color.burndown.done=gray3 on rgb241  # #282420 on #84c44b
color.burndown.pending=gray3 on rgb400  # #282420 on #c84134
color.burndown.started=gray3 on rgb145  # #282420 on #5ed9ff

# Report: history
color.history.add=gray3 on rgb400  # #282420 on #c84134
color.history.delete=gray3 on rgb145  # #282420 on #5ed9ff
color.history.done=gray3 on rgb241  # #282420 on #84c44b

# Report: summary
color.summary.background=on gray1  # #111417
color.summary.bar=gray3 on rgb241  # #282420 on #84c44b

# Command: calendar
color.calendar.due=gray3 on rgb145  # #282420 on #5ed9ff
color.calendar.due.today=gray3 on rgb530  # #282420 on #f4ae2e
color.calendar.holiday=gray3 on rgb410  # #282420 on #d0623c
color.calendar.overdue=gray3 on rgb400  # #282420 on #c84134
color.calendar.scheduled=gray3 on rgb023  # #282420 on #1397b9
color.calendar.today=gray3 on rgb121  # #282420 on #4f9452
color.calendar.weekend=gray11  # #857769
color.calendar.weeknumber=gray11  # #857769

# Command: sync
color.sync.added=rgb241  # #84c44b
color.sync.changed=rgb145  # #5ed9ff
color.sync.rejected=rgb400  # #c84134

# Command: undo
color.undo.after=rgb241  # #84c44b
color.undo.before=rgb400  # #c84134
