# tinted-taskwarrior
# Scheme name: Material Palenight
# Scheme author: Nate Peterson
# Scheme: base16-material-palenight (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #676e95
color.label.sort=rgb235  # #82aaff
color.alternate=on rgb112  # #444267
color.header=rgb235  # #82aaff
color.footnote=rgb245  # #89ddff
color.warning=gray4 on rgb542  # #292d3e on #ffcb6b
color.error=rgb522  # #f07178
color.debug=rgb245  # #89ddff

# Task state
color.completed=rgb112  # #676e95
color.deleted=rgb112  # #676e95
color.active=gray4 on rgb342  # #292d3e on #c3e88d
color.recurring=rgb245  # #89ddff
color.scheduled=rgb235  # #82aaff
color.until=
color.blocked=rgb112  # #676e95
color.blocking=gray4 on rgb425  # #292d3e on #c792ea

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb521  # #f78c6c
color.uda.priority.M=rgb542  # #ffcb6b
color.uda.priority.L=rgb235  # #82aaff

# Tags
color.tag.next=rgb425  # #c792ea
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ffcb6b
color.due.today=rgb521  # #f78c6c
color.overdue=rgb522  # #f07178

# Report: burndown
color.burndown.done=gray4 on rgb342  # #292d3e on #c3e88d
color.burndown.pending=gray4 on rgb522  # #292d3e on #f07178
color.burndown.started=gray4 on rgb542  # #292d3e on #ffcb6b

# Report: history
color.history.add=gray4 on rgb522  # #292d3e on #f07178
color.history.delete=gray4 on rgb542  # #292d3e on #ffcb6b
color.history.done=gray4 on rgb342  # #292d3e on #c3e88d

# Report: summary
color.summary.background=on rgb112  # #444267
color.summary.bar=gray4 on rgb342  # #292d3e on #c3e88d

# Command: calendar
color.calendar.due=gray4 on rgb542  # #292d3e on #ffcb6b
color.calendar.due.today=gray4 on rgb521  # #292d3e on #f78c6c
color.calendar.holiday=gray4 on rgb425  # #292d3e on #c792ea
color.calendar.overdue=gray4 on rgb522  # #292d3e on #f07178
color.calendar.scheduled=gray4 on rgb235  # #292d3e on #82aaff
color.calendar.today=gray4 on rgb245  # #292d3e on #89ddff
color.calendar.weekend=rgb112  # #676e95
color.calendar.weeknumber=rgb112  # #676e95

# Command: sync
color.sync.added=rgb342  # #c3e88d
color.sync.changed=rgb542  # #ffcb6b
color.sync.rejected=rgb522  # #f07178

# Command: undo
color.undo.after=rgb342  # #c3e88d
color.undo.before=rgb522  # #f07178
