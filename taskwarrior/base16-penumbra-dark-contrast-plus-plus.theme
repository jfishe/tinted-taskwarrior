# tinted-taskwarrior
# Scheme name: Penumbra Dark Contrast Plus Plus
# Scheme author: Neal McKee (https://github.com/nealmckee/penumbra)
# Scheme: base16-penumbra-dark-contrast-plus-plus (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #575b62
color.label.sort=rgb035  # #009edb
color.alternate=on gray2  # #1b1e23
color.header=rgb035  # #009edb
color.footnote=rgb033  # #00a8a4
color.warning=gray1 on rgb330  # #101317 on #b4a724
color.error=rgb422  # #e17782
color.debug=rgb033  # #00a8a4

# Task state
color.completed=gray8  # #575b62
color.deleted=gray8  # #575b62
color.active=gray1 on rgb131  # #101317 on #62b06c
color.recurring=rgb033  # #00a8a4
color.scheduled=rgb035  # #009edb
color.until=
color.blocked=gray8  # #575b62
color.blocking=gray1 on rgb224  # #101317 on #8a90d4

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb420  # #d88f4c
color.uda.priority.M=rgb330  # #b4a724
color.uda.priority.L=rgb035  # #009edb

# Tags
color.tag.next=rgb224  # #8a90d4
color.tag.none=
color.tagged=

# Due
color.due=rgb330  # #b4a724
color.due.today=rgb420  # #d88f4c
color.overdue=rgb422  # #e17782

# Report: burndown
color.burndown.done=gray1 on rgb131  # #101317 on #62b06c
color.burndown.pending=gray1 on rgb422  # #101317 on #e17782
color.burndown.started=gray1 on rgb330  # #101317 on #b4a724

# Report: history
color.history.add=gray1 on rgb422  # #101317 on #e17782
color.history.delete=gray1 on rgb330  # #101317 on #b4a724
color.history.done=gray1 on rgb131  # #101317 on #62b06c

# Report: summary
color.summary.background=on gray2  # #1b1e23
color.summary.bar=gray1 on rgb131  # #101317 on #62b06c

# Command: calendar
color.calendar.due=gray1 on rgb330  # #101317 on #b4a724
color.calendar.due.today=gray1 on rgb420  # #101317 on #d88f4c
color.calendar.holiday=gray1 on rgb224  # #101317 on #8a90d4
color.calendar.overdue=gray1 on rgb422  # #101317 on #e17782
color.calendar.scheduled=gray1 on rgb035  # #101317 on #009edb
color.calendar.today=gray1 on rgb033  # #101317 on #00a8a4
color.calendar.weekend=gray8  # #575b62
color.calendar.weeknumber=gray8  # #575b62

# Command: sync
color.sync.added=rgb131  # #62b06c
color.sync.changed=rgb330  # #b4a724
color.sync.rejected=rgb422  # #e17782

# Command: undo
color.undo.after=rgb131  # #62b06c
color.undo.before=rgb422  # #e17782
