# tinted-taskwarrior
# Scheme name: Solarized Dark Higher Contrast
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-solarized-dark-higher-contrast (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb023  # #3a8298
color.label.sort=rgb024  # #2075c7
color.alternate=on gray3  # #002731
color.header=rgb024  # #2075c7
color.footnote=rgb022  # #259185
color.warning=gray2 on rgb024  # #001e26 on #178dc7
color.error=rgb400  # #d01b24
color.debug=rgb022  # #259185

# Task state
color.completed=rgb023  # #3a8298
color.deleted=rgb023  # #3a8298
color.active=gray2 on rgb131  # #001e26 on #6bbe6c
color.recurring=rgb022  # #259185
color.scheduled=rgb024  # #2075c7
color.until=
color.blocked=rgb023  # #3a8298
color.blocking=gray2 on rgb402  # #001e26 on #c61b6e

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb320  # #a57705
color.uda.priority.M=rgb024  # #178dc7
color.uda.priority.L=rgb024  # #2075c7

# Tags
color.tag.next=rgb402  # #c61b6e
color.tag.none=
color.tagged=

# Due
color.due=rgb024  # #178dc7
color.due.today=rgb320  # #a57705
color.overdue=rgb400  # #d01b24

# Report: burndown
color.burndown.done=gray2 on rgb131  # #001e26 on #6bbe6c
color.burndown.pending=gray2 on rgb400  # #001e26 on #d01b24
color.burndown.started=gray2 on rgb024  # #001e26 on #178dc7

# Report: history
color.history.add=gray2 on rgb400  # #001e26 on #d01b24
color.history.delete=gray2 on rgb024  # #001e26 on #178dc7
color.history.done=gray2 on rgb131  # #001e26 on #6bbe6c

# Report: summary
color.summary.background=on gray3  # #002731
color.summary.bar=gray2 on rgb131  # #001e26 on #6bbe6c

# Command: calendar
color.calendar.due=gray2 on rgb024  # #001e26 on #178dc7
color.calendar.due.today=gray2 on rgb320  # #001e26 on #a57705
color.calendar.holiday=gray2 on rgb402  # #001e26 on #c61b6e
color.calendar.overdue=gray2 on rgb400  # #001e26 on #d01b24
color.calendar.scheduled=gray2 on rgb024  # #001e26 on #2075c7
color.calendar.today=gray2 on rgb022  # #001e26 on #259185
color.calendar.weekend=rgb023  # #3a8298
color.calendar.weeknumber=rgb023  # #3a8298

# Command: sync
color.sync.added=rgb131  # #6bbe6c
color.sync.changed=rgb024  # #178dc7
color.sync.rejected=rgb400  # #d01b24

# Command: undo
color.undo.after=rgb131  # #6bbe6c
color.undo.before=rgb400  # #d01b24
