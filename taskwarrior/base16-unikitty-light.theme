# tinted-taskwarrior
# Scheme name: Unikitty Light
# Scheme author: Josh W Lewis (@joshwlewis)
# Scheme: base16-unikitty-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray16  # #a7a5a8
color.label.sort=rgb215  # #775dff
color.alternate=on gray22  # #e1e1e2
color.header=rgb215  # #775dff
color.footnote=rgb035  # #149bda
color.warning=rgb555 on rgb420  # #ffffff on #dc8a0e
color.error=rgb402  # #d8137f
color.debug=rgb035  # #149bda

# Task state
color.completed=gray16  # #a7a5a8
color.deleted=gray16  # #a7a5a8
color.active=rgb555 on rgb032  # #ffffff on #17ad98
color.recurring=rgb035  # #149bda
color.scheduled=rgb215  # #775dff
color.until=
color.blocked=gray16  # #a7a5a8
color.blocking=rgb555 on rgb304  # #ffffff on #aa17e6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #d65407
color.uda.priority.M=rgb420  # #dc8a0e
color.uda.priority.L=rgb215  # #775dff

# Tags
color.tag.next=rgb304  # #aa17e6
color.tag.none=
color.tagged=

# Due
color.due=rgb420  # #dc8a0e
color.due.today=rgb410  # #d65407
color.overdue=rgb402  # #d8137f

# Report: burndown
color.burndown.done=rgb555 on rgb032  # #ffffff on #17ad98
color.burndown.pending=rgb555 on rgb402  # #ffffff on #d8137f
color.burndown.started=rgb555 on rgb420  # #ffffff on #dc8a0e

# Report: history
color.history.add=rgb555 on rgb402  # #ffffff on #d8137f
color.history.delete=rgb555 on rgb420  # #ffffff on #dc8a0e
color.history.done=rgb555 on rgb032  # #ffffff on #17ad98

# Report: summary
color.summary.background=on gray22  # #e1e1e2
color.summary.bar=rgb555 on rgb032  # #ffffff on #17ad98

# Command: calendar
color.calendar.due=rgb555 on rgb420  # #ffffff on #dc8a0e
color.calendar.due.today=rgb555 on rgb410  # #ffffff on #d65407
color.calendar.holiday=rgb555 on rgb304  # #ffffff on #aa17e6
color.calendar.overdue=rgb555 on rgb402  # #ffffff on #d8137f
color.calendar.scheduled=rgb555 on rgb215  # #ffffff on #775dff
color.calendar.today=rgb555 on rgb035  # #ffffff on #149bda
color.calendar.weekend=gray16  # #a7a5a8
color.calendar.weeknumber=gray16  # #a7a5a8

# Command: sync
color.sync.added=rgb032  # #17ad98
color.sync.changed=rgb420  # #dc8a0e
color.sync.rejected=rgb402  # #d8137f

# Command: undo
color.undo.after=rgb032  # #17ad98
color.undo.before=rgb402  # #d8137f
