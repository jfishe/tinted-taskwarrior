# tinted-taskwarrior
# Scheme name: Yesterday
# Scheme author: FroZnShiva (https://github.com/FroZnShiva)
# Scheme: base16-yesterday (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray14  # #969896
color.label.sort=rgb013  # #4271ae
color.alternate=on gray3  # #282a2e
color.header=rgb013  # #4271ae
color.footnote=rgb133  # #3e999f
color.warning=gray2 on rgb430  # #1d1f21 on #eab700
color.error=rgb400  # #c82829
color.debug=rgb133  # #3e999f

# Task state
color.completed=gray14  # #969896
color.deleted=gray14  # #969896
color.active=gray2 on rgb120  # #1d1f21 on #718c00
color.recurring=rgb133  # #3e999f
color.scheduled=rgb013  # #4271ae
color.until=
color.blocked=gray14  # #969896
color.blocking=gray2 on rgb213  # #1d1f21 on #8959a8

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #f5871f
color.uda.priority.M=rgb430  # #eab700
color.uda.priority.L=rgb013  # #4271ae

# Tags
color.tag.next=rgb213  # #8959a8
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #eab700
color.due.today=rgb520  # #f5871f
color.overdue=rgb400  # #c82829

# Report: burndown
color.burndown.done=gray2 on rgb120  # #1d1f21 on #718c00
color.burndown.pending=gray2 on rgb400  # #1d1f21 on #c82829
color.burndown.started=gray2 on rgb430  # #1d1f21 on #eab700

# Report: history
color.history.add=gray2 on rgb400  # #1d1f21 on #c82829
color.history.delete=gray2 on rgb430  # #1d1f21 on #eab700
color.history.done=gray2 on rgb120  # #1d1f21 on #718c00

# Report: summary
color.summary.background=on gray3  # #282a2e
color.summary.bar=gray2 on rgb120  # #1d1f21 on #718c00

# Command: calendar
color.calendar.due=gray2 on rgb430  # #1d1f21 on #eab700
color.calendar.due.today=gray2 on rgb520  # #1d1f21 on #f5871f
color.calendar.holiday=gray2 on rgb213  # #1d1f21 on #8959a8
color.calendar.overdue=gray2 on rgb400  # #1d1f21 on #c82829
color.calendar.scheduled=gray2 on rgb013  # #1d1f21 on #4271ae
color.calendar.today=gray2 on rgb133  # #1d1f21 on #3e999f
color.calendar.weekend=gray14  # #969896
color.calendar.weeknumber=gray14  # #969896

# Command: sync
color.sync.added=rgb120  # #718c00
color.sync.changed=rgb430  # #eab700
color.sync.rejected=rgb400  # #c82829

# Command: undo
color.undo.after=rgb120  # #718c00
color.undo.before=rgb400  # #c82829
