# tinted-taskwarrior
# Scheme name: Lumina Lagoon Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-lagoon-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb344  # #c5d8d8
color.label.sort=rgb013  # #185ca9
color.alternate=on rgb455  # #e1f4f4
color.header=rgb013  # #185ca9
color.footnote=rgb011  # #006e71
color.warning=rgb455 on rgb310  # #e9fafa on #a1600d
color.error=rgb200  # #8f2121
color.debug=rgb011  # #006e71

# Task state
color.completed=rgb344  # #c5d8d8
color.deleted=rgb344  # #c5d8d8
color.active=rgb455 on rgb011  # #e9fafa on #2e6147
color.recurring=rgb011  # #006e71
color.scheduled=rgb013  # #185ca9
color.until=
color.blocked=rgb344  # #c5d8d8
color.blocking=rgb455 on rgb113  # #e9fafa on #7153b5

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #924918
color.uda.priority.M=rgb310  # #a1600d
color.uda.priority.L=rgb013  # #185ca9

# Tags
color.tag.next=rgb113  # #7153b5
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #a1600d
color.due.today=rgb310  # #924918
color.overdue=rgb200  # #8f2121

# Report: burndown
color.burndown.done=rgb455 on rgb011  # #e9fafa on #2e6147
color.burndown.pending=rgb455 on rgb200  # #e9fafa on #8f2121
color.burndown.started=rgb455 on rgb310  # #e9fafa on #a1600d

# Report: history
color.history.add=rgb455 on rgb200  # #e9fafa on #8f2121
color.history.delete=rgb455 on rgb310  # #e9fafa on #a1600d
color.history.done=rgb455 on rgb011  # #e9fafa on #2e6147

# Report: summary
color.summary.background=on rgb455  # #e1f4f4
color.summary.bar=rgb455 on rgb011  # #e9fafa on #2e6147

# Command: calendar
color.calendar.due=rgb455 on rgb310  # #e9fafa on #a1600d
color.calendar.due.today=rgb455 on rgb310  # #e9fafa on #924918
color.calendar.holiday=rgb455 on rgb113  # #e9fafa on #7153b5
color.calendar.overdue=rgb455 on rgb200  # #e9fafa on #8f2121
color.calendar.scheduled=rgb455 on rgb013  # #e9fafa on #185ca9
color.calendar.today=rgb455 on rgb011  # #e9fafa on #006e71
color.calendar.weekend=rgb344  # #c5d8d8
color.calendar.weeknumber=rgb344  # #c5d8d8

# Command: sync
color.sync.added=rgb011  # #2e6147
color.sync.changed=rgb310  # #a1600d
color.sync.rejected=rgb200  # #8f2121

# Command: undo
color.undo.after=rgb011  # #2e6147
color.undo.before=rgb200  # #8f2121
