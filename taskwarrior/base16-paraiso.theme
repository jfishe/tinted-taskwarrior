# tinted-taskwarrior
# Scheme name: Paraiso
# Scheme author: Jan T. Sott
# Scheme: base16-paraiso (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #776e71
color.label.sort=rgb134  # #06b6ef
color.alternate=on gray5  # #41323f
color.header=rgb134  # #06b6ef
color.footnote=rgb144  # #5bc4bf
color.warning=gray3 on rgb540  # #2f1e2e on #fec418
color.error=rgb511  # #ef6155
color.debug=rgb144  # #5bc4bf

# Task state
color.completed=gray10  # #776e71
color.deleted=gray10  # #776e71
color.active=gray3 on rgb132  # #2f1e2e on #48b685
color.recurring=rgb144  # #5bc4bf
color.scheduled=rgb134  # #06b6ef
color.until=
color.blocked=gray10  # #776e71
color.blocking=gray3 on rgb213  # #2f1e2e on #815ba4

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #f99b15
color.uda.priority.M=rgb540  # #fec418
color.uda.priority.L=rgb134  # #06b6ef

# Tags
color.tag.next=rgb213  # #815ba4
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #fec418
color.due.today=rgb530  # #f99b15
color.overdue=rgb511  # #ef6155

# Report: burndown
color.burndown.done=gray3 on rgb132  # #2f1e2e on #48b685
color.burndown.pending=gray3 on rgb511  # #2f1e2e on #ef6155
color.burndown.started=gray3 on rgb540  # #2f1e2e on #fec418

# Report: history
color.history.add=gray3 on rgb511  # #2f1e2e on #ef6155
color.history.delete=gray3 on rgb540  # #2f1e2e on #fec418
color.history.done=gray3 on rgb132  # #2f1e2e on #48b685

# Report: summary
color.summary.background=on gray5  # #41323f
color.summary.bar=gray3 on rgb132  # #2f1e2e on #48b685

# Command: calendar
color.calendar.due=gray3 on rgb540  # #2f1e2e on #fec418
color.calendar.due.today=gray3 on rgb530  # #2f1e2e on #f99b15
color.calendar.holiday=gray3 on rgb213  # #2f1e2e on #815ba4
color.calendar.overdue=gray3 on rgb511  # #2f1e2e on #ef6155
color.calendar.scheduled=gray3 on rgb134  # #2f1e2e on #06b6ef
color.calendar.today=gray3 on rgb144  # #2f1e2e on #5bc4bf
color.calendar.weekend=gray10  # #776e71
color.calendar.weeknumber=gray10  # #776e71

# Command: sync
color.sync.added=rgb132  # #48b685
color.sync.changed=rgb540  # #fec418
color.sync.rejected=rgb511  # #ef6155

# Command: undo
color.undo.after=rgb132  # #48b685
color.undo.before=rgb511  # #ef6155
