# tinted-taskwarrior
# Scheme name: Snazzy
# Scheme author: Chawye Hsu (https://github.com/chawyehsu), based on Hyper Snazzy Theme (https://github.com/sindresorhus/hyper-snazzy)
# Scheme: base16-snazzy (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #78787e
color.label.sort=rgb245  # #57c7ff
color.alternate=on gray5  # #34353e
color.header=rgb245  # #57c7ff
color.footnote=rgb355  # #9aedfe
color.warning=gray3 on rgb553  # #282a36 on #f3f99d
color.error=rgb511  # #ff5c57
color.debug=rgb355  # #9aedfe

# Task state
color.completed=gray11  # #78787e
color.deleted=gray11  # #78787e
color.active=gray3 on rgb152  # #282a36 on #5af78e
color.recurring=rgb355  # #9aedfe
color.scheduled=rgb245  # #57c7ff
color.until=
color.blocked=gray11  # #78787e
color.blocking=gray3 on rgb513  # #282a36 on #ff6ac1

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #ff9f43
color.uda.priority.M=rgb553  # #f3f99d
color.uda.priority.L=rgb245  # #57c7ff

# Tags
color.tag.next=rgb513  # #ff6ac1
color.tag.none=
color.tagged=

# Due
color.due=rgb553  # #f3f99d
color.due.today=rgb531  # #ff9f43
color.overdue=rgb511  # #ff5c57

# Report: burndown
color.burndown.done=gray3 on rgb152  # #282a36 on #5af78e
color.burndown.pending=gray3 on rgb511  # #282a36 on #ff5c57
color.burndown.started=gray3 on rgb553  # #282a36 on #f3f99d

# Report: history
color.history.add=gray3 on rgb511  # #282a36 on #ff5c57
color.history.delete=gray3 on rgb553  # #282a36 on #f3f99d
color.history.done=gray3 on rgb152  # #282a36 on #5af78e

# Report: summary
color.summary.background=on gray5  # #34353e
color.summary.bar=gray3 on rgb152  # #282a36 on #5af78e

# Command: calendar
color.calendar.due=gray3 on rgb553  # #282a36 on #f3f99d
color.calendar.due.today=gray3 on rgb531  # #282a36 on #ff9f43
color.calendar.holiday=gray3 on rgb513  # #282a36 on #ff6ac1
color.calendar.overdue=gray3 on rgb511  # #282a36 on #ff5c57
color.calendar.scheduled=gray3 on rgb245  # #282a36 on #57c7ff
color.calendar.today=gray3 on rgb355  # #282a36 on #9aedfe
color.calendar.weekend=gray11  # #78787e
color.calendar.weeknumber=gray11  # #78787e

# Command: sync
color.sync.added=rgb152  # #5af78e
color.sync.changed=rgb553  # #f3f99d
color.sync.rejected=rgb511  # #ff5c57

# Command: undo
color.undo.after=rgb152  # #5af78e
color.undo.before=rgb511  # #ff5c57
