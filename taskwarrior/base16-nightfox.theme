# tinted-taskwarrior
# Scheme name: nightfox
# Scheme author: EdenEast (https://github.com/EdenEast)
# Scheme: base16-nightfox (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #575860
color.label.sort=rgb234  # #719cd6
color.alternate=on gray4  # #212e3f
color.header=rgb234  # #719cd6
color.footnote=rgb144  # #63cdcf
color.warning=gray3 on rgb431  # #192330 on #dbc074
color.error=rgb412  # #c94f6d
color.debug=rgb144  # #63cdcf

# Task state
color.completed=gray8  # #575860
color.deleted=gray8  # #575860
color.active=gray3 on rgb232  # #192330 on #81b29a
color.recurring=rgb144  # #63cdcf
color.scheduled=rgb234  # #719cd6
color.until=
color.blocked=gray8  # #575860
color.blocking=gray3 on rgb324  # #192330 on #9d79d6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #f4a261
color.uda.priority.M=rgb431  # #dbc074
color.uda.priority.L=rgb234  # #719cd6

# Tags
color.tag.next=rgb324  # #9d79d6
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #dbc074
color.due.today=rgb531  # #f4a261
color.overdue=rgb412  # #c94f6d

# Report: burndown
color.burndown.done=gray3 on rgb232  # #192330 on #81b29a
color.burndown.pending=gray3 on rgb412  # #192330 on #c94f6d
color.burndown.started=gray3 on rgb431  # #192330 on #dbc074

# Report: history
color.history.add=gray3 on rgb412  # #192330 on #c94f6d
color.history.delete=gray3 on rgb431  # #192330 on #dbc074
color.history.done=gray3 on rgb232  # #192330 on #81b29a

# Report: summary
color.summary.background=on gray4  # #212e3f
color.summary.bar=gray3 on rgb232  # #192330 on #81b29a

# Command: calendar
color.calendar.due=gray3 on rgb431  # #192330 on #dbc074
color.calendar.due.today=gray3 on rgb531  # #192330 on #f4a261
color.calendar.holiday=gray3 on rgb324  # #192330 on #9d79d6
color.calendar.overdue=gray3 on rgb412  # #192330 on #c94f6d
color.calendar.scheduled=gray3 on rgb234  # #192330 on #719cd6
color.calendar.today=gray3 on rgb144  # #192330 on #63cdcf
color.calendar.weekend=gray8  # #575860
color.calendar.weeknumber=gray8  # #575860

# Command: sync
color.sync.added=rgb232  # #81b29a
color.sync.changed=rgb431  # #dbc074
color.sync.rejected=rgb412  # #c94f6d

# Command: undo
color.undo.after=rgb232  # #81b29a
color.undo.before=rgb412  # #c94f6d
