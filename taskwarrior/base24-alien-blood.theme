# tinted-taskwarrior
# Scheme name: Alien Blood
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-alien-blood (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb110  # #46542a
color.label.sort=rgb012  # #2f697f
color.alternate=on gray3  # #112615
color.header=rgb012  # #2f697f
color.footnote=rgb022  # #317f76
color.warning=gray1 on rgb034  # #0f160f on #00a9df
color.error=rgb200  # #7f2b26
color.debug=rgb022  # #317f76

# Task state
color.completed=rgb110  # #46542a
color.deleted=rgb110  # #46542a
color.active=gray1 on rgb020  # #0f160f on #2f7e25
color.recurring=rgb022  # #317f76
color.scheduled=rgb012  # #2f697f
color.until=
color.blocked=rgb110  # #46542a
color.blocking=gray1 on rgb112  # #0f160f on #47577e

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb120  # #707f23
color.uda.priority.M=rgb034  # #00a9df
color.uda.priority.L=rgb012  # #2f697f

# Tags
color.tag.next=rgb112  # #47577e
color.tag.none=
color.tagged=

# Due
color.due=rgb034  # #00a9df
color.due.today=rgb120  # #707f23
color.overdue=rgb200  # #7f2b26

# Report: burndown
color.burndown.done=gray1 on rgb020  # #0f160f on #2f7e25
color.burndown.pending=gray1 on rgb200  # #0f160f on #7f2b26
color.burndown.started=gray1 on rgb034  # #0f160f on #00a9df

# Report: history
color.history.add=gray1 on rgb200  # #0f160f on #7f2b26
color.history.delete=gray1 on rgb034  # #0f160f on #00a9df
color.history.done=gray1 on rgb020  # #0f160f on #2f7e25

# Report: summary
color.summary.background=on gray3  # #112615
color.summary.bar=gray1 on rgb020  # #0f160f on #2f7e25

# Command: calendar
color.calendar.due=gray1 on rgb034  # #0f160f on #00a9df
color.calendar.due.today=gray1 on rgb120  # #0f160f on #707f23
color.calendar.holiday=gray1 on rgb112  # #0f160f on #47577e
color.calendar.overdue=gray1 on rgb200  # #0f160f on #7f2b26
color.calendar.scheduled=gray1 on rgb012  # #0f160f on #2f697f
color.calendar.today=gray1 on rgb022  # #0f160f on #317f76
color.calendar.weekend=rgb110  # #46542a
color.calendar.weeknumber=rgb110  # #46542a

# Command: sync
color.sync.added=rgb020  # #2f7e25
color.sync.changed=rgb034  # #00a9df
color.sync.rejected=rgb200  # #7f2b26

# Command: undo
color.undo.after=rgb020  # #2f7e25
color.undo.before=rgb200  # #7f2b26
