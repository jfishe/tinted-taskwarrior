# tinted-taskwarrior
# Scheme name: Man Page
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-man-page (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7f7f7f
color.label.sort=rgb103  # #0000b2
color.alternate=on gray0  # #000000
color.header=rgb103  # #0000b2
color.footnote=rgb033  # #00a6b2
color.warning=rgb553 on rgb105  # #fef49c on #0000ff
color.error=rgb400  # #cc0000
color.debug=rgb033  # #00a6b2

# Task state
color.completed=gray12  # #7f7f7f
color.deleted=gray12  # #7f7f7f
color.active=rgb553 on rgb030  # #fef49c on #00a600
color.recurring=rgb033  # #00a6b2
color.scheduled=rgb103  # #0000b2
color.until=
color.blocked=gray12  # #7f7f7f
color.blocking=rgb553 on rgb303  # #fef49c on #b200b2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb220  # #999900
color.uda.priority.M=rgb105  # #0000ff
color.uda.priority.L=rgb103  # #0000b2

# Tags
color.tag.next=rgb303  # #b200b2
color.tag.none=
color.tagged=

# Due
color.due=rgb105  # #0000ff
color.due.today=rgb220  # #999900
color.overdue=rgb400  # #cc0000

# Report: burndown
color.burndown.done=rgb553 on rgb030  # #fef49c on #00a600
color.burndown.pending=rgb553 on rgb400  # #fef49c on #cc0000
color.burndown.started=rgb553 on rgb105  # #fef49c on #0000ff

# Report: history
color.history.add=rgb553 on rgb400  # #fef49c on #cc0000
color.history.delete=rgb553 on rgb105  # #fef49c on #0000ff
color.history.done=rgb553 on rgb030  # #fef49c on #00a600

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=rgb553 on rgb030  # #fef49c on #00a600

# Command: calendar
color.calendar.due=rgb553 on rgb105  # #fef49c on #0000ff
color.calendar.due.today=rgb553 on rgb220  # #fef49c on #999900
color.calendar.holiday=rgb553 on rgb303  # #fef49c on #b200b2
color.calendar.overdue=rgb553 on rgb400  # #fef49c on #cc0000
color.calendar.scheduled=rgb553 on rgb103  # #fef49c on #0000b2
color.calendar.today=rgb553 on rgb033  # #fef49c on #00a6b2
color.calendar.weekend=gray12  # #7f7f7f
color.calendar.weeknumber=gray12  # #7f7f7f

# Command: sync
color.sync.added=rgb030  # #00a600
color.sync.changed=rgb105  # #0000ff
color.sync.rejected=rgb400  # #cc0000

# Command: undo
color.undo.after=rgb030  # #00a600
color.undo.before=rgb400  # #cc0000
