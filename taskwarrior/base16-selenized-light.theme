# tinted-taskwarrior
# Scheme name: selenized-light
# Scheme author: Jan Warchol (https://github.com/jan-warchol/selenized) / adapted to base16 by ali
# Scheme: base16-selenized-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray14  # #909995
color.label.sort=rgb014  # #006dce
color.alternate=on rgb443  # #ece3cc
color.header=rgb014  # #006dce
color.footnote=rgb022  # #00978a
color.warning=rgb554 on rgb320  # #fbf3db on #a78300
color.error=rgb400  # #cc1729
color.debug=rgb022  # #00978a

# Task state
color.completed=gray14  # #909995
color.deleted=gray14  # #909995
color.active=rgb554 on rgb020  # #fbf3db on #428b00
color.recurring=rgb022  # #00978a
color.scheduled=rgb014  # #006dce
color.until=
color.blocked=gray14  # #909995
color.blocking=rgb554 on rgb214  # #fbf3db on #825dc0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #bc5819
color.uda.priority.M=rgb320  # #a78300
color.uda.priority.L=rgb014  # #006dce

# Tags
color.tag.next=rgb214  # #825dc0
color.tag.none=
color.tagged=

# Due
color.due=rgb320  # #a78300
color.due.today=rgb410  # #bc5819
color.overdue=rgb400  # #cc1729

# Report: burndown
color.burndown.done=rgb554 on rgb020  # #fbf3db on #428b00
color.burndown.pending=rgb554 on rgb400  # #fbf3db on #cc1729
color.burndown.started=rgb554 on rgb320  # #fbf3db on #a78300

# Report: history
color.history.add=rgb554 on rgb400  # #fbf3db on #cc1729
color.history.delete=rgb554 on rgb320  # #fbf3db on #a78300
color.history.done=rgb554 on rgb020  # #fbf3db on #428b00

# Report: summary
color.summary.background=on rgb443  # #ece3cc
color.summary.bar=rgb554 on rgb020  # #fbf3db on #428b00

# Command: calendar
color.calendar.due=rgb554 on rgb320  # #fbf3db on #a78300
color.calendar.due.today=rgb554 on rgb410  # #fbf3db on #bc5819
color.calendar.holiday=rgb554 on rgb214  # #fbf3db on #825dc0
color.calendar.overdue=rgb554 on rgb400  # #fbf3db on #cc1729
color.calendar.scheduled=rgb554 on rgb014  # #fbf3db on #006dce
color.calendar.today=rgb554 on rgb022  # #fbf3db on #00978a
color.calendar.weekend=gray14  # #909995
color.calendar.weeknumber=gray14  # #909995

# Command: sync
color.sync.added=rgb020  # #428b00
color.sync.changed=rgb320  # #a78300
color.sync.rejected=rgb400  # #cc1729

# Command: undo
color.undo.after=rgb020  # #428b00
color.undo.before=rgb400  # #cc1729
