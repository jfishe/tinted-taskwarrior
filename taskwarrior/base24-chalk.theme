# tinted-taskwarrior
# Scheme name: Chalk
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-chalk (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #505050
color.label.sort=rgb134  # #5ab9ed
color.alternate=on gray2  # #202020
color.header=rgb134  # #5ab9ed
color.footnote=rgb033  # #10bcad
color.warning=gray1 on rgb431  # #151515 on #ddb26f
color.error=rgb523  # #fa859c
color.debug=rgb033  # #10bcad

# Task state
color.completed=gray7  # #505050
color.deleted=gray7  # #505050
color.active=gray1 on rgb231  # #151515 on #a1bb54
color.recurring=rgb033  # #10bcad
color.scheduled=rgb134  # #5ab9ed
color.until=
color.blocked=gray7  # #505050
color.blocking=gray1 on rgb424  # #151515 on #db8fea

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #ea9971
color.uda.priority.M=rgb431  # #ddb26f
color.uda.priority.L=rgb134  # #5ab9ed

# Tags
color.tag.next=rgb424  # #db8fea
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #ddb26f
color.due.today=rgb421  # #ea9971
color.overdue=rgb523  # #fa859c

# Report: burndown
color.burndown.done=gray1 on rgb231  # #151515 on #a1bb54
color.burndown.pending=gray1 on rgb523  # #151515 on #fa859c
color.burndown.started=gray1 on rgb431  # #151515 on #ddb26f

# Report: history
color.history.add=gray1 on rgb523  # #151515 on #fa859c
color.history.delete=gray1 on rgb431  # #151515 on #ddb26f
color.history.done=gray1 on rgb231  # #151515 on #a1bb54

# Report: summary
color.summary.background=on gray2  # #202020
color.summary.bar=gray1 on rgb231  # #151515 on #a1bb54

# Command: calendar
color.calendar.due=gray1 on rgb431  # #151515 on #ddb26f
color.calendar.due.today=gray1 on rgb421  # #151515 on #ea9971
color.calendar.holiday=gray1 on rgb424  # #151515 on #db8fea
color.calendar.overdue=gray1 on rgb523  # #151515 on #fa859c
color.calendar.scheduled=gray1 on rgb134  # #151515 on #5ab9ed
color.calendar.today=gray1 on rgb033  # #151515 on #10bcad
color.calendar.weekend=gray7  # #505050
color.calendar.weeknumber=gray7  # #505050

# Command: sync
color.sync.added=rgb231  # #a1bb54
color.sync.changed=rgb431  # #ddb26f
color.sync.rejected=rgb523  # #fa859c

# Command: undo
color.undo.after=rgb231  # #a1bb54
color.undo.before=rgb523  # #fa859c
