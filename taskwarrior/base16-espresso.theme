# tinted-taskwarrior
# Scheme name: Espresso
# Scheme author: Unknown. Maintained by Alex Mirrington (https://github.com/alexmirrington)
# Scheme: base16-espresso (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #777777
color.label.sort=rgb123  # #6c99bb
color.alternate=on gray5  # #393939
color.header=rgb123  # #6c99bb
color.footnote=rgb345  # #bed6ff
color.warning=gray4 on rgb542  # #2d2d2d on #ffc66d
color.error=rgb411  # #d25252
color.debug=rgb345  # #bed6ff

# Task state
color.completed=gray11  # #777777
color.deleted=gray11  # #777777
color.active=gray4 on rgb341  # #2d2d2d on #a5c261
color.recurring=rgb345  # #bed6ff
color.scheduled=rgb123  # #6c99bb
color.until=
color.blocked=gray11  # #777777
color.blocking=gray4 on rgb424  # #2d2d2d on #d197d9

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #f9a959
color.uda.priority.M=rgb542  # #ffc66d
color.uda.priority.L=rgb123  # #6c99bb

# Tags
color.tag.next=rgb424  # #d197d9
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ffc66d
color.due.today=rgb531  # #f9a959
color.overdue=rgb411  # #d25252

# Report: burndown
color.burndown.done=gray4 on rgb341  # #2d2d2d on #a5c261
color.burndown.pending=gray4 on rgb411  # #2d2d2d on #d25252
color.burndown.started=gray4 on rgb542  # #2d2d2d on #ffc66d

# Report: history
color.history.add=gray4 on rgb411  # #2d2d2d on #d25252
color.history.delete=gray4 on rgb542  # #2d2d2d on #ffc66d
color.history.done=gray4 on rgb341  # #2d2d2d on #a5c261

# Report: summary
color.summary.background=on gray5  # #393939
color.summary.bar=gray4 on rgb341  # #2d2d2d on #a5c261

# Command: calendar
color.calendar.due=gray4 on rgb542  # #2d2d2d on #ffc66d
color.calendar.due.today=gray4 on rgb531  # #2d2d2d on #f9a959
color.calendar.holiday=gray4 on rgb424  # #2d2d2d on #d197d9
color.calendar.overdue=gray4 on rgb411  # #2d2d2d on #d25252
color.calendar.scheduled=gray4 on rgb123  # #2d2d2d on #6c99bb
color.calendar.today=gray4 on rgb345  # #2d2d2d on #bed6ff
color.calendar.weekend=gray11  # #777777
color.calendar.weeknumber=gray11  # #777777

# Command: sync
color.sync.added=rgb341  # #a5c261
color.sync.changed=rgb542  # #ffc66d
color.sync.rejected=rgb411  # #d25252

# Command: undo
color.undo.after=rgb341  # #a5c261
color.undo.before=rgb411  # #d25252
