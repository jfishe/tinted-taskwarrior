# tinted-taskwarrior
# Scheme name: Sundried
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-sundried (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6b6b67
color.label.sort=rgb113  # #485a98
color.alternate=on gray4  # #302b2a
color.header=rgb113  # #485a98
color.footnote=rgb321  # #9c814e
color.warning=gray2 on rgb125  # #1a1818 on #7898f7
color.error=rgb311  # #a6463d
color.debug=rgb321  # #9c814e

# Task state
color.completed=gray10  # #6b6b67
color.deleted=gray10  # #6b6b67
color.active=gray2 on rgb121  # #1a1818 on #577644
color.recurring=rgb321  # #9c814e
color.scheduled=rgb113  # #485a98
color.until=
color.blocked=gray10  # #6b6b67
color.blocking=gray2 on rgb211  # #1a1818 on #854551

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #9c5f2a
color.uda.priority.M=rgb125  # #7898f7
color.uda.priority.L=rgb113  # #485a98

# Tags
color.tag.next=rgb211  # #854551
color.tag.none=
color.tagged=

# Due
color.due=rgb125  # #7898f7
color.due.today=rgb310  # #9c5f2a
color.overdue=rgb311  # #a6463d

# Report: burndown
color.burndown.done=gray2 on rgb121  # #1a1818 on #577644
color.burndown.pending=gray2 on rgb311  # #1a1818 on #a6463d
color.burndown.started=gray2 on rgb125  # #1a1818 on #7898f7

# Report: history
color.history.add=gray2 on rgb311  # #1a1818 on #a6463d
color.history.delete=gray2 on rgb125  # #1a1818 on #7898f7
color.history.done=gray2 on rgb121  # #1a1818 on #577644

# Report: summary
color.summary.background=on gray4  # #302b2a
color.summary.bar=gray2 on rgb121  # #1a1818 on #577644

# Command: calendar
color.calendar.due=gray2 on rgb125  # #1a1818 on #7898f7
color.calendar.due.today=gray2 on rgb310  # #1a1818 on #9c5f2a
color.calendar.holiday=gray2 on rgb211  # #1a1818 on #854551
color.calendar.overdue=gray2 on rgb311  # #1a1818 on #a6463d
color.calendar.scheduled=gray2 on rgb113  # #1a1818 on #485a98
color.calendar.today=gray2 on rgb321  # #1a1818 on #9c814e
color.calendar.weekend=gray10  # #6b6b67
color.calendar.weeknumber=gray10  # #6b6b67

# Command: sync
color.sync.added=rgb121  # #577644
color.sync.changed=rgb125  # #7898f7
color.sync.rejected=rgb311  # #a6463d

# Command: undo
color.undo.after=rgb121  # #577644
color.undo.before=rgb311  # #a6463d
