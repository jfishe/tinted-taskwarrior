# tinted-taskwarrior
# Scheme name: Tokyo City Terminal Dark
# Scheme author: Michaël Ball
# Scheme: base16-tokyo-city-terminal-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb111  # #526270
color.label.sort=rgb025  # #539afc
color.alternate=on gray3  # #1d252c
color.header=rgb025  # #539afc
color.footnote=rgb144  # #70e1e8
color.warning=gray2 on rgb432  # #171d23 on #ebbf83
color.error=rgb411  # #d95468
color.debug=rgb144  # #70e1e8

# Task state
color.completed=rgb111  # #526270
color.deleted=rgb111  # #526270
color.active=gray2 on rgb243  # #171d23 on #8bd49c
color.recurring=rgb144  # #70e1e8
color.scheduled=rgb025  # #539afc
color.until=
color.blocked=rgb111  # #526270
color.blocking=gray2 on rgb301  # #171d23 on #b62d65

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #ff9e64
color.uda.priority.M=rgb432  # #ebbf83
color.uda.priority.L=rgb025  # #539afc

# Tags
color.tag.next=rgb301  # #b62d65
color.tag.none=
color.tagged=

# Due
color.due=rgb432  # #ebbf83
color.due.today=rgb532  # #ff9e64
color.overdue=rgb411  # #d95468

# Report: burndown
color.burndown.done=gray2 on rgb243  # #171d23 on #8bd49c
color.burndown.pending=gray2 on rgb411  # #171d23 on #d95468
color.burndown.started=gray2 on rgb432  # #171d23 on #ebbf83

# Report: history
color.history.add=gray2 on rgb411  # #171d23 on #d95468
color.history.delete=gray2 on rgb432  # #171d23 on #ebbf83
color.history.done=gray2 on rgb243  # #171d23 on #8bd49c

# Report: summary
color.summary.background=on gray3  # #1d252c
color.summary.bar=gray2 on rgb243  # #171d23 on #8bd49c

# Command: calendar
color.calendar.due=gray2 on rgb432  # #171d23 on #ebbf83
color.calendar.due.today=gray2 on rgb532  # #171d23 on #ff9e64
color.calendar.holiday=gray2 on rgb301  # #171d23 on #b62d65
color.calendar.overdue=gray2 on rgb411  # #171d23 on #d95468
color.calendar.scheduled=gray2 on rgb025  # #171d23 on #539afc
color.calendar.today=gray2 on rgb144  # #171d23 on #70e1e8
color.calendar.weekend=rgb111  # #526270
color.calendar.weeknumber=rgb111  # #526270

# Command: sync
color.sync.added=rgb243  # #8bd49c
color.sync.changed=rgb432  # #ebbf83
color.sync.rejected=rgb411  # #d95468

# Command: undo
color.undo.after=rgb243  # #8bd49c
color.undo.before=rgb411  # #d95468
