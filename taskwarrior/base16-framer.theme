# tinted-taskwarrior
# Scheme name: Framer
# Scheme author: Framer (Maintained by Jesse Hoyos)
# Scheme: base16-framer (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #747474
color.label.sort=rgb035  # #20bcfc
color.alternate=on gray1  # #151515
color.header=rgb035  # #20bcfc
color.footnote=rgb345  # #acddfd
color.warning=gray2 on rgb542  # #181818 on #fecb6e
color.error=rgb521  # #fd886b
color.debug=rgb345  # #acddfd

# Task state
color.completed=gray11  # #747474
color.deleted=gray11  # #747474
color.active=gray2 on rgb144  # #181818 on #32ccdc
color.recurring=rgb345  # #acddfd
color.scheduled=rgb035  # #20bcfc
color.until=
color.blocked=gray11  # #747474
color.blocking=gray2 on rgb325  # #181818 on #ba8cfc

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb501  # #fc4769
color.uda.priority.M=rgb542  # #fecb6e
color.uda.priority.L=rgb035  # #20bcfc

# Tags
color.tag.next=rgb325  # #ba8cfc
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #fecb6e
color.due.today=rgb501  # #fc4769
color.overdue=rgb521  # #fd886b

# Report: burndown
color.burndown.done=gray2 on rgb144  # #181818 on #32ccdc
color.burndown.pending=gray2 on rgb521  # #181818 on #fd886b
color.burndown.started=gray2 on rgb542  # #181818 on #fecb6e

# Report: history
color.history.add=gray2 on rgb521  # #181818 on #fd886b
color.history.delete=gray2 on rgb542  # #181818 on #fecb6e
color.history.done=gray2 on rgb144  # #181818 on #32ccdc

# Report: summary
color.summary.background=on gray1  # #151515
color.summary.bar=gray2 on rgb144  # #181818 on #32ccdc

# Command: calendar
color.calendar.due=gray2 on rgb542  # #181818 on #fecb6e
color.calendar.due.today=gray2 on rgb501  # #181818 on #fc4769
color.calendar.holiday=gray2 on rgb325  # #181818 on #ba8cfc
color.calendar.overdue=gray2 on rgb521  # #181818 on #fd886b
color.calendar.scheduled=gray2 on rgb035  # #181818 on #20bcfc
color.calendar.today=gray2 on rgb345  # #181818 on #acddfd
color.calendar.weekend=gray11  # #747474
color.calendar.weeknumber=gray11  # #747474

# Command: sync
color.sync.added=rgb144  # #32ccdc
color.sync.changed=rgb542  # #fecb6e
color.sync.rejected=rgb521  # #fd886b

# Command: undo
color.undo.after=rgb144  # #32ccdc
color.undo.before=rgb521  # #fd886b
