# tinted-taskwarrior
# Scheme name: deep
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-deep (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #767676
color.label.sort=rgb115  # #5665fe
color.alternate=on gray0  # #000000
color.header=rgb115  # #5665fe
color.footnote=rgb144  # #4fd2d9
color.warning=gray0 on rgb335  # #080808 on #9fa8fe
color.error=rgb400  # #d60005
color.debug=rgb144  # #4fd2d9

# Task state
color.completed=gray11  # #767676
color.deleted=gray11  # #767676
color.active=gray0 on rgb040  # #080808 on #1cd815
color.recurring=rgb144  # #4fd2d9
color.scheduled=rgb115  # #5665fe
color.until=
color.blocked=gray11  # #767676
color.blocking=gray0 on rgb314  # #080808 on #af51d9

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb430  # #d9bc25
color.uda.priority.M=rgb335  # #9fa8fe
color.uda.priority.L=rgb115  # #5665fe

# Tags
color.tag.next=rgb314  # #af51d9
color.tag.none=
color.tagged=

# Due
color.due=rgb335  # #9fa8fe
color.due.today=rgb430  # #d9bc25
color.overdue=rgb400  # #d60005

# Report: burndown
color.burndown.done=gray0 on rgb040  # #080808 on #1cd815
color.burndown.pending=gray0 on rgb400  # #080808 on #d60005
color.burndown.started=gray0 on rgb335  # #080808 on #9fa8fe

# Report: history
color.history.add=gray0 on rgb400  # #080808 on #d60005
color.history.delete=gray0 on rgb335  # #080808 on #9fa8fe
color.history.done=gray0 on rgb040  # #080808 on #1cd815

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray0 on rgb040  # #080808 on #1cd815

# Command: calendar
color.calendar.due=gray0 on rgb335  # #080808 on #9fa8fe
color.calendar.due.today=gray0 on rgb430  # #080808 on #d9bc25
color.calendar.holiday=gray0 on rgb314  # #080808 on #af51d9
color.calendar.overdue=gray0 on rgb400  # #080808 on #d60005
color.calendar.scheduled=gray0 on rgb115  # #080808 on #5665fe
color.calendar.today=gray0 on rgb144  # #080808 on #4fd2d9
color.calendar.weekend=gray11  # #767676
color.calendar.weeknumber=gray11  # #767676

# Command: sync
color.sync.added=rgb040  # #1cd815
color.sync.changed=rgb335  # #9fa8fe
color.sync.rejected=rgb400  # #d60005

# Command: undo
color.undo.after=rgb040  # #1cd815
color.undo.before=rgb400  # #d60005
