# tinted-taskwarrior
# Scheme name: Lumina Espresso Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-espresso-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray4  # #382d24
color.label.sort=rgb234  # #96bfe9
color.alternate=on gray2  # #231911
color.header=rgb234  # #96bfe9
color.footnote=rgb244  # #90cad1
color.warning=gray1 on rgb542  # #1e150e on #efca86
color.error=rgb411  # #cd766e
color.debug=rgb244  # #90cad1

# Task state
color.completed=gray4  # #382d24
color.deleted=gray4  # #382d24
color.active=gray1 on rgb243  # #1e150e on #95d3b1
color.recurring=rgb244  # #90cad1
color.scheduled=rgb234  # #96bfe9
color.until=
color.blocked=gray4  # #382d24
color.blocking=gray1 on rgb435  # #1e150e on #c7ade7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb432  # #d9bfa6
color.uda.priority.M=rgb542  # #efca86
color.uda.priority.L=rgb234  # #96bfe9

# Tags
color.tag.next=rgb435  # #c7ade7
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #efca86
color.due.today=rgb432  # #d9bfa6
color.overdue=rgb411  # #cd766e

# Report: burndown
color.burndown.done=gray1 on rgb243  # #1e150e on #95d3b1
color.burndown.pending=gray1 on rgb411  # #1e150e on #cd766e
color.burndown.started=gray1 on rgb542  # #1e150e on #efca86

# Report: history
color.history.add=gray1 on rgb411  # #1e150e on #cd766e
color.history.delete=gray1 on rgb542  # #1e150e on #efca86
color.history.done=gray1 on rgb243  # #1e150e on #95d3b1

# Report: summary
color.summary.background=on gray2  # #231911
color.summary.bar=gray1 on rgb243  # #1e150e on #95d3b1

# Command: calendar
color.calendar.due=gray1 on rgb542  # #1e150e on #efca86
color.calendar.due.today=gray1 on rgb432  # #1e150e on #d9bfa6
color.calendar.holiday=gray1 on rgb435  # #1e150e on #c7ade7
color.calendar.overdue=gray1 on rgb411  # #1e150e on #cd766e
color.calendar.scheduled=gray1 on rgb234  # #1e150e on #96bfe9
color.calendar.today=gray1 on rgb244  # #1e150e on #90cad1
color.calendar.weekend=gray4  # #382d24
color.calendar.weeknumber=gray4  # #382d24

# Command: sync
color.sync.added=rgb243  # #95d3b1
color.sync.changed=rgb542  # #efca86
color.sync.rejected=rgb411  # #cd766e

# Command: undo
color.undo.after=rgb243  # #95d3b1
color.undo.before=rgb411  # #cd766e
