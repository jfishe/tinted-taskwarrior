# tinted-taskwarrior
# Scheme name: Purple Rain
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-purple-rain (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7f7f7f
color.label.sort=rgb035  # #00a1f9
color.alternate=on gray0  # #000000
color.header=rgb035  # #00a1f9
color.footnote=rgb144  # #00ddef
color.warning=rgb101 on rgb035  # #20084a on #00a5ff
color.error=rgb500  # #ff260d
color.debug=rgb144  # #00ddef

# Task state
color.completed=gray12  # #7f7f7f
color.deleted=gray12  # #7f7f7f
color.active=rgb101 on rgb240  # #20084a on #9ae204
color.recurring=rgb144  # #00ddef
color.scheduled=rgb035  # #00a1f9
color.until=
color.blocked=gray12  # #7f7f7f
color.blocking=rgb101 on rgb213  # #20084a on #805bb5

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb540  # #ffc400
color.uda.priority.M=rgb035  # #00a5ff
color.uda.priority.L=rgb035  # #00a1f9

# Tags
color.tag.next=rgb213  # #805bb5
color.tag.none=
color.tagged=

# Due
color.due=rgb035  # #00a5ff
color.due.today=rgb540  # #ffc400
color.overdue=rgb500  # #ff260d

# Report: burndown
color.burndown.done=rgb101 on rgb240  # #20084a on #9ae204
color.burndown.pending=rgb101 on rgb500  # #20084a on #ff260d
color.burndown.started=rgb101 on rgb035  # #20084a on #00a5ff

# Report: history
color.history.add=rgb101 on rgb500  # #20084a on #ff260d
color.history.delete=rgb101 on rgb035  # #20084a on #00a5ff
color.history.done=rgb101 on rgb240  # #20084a on #9ae204

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=rgb101 on rgb240  # #20084a on #9ae204

# Command: calendar
color.calendar.due=rgb101 on rgb035  # #20084a on #00a5ff
color.calendar.due.today=rgb101 on rgb540  # #20084a on #ffc400
color.calendar.holiday=rgb101 on rgb213  # #20084a on #805bb5
color.calendar.overdue=rgb101 on rgb500  # #20084a on #ff260d
color.calendar.scheduled=rgb101 on rgb035  # #20084a on #00a1f9
color.calendar.today=rgb101 on rgb144  # #20084a on #00ddef
color.calendar.weekend=gray12  # #7f7f7f
color.calendar.weeknumber=gray12  # #7f7f7f

# Command: sync
color.sync.added=rgb240  # #9ae204
color.sync.changed=rgb035  # #00a5ff
color.sync.rejected=rgb500  # #ff260d

# Command: undo
color.undo.after=rgb240  # #9ae204
color.undo.before=rgb500  # #ff260d
