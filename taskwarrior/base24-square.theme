# tinted-taskwarrior
# Scheme name: Square
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-square (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #4b4b4b
color.label.sort=rgb345  # #a9cdeb
color.alternate=on gray0  # #050505
color.header=rgb345  # #a9cdeb
color.footnote=rgb445  # #c9caec
color.warning=gray2 on rgb345  # #1a1a1a on #b6defb
color.error=rgb522  # #e9897c
color.debug=rgb445  # #c9caec

# Task state
color.completed=gray7  # #4b4b4b
color.deleted=gray7  # #4b4b4b
color.active=gray2 on rgb402  # #1a1a1a on #b6377d
color.recurring=rgb445  # #c9caec
color.scheduled=rgb345  # #a9cdeb
color.until=
color.blocked=gray7  # #4b4b4b
color.blocking=gray2 on rgb212  # #1a1a1a on #75507b

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb554  # #ecebbe
color.uda.priority.M=rgb345  # #b6defb
color.uda.priority.L=rgb345  # #a9cdeb

# Tags
color.tag.next=rgb212  # #75507b
color.tag.none=
color.tagged=

# Due
color.due=rgb345  # #b6defb
color.due.today=rgb554  # #ecebbe
color.overdue=rgb522  # #e9897c

# Report: burndown
color.burndown.done=gray2 on rgb402  # #1a1a1a on #b6377d
color.burndown.pending=gray2 on rgb522  # #1a1a1a on #e9897c
color.burndown.started=gray2 on rgb345  # #1a1a1a on #b6defb

# Report: history
color.history.add=gray2 on rgb522  # #1a1a1a on #e9897c
color.history.delete=gray2 on rgb345  # #1a1a1a on #b6defb
color.history.done=gray2 on rgb402  # #1a1a1a on #b6377d

# Report: summary
color.summary.background=on gray0  # #050505
color.summary.bar=gray2 on rgb402  # #1a1a1a on #b6377d

# Command: calendar
color.calendar.due=gray2 on rgb345  # #1a1a1a on #b6defb
color.calendar.due.today=gray2 on rgb554  # #1a1a1a on #ecebbe
color.calendar.holiday=gray2 on rgb212  # #1a1a1a on #75507b
color.calendar.overdue=gray2 on rgb522  # #1a1a1a on #e9897c
color.calendar.scheduled=gray2 on rgb345  # #1a1a1a on #a9cdeb
color.calendar.today=gray2 on rgb445  # #1a1a1a on #c9caec
color.calendar.weekend=gray7  # #4b4b4b
color.calendar.weeknumber=gray7  # #4b4b4b

# Command: sync
color.sync.added=rgb402  # #b6377d
color.sync.changed=rgb345  # #b6defb
color.sync.rejected=rgb522  # #e9897c

# Command: undo
color.undo.after=rgb402  # #b6377d
color.undo.before=rgb522  # #e9897c
