# tinted-taskwarrior
# Scheme name: Black Metal (Mayhem)
# Scheme author: metalelf0 (https://github.com/metalelf0)
# Scheme: base16-black-metal-mayhem (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray4  # #333333
color.label.sort=rgb222  # #888888
color.alternate=on gray1  # #121212
color.header=rgb222  # #888888
color.footnote=gray16  # #aaaaaa
color.warning=gray0 on rgb541  # #000000 on #eecc6c
color.error=rgb122  # #5f8787
color.debug=gray16  # #aaaaaa

# Task state
color.completed=gray4  # #333333
color.deleted=gray4  # #333333
color.active=gray0 on rgb554  # #000000 on #f3ecd4
color.recurring=gray16  # #aaaaaa
color.scheduled=rgb222  # #888888
color.until=
color.blocked=gray4  # #333333
color.blocking=gray0 on gray15  # #000000 on #999999

# Project
color.project.none=

# Priority
color.uda.priority.H=gray16  # #aaaaaa
color.uda.priority.M=rgb541  # #eecc6c
color.uda.priority.L=rgb222  # #888888

# Tags
color.tag.next=gray15  # #999999
color.tag.none=
color.tagged=

# Due
color.due=rgb541  # #eecc6c
color.due.today=gray16  # #aaaaaa
color.overdue=rgb122  # #5f8787

# Report: burndown
color.burndown.done=gray0 on rgb554  # #000000 on #f3ecd4
color.burndown.pending=gray0 on rgb122  # #000000 on #5f8787
color.burndown.started=gray0 on rgb541  # #000000 on #eecc6c

# Report: history
color.history.add=gray0 on rgb122  # #000000 on #5f8787
color.history.delete=gray0 on rgb541  # #000000 on #eecc6c
color.history.done=gray0 on rgb554  # #000000 on #f3ecd4

# Report: summary
color.summary.background=on gray1  # #121212
color.summary.bar=gray0 on rgb554  # #000000 on #f3ecd4

# Command: calendar
color.calendar.due=gray0 on rgb541  # #000000 on #eecc6c
color.calendar.due.today=gray0 on gray16  # #000000 on #aaaaaa
color.calendar.holiday=gray0 on gray15  # #000000 on #999999
color.calendar.overdue=gray0 on rgb122  # #000000 on #5f8787
color.calendar.scheduled=gray0 on rgb222  # #000000 on #888888
color.calendar.today=gray0 on gray16  # #000000 on #aaaaaa
color.calendar.weekend=gray4  # #333333
color.calendar.weeknumber=gray4  # #333333

# Command: sync
color.sync.added=rgb554  # #f3ecd4
color.sync.changed=rgb541  # #eecc6c
color.sync.rejected=rgb122  # #5f8787

# Command: undo
color.undo.after=rgb554  # #f3ecd4
color.undo.before=rgb122  # #5f8787
