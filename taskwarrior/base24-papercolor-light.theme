# tinted-taskwarrior
# Scheme name: PaperColor Light
# Scheme author: Nguyen Nguyen (https://github.com/NLKNguyen/papercolor-theme)
# Scheme: base24-papercolor-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb222  # #878787
color.label.sort=rgb023  # #0087af
color.alternate=on gray22  # #e4e4e4
color.header=rgb023  # #0087af
color.footnote=rgb410  # #d75f00
color.warning=gray23 on rgb120  # #eeeeee on #5f8700
color.error=rgb300  # #af0000
color.debug=rgb410  # #d75f00

# Task state
color.completed=rgb222  # #878787
color.deleted=rgb222  # #878787
color.active=gray23 on rgb020  # #eeeeee on #008700
color.recurring=rgb410  # #d75f00
color.scheduled=rgb023  # #0087af
color.until=
color.blocked=rgb222  # #878787
color.blocking=gray23 on rgb203  # #eeeeee on #8700af

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb402  # #d70087
color.uda.priority.M=rgb120  # #5f8700
color.uda.priority.L=rgb023  # #0087af

# Tags
color.tag.next=rgb203  # #8700af
color.tag.none=
color.tagged=

# Due
color.due=rgb120  # #5f8700
color.due.today=rgb402  # #d70087
color.overdue=rgb300  # #af0000

# Report: burndown
color.burndown.done=gray23 on rgb020  # #eeeeee on #008700
color.burndown.pending=gray23 on rgb300  # #eeeeee on #af0000
color.burndown.started=gray23 on rgb120  # #eeeeee on #5f8700

# Report: history
color.history.add=gray23 on rgb300  # #eeeeee on #af0000
color.history.delete=gray23 on rgb120  # #eeeeee on #5f8700
color.history.done=gray23 on rgb020  # #eeeeee on #008700

# Report: summary
color.summary.background=on gray22  # #e4e4e4
color.summary.bar=gray23 on rgb020  # #eeeeee on #008700

# Command: calendar
color.calendar.due=gray23 on rgb120  # #eeeeee on #5f8700
color.calendar.due.today=gray23 on rgb402  # #eeeeee on #d70087
color.calendar.holiday=gray23 on rgb203  # #eeeeee on #8700af
color.calendar.overdue=gray23 on rgb300  # #eeeeee on #af0000
color.calendar.scheduled=gray23 on rgb023  # #eeeeee on #0087af
color.calendar.today=gray23 on rgb410  # #eeeeee on #d75f00
color.calendar.weekend=rgb222  # #878787
color.calendar.weeknumber=rgb222  # #878787

# Command: sync
color.sync.added=rgb020  # #008700
color.sync.changed=rgb120  # #5f8700
color.sync.rejected=rgb300  # #af0000

# Command: undo
color.undo.after=rgb020  # #008700
color.undo.before=rgb300  # #af0000
