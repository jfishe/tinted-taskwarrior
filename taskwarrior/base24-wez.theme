# tinted-taskwarrior
# Scheme name: Wez
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-wez (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #727272
color.label.sort=rgb114  # #5455cb
color.alternate=on gray0  # #000000
color.header=rgb114  # #5455cb
color.footnote=rgb244  # #7acaca
color.warning=gray0 on rgb115  # #000000 on #5555ff
color.error=rgb411  # #cc5555
color.debug=rgb244  # #7acaca

# Task state
color.completed=gray11  # #727272
color.deleted=gray11  # #727272
color.active=gray0 on rgb141  # #000000 on #55cc55
color.recurring=rgb244  # #7acaca
color.scheduled=rgb114  # #5455cb
color.until=
color.blocked=gray11  # #727272
color.blocking=gray0 on rgb414  # #000000 on #cc55cc

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb441  # #cdcd55
color.uda.priority.M=rgb115  # #5555ff
color.uda.priority.L=rgb114  # #5455cb

# Tags
color.tag.next=rgb414  # #cc55cc
color.tag.none=
color.tagged=

# Due
color.due=rgb115  # #5555ff
color.due.today=rgb441  # #cdcd55
color.overdue=rgb411  # #cc5555

# Report: burndown
color.burndown.done=gray0 on rgb141  # #000000 on #55cc55
color.burndown.pending=gray0 on rgb411  # #000000 on #cc5555
color.burndown.started=gray0 on rgb115  # #000000 on #5555ff

# Report: history
color.history.add=gray0 on rgb411  # #000000 on #cc5555
color.history.delete=gray0 on rgb115  # #000000 on #5555ff
color.history.done=gray0 on rgb141  # #000000 on #55cc55

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray0 on rgb141  # #000000 on #55cc55

# Command: calendar
color.calendar.due=gray0 on rgb115  # #000000 on #5555ff
color.calendar.due.today=gray0 on rgb441  # #000000 on #cdcd55
color.calendar.holiday=gray0 on rgb414  # #000000 on #cc55cc
color.calendar.overdue=gray0 on rgb411  # #000000 on #cc5555
color.calendar.scheduled=gray0 on rgb114  # #000000 on #5455cb
color.calendar.today=gray0 on rgb244  # #000000 on #7acaca
color.calendar.weekend=gray11  # #727272
color.calendar.weeknumber=gray11  # #727272

# Command: sync
color.sync.added=rgb141  # #55cc55
color.sync.changed=rgb115  # #5555ff
color.sync.rejected=rgb411  # #cc5555

# Command: undo
color.undo.after=rgb141  # #55cc55
color.undo.before=rgb411  # #cc5555
