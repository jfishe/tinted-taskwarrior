# tinted-taskwarrior
# Scheme name: Sandcastle
# Scheme author: George Essig (https://github.com/gessig)
# Scheme: base16-sandcastle (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb111  # #665c54
color.label.sort=rgb233  # #83a598
color.alternate=on gray4  # #2c323b
color.header=rgb233  # #83a598
color.footnote=rgb233  # #83a598
color.warning=gray4 on rgb320  # #282c34 on #a07e3b
color.error=rgb233  # #83a598
color.debug=rgb233  # #83a598

# Task state
color.completed=rgb111  # #665c54
color.deleted=rgb111  # #665c54
color.active=gray4 on rgb122  # #282c34 on #528b8b
color.recurring=rgb233  # #83a598
color.scheduled=rgb233  # #83a598
color.until=
color.blocked=rgb111  # #665c54
color.blocking=gray4 on rgb411  # #282c34 on #d75f5f

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb320  # #a07e3b
color.uda.priority.M=rgb320  # #a07e3b
color.uda.priority.L=rgb233  # #83a598

# Tags
color.tag.next=rgb411  # #d75f5f
color.tag.none=
color.tagged=

# Due
color.due=rgb320  # #a07e3b
color.due.today=rgb320  # #a07e3b
color.overdue=rgb233  # #83a598

# Report: burndown
color.burndown.done=gray4 on rgb122  # #282c34 on #528b8b
color.burndown.pending=gray4 on rgb233  # #282c34 on #83a598
color.burndown.started=gray4 on rgb320  # #282c34 on #a07e3b

# Report: history
color.history.add=gray4 on rgb233  # #282c34 on #83a598
color.history.delete=gray4 on rgb320  # #282c34 on #a07e3b
color.history.done=gray4 on rgb122  # #282c34 on #528b8b

# Report: summary
color.summary.background=on gray4  # #2c323b
color.summary.bar=gray4 on rgb122  # #282c34 on #528b8b

# Command: calendar
color.calendar.due=gray4 on rgb320  # #282c34 on #a07e3b
color.calendar.due.today=gray4 on rgb320  # #282c34 on #a07e3b
color.calendar.holiday=gray4 on rgb411  # #282c34 on #d75f5f
color.calendar.overdue=gray4 on rgb233  # #282c34 on #83a598
color.calendar.scheduled=gray4 on rgb233  # #282c34 on #83a598
color.calendar.today=gray4 on rgb233  # #282c34 on #83a598
color.calendar.weekend=rgb111  # #665c54
color.calendar.weeknumber=rgb111  # #665c54

# Command: sync
color.sync.added=rgb122  # #528b8b
color.sync.changed=rgb320  # #a07e3b
color.sync.rejected=rgb233  # #83a598

# Command: undo
color.undo.after=rgb122  # #528b8b
color.undo.before=rgb233  # #83a598
