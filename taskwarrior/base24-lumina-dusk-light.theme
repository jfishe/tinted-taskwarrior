# tinted-taskwarrior
# Scheme name: Lumina Dusk Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-dusk-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray20  # #d4d0de
color.label.sort=rgb013  # #3163ad
color.alternate=on gray23  # #f0ecfa
color.header=rgb013  # #3163ad
color.footnote=rgb012  # #007185
color.warning=gray23 on rgb310  # #f6f3fe on #9e611b
color.error=rgb200  # #872423
color.debug=rgb012  # #007185

# Task state
color.completed=gray20  # #d4d0de
color.deleted=gray20  # #d4d0de
color.active=gray23 on rgb021  # #f6f3fe on #357545
color.recurring=rgb012  # #007185
color.scheduled=rgb013  # #3163ad
color.until=
color.blocked=gray20  # #d4d0de
color.blocking=gray23 on rgb213  # #f6f3fe on #7b46a4

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #8c491d
color.uda.priority.M=rgb310  # #9e611b
color.uda.priority.L=rgb013  # #3163ad

# Tags
color.tag.next=rgb213  # #7b46a4
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #9e611b
color.due.today=rgb310  # #8c491d
color.overdue=rgb200  # #872423

# Report: burndown
color.burndown.done=gray23 on rgb021  # #f6f3fe on #357545
color.burndown.pending=gray23 on rgb200  # #f6f3fe on #872423
color.burndown.started=gray23 on rgb310  # #f6f3fe on #9e611b

# Report: history
color.history.add=gray23 on rgb200  # #f6f3fe on #872423
color.history.delete=gray23 on rgb310  # #f6f3fe on #9e611b
color.history.done=gray23 on rgb021  # #f6f3fe on #357545

# Report: summary
color.summary.background=on gray23  # #f0ecfa
color.summary.bar=gray23 on rgb021  # #f6f3fe on #357545

# Command: calendar
color.calendar.due=gray23 on rgb310  # #f6f3fe on #9e611b
color.calendar.due.today=gray23 on rgb310  # #f6f3fe on #8c491d
color.calendar.holiday=gray23 on rgb213  # #f6f3fe on #7b46a4
color.calendar.overdue=gray23 on rgb200  # #f6f3fe on #872423
color.calendar.scheduled=gray23 on rgb013  # #f6f3fe on #3163ad
color.calendar.today=gray23 on rgb012  # #f6f3fe on #007185
color.calendar.weekend=gray20  # #d4d0de
color.calendar.weeknumber=gray20  # #d4d0de

# Command: sync
color.sync.added=rgb021  # #357545
color.sync.changed=rgb310  # #9e611b
color.sync.rejected=rgb200  # #872423

# Command: undo
color.undo.after=rgb021  # #357545
color.undo.before=rgb200  # #872423
