# tinted-taskwarrior
# Scheme name: Purpledream
# Scheme author: malet
# Scheme: base16-purpledream (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #605060
color.label.sort=rgb035  # #00a0f0
color.alternate=on gray3  # #302030
color.header=rgb035  # #00a0f0
color.footnote=rgb024  # #0075b0
color.warning=gray0 on rgb503  # #100510 on #f000a0
color.error=rgb500  # #ff1d0d
color.debug=rgb024  # #0075b0

# Task state
color.completed=rgb112  # #605060
color.deleted=rgb112  # #605060
color.active=gray0 on rgb041  # #100510 on #14cc64
color.recurring=rgb024  # #0075b0
color.scheduled=rgb035  # #00a0f0
color.until=
color.blocked=rgb112  # #605060
color.blocking=gray0 on rgb304  # #100510 on #b000d0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb430  # #ccae14
color.uda.priority.M=rgb503  # #f000a0
color.uda.priority.L=rgb035  # #00a0f0

# Tags
color.tag.next=rgb304  # #b000d0
color.tag.none=
color.tagged=

# Due
color.due=rgb503  # #f000a0
color.due.today=rgb430  # #ccae14
color.overdue=rgb500  # #ff1d0d

# Report: burndown
color.burndown.done=gray0 on rgb041  # #100510 on #14cc64
color.burndown.pending=gray0 on rgb500  # #100510 on #ff1d0d
color.burndown.started=gray0 on rgb503  # #100510 on #f000a0

# Report: history
color.history.add=gray0 on rgb500  # #100510 on #ff1d0d
color.history.delete=gray0 on rgb503  # #100510 on #f000a0
color.history.done=gray0 on rgb041  # #100510 on #14cc64

# Report: summary
color.summary.background=on gray3  # #302030
color.summary.bar=gray0 on rgb041  # #100510 on #14cc64

# Command: calendar
color.calendar.due=gray0 on rgb503  # #100510 on #f000a0
color.calendar.due.today=gray0 on rgb430  # #100510 on #ccae14
color.calendar.holiday=gray0 on rgb304  # #100510 on #b000d0
color.calendar.overdue=gray0 on rgb500  # #100510 on #ff1d0d
color.calendar.scheduled=gray0 on rgb035  # #100510 on #00a0f0
color.calendar.today=gray0 on rgb024  # #100510 on #0075b0
color.calendar.weekend=rgb112  # #605060
color.calendar.weeknumber=rgb112  # #605060

# Command: sync
color.sync.added=rgb041  # #14cc64
color.sync.changed=rgb503  # #f000a0
color.sync.rejected=rgb500  # #ff1d0d

# Command: undo
color.undo.after=rgb041  # #14cc64
color.undo.before=rgb500  # #ff1d0d
