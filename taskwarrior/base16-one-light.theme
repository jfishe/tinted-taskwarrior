# tinted-taskwarrior
# Scheme name: One Light
# Scheme author: Daniel Pfeifer (http://github.com/purpleKarrot)
# Scheme: base16-one-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray15  # #a0a1a7
color.label.sort=rgb124  # #4078f2
color.alternate=on gray23  # #f0f0f1
color.header=rgb124  # #4078f2
color.footnote=rgb024  # #0184bc
color.warning=rgb555 on rgb420  # #fafafa on #c18401
color.error=rgb401  # #ca1243
color.debug=rgb024  # #0184bc

# Task state
color.completed=gray15  # #a0a1a7
color.deleted=gray15  # #a0a1a7
color.active=rgb555 on rgb131  # #fafafa on #50a14f
color.recurring=rgb024  # #0184bc
color.scheduled=rgb124  # #4078f2
color.until=
color.blocked=gray15  # #a0a1a7
color.blocking=rgb555 on rgb303  # #fafafa on #a626a4

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #d75f00
color.uda.priority.M=rgb420  # #c18401
color.uda.priority.L=rgb124  # #4078f2

# Tags
color.tag.next=rgb303  # #a626a4
color.tag.none=
color.tagged=

# Due
color.due=rgb420  # #c18401
color.due.today=rgb410  # #d75f00
color.overdue=rgb401  # #ca1243

# Report: burndown
color.burndown.done=rgb555 on rgb131  # #fafafa on #50a14f
color.burndown.pending=rgb555 on rgb401  # #fafafa on #ca1243
color.burndown.started=rgb555 on rgb420  # #fafafa on #c18401

# Report: history
color.history.add=rgb555 on rgb401  # #fafafa on #ca1243
color.history.delete=rgb555 on rgb420  # #fafafa on #c18401
color.history.done=rgb555 on rgb131  # #fafafa on #50a14f

# Report: summary
color.summary.background=on gray23  # #f0f0f1
color.summary.bar=rgb555 on rgb131  # #fafafa on #50a14f

# Command: calendar
color.calendar.due=rgb555 on rgb420  # #fafafa on #c18401
color.calendar.due.today=rgb555 on rgb410  # #fafafa on #d75f00
color.calendar.holiday=rgb555 on rgb303  # #fafafa on #a626a4
color.calendar.overdue=rgb555 on rgb401  # #fafafa on #ca1243
color.calendar.scheduled=rgb555 on rgb124  # #fafafa on #4078f2
color.calendar.today=rgb555 on rgb024  # #fafafa on #0184bc
color.calendar.weekend=gray15  # #a0a1a7
color.calendar.weeknumber=gray15  # #a0a1a7

# Command: sync
color.sync.added=rgb131  # #50a14f
color.sync.changed=rgb420  # #c18401
color.sync.rejected=rgb401  # #ca1243

# Command: undo
color.undo.after=rgb131  # #50a14f
color.undo.before=rgb401  # #ca1243
