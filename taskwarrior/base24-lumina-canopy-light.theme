# tinted-taskwarrior
# Scheme name: Lumina Canopy Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-canopy-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb444  # #cdd7cb
color.label.sort=rgb013  # #046aa7
color.alternate=on gray23  # #e9f3e6
color.header=rgb013  # #046aa7
color.footnote=rgb011  # #007184
color.warning=rgb555 on rgb210  # #f1f9ef on #905705
color.error=rgb100  # #860c2c
color.debug=rgb011  # #007184

# Task state
color.completed=rgb444  # #cdd7cb
color.deleted=rgb444  # #cdd7cb
color.active=rgb555 on rgb021  # #f1f9ef on #337545
color.recurring=rgb011  # #007184
color.scheduled=rgb013  # #046aa7
color.until=
color.blocked=rgb444  # #cdd7cb
color.blocking=rgb555 on rgb113  # #f1f9ef on #65599e

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb200  # #7b3c12
color.uda.priority.M=rgb210  # #905705
color.uda.priority.L=rgb013  # #046aa7

# Tags
color.tag.next=rgb113  # #65599e
color.tag.none=
color.tagged=

# Due
color.due=rgb210  # #905705
color.due.today=rgb200  # #7b3c12
color.overdue=rgb100  # #860c2c

# Report: burndown
color.burndown.done=rgb555 on rgb021  # #f1f9ef on #337545
color.burndown.pending=rgb555 on rgb100  # #f1f9ef on #860c2c
color.burndown.started=rgb555 on rgb210  # #f1f9ef on #905705

# Report: history
color.history.add=rgb555 on rgb100  # #f1f9ef on #860c2c
color.history.delete=rgb555 on rgb210  # #f1f9ef on #905705
color.history.done=rgb555 on rgb021  # #f1f9ef on #337545

# Report: summary
color.summary.background=on gray23  # #e9f3e6
color.summary.bar=rgb555 on rgb021  # #f1f9ef on #337545

# Command: calendar
color.calendar.due=rgb555 on rgb210  # #f1f9ef on #905705
color.calendar.due.today=rgb555 on rgb200  # #f1f9ef on #7b3c12
color.calendar.holiday=rgb555 on rgb113  # #f1f9ef on #65599e
color.calendar.overdue=rgb555 on rgb100  # #f1f9ef on #860c2c
color.calendar.scheduled=rgb555 on rgb013  # #f1f9ef on #046aa7
color.calendar.today=rgb555 on rgb011  # #f1f9ef on #007184
color.calendar.weekend=rgb444  # #cdd7cb
color.calendar.weeknumber=rgb444  # #cdd7cb

# Command: sync
color.sync.added=rgb021  # #337545
color.sync.changed=rgb210  # #905705
color.sync.rejected=rgb100  # #860c2c

# Command: undo
color.undo.after=rgb021  # #337545
color.undo.before=rgb100  # #860c2c
