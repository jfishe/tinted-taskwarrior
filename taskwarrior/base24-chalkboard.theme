# tinted-taskwarrior
# Scheme name: Chalkboard
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-chalkboard (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray8  # #5b5b5b
color.label.sort=rgb113  # #7372c3
color.alternate=on gray0  # #000000
color.header=rgb113  # #7372c3
color.footnote=rgb244  # #72c2c3
color.warning=gray3 on rgb334  # #29262f on #aaaadb
color.error=rgb411  # #c37372
color.debug=rgb244  # #72c2c3

# Task state
color.completed=gray8  # #5b5b5b
color.deleted=gray8  # #5b5b5b
color.active=gray3 on rgb242  # #29262f on #72c373
color.recurring=rgb244  # #72c2c3
color.scheduled=rgb113  # #7372c3
color.until=
color.blocked=gray8  # #5b5b5b
color.blocking=gray3 on rgb414  # #29262f on #c372c2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb442  # #c2c372
color.uda.priority.M=rgb334  # #aaaadb
color.uda.priority.L=rgb113  # #7372c3

# Tags
color.tag.next=rgb414  # #c372c2
color.tag.none=
color.tagged=

# Due
color.due=rgb334  # #aaaadb
color.due.today=rgb442  # #c2c372
color.overdue=rgb411  # #c37372

# Report: burndown
color.burndown.done=gray3 on rgb242  # #29262f on #72c373
color.burndown.pending=gray3 on rgb411  # #29262f on #c37372
color.burndown.started=gray3 on rgb334  # #29262f on #aaaadb

# Report: history
color.history.add=gray3 on rgb411  # #29262f on #c37372
color.history.delete=gray3 on rgb334  # #29262f on #aaaadb
color.history.done=gray3 on rgb242  # #29262f on #72c373

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray3 on rgb242  # #29262f on #72c373

# Command: calendar
color.calendar.due=gray3 on rgb334  # #29262f on #aaaadb
color.calendar.due.today=gray3 on rgb442  # #29262f on #c2c372
color.calendar.holiday=gray3 on rgb414  # #29262f on #c372c2
color.calendar.overdue=gray3 on rgb411  # #29262f on #c37372
color.calendar.scheduled=gray3 on rgb113  # #29262f on #7372c3
color.calendar.today=gray3 on rgb244  # #29262f on #72c2c3
color.calendar.weekend=gray8  # #5b5b5b
color.calendar.weeknumber=gray8  # #5b5b5b

# Command: sync
color.sync.added=rgb242  # #72c373
color.sync.changed=rgb334  # #aaaadb
color.sync.rejected=rgb411  # #c37372

# Command: undo
color.undo.after=rgb242  # #72c373
color.undo.before=rgb411  # #c37372
