# tinted-taskwarrior
# Scheme name: Aztec
# Scheme author: TheNeverMan (github.com/TheNeverMan)
# Scheme: base16-aztec (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray4  # #2e2e05
color.label.sort=rgb113  # #5b4a9f
color.alternate=on gray2  # #1a1e01
color.header=rgb113  # #5b4a9f
color.footnote=rgb023  # #3d94a5
color.warning=gray1 on rgb430  # #101600 on #eebb00
color.error=rgb500  # #ee2e00
color.debug=rgb023  # #3d94a5

# Task state
color.completed=gray4  # #2e2e05
color.deleted=gray4  # #2e2e05
color.active=gray1 on rgb140  # #101600 on #63d932
color.recurring=rgb023  # #3d94a5
color.scheduled=rgb113  # #5b4a9f
color.until=
color.blocked=gray4  # #2e2e05
color.blocking=gray1 on rgb303  # #101600 on #883e9f

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #ee8800
color.uda.priority.M=rgb430  # #eebb00
color.uda.priority.L=rgb113  # #5b4a9f

# Tags
color.tag.next=rgb303  # #883e9f
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #eebb00
color.due.today=rgb520  # #ee8800
color.overdue=rgb500  # #ee2e00

# Report: burndown
color.burndown.done=gray1 on rgb140  # #101600 on #63d932
color.burndown.pending=gray1 on rgb500  # #101600 on #ee2e00
color.burndown.started=gray1 on rgb430  # #101600 on #eebb00

# Report: history
color.history.add=gray1 on rgb500  # #101600 on #ee2e00
color.history.delete=gray1 on rgb430  # #101600 on #eebb00
color.history.done=gray1 on rgb140  # #101600 on #63d932

# Report: summary
color.summary.background=on gray2  # #1a1e01
color.summary.bar=gray1 on rgb140  # #101600 on #63d932

# Command: calendar
color.calendar.due=gray1 on rgb430  # #101600 on #eebb00
color.calendar.due.today=gray1 on rgb520  # #101600 on #ee8800
color.calendar.holiday=gray1 on rgb303  # #101600 on #883e9f
color.calendar.overdue=gray1 on rgb500  # #101600 on #ee2e00
color.calendar.scheduled=gray1 on rgb113  # #101600 on #5b4a9f
color.calendar.today=gray1 on rgb023  # #101600 on #3d94a5
color.calendar.weekend=gray4  # #2e2e05
color.calendar.weeknumber=gray4  # #2e2e05

# Command: sync
color.sync.added=rgb140  # #63d932
color.sync.changed=rgb430  # #eebb00
color.sync.rejected=rgb500  # #ee2e00

# Command: undo
color.undo.after=rgb140  # #63d932
color.undo.before=rgb500  # #ee2e00
