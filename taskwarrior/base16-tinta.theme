# tinted-taskwarrior
# Scheme name: Tinta
# Scheme author: Teshre
# Scheme: base16-tinta (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray9  # #62626a
color.label.sort=rgb234  # #8a9ab0
color.alternate=on gray2  # #202023
color.header=rgb234  # #8a9ab0
color.footnote=rgb233  # #80b8b4
color.warning=gray1 on rgb331  # #101012 on #c8b86a
color.error=rgb411  # #d0726a
color.debug=rgb233  # #80b8b4

# Task state
color.completed=gray9  # #62626a
color.deleted=gray9  # #62626a
color.active=gray1 on rgb332  # #101012 on #9aa890
color.recurring=rgb233  # #80b8b4
color.scheduled=rgb234  # #8a9ab0
color.until=
color.blocked=gray9  # #62626a
color.blocking=gray1 on rgb334  # #101012 on #b0a0b8

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #e8843a
color.uda.priority.M=rgb331  # #c8b86a
color.uda.priority.L=rgb234  # #8a9ab0

# Tags
color.tag.next=rgb334  # #b0a0b8
color.tag.none=
color.tagged=

# Due
color.due=rgb331  # #c8b86a
color.due.today=rgb520  # #e8843a
color.overdue=rgb411  # #d0726a

# Report: burndown
color.burndown.done=gray1 on rgb332  # #101012 on #9aa890
color.burndown.pending=gray1 on rgb411  # #101012 on #d0726a
color.burndown.started=gray1 on rgb331  # #101012 on #c8b86a

# Report: history
color.history.add=gray1 on rgb411  # #101012 on #d0726a
color.history.delete=gray1 on rgb331  # #101012 on #c8b86a
color.history.done=gray1 on rgb332  # #101012 on #9aa890

# Report: summary
color.summary.background=on gray2  # #202023
color.summary.bar=gray1 on rgb332  # #101012 on #9aa890

# Command: calendar
color.calendar.due=gray1 on rgb331  # #101012 on #c8b86a
color.calendar.due.today=gray1 on rgb520  # #101012 on #e8843a
color.calendar.holiday=gray1 on rgb334  # #101012 on #b0a0b8
color.calendar.overdue=gray1 on rgb411  # #101012 on #d0726a
color.calendar.scheduled=gray1 on rgb234  # #101012 on #8a9ab0
color.calendar.today=gray1 on rgb233  # #101012 on #80b8b4
color.calendar.weekend=gray9  # #62626a
color.calendar.weeknumber=gray9  # #62626a

# Command: sync
color.sync.added=rgb332  # #9aa890
color.sync.changed=rgb331  # #c8b86a
color.sync.rejected=rgb411  # #d0726a

# Command: undo
color.undo.after=rgb332  # #9aa890
color.undo.before=rgb411  # #d0726a
