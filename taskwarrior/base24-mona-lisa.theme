# tinted-taskwarrior
# Scheme name: Mona Lisa
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-mona-lisa (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb310  # #a26734
color.label.sort=gray8  # #515b5c
color.alternate=on rgb100  # #341a0d
color.header=gray8  # #515b5c
color.footnote=rgb121  # #588056
color.warning=gray0 on rgb233  # #110b0d on #9eb2b3
color.error=rgb300  # #9b281b
color.debug=rgb121  # #588056

# Task state
color.completed=rgb310  # #a26734
color.deleted=rgb310  # #a26734
color.active=gray0 on rgb110  # #110b0d on #626132
color.recurring=rgb121  # #588056
color.scheduled=gray8  # #515b5c
color.until=
color.blocked=rgb310  # #a26734
color.blocking=gray0 on rgb200  # #110b0d on #9b1d29

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #c26e27
color.uda.priority.M=rgb233  # #9eb2b3
color.uda.priority.L=gray8  # #515b5c

# Tags
color.tag.next=rgb200  # #9b1d29
color.tag.none=
color.tagged=

# Due
color.due=rgb233  # #9eb2b3
color.due.today=rgb410  # #c26e27
color.overdue=rgb300  # #9b281b

# Report: burndown
color.burndown.done=gray0 on rgb110  # #110b0d on #626132
color.burndown.pending=gray0 on rgb300  # #110b0d on #9b281b
color.burndown.started=gray0 on rgb233  # #110b0d on #9eb2b3

# Report: history
color.history.add=gray0 on rgb300  # #110b0d on #9b281b
color.history.delete=gray0 on rgb233  # #110b0d on #9eb2b3
color.history.done=gray0 on rgb110  # #110b0d on #626132

# Report: summary
color.summary.background=on rgb100  # #341a0d
color.summary.bar=gray0 on rgb110  # #110b0d on #626132

# Command: calendar
color.calendar.due=gray0 on rgb233  # #110b0d on #9eb2b3
color.calendar.due.today=gray0 on rgb410  # #110b0d on #c26e27
color.calendar.holiday=gray0 on rgb200  # #110b0d on #9b1d29
color.calendar.overdue=gray0 on rgb300  # #110b0d on #9b281b
color.calendar.scheduled=gray0 on gray8  # #110b0d on #515b5c
color.calendar.today=gray0 on rgb121  # #110b0d on #588056
color.calendar.weekend=rgb310  # #a26734
color.calendar.weeknumber=rgb310  # #a26734

# Command: sync
color.sync.added=rgb110  # #626132
color.sync.changed=rgb233  # #9eb2b3
color.sync.rejected=rgb300  # #9b281b

# Command: undo
color.undo.after=rgb110  # #626132
color.undo.before=rgb300  # #9b281b
