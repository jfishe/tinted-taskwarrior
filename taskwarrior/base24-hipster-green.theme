# tinted-taskwarrior
# Scheme name: Hipster Green
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-hipster-green (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7c7c7c
color.label.sort=rgb013  # #246db2
color.alternate=on gray0  # #000000
color.header=rgb013  # #246db2
color.footnote=rgb033  # #00a6b2
color.warning=gray0 on rgb105  # #0f0a05 on #0000ff
color.error=rgb401  # #b6204a
color.debug=rgb033  # #00a6b2

# Task state
color.completed=gray12  # #7c7c7c
color.deleted=gray12  # #7c7c7c
color.active=gray0 on rgb030  # #0f0a05 on #00a600
color.recurring=rgb033  # #00a6b2
color.scheduled=rgb013  # #246db2
color.until=
color.blocked=gray12  # #7c7c7c
color.blocking=gray0 on rgb303  # #0f0a05 on #b200b2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb330  # #bebe00
color.uda.priority.M=rgb105  # #0000ff
color.uda.priority.L=rgb013  # #246db2

# Tags
color.tag.next=rgb303  # #b200b2
color.tag.none=
color.tagged=

# Due
color.due=rgb105  # #0000ff
color.due.today=rgb330  # #bebe00
color.overdue=rgb401  # #b6204a

# Report: burndown
color.burndown.done=gray0 on rgb030  # #0f0a05 on #00a600
color.burndown.pending=gray0 on rgb401  # #0f0a05 on #b6204a
color.burndown.started=gray0 on rgb105  # #0f0a05 on #0000ff

# Report: history
color.history.add=gray0 on rgb401  # #0f0a05 on #b6204a
color.history.delete=gray0 on rgb105  # #0f0a05 on #0000ff
color.history.done=gray0 on rgb030  # #0f0a05 on #00a600

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray0 on rgb030  # #0f0a05 on #00a600

# Command: calendar
color.calendar.due=gray0 on rgb105  # #0f0a05 on #0000ff
color.calendar.due.today=gray0 on rgb330  # #0f0a05 on #bebe00
color.calendar.holiday=gray0 on rgb303  # #0f0a05 on #b200b2
color.calendar.overdue=gray0 on rgb401  # #0f0a05 on #b6204a
color.calendar.scheduled=gray0 on rgb013  # #0f0a05 on #246db2
color.calendar.today=gray0 on rgb033  # #0f0a05 on #00a6b2
color.calendar.weekend=gray12  # #7c7c7c
color.calendar.weeknumber=gray12  # #7c7c7c

# Command: sync
color.sync.added=rgb030  # #00a600
color.sync.changed=rgb105  # #0000ff
color.sync.rejected=rgb401  # #b6204a

# Command: undo
color.undo.after=rgb030  # #00a600
color.undo.before=rgb401  # #b6204a
