# tinted-taskwarrior
# Scheme name: dawnfox
# Scheme author: EdenEast (https://github.com/EdenEast)
# Scheme: base16-dawnfox (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb113  # #5f5695
color.label.sort=rgb012  # #286983
color.alternate=on gray22  # #ebe0df
color.header=rgb012  # #286983
color.footnote=rgb122  # #56949f
color.warning=gray23 on rgb420  # #faf4ed on #ea9d34
color.error=rgb312  # #b4637a
color.debug=rgb122  # #56949f

# Task state
color.completed=rgb113  # #5f5695
color.deleted=rgb113  # #5f5695
color.active=gray23 on rgb121  # #faf4ed on #618774
color.recurring=rgb122  # #56949f
color.scheduled=rgb012  # #286983
color.until=
color.blocked=rgb113  # #5f5695
color.blocking=gray23 on rgb223  # #faf4ed on #907aa9

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb422  # #d7827e
color.uda.priority.M=rgb420  # #ea9d34
color.uda.priority.L=rgb012  # #286983

# Tags
color.tag.next=rgb223  # #907aa9
color.tag.none=
color.tagged=

# Due
color.due=rgb420  # #ea9d34
color.due.today=rgb422  # #d7827e
color.overdue=rgb312  # #b4637a

# Report: burndown
color.burndown.done=gray23 on rgb121  # #faf4ed on #618774
color.burndown.pending=gray23 on rgb312  # #faf4ed on #b4637a
color.burndown.started=gray23 on rgb420  # #faf4ed on #ea9d34

# Report: history
color.history.add=gray23 on rgb312  # #faf4ed on #b4637a
color.history.delete=gray23 on rgb420  # #faf4ed on #ea9d34
color.history.done=gray23 on rgb121  # #faf4ed on #618774

# Report: summary
color.summary.background=on gray22  # #ebe0df
color.summary.bar=gray23 on rgb121  # #faf4ed on #618774

# Command: calendar
color.calendar.due=gray23 on rgb420  # #faf4ed on #ea9d34
color.calendar.due.today=gray23 on rgb422  # #faf4ed on #d7827e
color.calendar.holiday=gray23 on rgb223  # #faf4ed on #907aa9
color.calendar.overdue=gray23 on rgb312  # #faf4ed on #b4637a
color.calendar.scheduled=gray23 on rgb012  # #faf4ed on #286983
color.calendar.today=gray23 on rgb122  # #faf4ed on #56949f
color.calendar.weekend=rgb113  # #5f5695
color.calendar.weeknumber=rgb113  # #5f5695

# Command: sync
color.sync.added=rgb121  # #618774
color.sync.changed=rgb420  # #ea9d34
color.sync.rejected=rgb312  # #b4637a

# Command: undo
color.undo.after=rgb121  # #618774
color.undo.before=rgb312  # #b4637a
