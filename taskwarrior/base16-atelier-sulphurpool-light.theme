# tinted-taskwarrior
# Scheme name: Atelier Sulphurpool Light
# Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
# Scheme: base16-atelier-sulphurpool-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb223  # #898ea4
color.label.sort=rgb024  # #3d8fd1
color.alternate=on gray22  # #dfe2f1
color.header=rgb024  # #3d8fd1
color.footnote=rgb034  # #22a2c9
color.warning=rgb555 on rgb320  # #f5f7ff on #c08b30
color.error=rgb400  # #c94922
color.debug=rgb034  # #22a2c9

# Task state
color.completed=rgb223  # #898ea4
color.deleted=rgb223  # #898ea4
color.active=rgb555 on rgb320  # #f5f7ff on #ac9739
color.recurring=rgb034  # #22a2c9
color.scheduled=rgb024  # #3d8fd1
color.until=
color.blocked=rgb223  # #898ea4
color.blocking=rgb555 on rgb124  # #f5f7ff on #6679cc

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb410  # #c76b29
color.uda.priority.M=rgb320  # #c08b30
color.uda.priority.L=rgb024  # #3d8fd1

# Tags
color.tag.next=rgb124  # #6679cc
color.tag.none=
color.tagged=

# Due
color.due=rgb320  # #c08b30
color.due.today=rgb410  # #c76b29
color.overdue=rgb400  # #c94922

# Report: burndown
color.burndown.done=rgb555 on rgb320  # #f5f7ff on #ac9739
color.burndown.pending=rgb555 on rgb400  # #f5f7ff on #c94922
color.burndown.started=rgb555 on rgb320  # #f5f7ff on #c08b30

# Report: history
color.history.add=rgb555 on rgb400  # #f5f7ff on #c94922
color.history.delete=rgb555 on rgb320  # #f5f7ff on #c08b30
color.history.done=rgb555 on rgb320  # #f5f7ff on #ac9739

# Report: summary
color.summary.background=on gray22  # #dfe2f1
color.summary.bar=rgb555 on rgb320  # #f5f7ff on #ac9739

# Command: calendar
color.calendar.due=rgb555 on rgb320  # #f5f7ff on #c08b30
color.calendar.due.today=rgb555 on rgb410  # #f5f7ff on #c76b29
color.calendar.holiday=rgb555 on rgb124  # #f5f7ff on #6679cc
color.calendar.overdue=rgb555 on rgb400  # #f5f7ff on #c94922
color.calendar.scheduled=rgb555 on rgb024  # #f5f7ff on #3d8fd1
color.calendar.today=rgb555 on rgb034  # #f5f7ff on #22a2c9
color.calendar.weekend=rgb223  # #898ea4
color.calendar.weeknumber=rgb223  # #898ea4

# Command: sync
color.sync.added=rgb320  # #ac9739
color.sync.changed=rgb320  # #c08b30
color.sync.rejected=rgb400  # #c94922

# Command: undo
color.undo.after=rgb320  # #ac9739
color.undo.before=rgb400  # #c94922
