# tinted-taskwarrior
# Scheme name: Praha
# Scheme author: xscriptor (https://github.com/xscriptor)
# Scheme: base24-praha (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb113  # #6272a4
color.label.sort=rgb325  # #bd93f9
color.alternate=on gray3  # #2a2a2a
color.header=rgb325  # #bd93f9
color.footnote=rgb145  # #8be9fd
color.warning=gray2 on rgb542  # #1a1a1a on #ffe4a3
color.error=rgb511  # #ff5555
color.debug=rgb145  # #8be9fd

# Task state
color.completed=rgb113  # #6272a4
color.deleted=rgb113  # #6272a4
color.active=gray2 on rgb342  # #1a1a1a on #b8e6a0
color.recurring=rgb145  # #8be9fd
color.scheduled=rgb325  # #bd93f9
color.until=
color.blocked=rgb113  # #6272a4
color.blocking=gray2 on rgb533  # #1a1a1a on #ff9aa2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb521  # #ff9c7c
color.uda.priority.M=rgb542  # #ffe4a3
color.uda.priority.L=rgb325  # #bd93f9

# Tags
color.tag.next=rgb533  # #ff9aa2
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ffe4a3
color.due.today=rgb521  # #ff9c7c
color.overdue=rgb511  # #ff5555

# Report: burndown
color.burndown.done=gray2 on rgb342  # #1a1a1a on #b8e6a0
color.burndown.pending=gray2 on rgb511  # #1a1a1a on #ff5555
color.burndown.started=gray2 on rgb542  # #1a1a1a on #ffe4a3

# Report: history
color.history.add=gray2 on rgb511  # #1a1a1a on #ff5555
color.history.delete=gray2 on rgb542  # #1a1a1a on #ffe4a3
color.history.done=gray2 on rgb342  # #1a1a1a on #b8e6a0

# Report: summary
color.summary.background=on gray3  # #2a2a2a
color.summary.bar=gray2 on rgb342  # #1a1a1a on #b8e6a0

# Command: calendar
color.calendar.due=gray2 on rgb542  # #1a1a1a on #ffe4a3
color.calendar.due.today=gray2 on rgb521  # #1a1a1a on #ff9c7c
color.calendar.holiday=gray2 on rgb533  # #1a1a1a on #ff9aa2
color.calendar.overdue=gray2 on rgb511  # #1a1a1a on #ff5555
color.calendar.scheduled=gray2 on rgb325  # #1a1a1a on #bd93f9
color.calendar.today=gray2 on rgb145  # #1a1a1a on #8be9fd
color.calendar.weekend=rgb113  # #6272a4
color.calendar.weeknumber=rgb113  # #6272a4

# Command: sync
color.sync.added=rgb342  # #b8e6a0
color.sync.changed=rgb542  # #ffe4a3
color.sync.rejected=rgb511  # #ff5555

# Command: undo
color.undo.after=rgb342  # #b8e6a0
color.undo.before=rgb511  # #ff5555
