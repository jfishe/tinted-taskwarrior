# tinted-taskwarrior
# Scheme name: Noche
# Scheme author: Teshre
# Scheme: base16-noche (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #5a6178
color.label.sort=rgb235  # #7aa0e8
color.alternate=on gray2  # #181c2c
color.header=rgb235  # #7aa0e8
color.footnote=rgb144  # #6dd8d0
color.warning=gray1 on rgb431  # #0c0e16 on #d8c062
color.error=rgb422  # #e2727e
color.debug=rgb144  # #6dd8d0

# Task state
color.completed=rgb112  # #5a6178
color.deleted=rgb112  # #5a6178
color.active=gray1 on rgb243  # #0c0e16 on #7cc596
color.recurring=rgb144  # #6dd8d0
color.scheduled=rgb235  # #7aa0e8
color.until=
color.blocked=rgb112  # #5a6178
color.blocking=gray1 on rgb324  # #0c0e16 on #b79ae0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb235  # #82a6e0
color.uda.priority.M=rgb431  # #d8c062
color.uda.priority.L=rgb235  # #7aa0e8

# Tags
color.tag.next=rgb324  # #b79ae0
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #d8c062
color.due.today=rgb235  # #82a6e0
color.overdue=rgb422  # #e2727e

# Report: burndown
color.burndown.done=gray1 on rgb243  # #0c0e16 on #7cc596
color.burndown.pending=gray1 on rgb422  # #0c0e16 on #e2727e
color.burndown.started=gray1 on rgb431  # #0c0e16 on #d8c062

# Report: history
color.history.add=gray1 on rgb422  # #0c0e16 on #e2727e
color.history.delete=gray1 on rgb431  # #0c0e16 on #d8c062
color.history.done=gray1 on rgb243  # #0c0e16 on #7cc596

# Report: summary
color.summary.background=on gray2  # #181c2c
color.summary.bar=gray1 on rgb243  # #0c0e16 on #7cc596

# Command: calendar
color.calendar.due=gray1 on rgb431  # #0c0e16 on #d8c062
color.calendar.due.today=gray1 on rgb235  # #0c0e16 on #82a6e0
color.calendar.holiday=gray1 on rgb324  # #0c0e16 on #b79ae0
color.calendar.overdue=gray1 on rgb422  # #0c0e16 on #e2727e
color.calendar.scheduled=gray1 on rgb235  # #0c0e16 on #7aa0e8
color.calendar.today=gray1 on rgb144  # #0c0e16 on #6dd8d0
color.calendar.weekend=rgb112  # #5a6178
color.calendar.weeknumber=rgb112  # #5a6178

# Command: sync
color.sync.added=rgb243  # #7cc596
color.sync.changed=rgb431  # #d8c062
color.sync.rejected=rgb422  # #e2727e

# Command: undo
color.undo.after=rgb243  # #7cc596
color.undo.before=rgb422  # #e2727e
