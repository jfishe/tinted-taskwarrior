# tinted-taskwarrior
# Scheme name: Edge Dark
# Scheme author: cjayross (https://github.com/cjayross), Tinted Theming (https://github.com/tinted-theming)
# Scheme: base16-edge-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #4a4c4f
color.label.sort=rgb135  # #73b3e7
color.alternate=on gray4  # #313235
color.header=rgb135  # #73b3e7
color.footnote=rgb132  # #5ebaa5
color.warning=gray3 on rgb431  # #262729 on #dbb774
color.error=rgb511  # #e77171
color.debug=rgb132  # #5ebaa5

# Task state
color.completed=gray7  # #4a4c4f
color.deleted=gray7  # #4a4c4f
color.active=gray3 on rgb231  # #262729 on #a1bf78
color.recurring=rgb132  # #5ebaa5
color.scheduled=rgb135  # #73b3e7
color.until=
color.blocked=gray7  # #4a4c4f
color.blocking=gray3 on rgb424  # #262729 on #d390e7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #eba31a
color.uda.priority.M=rgb431  # #dbb774
color.uda.priority.L=rgb135  # #73b3e7

# Tags
color.tag.next=rgb424  # #d390e7
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #dbb774
color.due.today=rgb530  # #eba31a
color.overdue=rgb511  # #e77171

# Report: burndown
color.burndown.done=gray3 on rgb231  # #262729 on #a1bf78
color.burndown.pending=gray3 on rgb511  # #262729 on #e77171
color.burndown.started=gray3 on rgb431  # #262729 on #dbb774

# Report: history
color.history.add=gray3 on rgb511  # #262729 on #e77171
color.history.delete=gray3 on rgb431  # #262729 on #dbb774
color.history.done=gray3 on rgb231  # #262729 on #a1bf78

# Report: summary
color.summary.background=on gray4  # #313235
color.summary.bar=gray3 on rgb231  # #262729 on #a1bf78

# Command: calendar
color.calendar.due=gray3 on rgb431  # #262729 on #dbb774
color.calendar.due.today=gray3 on rgb530  # #262729 on #eba31a
color.calendar.holiday=gray3 on rgb424  # #262729 on #d390e7
color.calendar.overdue=gray3 on rgb511  # #262729 on #e77171
color.calendar.scheduled=gray3 on rgb135  # #262729 on #73b3e7
color.calendar.today=gray3 on rgb132  # #262729 on #5ebaa5
color.calendar.weekend=gray7  # #4a4c4f
color.calendar.weeknumber=gray7  # #4a4c4f

# Command: sync
color.sync.added=rgb231  # #a1bf78
color.sync.changed=rgb431  # #dbb774
color.sync.rejected=rgb511  # #e77171

# Command: undo
color.undo.after=rgb231  # #a1bf78
color.undo.before=rgb511  # #e77171
