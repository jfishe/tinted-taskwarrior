# tinted-taskwarrior
# Scheme name: Lumina Nebula Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-nebula-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray4  # #2d3041
color.label.sort=rgb345  # #c6d6e8
color.alternate=on gray2  # #1a1c2c
color.header=rgb345  # #c6d6e8
color.footnote=rgb244  # #88d2da
color.warning=gray2 on rgb432  # #161826 on #f3c085
color.error=rgb411  # #d57068
color.debug=rgb244  # #88d2da

# Task state
color.completed=gray4  # #2d3041
color.deleted=gray4  # #2d3041
color.active=gray2 on rgb243  # #161826 on #8fdcba
color.recurring=rgb244  # #88d2da
color.scheduled=rgb345  # #c6d6e8
color.until=
color.blocked=gray4  # #2d3041
color.blocking=gray2 on rgb335  # #161826 on #b0a4f8

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #fab17e
color.uda.priority.M=rgb432  # #f3c085
color.uda.priority.L=rgb345  # #c6d6e8

# Tags
color.tag.next=rgb335  # #b0a4f8
color.tag.none=
color.tagged=

# Due
color.due=rgb432  # #f3c085
color.due.today=rgb532  # #fab17e
color.overdue=rgb411  # #d57068

# Report: burndown
color.burndown.done=gray2 on rgb243  # #161826 on #8fdcba
color.burndown.pending=gray2 on rgb411  # #161826 on #d57068
color.burndown.started=gray2 on rgb432  # #161826 on #f3c085

# Report: history
color.history.add=gray2 on rgb411  # #161826 on #d57068
color.history.delete=gray2 on rgb432  # #161826 on #f3c085
color.history.done=gray2 on rgb243  # #161826 on #8fdcba

# Report: summary
color.summary.background=on gray2  # #1a1c2c
color.summary.bar=gray2 on rgb243  # #161826 on #8fdcba

# Command: calendar
color.calendar.due=gray2 on rgb432  # #161826 on #f3c085
color.calendar.due.today=gray2 on rgb532  # #161826 on #fab17e
color.calendar.holiday=gray2 on rgb335  # #161826 on #b0a4f8
color.calendar.overdue=gray2 on rgb411  # #161826 on #d57068
color.calendar.scheduled=gray2 on rgb345  # #161826 on #c6d6e8
color.calendar.today=gray2 on rgb244  # #161826 on #88d2da
color.calendar.weekend=gray4  # #2d3041
color.calendar.weeknumber=gray4  # #2d3041

# Command: sync
color.sync.added=rgb243  # #8fdcba
color.sync.changed=rgb432  # #f3c085
color.sync.rejected=rgb411  # #d57068

# Command: undo
color.undo.after=rgb243  # #8fdcba
color.undo.before=rgb411  # #d57068
