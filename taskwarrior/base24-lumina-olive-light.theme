# tinted-taskwarrior
# Scheme name: Lumina Olive Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-olive-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray20  # #d4d3c5
color.label.sort=rgb013  # #3264a3
color.alternate=on gray23  # #f0efe0
color.header=rgb013  # #3264a3
color.footnote=rgb012  # #006f83
color.warning=rgb554 on rgb310  # #f7f6e5 on #a16010
color.error=rgb200  # #8a1f1f
color.debug=rgb012  # #006f83

# Task state
color.completed=gray20  # #d4d3c5
color.deleted=gray20  # #d4d3c5
color.active=rgb554 on rgb011  # #f7f6e5 on #30624e
color.recurring=rgb012  # #006f83
color.scheduled=rgb013  # #3264a3
color.until=
color.blocked=gray20  # #d4d3c5
color.blocking=rgb554 on rgb113  # #f7f6e5 on #6355a0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb300  # #a24113
color.uda.priority.M=rgb310  # #a16010
color.uda.priority.L=rgb013  # #3264a3

# Tags
color.tag.next=rgb113  # #6355a0
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #a16010
color.due.today=rgb300  # #a24113
color.overdue=rgb200  # #8a1f1f

# Report: burndown
color.burndown.done=rgb554 on rgb011  # #f7f6e5 on #30624e
color.burndown.pending=rgb554 on rgb200  # #f7f6e5 on #8a1f1f
color.burndown.started=rgb554 on rgb310  # #f7f6e5 on #a16010

# Report: history
color.history.add=rgb554 on rgb200  # #f7f6e5 on #8a1f1f
color.history.delete=rgb554 on rgb310  # #f7f6e5 on #a16010
color.history.done=rgb554 on rgb011  # #f7f6e5 on #30624e

# Report: summary
color.summary.background=on gray23  # #f0efe0
color.summary.bar=rgb554 on rgb011  # #f7f6e5 on #30624e

# Command: calendar
color.calendar.due=rgb554 on rgb310  # #f7f6e5 on #a16010
color.calendar.due.today=rgb554 on rgb300  # #f7f6e5 on #a24113
color.calendar.holiday=rgb554 on rgb113  # #f7f6e5 on #6355a0
color.calendar.overdue=rgb554 on rgb200  # #f7f6e5 on #8a1f1f
color.calendar.scheduled=rgb554 on rgb013  # #f7f6e5 on #3264a3
color.calendar.today=rgb554 on rgb012  # #f7f6e5 on #006f83
color.calendar.weekend=gray20  # #d4d3c5
color.calendar.weeknumber=gray20  # #d4d3c5

# Command: sync
color.sync.added=rgb011  # #30624e
color.sync.changed=rgb310  # #a16010
color.sync.rejected=rgb200  # #8a1f1f

# Command: undo
color.undo.after=rgb011  # #30624e
color.undo.before=rgb200  # #8a1f1f
