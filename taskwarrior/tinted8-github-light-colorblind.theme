# tinted-taskwarrior
# Scheme name: Github Light Colorblind
# Scheme author: Tinted Theming (https://github.com/tinted-theming)
# Scheme: tinted8-github-light-colorblind (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray9  # #59636e
color.label.sort=rgb014  # #0969da
color.alternate=on gray6  # #3d454c
color.header=rgb014  # #0969da
color.footnote=rgb022  # #1b7c83
color.warning=rgb555 on rgb100  # #ffffff on #4d2d00
color.error=rgb410  # #bc4c00
color.debug=rgb022  # #1b7c83

# Task state
color.completed=gray9  # #59636e
color.deleted=gray9  # #59636e
color.active=rgb555 on rgb013  # #ffffff on #0550ae
color.recurring=rgb022  # #1b7c83
color.scheduled=rgb014  # #0969da
color.until=
color.blocked=gray9  # #59636e
color.blocking=rgb555 on rgb214  # #ffffff on #8250df

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb300  # #953800
color.uda.priority.M=rgb100  # #4d2d00
color.uda.priority.L=rgb014  # #0969da

# Tags
color.tag.next=rgb214  # #8250df
color.tag.none=
color.tagged=

# Due
color.due=rgb100  # #4d2d00
color.due.today=rgb300  # #953800
color.overdue=rgb410  # #bc4c00

# Report: burndown
color.burndown.done=rgb555 on rgb013  # #ffffff on #0550ae
color.burndown.pending=rgb555 on rgb410  # #ffffff on #bc4c00
color.burndown.started=rgb555 on rgb100  # #ffffff on #4d2d00

# Report: history
color.history.add=rgb555 on rgb410  # #ffffff on #bc4c00
color.history.delete=rgb555 on rgb100  # #ffffff on #4d2d00
color.history.done=rgb555 on rgb013  # #ffffff on #0550ae

# Report: summary
color.summary.background=on gray6  # #3d454c
color.summary.bar=rgb555 on rgb013  # #ffffff on #0550ae

# Command: calendar
color.calendar.due=rgb555 on rgb100  # #ffffff on #4d2d00
color.calendar.due.today=rgb555 on rgb300  # #ffffff on #953800
color.calendar.holiday=rgb555 on rgb214  # #ffffff on #8250df
color.calendar.overdue=rgb555 on rgb410  # #ffffff on #bc4c00
color.calendar.scheduled=rgb555 on rgb014  # #ffffff on #0969da
color.calendar.today=rgb555 on rgb022  # #ffffff on #1b7c83
color.calendar.weekend=gray9  # #59636e
color.calendar.weeknumber=gray9  # #59636e

# Command: sync
color.sync.added=rgb013  # #0550ae
color.sync.changed=rgb100  # #4d2d00
color.sync.rejected=rgb410  # #bc4c00

# Command: undo
color.undo.after=rgb013  # #0550ae
color.undo.before=rgb410  # #bc4c00
