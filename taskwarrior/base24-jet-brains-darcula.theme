# tinted-taskwarrior
# Scheme name: Jet Brains Darcula
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-jet-brains-darcula (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6b6b6b
color.label.sort=rgb124  # #4581eb
color.alternate=on gray0  # #000000
color.header=rgb124  # #4581eb
color.footnote=rgb044  # #33c2c1
color.warning=gray2 on rgb235  # #202020 on #6d9df1
color.error=rgb511  # #fa5355
color.debug=rgb044  # #33c2c1

# Task state
color.completed=gray10  # #6b6b6b
color.deleted=gray10  # #6b6b6b
color.active=gray2 on rgb010  # #202020 on #126e00
color.recurring=rgb044  # #33c2c1
color.scheduled=rgb124  # #4581eb
color.until=
color.blocked=gray10  # #6b6b6b
color.blocking=gray2 on rgb515  # #202020 on #fa54ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb440  # #c2c300
color.uda.priority.M=rgb235  # #6d9df1
color.uda.priority.L=rgb124  # #4581eb

# Tags
color.tag.next=rgb515  # #fa54ff
color.tag.none=
color.tagged=

# Due
color.due=rgb235  # #6d9df1
color.due.today=rgb440  # #c2c300
color.overdue=rgb511  # #fa5355

# Report: burndown
color.burndown.done=gray2 on rgb010  # #202020 on #126e00
color.burndown.pending=gray2 on rgb511  # #202020 on #fa5355
color.burndown.started=gray2 on rgb235  # #202020 on #6d9df1

# Report: history
color.history.add=gray2 on rgb511  # #202020 on #fa5355
color.history.delete=gray2 on rgb235  # #202020 on #6d9df1
color.history.done=gray2 on rgb010  # #202020 on #126e00

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray2 on rgb010  # #202020 on #126e00

# Command: calendar
color.calendar.due=gray2 on rgb235  # #202020 on #6d9df1
color.calendar.due.today=gray2 on rgb440  # #202020 on #c2c300
color.calendar.holiday=gray2 on rgb515  # #202020 on #fa54ff
color.calendar.overdue=gray2 on rgb511  # #202020 on #fa5355
color.calendar.scheduled=gray2 on rgb124  # #202020 on #4581eb
color.calendar.today=gray2 on rgb044  # #202020 on #33c2c1
color.calendar.weekend=gray10  # #6b6b6b
color.calendar.weeknumber=gray10  # #6b6b6b

# Command: sync
color.sync.added=rgb010  # #126e00
color.sync.changed=rgb235  # #6d9df1
color.sync.rejected=rgb511  # #fa5355

# Command: undo
color.undo.after=rgb010  # #126e00
color.undo.before=rgb511  # #fa5355
