# tinted-taskwarrior
# Scheme name: Terracotta Dark
# Scheme author: Alexander Rossell Hayes (https://github.com/rossellhayes)
# Scheme: base16-terracotta-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #594740
color.label.sort=rgb334  # #b0a4c3
color.alternate=on gray4  # #362b27
color.header=rgb334  # #b0a4c3
color.footnote=rgb334  # #c0bcdb
color.warning=gray2 on rgb531  # #241d1a on #ffc37a
color.error=rgb522  # #f6998f
color.debug=rgb334  # #c0bcdb

# Task state
color.completed=gray7  # #594740
color.deleted=gray7  # #594740
color.active=gray2 on rgb342  # #241d1a on #b6c68a
color.recurring=rgb334  # #c0bcdb
color.scheduled=rgb334  # #b0a4c3
color.until=
color.blocked=gray7  # #594740
color.blocking=gray2 on rgb433  # #241d1a on #d8a2b0

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #ffa888
color.uda.priority.M=rgb531  # #ffc37a
color.uda.priority.L=rgb334  # #b0a4c3

# Tags
color.tag.next=rgb433  # #d8a2b0
color.tag.none=
color.tagged=

# Due
color.due=rgb531  # #ffc37a
color.due.today=rgb532  # #ffa888
color.overdue=rgb522  # #f6998f

# Report: burndown
color.burndown.done=gray2 on rgb342  # #241d1a on #b6c68a
color.burndown.pending=gray2 on rgb522  # #241d1a on #f6998f
color.burndown.started=gray2 on rgb531  # #241d1a on #ffc37a

# Report: history
color.history.add=gray2 on rgb522  # #241d1a on #f6998f
color.history.delete=gray2 on rgb531  # #241d1a on #ffc37a
color.history.done=gray2 on rgb342  # #241d1a on #b6c68a

# Report: summary
color.summary.background=on gray4  # #362b27
color.summary.bar=gray2 on rgb342  # #241d1a on #b6c68a

# Command: calendar
color.calendar.due=gray2 on rgb531  # #241d1a on #ffc37a
color.calendar.due.today=gray2 on rgb532  # #241d1a on #ffa888
color.calendar.holiday=gray2 on rgb433  # #241d1a on #d8a2b0
color.calendar.overdue=gray2 on rgb522  # #241d1a on #f6998f
color.calendar.scheduled=gray2 on rgb334  # #241d1a on #b0a4c3
color.calendar.today=gray2 on rgb334  # #241d1a on #c0bcdb
color.calendar.weekend=gray7  # #594740
color.calendar.weeknumber=gray7  # #594740

# Command: sync
color.sync.added=rgb342  # #b6c68a
color.sync.changed=rgb531  # #ffc37a
color.sync.rejected=rgb522  # #f6998f

# Command: undo
color.undo.after=rgb342  # #b6c68a
color.undo.before=rgb522  # #f6998f
