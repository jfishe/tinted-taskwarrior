# tinted-taskwarrior
# Scheme name: Builtin Light
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-builtin-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6e6e6e
color.label.sort=rgb103  # #0000bb
color.alternate=on gray0  # #000000
color.header=rgb103  # #0000bb
color.footnote=rgb033  # #00bbbb
color.warning=rgb555 on rgb115  # #ffffff on #5555ff
color.error=rgb300  # #bb0000
color.debug=rgb033  # #00bbbb

# Task state
color.completed=gray10  # #6e6e6e
color.deleted=gray10  # #6e6e6e
color.active=rgb555 on rgb030  # #ffffff on #00bb00
color.recurring=rgb033  # #00bbbb
color.scheduled=rgb103  # #0000bb
color.until=
color.blocked=gray10  # #6e6e6e
color.blocking=rgb555 on rgb303  # #ffffff on #bb00bb

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb330  # #bbbb00
color.uda.priority.M=rgb115  # #5555ff
color.uda.priority.L=rgb103  # #0000bb

# Tags
color.tag.next=rgb303  # #bb00bb
color.tag.none=
color.tagged=

# Due
color.due=rgb115  # #5555ff
color.due.today=rgb330  # #bbbb00
color.overdue=rgb300  # #bb0000

# Report: burndown
color.burndown.done=rgb555 on rgb030  # #ffffff on #00bb00
color.burndown.pending=rgb555 on rgb300  # #ffffff on #bb0000
color.burndown.started=rgb555 on rgb115  # #ffffff on #5555ff

# Report: history
color.history.add=rgb555 on rgb300  # #ffffff on #bb0000
color.history.delete=rgb555 on rgb115  # #ffffff on #5555ff
color.history.done=rgb555 on rgb030  # #ffffff on #00bb00

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=rgb555 on rgb030  # #ffffff on #00bb00

# Command: calendar
color.calendar.due=rgb555 on rgb115  # #ffffff on #5555ff
color.calendar.due.today=rgb555 on rgb330  # #ffffff on #bbbb00
color.calendar.holiday=rgb555 on rgb303  # #ffffff on #bb00bb
color.calendar.overdue=rgb555 on rgb300  # #ffffff on #bb0000
color.calendar.scheduled=rgb555 on rgb103  # #ffffff on #0000bb
color.calendar.today=rgb555 on rgb033  # #ffffff on #00bbbb
color.calendar.weekend=gray10  # #6e6e6e
color.calendar.weeknumber=gray10  # #6e6e6e

# Command: sync
color.sync.added=rgb030  # #00bb00
color.sync.changed=rgb115  # #5555ff
color.sync.rejected=rgb300  # #bb0000

# Command: undo
color.undo.after=rgb030  # #00bb00
color.undo.before=rgb300  # #bb0000
