# tinted-taskwarrior
# Scheme name: Penumbra Light
# Scheme author: Zachary Weiss (https://github.com/zacharyweiss)
# Scheme: base16-penumbra-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray18  # #bebebe
color.label.sort=rgb025  # #5794d0
color.alternate=on rgb555  # #fff7ed
color.header=rgb025  # #5794d0
color.footnote=rgb033  # #00a2af
color.warning=rgb555 on rgb220  # #fffdfb on #8d9741
color.error=rgb411  # #ca736c
color.debug=rgb033  # #00a2af

# Task state
color.completed=gray18  # #bebebe
color.deleted=gray18  # #bebebe
color.active=rgb555 on rgb132  # #fffdfb on #47a477
color.recurring=rgb033  # #00a2af
color.scheduled=rgb025  # #5794d0
color.until=
color.blocked=gray18  # #bebebe
color.blocking=rgb555 on rgb224  # #fffdfb on #9481cc

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb321  # #ba823a
color.uda.priority.M=rgb220  # #8d9741
color.uda.priority.L=rgb025  # #5794d0

# Tags
color.tag.next=rgb224  # #9481cc
color.tag.none=
color.tagged=

# Due
color.due=rgb220  # #8d9741
color.due.today=rgb321  # #ba823a
color.overdue=rgb411  # #ca736c

# Report: burndown
color.burndown.done=rgb555 on rgb132  # #fffdfb on #47a477
color.burndown.pending=rgb555 on rgb411  # #fffdfb on #ca736c
color.burndown.started=rgb555 on rgb220  # #fffdfb on #8d9741

# Report: history
color.history.add=rgb555 on rgb411  # #fffdfb on #ca736c
color.history.delete=rgb555 on rgb220  # #fffdfb on #8d9741
color.history.done=rgb555 on rgb132  # #fffdfb on #47a477

# Report: summary
color.summary.background=on rgb555  # #fff7ed
color.summary.bar=rgb555 on rgb132  # #fffdfb on #47a477

# Command: calendar
color.calendar.due=rgb555 on rgb220  # #fffdfb on #8d9741
color.calendar.due.today=rgb555 on rgb321  # #fffdfb on #ba823a
color.calendar.holiday=rgb555 on rgb224  # #fffdfb on #9481cc
color.calendar.overdue=rgb555 on rgb411  # #fffdfb on #ca736c
color.calendar.scheduled=rgb555 on rgb025  # #fffdfb on #5794d0
color.calendar.today=rgb555 on rgb033  # #fffdfb on #00a2af
color.calendar.weekend=gray18  # #bebebe
color.calendar.weeknumber=gray18  # #bebebe

# Command: sync
color.sync.added=rgb132  # #47a477
color.sync.changed=rgb220  # #8d9741
color.sync.rejected=rgb411  # #ca736c

# Command: undo
color.undo.after=rgb132  # #47a477
color.undo.before=rgb411  # #ca736c
