# tinted-taskwarrior
# Scheme name: Humanoid dark
# Scheme author: Thomas (tasmo) Friese
# Scheme: base16-humanoid-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray9  # #60615d
color.label.sort=rgb035  # #00a6fb
color.alternate=on gray5  # #333b3d
color.header=rgb035  # #00a6fb
color.footnote=rgb044  # #0dd9d6
color.warning=gray3 on rgb530  # #232629 on #ffb627
color.error=rgb500  # #f11235
color.debug=rgb044  # #0dd9d6

# Task state
color.completed=gray9  # #60615d
color.deleted=gray9  # #60615d
color.active=gray3 on rgb041  # #232629 on #02d849
color.recurring=rgb044  # #0dd9d6
color.scheduled=rgb035  # #00a6fb
color.until=
color.blocked=gray9  # #60615d
color.blocking=gray3 on rgb514  # #232629 on #f15ee3

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb520  # #ff9505
color.uda.priority.M=rgb530  # #ffb627
color.uda.priority.L=rgb035  # #00a6fb

# Tags
color.tag.next=rgb514  # #f15ee3
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #ffb627
color.due.today=rgb520  # #ff9505
color.overdue=rgb500  # #f11235

# Report: burndown
color.burndown.done=gray3 on rgb041  # #232629 on #02d849
color.burndown.pending=gray3 on rgb500  # #232629 on #f11235
color.burndown.started=gray3 on rgb530  # #232629 on #ffb627

# Report: history
color.history.add=gray3 on rgb500  # #232629 on #f11235
color.history.delete=gray3 on rgb530  # #232629 on #ffb627
color.history.done=gray3 on rgb041  # #232629 on #02d849

# Report: summary
color.summary.background=on gray5  # #333b3d
color.summary.bar=gray3 on rgb041  # #232629 on #02d849

# Command: calendar
color.calendar.due=gray3 on rgb530  # #232629 on #ffb627
color.calendar.due.today=gray3 on rgb520  # #232629 on #ff9505
color.calendar.holiday=gray3 on rgb514  # #232629 on #f15ee3
color.calendar.overdue=gray3 on rgb500  # #232629 on #f11235
color.calendar.scheduled=gray3 on rgb035  # #232629 on #00a6fb
color.calendar.today=gray3 on rgb044  # #232629 on #0dd9d6
color.calendar.weekend=gray9  # #60615d
color.calendar.weeknumber=gray9  # #60615d

# Command: sync
color.sync.added=rgb041  # #02d849
color.sync.changed=rgb530  # #ffb627
color.sync.rejected=rgb500  # #f11235

# Command: undo
color.undo.after=rgb041  # #02d849
color.undo.before=rgb500  # #f11235
