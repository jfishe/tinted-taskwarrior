# tinted-taskwarrior
# Scheme name: Atelier Dune Light
# Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
# Scheme: base16-atelier-dune-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb221  # #999580
color.label.sort=rgb124  # #6684e1
color.alternate=on rgb443  # #e8e4cf
color.header=rgb124  # #6684e1
color.footnote=rgb032  # #1fad83
color.warning=rgb555 on rgb320  # #fefbec on #ae9513
color.error=rgb400  # #d73737
color.debug=rgb032  # #1fad83

# Task state
color.completed=rgb221  # #999580
color.deleted=rgb221  # #999580
color.active=rgb555 on rgb130  # #fefbec on #60ac39
color.recurring=rgb032  # #1fad83
color.scheduled=rgb124  # #6684e1
color.until=
color.blocked=rgb221  # #999580
color.blocking=rgb555 on rgb314  # #fefbec on #b854d4

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #b65611
color.uda.priority.M=rgb320  # #ae9513
color.uda.priority.L=rgb124  # #6684e1

# Tags
color.tag.next=rgb314  # #b854d4
color.tag.none=
color.tagged=

# Due
color.due=rgb320  # #ae9513
color.due.today=rgb310  # #b65611
color.overdue=rgb400  # #d73737

# Report: burndown
color.burndown.done=rgb555 on rgb130  # #fefbec on #60ac39
color.burndown.pending=rgb555 on rgb400  # #fefbec on #d73737
color.burndown.started=rgb555 on rgb320  # #fefbec on #ae9513

# Report: history
color.history.add=rgb555 on rgb400  # #fefbec on #d73737
color.history.delete=rgb555 on rgb320  # #fefbec on #ae9513
color.history.done=rgb555 on rgb130  # #fefbec on #60ac39

# Report: summary
color.summary.background=on rgb443  # #e8e4cf
color.summary.bar=rgb555 on rgb130  # #fefbec on #60ac39

# Command: calendar
color.calendar.due=rgb555 on rgb320  # #fefbec on #ae9513
color.calendar.due.today=rgb555 on rgb310  # #fefbec on #b65611
color.calendar.holiday=rgb555 on rgb314  # #fefbec on #b854d4
color.calendar.overdue=rgb555 on rgb400  # #fefbec on #d73737
color.calendar.scheduled=rgb555 on rgb124  # #fefbec on #6684e1
color.calendar.today=rgb555 on rgb032  # #fefbec on #1fad83
color.calendar.weekend=rgb221  # #999580
color.calendar.weeknumber=rgb221  # #999580

# Command: sync
color.sync.added=rgb130  # #60ac39
color.sync.changed=rgb320  # #ae9513
color.sync.rejected=rgb400  # #d73737

# Command: undo
color.undo.after=rgb130  # #60ac39
color.undo.before=rgb400  # #d73737
