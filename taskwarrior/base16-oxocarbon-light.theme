# tinted-taskwarrior
# Scheme name: Oxocarbon Light
# Scheme author: shaunsingh/IBM, Tinted Theming (https://github.com/tinted-theming)
# Scheme: base16-oxocarbon-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray16  # #a1acba
color.label.sort=rgb015  # #0f62fe
color.alternate=on gray22  # #dde1e6
color.header=rgb015  # #0f62fe
color.footnote=rgb204  # #673ab7
color.warning=gray23 on rgb510  # #f2f4f8 on #ff6f00
color.error=rgb523  # #ff7eb6
color.debug=rgb204  # #673ab7

# Task state
color.completed=gray16  # #a1acba
color.deleted=gray16  # #a1acba
color.active=gray23 on rgb131  # #f2f4f8 on #42be65
color.recurring=rgb204  # #673ab7
color.scheduled=rgb015  # #0f62fe
color.until=
color.blocked=gray16  # #a1acba
color.blocking=gray23 on rgb325  # #f2f4f8 on #be95ff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb412  # #ee5396
color.uda.priority.M=rgb510  # #ff6f00
color.uda.priority.L=rgb015  # #0f62fe

# Tags
color.tag.next=rgb325  # #be95ff
color.tag.none=
color.tagged=

# Due
color.due=rgb510  # #ff6f00
color.due.today=rgb412  # #ee5396
color.overdue=rgb523  # #ff7eb6

# Report: burndown
color.burndown.done=gray23 on rgb131  # #f2f4f8 on #42be65
color.burndown.pending=gray23 on rgb523  # #f2f4f8 on #ff7eb6
color.burndown.started=gray23 on rgb510  # #f2f4f8 on #ff6f00

# Report: history
color.history.add=gray23 on rgb523  # #f2f4f8 on #ff7eb6
color.history.delete=gray23 on rgb510  # #f2f4f8 on #ff6f00
color.history.done=gray23 on rgb131  # #f2f4f8 on #42be65

# Report: summary
color.summary.background=on gray22  # #dde1e6
color.summary.bar=gray23 on rgb131  # #f2f4f8 on #42be65

# Command: calendar
color.calendar.due=gray23 on rgb510  # #f2f4f8 on #ff6f00
color.calendar.due.today=gray23 on rgb412  # #f2f4f8 on #ee5396
color.calendar.holiday=gray23 on rgb325  # #f2f4f8 on #be95ff
color.calendar.overdue=gray23 on rgb523  # #f2f4f8 on #ff7eb6
color.calendar.scheduled=gray23 on rgb015  # #f2f4f8 on #0f62fe
color.calendar.today=gray23 on rgb204  # #f2f4f8 on #673ab7
color.calendar.weekend=gray16  # #a1acba
color.calendar.weeknumber=gray16  # #a1acba

# Command: sync
color.sync.added=rgb131  # #42be65
color.sync.changed=rgb510  # #ff6f00
color.sync.rejected=rgb523  # #ff7eb6

# Command: undo
color.undo.after=rgb131  # #42be65
color.undo.before=rgb523  # #ff7eb6
