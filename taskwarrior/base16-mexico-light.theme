# tinted-taskwarrior
# Scheme name: Mexico Light
# Scheme author: Sheldon Johnson
# Scheme: base16-mexico-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray18  # #b8b8b8
color.label.sort=rgb134  # #7cafc2
color.alternate=on gray22  # #e8e8e8
color.header=rgb134  # #7cafc2
color.footnote=rgb023  # #4b8093
color.warning=rgb555 on rgb530  # #f8f8f8 on #f79a0e
color.error=rgb311  # #ab4642
color.debug=rgb023  # #4b8093

# Task state
color.completed=gray18  # #b8b8b8
color.deleted=gray18  # #b8b8b8
color.active=rgb555 on rgb121  # #f8f8f8 on #538947
color.recurring=rgb023  # #4b8093
color.scheduled=rgb134  # #7cafc2
color.until=
color.blocked=gray18  # #b8b8b8
color.blocking=rgb555 on rgb313  # #f8f8f8 on #96609e

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #dc9656
color.uda.priority.M=rgb530  # #f79a0e
color.uda.priority.L=rgb134  # #7cafc2

# Tags
color.tag.next=rgb313  # #96609e
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #f79a0e
color.due.today=rgb531  # #dc9656
color.overdue=rgb311  # #ab4642

# Report: burndown
color.burndown.done=rgb555 on rgb121  # #f8f8f8 on #538947
color.burndown.pending=rgb555 on rgb311  # #f8f8f8 on #ab4642
color.burndown.started=rgb555 on rgb530  # #f8f8f8 on #f79a0e

# Report: history
color.history.add=rgb555 on rgb311  # #f8f8f8 on #ab4642
color.history.delete=rgb555 on rgb530  # #f8f8f8 on #f79a0e
color.history.done=rgb555 on rgb121  # #f8f8f8 on #538947

# Report: summary
color.summary.background=on gray22  # #e8e8e8
color.summary.bar=rgb555 on rgb121  # #f8f8f8 on #538947

# Command: calendar
color.calendar.due=rgb555 on rgb530  # #f8f8f8 on #f79a0e
color.calendar.due.today=rgb555 on rgb531  # #f8f8f8 on #dc9656
color.calendar.holiday=rgb555 on rgb313  # #f8f8f8 on #96609e
color.calendar.overdue=rgb555 on rgb311  # #f8f8f8 on #ab4642
color.calendar.scheduled=rgb555 on rgb134  # #f8f8f8 on #7cafc2
color.calendar.today=rgb555 on rgb023  # #f8f8f8 on #4b8093
color.calendar.weekend=gray18  # #b8b8b8
color.calendar.weeknumber=gray18  # #b8b8b8

# Command: sync
color.sync.added=rgb121  # #538947
color.sync.changed=rgb530  # #f79a0e
color.sync.rejected=rgb311  # #ab4642

# Command: undo
color.undo.after=rgb121  # #538947
color.undo.before=rgb311  # #ab4642
