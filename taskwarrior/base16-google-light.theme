# tinted-taskwarrior
# Scheme name: Google Light
# Scheme author: Seth Wright (http://sethawright.com)
# Scheme: base16-google-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray17  # #b4b7b4
color.label.sort=rgb015  # #3971ed
color.alternate=on gray22  # #e0e0e0
color.header=rgb015  # #3971ed
color.footnote=rgb015  # #3971ed
color.warning=rgb555 on rgb530  # #ffffff on #fba922
color.error=rgb400  # #cc342b
color.debug=rgb015  # #3971ed

# Task state
color.completed=gray17  # #b4b7b4
color.deleted=gray17  # #b4b7b4
color.active=rgb555 on rgb021  # #ffffff on #198844
color.recurring=rgb015  # #3971ed
color.scheduled=rgb015  # #3971ed
color.until=
color.blocked=gray17  # #b4b7b4
color.blocking=rgb555 on rgb314  # #ffffff on #a36ac7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb510  # #f96a38
color.uda.priority.M=rgb530  # #fba922
color.uda.priority.L=rgb015  # #3971ed

# Tags
color.tag.next=rgb314  # #a36ac7
color.tag.none=
color.tagged=

# Due
color.due=rgb530  # #fba922
color.due.today=rgb510  # #f96a38
color.overdue=rgb400  # #cc342b

# Report: burndown
color.burndown.done=rgb555 on rgb021  # #ffffff on #198844
color.burndown.pending=rgb555 on rgb400  # #ffffff on #cc342b
color.burndown.started=rgb555 on rgb530  # #ffffff on #fba922

# Report: history
color.history.add=rgb555 on rgb400  # #ffffff on #cc342b
color.history.delete=rgb555 on rgb530  # #ffffff on #fba922
color.history.done=rgb555 on rgb021  # #ffffff on #198844

# Report: summary
color.summary.background=on gray22  # #e0e0e0
color.summary.bar=rgb555 on rgb021  # #ffffff on #198844

# Command: calendar
color.calendar.due=rgb555 on rgb530  # #ffffff on #fba922
color.calendar.due.today=rgb555 on rgb510  # #ffffff on #f96a38
color.calendar.holiday=rgb555 on rgb314  # #ffffff on #a36ac7
color.calendar.overdue=rgb555 on rgb400  # #ffffff on #cc342b
color.calendar.scheduled=rgb555 on rgb015  # #ffffff on #3971ed
color.calendar.today=rgb555 on rgb015  # #ffffff on #3971ed
color.calendar.weekend=gray17  # #b4b7b4
color.calendar.weeknumber=gray17  # #b4b7b4

# Command: sync
color.sync.added=rgb021  # #198844
color.sync.changed=rgb530  # #fba922
color.sync.rejected=rgb400  # #cc342b

# Command: undo
color.undo.after=rgb021  # #198844
color.undo.before=rgb400  # #cc342b
