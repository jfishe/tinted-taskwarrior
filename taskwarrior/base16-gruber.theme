# tinted-taskwarrior
# Scheme name: Gruber
# Scheme author: Patel, Nimai &lt;nimai.m.patel@gmail.com&gt;, colors from www.github.com/rexim/gruber-darker-theme
# Scheme: base16-gruber (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #52494e
color.label.sort=rgb234  # #96a6c8
color.alternate=on gray6  # #453d41
color.header=rgb234  # #96a6c8
color.footnote=rgb233  # #95a99f
color.warning=gray2 on rgb540  # #181818 on #ffdd33
color.error=rgb511  # #f43841
color.debug=rgb233  # #95a99f

# Task state
color.completed=gray7  # #52494e
color.deleted=gray7  # #52494e
color.active=gray2 on rgb140  # #181818 on #73c936
color.recurring=rgb233  # #95a99f
color.scheduled=rgb234  # #96a6c8
color.until=
color.blocked=gray7  # #52494e
color.blocking=gray2 on rgb223  # #181818 on #9e95c7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb311  # #c73c3f
color.uda.priority.M=rgb540  # #ffdd33
color.uda.priority.L=rgb234  # #96a6c8

# Tags
color.tag.next=rgb223  # #9e95c7
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #ffdd33
color.due.today=rgb311  # #c73c3f
color.overdue=rgb511  # #f43841

# Report: burndown
color.burndown.done=gray2 on rgb140  # #181818 on #73c936
color.burndown.pending=gray2 on rgb511  # #181818 on #f43841
color.burndown.started=gray2 on rgb540  # #181818 on #ffdd33

# Report: history
color.history.add=gray2 on rgb511  # #181818 on #f43841
color.history.delete=gray2 on rgb540  # #181818 on #ffdd33
color.history.done=gray2 on rgb140  # #181818 on #73c936

# Report: summary
color.summary.background=on gray6  # #453d41
color.summary.bar=gray2 on rgb140  # #181818 on #73c936

# Command: calendar
color.calendar.due=gray2 on rgb540  # #181818 on #ffdd33
color.calendar.due.today=gray2 on rgb311  # #181818 on #c73c3f
color.calendar.holiday=gray2 on rgb223  # #181818 on #9e95c7
color.calendar.overdue=gray2 on rgb511  # #181818 on #f43841
color.calendar.scheduled=gray2 on rgb234  # #181818 on #96a6c8
color.calendar.today=gray2 on rgb233  # #181818 on #95a99f
color.calendar.weekend=gray7  # #52494e
color.calendar.weeknumber=gray7  # #52494e

# Command: sync
color.sync.added=rgb140  # #73c936
color.sync.changed=rgb540  # #ffdd33
color.sync.rejected=rgb511  # #f43841

# Command: undo
color.undo.after=rgb140  # #73c936
color.undo.before=rgb511  # #f43841
