# tinted-taskwarrior
# Scheme name: Space Gray Eighties Dull
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-space-gray-eighties-dull (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6c6d70
color.label.sort=rgb123  # #7b8fa4
color.alternate=on gray1  # #15171c
color.header=rgb123  # #7b8fa4
color.footnote=rgb244  # #7fcccb
color.warning=gray2 on rgb123  # #212121 on #5485c0
color.error=rgb311  # #b14956
color.debug=rgb244  # #7fcccb

# Task state
color.completed=gray10  # #6c6d70
color.deleted=gray10  # #6c6d70
color.active=gray2 on rgb231  # #212121 on #91b377
color.recurring=rgb244  # #7fcccb
color.scheduled=rgb123  # #7b8fa4
color.until=
color.blocked=gray10  # #6c6d70
color.blocking=gray2 on rgb323  # #212121 on #a5779e

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #c6725a
color.uda.priority.M=rgb123  # #5485c0
color.uda.priority.L=rgb123  # #7b8fa4

# Tags
color.tag.next=rgb323  # #a5779e
color.tag.none=
color.tagged=

# Due
color.due=rgb123  # #5485c0
color.due.today=rgb421  # #c6725a
color.overdue=rgb311  # #b14956

# Report: burndown
color.burndown.done=gray2 on rgb231  # #212121 on #91b377
color.burndown.pending=gray2 on rgb311  # #212121 on #b14956
color.burndown.started=gray2 on rgb123  # #212121 on #5485c0

# Report: history
color.history.add=gray2 on rgb311  # #212121 on #b14956
color.history.delete=gray2 on rgb123  # #212121 on #5485c0
color.history.done=gray2 on rgb231  # #212121 on #91b377

# Report: summary
color.summary.background=on gray1  # #15171c
color.summary.bar=gray2 on rgb231  # #212121 on #91b377

# Command: calendar
color.calendar.due=gray2 on rgb123  # #212121 on #5485c0
color.calendar.due.today=gray2 on rgb421  # #212121 on #c6725a
color.calendar.holiday=gray2 on rgb323  # #212121 on #a5779e
color.calendar.overdue=gray2 on rgb311  # #212121 on #b14956
color.calendar.scheduled=gray2 on rgb123  # #212121 on #7b8fa4
color.calendar.today=gray2 on rgb244  # #212121 on #7fcccb
color.calendar.weekend=gray10  # #6c6d70
color.calendar.weeknumber=gray10  # #6c6d70

# Command: sync
color.sync.added=rgb231  # #91b377
color.sync.changed=rgb123  # #5485c0
color.sync.rejected=rgb311  # #b14956

# Command: undo
color.undo.after=rgb231  # #91b377
color.undo.before=rgb311  # #b14956
