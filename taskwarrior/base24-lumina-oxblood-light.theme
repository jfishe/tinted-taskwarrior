# tinted-taskwarrior
# Scheme name: Lumina Oxblood Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-oxblood-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray20  # #deced1
color.label.sort=rgb013  # #3166a6
color.alternate=on gray23  # #fbeaed
color.header=rgb013  # #3166a6
color.footnote=rgb011  # #087380
color.warning=gray23 on rgb310  # #fef2f4 on #a1600a
color.error=rgb300  # #9b2827
color.debug=rgb011  # #087380

# Task state
color.completed=gray20  # #deced1
color.deleted=gray20  # #deced1
color.active=gray23 on rgb021  # #fef2f4 on #237742
color.recurring=rgb011  # #087380
color.scheduled=rgb013  # #3166a6
color.until=
color.blocked=gray20  # #deced1
color.blocking=gray23 on rgb113  # #fef2f4 on #6556a3

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #9e511f
color.uda.priority.M=rgb310  # #a1600a
color.uda.priority.L=rgb013  # #3166a6

# Tags
color.tag.next=rgb113  # #6556a3
color.tag.none=
color.tagged=

# Due
color.due=rgb310  # #a1600a
color.due.today=rgb310  # #9e511f
color.overdue=rgb300  # #9b2827

# Report: burndown
color.burndown.done=gray23 on rgb021  # #fef2f4 on #237742
color.burndown.pending=gray23 on rgb300  # #fef2f4 on #9b2827
color.burndown.started=gray23 on rgb310  # #fef2f4 on #a1600a

# Report: history
color.history.add=gray23 on rgb300  # #fef2f4 on #9b2827
color.history.delete=gray23 on rgb310  # #fef2f4 on #a1600a
color.history.done=gray23 on rgb021  # #fef2f4 on #237742

# Report: summary
color.summary.background=on gray23  # #fbeaed
color.summary.bar=gray23 on rgb021  # #fef2f4 on #237742

# Command: calendar
color.calendar.due=gray23 on rgb310  # #fef2f4 on #a1600a
color.calendar.due.today=gray23 on rgb310  # #fef2f4 on #9e511f
color.calendar.holiday=gray23 on rgb113  # #fef2f4 on #6556a3
color.calendar.overdue=gray23 on rgb300  # #fef2f4 on #9b2827
color.calendar.scheduled=gray23 on rgb013  # #fef2f4 on #3166a6
color.calendar.today=gray23 on rgb011  # #fef2f4 on #087380
color.calendar.weekend=gray20  # #deced1
color.calendar.weeknumber=gray20  # #deced1

# Command: sync
color.sync.added=rgb021  # #237742
color.sync.changed=rgb310  # #a1600a
color.sync.rejected=rgb300  # #9b2827

# Command: undo
color.undo.after=rgb021  # #237742
color.undo.before=rgb300  # #9b2827
