# tinted-taskwarrior
# Scheme name: Royal
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-royal (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray5  # #393446
color.label.sort=rgb123  # #6480af
color.alternate=on gray3  # #241f2a
color.header=rgb123  # #6480af
color.footnote=rgb234  # #8aaabd
color.warning=gray0 on rgb235  # #100814 on #8fb9f9
color.error=rgb301  # #90274b
color.debug=rgb234  # #8aaabd

# Task state
color.completed=gray5  # #393446
color.deleted=gray5  # #393446
color.active=gray0 on rgb020  # #100814 on #23801c
color.recurring=rgb234  # #8aaabd
color.scheduled=rgb123  # #6480af
color.until=
color.blocked=gray5  # #393446
color.blocking=gray0 on rgb113  # #100814 on #664d96

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb330  # #b49d27
color.uda.priority.M=rgb235  # #8fb9f9
color.uda.priority.L=rgb123  # #6480af

# Tags
color.tag.next=rgb113  # #664d96
color.tag.none=
color.tagged=

# Due
color.due=rgb235  # #8fb9f9
color.due.today=rgb330  # #b49d27
color.overdue=rgb301  # #90274b

# Report: burndown
color.burndown.done=gray0 on rgb020  # #100814 on #23801c
color.burndown.pending=gray0 on rgb301  # #100814 on #90274b
color.burndown.started=gray0 on rgb235  # #100814 on #8fb9f9

# Report: history
color.history.add=gray0 on rgb301  # #100814 on #90274b
color.history.delete=gray0 on rgb235  # #100814 on #8fb9f9
color.history.done=gray0 on rgb020  # #100814 on #23801c

# Report: summary
color.summary.background=on gray3  # #241f2a
color.summary.bar=gray0 on rgb020  # #100814 on #23801c

# Command: calendar
color.calendar.due=gray0 on rgb235  # #100814 on #8fb9f9
color.calendar.due.today=gray0 on rgb330  # #100814 on #b49d27
color.calendar.holiday=gray0 on rgb113  # #100814 on #664d96
color.calendar.overdue=gray0 on rgb301  # #100814 on #90274b
color.calendar.scheduled=gray0 on rgb123  # #100814 on #6480af
color.calendar.today=gray0 on rgb234  # #100814 on #8aaabd
color.calendar.weekend=gray5  # #393446
color.calendar.weeknumber=gray5  # #393446

# Command: sync
color.sync.added=rgb020  # #23801c
color.sync.changed=rgb235  # #8fb9f9
color.sync.rejected=rgb301  # #90274b

# Command: undo
color.undo.after=rgb020  # #23801c
color.undo.before=rgb301  # #90274b
