# tinted-taskwarrior
# Scheme name: Mission Brogue
# Scheme author: Thomas Leon Highbaugh
# Scheme: base24-mission-brogue (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb123  # #60778a
color.label.sort=rgb345  # #a2c5fd
color.alternate=on gray6  # #3b4954
color.header=rgb345  # #a2c5fd
color.footnote=rgb244  # #93dfec
color.warning=gray4 on rgb432  # #283139 on #e0b88a
color.error=rgb533  # #efa9a9
color.debug=rgb244  # #93dfec

# Task state
color.completed=rgb123  # #60778a
color.deleted=rgb123  # #60778a
color.active=gray4 on rgb243  # #283139 on #8cd4b0
color.recurring=rgb244  # #93dfec
color.scheduled=rgb345  # #a2c5fd
color.until=
color.blocked=rgb123  # #60778a
color.blocking=gray4 on rgb434  # #283139 on #ccb7db

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb541  # #f2db78
color.uda.priority.M=rgb432  # #e0b88a
color.uda.priority.L=rgb345  # #a2c5fd

# Tags
color.tag.next=rgb434  # #ccb7db
color.tag.none=
color.tagged=

# Due
color.due=rgb432  # #e0b88a
color.due.today=rgb541  # #f2db78
color.overdue=rgb533  # #efa9a9

# Report: burndown
color.burndown.done=gray4 on rgb243  # #283139 on #8cd4b0
color.burndown.pending=gray4 on rgb533  # #283139 on #efa9a9
color.burndown.started=gray4 on rgb432  # #283139 on #e0b88a

# Report: history
color.history.add=gray4 on rgb533  # #283139 on #efa9a9
color.history.delete=gray4 on rgb432  # #283139 on #e0b88a
color.history.done=gray4 on rgb243  # #283139 on #8cd4b0

# Report: summary
color.summary.background=on gray6  # #3b4954
color.summary.bar=gray4 on rgb243  # #283139 on #8cd4b0

# Command: calendar
color.calendar.due=gray4 on rgb432  # #283139 on #e0b88a
color.calendar.due.today=gray4 on rgb541  # #283139 on #f2db78
color.calendar.holiday=gray4 on rgb434  # #283139 on #ccb7db
color.calendar.overdue=gray4 on rgb533  # #283139 on #efa9a9
color.calendar.scheduled=gray4 on rgb345  # #283139 on #a2c5fd
color.calendar.today=gray4 on rgb244  # #283139 on #93dfec
color.calendar.weekend=rgb123  # #60778a
color.calendar.weeknumber=rgb123  # #60778a

# Command: sync
color.sync.added=rgb243  # #8cd4b0
color.sync.changed=rgb432  # #e0b88a
color.sync.rejected=rgb533  # #efa9a9

# Command: undo
color.undo.after=rgb243  # #8cd4b0
color.undo.before=rgb533  # #efa9a9
