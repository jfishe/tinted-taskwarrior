# tinted-taskwarrior
# Scheme name: Ollie
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-ollie (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb211  # #664b46
color.label.sort=rgb013  # #2c56ab
color.alternate=on gray0  # #000000
color.header=rgb013  # #2c56ab
color.footnote=rgb033  # #1fa5ab
color.warning=gray2 on rgb125  # #212024 on #4487ff
color.error=rgb300  # #ab2e30
color.debug=rgb033  # #1fa5ab

# Task state
color.completed=rgb211  # #664b46
color.deleted=rgb211  # #664b46
color.active=gray2 on rgb031  # #212024 on #31ab60
color.recurring=rgb033  # #1fa5ab
color.scheduled=rgb013  # #2c56ab
color.until=
color.blocked=rgb211  # #664b46
color.blocking=gray2 on rgb320  # #212024 on #af8427

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb310  # #ab4200
color.uda.priority.M=rgb125  # #4487ff
color.uda.priority.L=rgb013  # #2c56ab

# Tags
color.tag.next=rgb320  # #af8427
color.tag.none=
color.tagged=

# Due
color.due=rgb125  # #4487ff
color.due.today=rgb310  # #ab4200
color.overdue=rgb300  # #ab2e30

# Report: burndown
color.burndown.done=gray2 on rgb031  # #212024 on #31ab60
color.burndown.pending=gray2 on rgb300  # #212024 on #ab2e30
color.burndown.started=gray2 on rgb125  # #212024 on #4487ff

# Report: history
color.history.add=gray2 on rgb300  # #212024 on #ab2e30
color.history.delete=gray2 on rgb125  # #212024 on #4487ff
color.history.done=gray2 on rgb031  # #212024 on #31ab60

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray2 on rgb031  # #212024 on #31ab60

# Command: calendar
color.calendar.due=gray2 on rgb125  # #212024 on #4487ff
color.calendar.due.today=gray2 on rgb310  # #212024 on #ab4200
color.calendar.holiday=gray2 on rgb320  # #212024 on #af8427
color.calendar.overdue=gray2 on rgb300  # #212024 on #ab2e30
color.calendar.scheduled=gray2 on rgb013  # #212024 on #2c56ab
color.calendar.today=gray2 on rgb033  # #212024 on #1fa5ab
color.calendar.weekend=rgb211  # #664b46
color.calendar.weeknumber=rgb211  # #664b46

# Command: sync
color.sync.added=rgb031  # #31ab60
color.sync.changed=rgb125  # #4487ff
color.sync.rejected=rgb300  # #ab2e30

# Command: undo
color.undo.after=rgb031  # #31ab60
color.undo.before=rgb300  # #ab2e30
