# tinted-taskwarrior
# Scheme name: Horizon Terminal Light
# Scheme author: Michaël Ball (http://github.com/michael-ball/)
# Scheme: base16-horizon-terminal-light (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray17  # #bdb3b1
color.label.sort=rgb034  # #26bbd9
color.alternate=on rgb544  # #fadad1
color.header=rgb034  # #26bbd9
color.footnote=rgb144  # #59e1e3
color.warning=gray23 on rgb544  # #fdf0ed on #fadad1
color.error=rgb512  # #e95678
color.debug=rgb144  # #59e1e3

# Task state
color.completed=gray17  # #bdb3b1
color.deleted=gray17  # #bdb3b1
color.active=gray23 on rgb042  # #fdf0ed on #29d398
color.recurring=rgb144  # #59e1e3
color.scheduled=rgb034  # #26bbd9
color.until=
color.blocked=gray17  # #bdb3b1
color.blocking=gray23 on rgb513  # #fdf0ed on #ee64ac

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb544  # #f9cec3
color.uda.priority.M=rgb544  # #fadad1
color.uda.priority.L=rgb034  # #26bbd9

# Tags
color.tag.next=rgb513  # #ee64ac
color.tag.none=
color.tagged=

# Due
color.due=rgb544  # #fadad1
color.due.today=rgb544  # #f9cec3
color.overdue=rgb512  # #e95678

# Report: burndown
color.burndown.done=gray23 on rgb042  # #fdf0ed on #29d398
color.burndown.pending=gray23 on rgb512  # #fdf0ed on #e95678
color.burndown.started=gray23 on rgb544  # #fdf0ed on #fadad1

# Report: history
color.history.add=gray23 on rgb512  # #fdf0ed on #e95678
color.history.delete=gray23 on rgb544  # #fdf0ed on #fadad1
color.history.done=gray23 on rgb042  # #fdf0ed on #29d398

# Report: summary
color.summary.background=on rgb544  # #fadad1
color.summary.bar=gray23 on rgb042  # #fdf0ed on #29d398

# Command: calendar
color.calendar.due=gray23 on rgb544  # #fdf0ed on #fadad1
color.calendar.due.today=gray23 on rgb544  # #fdf0ed on #f9cec3
color.calendar.holiday=gray23 on rgb513  # #fdf0ed on #ee64ac
color.calendar.overdue=gray23 on rgb512  # #fdf0ed on #e95678
color.calendar.scheduled=gray23 on rgb034  # #fdf0ed on #26bbd9
color.calendar.today=gray23 on rgb144  # #fdf0ed on #59e1e3
color.calendar.weekend=gray17  # #bdb3b1
color.calendar.weeknumber=gray17  # #bdb3b1

# Command: sync
color.sync.added=rgb042  # #29d398
color.sync.changed=rgb544  # #fadad1
color.sync.rejected=rgb512  # #e95678

# Command: undo
color.undo.after=rgb042  # #29d398
color.undo.before=rgb512  # #e95678
