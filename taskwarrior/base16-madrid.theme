# tinted-taskwarrior
# Scheme name: Madrid
# Scheme author: xscriptor (https://github.com/xscriptor)
# Scheme: base16-madrid (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #4d4d4d
color.label.sort=rgb023  # #007a9e
color.alternate=on gray23  # #eaeaea
color.header=rgb023  # #007a9e
color.footnote=rgb023  # #007a9e
color.warning=rgb555 on rgb210  # #fafafa on #8a6408
color.error=rgb200  # #990026
color.debug=rgb023  # #007a9e

# Task state
color.completed=gray7  # #4d4d4d
color.deleted=gray7  # #4d4d4d
color.active=rgb555 on rgb020  # #fafafa on #007a28
color.recurring=rgb023  # #007a9e
color.scheduled=rgb023  # #007a9e
color.until=
color.blocked=gray7  # #4d4d4d
color.blocking=rgb555 on rgb103  # #fafafa on #4d2699

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb300  # #923217
color.uda.priority.M=rgb210  # #8a6408
color.uda.priority.L=rgb023  # #007a9e

# Tags
color.tag.next=rgb103  # #4d2699
color.tag.none=
color.tagged=

# Due
color.due=rgb210  # #8a6408
color.due.today=rgb300  # #923217
color.overdue=rgb200  # #990026

# Report: burndown
color.burndown.done=rgb555 on rgb020  # #fafafa on #007a28
color.burndown.pending=rgb555 on rgb200  # #fafafa on #990026
color.burndown.started=rgb555 on rgb210  # #fafafa on #8a6408

# Report: history
color.history.add=rgb555 on rgb200  # #fafafa on #990026
color.history.delete=rgb555 on rgb210  # #fafafa on #8a6408
color.history.done=rgb555 on rgb020  # #fafafa on #007a28

# Report: summary
color.summary.background=on gray23  # #eaeaea
color.summary.bar=rgb555 on rgb020  # #fafafa on #007a28

# Command: calendar
color.calendar.due=rgb555 on rgb210  # #fafafa on #8a6408
color.calendar.due.today=rgb555 on rgb300  # #fafafa on #923217
color.calendar.holiday=rgb555 on rgb103  # #fafafa on #4d2699
color.calendar.overdue=rgb555 on rgb200  # #fafafa on #990026
color.calendar.scheduled=rgb555 on rgb023  # #fafafa on #007a9e
color.calendar.today=rgb555 on rgb023  # #fafafa on #007a9e
color.calendar.weekend=gray7  # #4d4d4d
color.calendar.weeknumber=gray7  # #4d4d4d

# Command: sync
color.sync.added=rgb020  # #007a28
color.sync.changed=rgb210  # #8a6408
color.sync.rejected=rgb200  # #990026

# Command: undo
color.undo.after=rgb020  # #007a28
color.undo.before=rgb200  # #990026
