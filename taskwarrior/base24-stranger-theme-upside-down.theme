# tinted-taskwarrior
# Scheme name: Stranger Theme Upside Down
# Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
# Scheme: base24-stranger-theme-upside-down (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7a8495
color.label.sort=rgb135  # #61afef
color.alternate=on gray3  # #21252b
color.header=rgb135  # #61afef
color.footnote=rgb133  # #56b6c2
color.warning=gray1 on rgb431  # #0d1117 on #e5c07b
color.error=rgb411  # #e06c75
color.debug=rgb133  # #56b6c2

# Task state
color.completed=gray12  # #7a8495
color.deleted=gray12  # #7a8495
color.active=gray1 on rgb342  # #0d1117 on #98c379
color.recurring=rgb133  # #56b6c2
color.scheduled=rgb135  # #61afef
color.until=
color.blocked=gray12  # #7a8495
color.blocking=gray1 on rgb414  # #0d1117 on #c678dd

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb432  # #d19a66
color.uda.priority.M=rgb431  # #e5c07b
color.uda.priority.L=rgb135  # #61afef

# Tags
color.tag.next=rgb414  # #c678dd
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #e5c07b
color.due.today=rgb432  # #d19a66
color.overdue=rgb411  # #e06c75

# Report: burndown
color.burndown.done=gray1 on rgb342  # #0d1117 on #98c379
color.burndown.pending=gray1 on rgb411  # #0d1117 on #e06c75
color.burndown.started=gray1 on rgb431  # #0d1117 on #e5c07b

# Report: history
color.history.add=gray1 on rgb411  # #0d1117 on #e06c75
color.history.delete=gray1 on rgb431  # #0d1117 on #e5c07b
color.history.done=gray1 on rgb342  # #0d1117 on #98c379

# Report: summary
color.summary.background=on gray3  # #21252b
color.summary.bar=gray1 on rgb342  # #0d1117 on #98c379

# Command: calendar
color.calendar.due=gray1 on rgb431  # #0d1117 on #e5c07b
color.calendar.due.today=gray1 on rgb432  # #0d1117 on #d19a66
color.calendar.holiday=gray1 on rgb414  # #0d1117 on #c678dd
color.calendar.overdue=gray1 on rgb411  # #0d1117 on #e06c75
color.calendar.scheduled=gray1 on rgb135  # #0d1117 on #61afef
color.calendar.today=gray1 on rgb133  # #0d1117 on #56b6c2
color.calendar.weekend=gray12  # #7a8495
color.calendar.weeknumber=gray12  # #7a8495

# Command: sync
color.sync.added=rgb342  # #98c379
color.sync.changed=rgb431  # #e5c07b
color.sync.rejected=rgb411  # #e06c75

# Command: undo
color.undo.after=rgb342  # #98c379
color.undo.before=rgb411  # #e06c75
