# tinted-taskwarrior
# Scheme name: Lumina Lagoon Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-lagoon-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb011  # #1c434b
color.label.sort=rgb345  # #8ec3f9
color.alternate=on gray3  # #042e36
color.header=rgb345  # #8ec3f9
color.footnote=rgb144  # #5ad3d6
color.warning=gray3 on rgb542  # #042930 on #e7cf94
color.error=rgb411  # #d3726a
color.debug=rgb144  # #5ad3d6

# Task state
color.completed=rgb011  # #1c434b
color.deleted=rgb011  # #1c434b
color.active=gray3 on rgb343  # #042930 on #9fd4a9
color.recurring=rgb144  # #5ad3d6
color.scheduled=rgb345  # #8ec3f9
color.until=
color.blocked=rgb011  # #1c434b
color.blocking=gray3 on rgb435  # #042930 on #c8baf6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #f9b283
color.uda.priority.M=rgb542  # #e7cf94
color.uda.priority.L=rgb345  # #8ec3f9

# Tags
color.tag.next=rgb435  # #c8baf6
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #e7cf94
color.due.today=rgb532  # #f9b283
color.overdue=rgb411  # #d3726a

# Report: burndown
color.burndown.done=gray3 on rgb343  # #042930 on #9fd4a9
color.burndown.pending=gray3 on rgb411  # #042930 on #d3726a
color.burndown.started=gray3 on rgb542  # #042930 on #e7cf94

# Report: history
color.history.add=gray3 on rgb411  # #042930 on #d3726a
color.history.delete=gray3 on rgb542  # #042930 on #e7cf94
color.history.done=gray3 on rgb343  # #042930 on #9fd4a9

# Report: summary
color.summary.background=on gray3  # #042e36
color.summary.bar=gray3 on rgb343  # #042930 on #9fd4a9

# Command: calendar
color.calendar.due=gray3 on rgb542  # #042930 on #e7cf94
color.calendar.due.today=gray3 on rgb532  # #042930 on #f9b283
color.calendar.holiday=gray3 on rgb435  # #042930 on #c8baf6
color.calendar.overdue=gray3 on rgb411  # #042930 on #d3726a
color.calendar.scheduled=gray3 on rgb345  # #042930 on #8ec3f9
color.calendar.today=gray3 on rgb144  # #042930 on #5ad3d6
color.calendar.weekend=rgb011  # #1c434b
color.calendar.weeknumber=rgb011  # #1c434b

# Command: sync
color.sync.added=rgb343  # #9fd4a9
color.sync.changed=rgb542  # #e7cf94
color.sync.rejected=rgb411  # #d3726a

# Command: undo
color.undo.after=rgb343  # #9fd4a9
color.undo.before=rgb411  # #d3726a
