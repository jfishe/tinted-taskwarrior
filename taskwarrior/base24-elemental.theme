# tinted-taskwarrior
# Scheme name: Elemental
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-elemental (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb111  # #5f5d50
color.label.sort=rgb122  # #497f7d
color.alternate=on gray5  # #3c3b30
color.header=rgb122  # #497f7d
color.footnote=rgb021  # #387f58
color.warning=gray2 on rgb244  # #21211c on #78d8d8
color.error=rgb300  # #97280f
color.debug=rgb021  # #387f58

# Task state
color.completed=rgb111  # #5f5d50
color.deleted=rgb111  # #5f5d50
color.active=gray2 on rgb131  # #21211c on #479942
color.recurring=rgb021  # #387f58
color.scheduled=rgb122  # #497f7d
color.until=
color.blocked=rgb111  # #5f5d50
color.blocking=gray2 on rgb210  # #21211c on #7e4e2e

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb220  # #7f7110
color.uda.priority.M=rgb244  # #78d8d8
color.uda.priority.L=rgb122  # #497f7d

# Tags
color.tag.next=rgb210  # #7e4e2e
color.tag.none=
color.tagged=

# Due
color.due=rgb244  # #78d8d8
color.due.today=rgb220  # #7f7110
color.overdue=rgb300  # #97280f

# Report: burndown
color.burndown.done=gray2 on rgb131  # #21211c on #479942
color.burndown.pending=gray2 on rgb300  # #21211c on #97280f
color.burndown.started=gray2 on rgb244  # #21211c on #78d8d8

# Report: history
color.history.add=gray2 on rgb300  # #21211c on #97280f
color.history.delete=gray2 on rgb244  # #21211c on #78d8d8
color.history.done=gray2 on rgb131  # #21211c on #479942

# Report: summary
color.summary.background=on gray5  # #3c3b30
color.summary.bar=gray2 on rgb131  # #21211c on #479942

# Command: calendar
color.calendar.due=gray2 on rgb244  # #21211c on #78d8d8
color.calendar.due.today=gray2 on rgb220  # #21211c on #7f7110
color.calendar.holiday=gray2 on rgb210  # #21211c on #7e4e2e
color.calendar.overdue=gray2 on rgb300  # #21211c on #97280f
color.calendar.scheduled=gray2 on rgb122  # #21211c on #497f7d
color.calendar.today=gray2 on rgb021  # #21211c on #387f58
color.calendar.weekend=rgb111  # #5f5d50
color.calendar.weeknumber=rgb111  # #5f5d50

# Command: sync
color.sync.added=rgb131  # #479942
color.sync.changed=rgb244  # #78d8d8
color.sync.rejected=rgb300  # #97280f

# Command: undo
color.undo.after=rgb131  # #479942
color.undo.before=rgb300  # #97280f
