# tinted-taskwarrior
# Scheme name: Corduroy
# Scheme author: taysatte (https://github.com/taysatte)
# Scheme: base16-corduroy (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb112  # #6f6373
color.label.sort=rgb422  # #d27f91
color.alternate=on gray2  # #261e2a
color.header=rgb422  # #d27f91
color.footnote=rgb533  # #e99d90
color.warning=gray2 on rgb532  # #1d1920 on #edb392
color.error=rgb512  # #e06278
color.debug=rgb533  # #e99d90

# Task state
color.completed=rgb112  # #6f6373
color.deleted=rgb112  # #6f6373
color.active=gray2 on rgb122  # #1d1920 on #4b8686
color.recurring=rgb533  # #e99d90
color.scheduled=rgb422  # #d27f91
color.until=
color.blocked=rgb112  # #6f6373
color.blocking=gray2 on rgb323  # #1d1920 on #c285b2

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb533  # #e99d90
color.uda.priority.M=rgb532  # #edb392
color.uda.priority.L=rgb422  # #d27f91

# Tags
color.tag.next=rgb323  # #c285b2
color.tag.none=
color.tagged=

# Due
color.due=rgb532  # #edb392
color.due.today=rgb533  # #e99d90
color.overdue=rgb512  # #e06278

# Report: burndown
color.burndown.done=gray2 on rgb122  # #1d1920 on #4b8686
color.burndown.pending=gray2 on rgb512  # #1d1920 on #e06278
color.burndown.started=gray2 on rgb532  # #1d1920 on #edb392

# Report: history
color.history.add=gray2 on rgb512  # #1d1920 on #e06278
color.history.delete=gray2 on rgb532  # #1d1920 on #edb392
color.history.done=gray2 on rgb122  # #1d1920 on #4b8686

# Report: summary
color.summary.background=on gray2  # #261e2a
color.summary.bar=gray2 on rgb122  # #1d1920 on #4b8686

# Command: calendar
color.calendar.due=gray2 on rgb532  # #1d1920 on #edb392
color.calendar.due.today=gray2 on rgb533  # #1d1920 on #e99d90
color.calendar.holiday=gray2 on rgb323  # #1d1920 on #c285b2
color.calendar.overdue=gray2 on rgb512  # #1d1920 on #e06278
color.calendar.scheduled=gray2 on rgb422  # #1d1920 on #d27f91
color.calendar.today=gray2 on rgb533  # #1d1920 on #e99d90
color.calendar.weekend=rgb112  # #6f6373
color.calendar.weeknumber=rgb112  # #6f6373

# Command: sync
color.sync.added=rgb122  # #4b8686
color.sync.changed=rgb532  # #edb392
color.sync.rejected=rgb512  # #e06278

# Command: undo
color.undo.after=rgb122  # #4b8686
color.undo.before=rgb512  # #e06278
