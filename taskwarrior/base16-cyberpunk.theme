# tinted-taskwarrior
# Scheme name: Cyberpunk
# Scheme author: benjujo
# Scheme: base16-cyberpunk (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #4f4f4f
color.label.sort=rgb125  # #4c83ff
color.alternate=on gray3  # #2b2b2b
color.header=rgb125  # #4c83ff
color.footnote=rgb244  # #93e0e3
color.warning=gray0 on rgb550  # #000000 on #ffff00
color.error=rgb500  # #ff0000
color.debug=rgb244  # #93e0e3

# Task state
color.completed=gray7  # #4f4f4f
color.deleted=gray7  # #4f4f4f
color.active=gray0 on rgb140  # #000000 on #61ce3c
color.recurring=rgb244  # #93e0e3
color.scheduled=rgb125  # #4c83ff
color.until=
color.blocked=gray7  # #4f4f4f
color.blocking=gray0 on rgb502  # #000000 on #ff1493

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb530  # #ffa500
color.uda.priority.M=rgb550  # #ffff00
color.uda.priority.L=rgb125  # #4c83ff

# Tags
color.tag.next=rgb502  # #ff1493
color.tag.none=
color.tagged=

# Due
color.due=rgb550  # #ffff00
color.due.today=rgb530  # #ffa500
color.overdue=rgb500  # #ff0000

# Report: burndown
color.burndown.done=gray0 on rgb140  # #000000 on #61ce3c
color.burndown.pending=gray0 on rgb500  # #000000 on #ff0000
color.burndown.started=gray0 on rgb550  # #000000 on #ffff00

# Report: history
color.history.add=gray0 on rgb500  # #000000 on #ff0000
color.history.delete=gray0 on rgb550  # #000000 on #ffff00
color.history.done=gray0 on rgb140  # #000000 on #61ce3c

# Report: summary
color.summary.background=on gray3  # #2b2b2b
color.summary.bar=gray0 on rgb140  # #000000 on #61ce3c

# Command: calendar
color.calendar.due=gray0 on rgb550  # #000000 on #ffff00
color.calendar.due.today=gray0 on rgb530  # #000000 on #ffa500
color.calendar.holiday=gray0 on rgb502  # #000000 on #ff1493
color.calendar.overdue=gray0 on rgb500  # #000000 on #ff0000
color.calendar.scheduled=gray0 on rgb125  # #000000 on #4c83ff
color.calendar.today=gray0 on rgb244  # #000000 on #93e0e3
color.calendar.weekend=gray7  # #4f4f4f
color.calendar.weeknumber=gray7  # #4f4f4f

# Command: sync
color.sync.added=rgb140  # #61ce3c
color.sync.changed=rgb550  # #ffff00
color.sync.rejected=rgb500  # #ff0000

# Command: undo
color.undo.after=rgb140  # #61ce3c
color.undo.before=rgb500  # #ff0000
