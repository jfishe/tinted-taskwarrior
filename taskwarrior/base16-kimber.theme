# tinted-taskwarrior
# Scheme name: Kimber
# Scheme author: Mishka Nguyen (https://github.com/akhsiM)
# Scheme: base16-kimber (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb211  # #644646
color.label.sort=rgb123  # #537c9c
color.alternate=on gray4  # #313131
color.header=rgb123  # #537c9c
color.footnote=rgb133  # #78b4b4
color.warning=gray3 on rgb431  # #222222 on #d8b56d
color.error=rgb422  # #c88c8c
color.debug=rgb133  # #78b4b4

# Task state
color.completed=rgb211  # #644646
color.deleted=rgb211  # #644646
color.active=gray3 on rgb343  # #222222 on #99c899
color.recurring=rgb133  # #78b4b4
color.scheduled=rgb123  # #537c9c
color.until=
color.blocked=rgb211  # #644646
color.blocking=gray3 on rgb244  # #222222 on #86cacd

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb012  # #476c88
color.uda.priority.M=rgb431  # #d8b56d
color.uda.priority.L=rgb123  # #537c9c

# Tags
color.tag.next=rgb244  # #86cacd
color.tag.none=
color.tagged=

# Due
color.due=rgb431  # #d8b56d
color.due.today=rgb012  # #476c88
color.overdue=rgb422  # #c88c8c

# Report: burndown
color.burndown.done=gray3 on rgb343  # #222222 on #99c899
color.burndown.pending=gray3 on rgb422  # #222222 on #c88c8c
color.burndown.started=gray3 on rgb431  # #222222 on #d8b56d

# Report: history
color.history.add=gray3 on rgb422  # #222222 on #c88c8c
color.history.delete=gray3 on rgb431  # #222222 on #d8b56d
color.history.done=gray3 on rgb343  # #222222 on #99c899

# Report: summary
color.summary.background=on gray4  # #313131
color.summary.bar=gray3 on rgb343  # #222222 on #99c899

# Command: calendar
color.calendar.due=gray3 on rgb431  # #222222 on #d8b56d
color.calendar.due.today=gray3 on rgb012  # #222222 on #476c88
color.calendar.holiday=gray3 on rgb244  # #222222 on #86cacd
color.calendar.overdue=gray3 on rgb422  # #222222 on #c88c8c
color.calendar.scheduled=gray3 on rgb123  # #222222 on #537c9c
color.calendar.today=gray3 on rgb133  # #222222 on #78b4b4
color.calendar.weekend=rgb211  # #644646
color.calendar.weeknumber=rgb211  # #644646

# Command: sync
color.sync.added=rgb343  # #99c899
color.sync.changed=rgb431  # #d8b56d
color.sync.rejected=rgb422  # #c88c8c

# Command: undo
color.undo.after=rgb343  # #99c899
color.undo.before=rgb422  # #c88c8c
