# tinted-taskwarrior
# Scheme name: Espresso
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-espresso (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #797979
color.label.sort=rgb123  # #6c99bb
color.alternate=on gray4  # #343434
color.header=rgb123  # #6c99bb
color.footnote=rgb345  # #bed6ff
color.warning=gray3 on rgb234  # #262626 on #8ab7d9
color.error=rgb411  # #d25151
color.debug=rgb345  # #bed6ff

# Task state
color.completed=gray11  # #797979
color.deleted=gray11  # #797979
color.active=gray3 on rgb341  # #262626 on #a5c261
color.recurring=rgb345  # #bed6ff
color.scheduled=rgb123  # #6c99bb
color.until=
color.blocked=gray11  # #797979
color.blocking=gray3 on rgb424  # #262626 on #d197d9

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb542  # #ffc66d
color.uda.priority.M=rgb234  # #8ab7d9
color.uda.priority.L=rgb123  # #6c99bb

# Tags
color.tag.next=rgb424  # #d197d9
color.tag.none=
color.tagged=

# Due
color.due=rgb234  # #8ab7d9
color.due.today=rgb542  # #ffc66d
color.overdue=rgb411  # #d25151

# Report: burndown
color.burndown.done=gray3 on rgb341  # #262626 on #a5c261
color.burndown.pending=gray3 on rgb411  # #262626 on #d25151
color.burndown.started=gray3 on rgb234  # #262626 on #8ab7d9

# Report: history
color.history.add=gray3 on rgb411  # #262626 on #d25151
color.history.delete=gray3 on rgb234  # #262626 on #8ab7d9
color.history.done=gray3 on rgb341  # #262626 on #a5c261

# Report: summary
color.summary.background=on gray4  # #343434
color.summary.bar=gray3 on rgb341  # #262626 on #a5c261

# Command: calendar
color.calendar.due=gray3 on rgb234  # #262626 on #8ab7d9
color.calendar.due.today=gray3 on rgb542  # #262626 on #ffc66d
color.calendar.holiday=gray3 on rgb424  # #262626 on #d197d9
color.calendar.overdue=gray3 on rgb411  # #262626 on #d25151
color.calendar.scheduled=gray3 on rgb123  # #262626 on #6c99bb
color.calendar.today=gray3 on rgb345  # #262626 on #bed6ff
color.calendar.weekend=gray11  # #797979
color.calendar.weeknumber=gray11  # #797979

# Command: sync
color.sync.added=rgb341  # #a5c261
color.sync.changed=rgb234  # #8ab7d9
color.sync.rejected=rgb411  # #d25151

# Command: undo
color.undo.after=rgb341  # #a5c261
color.undo.before=rgb411  # #d25151
