# tinted-taskwarrior
# Scheme name: Chicago Night
# Scheme author: Wendell, Ryan &lt;ryanjwendell@gmail.com&gt;
# Scheme: base16-chicago-night (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb122  # #5f7368
color.label.sort=rgb103  # #522398
color.alternate=on gray5  # #2a3b32
color.header=rgb103  # #522398
color.footnote=rgb035  # #00a1de
color.warning=gray3 on rgb540  # #1e2a24 on #f9e300
color.error=rgb300  # #c60c30
color.debug=rgb035  # #00a1de

# Task state
color.completed=rgb122  # #5f7368
color.deleted=rgb122  # #5f7368
color.active=gray3 on rgb031  # #1e2a24 on #009b3a
color.recurring=rgb035  # #00a1de
color.scheduled=rgb103  # #522398
color.until=
color.blocked=rgb122  # #5f7368
color.blocking=gray3 on rgb423  # #1e2a24 on #e27ea6

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb500  # #f9461c
color.uda.priority.M=rgb540  # #f9e300
color.uda.priority.L=rgb103  # #522398

# Tags
color.tag.next=rgb423  # #e27ea6
color.tag.none=
color.tagged=

# Due
color.due=rgb540  # #f9e300
color.due.today=rgb500  # #f9461c
color.overdue=rgb300  # #c60c30

# Report: burndown
color.burndown.done=gray3 on rgb031  # #1e2a24 on #009b3a
color.burndown.pending=gray3 on rgb300  # #1e2a24 on #c60c30
color.burndown.started=gray3 on rgb540  # #1e2a24 on #f9e300

# Report: history
color.history.add=gray3 on rgb300  # #1e2a24 on #c60c30
color.history.delete=gray3 on rgb540  # #1e2a24 on #f9e300
color.history.done=gray3 on rgb031  # #1e2a24 on #009b3a

# Report: summary
color.summary.background=on gray5  # #2a3b32
color.summary.bar=gray3 on rgb031  # #1e2a24 on #009b3a

# Command: calendar
color.calendar.due=gray3 on rgb540  # #1e2a24 on #f9e300
color.calendar.due.today=gray3 on rgb500  # #1e2a24 on #f9461c
color.calendar.holiday=gray3 on rgb423  # #1e2a24 on #e27ea6
color.calendar.overdue=gray3 on rgb300  # #1e2a24 on #c60c30
color.calendar.scheduled=gray3 on rgb103  # #1e2a24 on #522398
color.calendar.today=gray3 on rgb035  # #1e2a24 on #00a1de
color.calendar.weekend=rgb122  # #5f7368
color.calendar.weeknumber=rgb122  # #5f7368

# Command: sync
color.sync.added=rgb031  # #009b3a
color.sync.changed=rgb540  # #f9e300
color.sync.rejected=rgb300  # #c60c30

# Command: undo
color.undo.after=rgb031  # #009b3a
color.undo.before=rgb300  # #c60c30
