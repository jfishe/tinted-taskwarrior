# tinted-taskwarrior
# Scheme name: Solar Flare
# Scheme author: Chuck Harmston (https://chuck.harmston.ch)
# Scheme: base16-solarflare (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #667581
color.label.sort=rgb034  # #33b5e1
color.alternate=on gray4  # #222e38
color.header=rgb034  # #33b5e1
color.footnote=rgb143  # #52cbb0
color.warning=gray3 on rgb430  # #18262f on #e4b51c
color.error=rgb511  # #ef5253
color.debug=rgb143  # #52cbb0

# Task state
color.completed=gray11  # #667581
color.deleted=gray11  # #667581
color.active=gray3 on rgb241  # #18262f on #7cc844
color.recurring=rgb143  # #52cbb0
color.scheduled=rgb034  # #33b5e1
color.until=
color.blocked=gray11  # #667581
color.blocking=gray3 on rgb314  # #18262f on #a363d5

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb510  # #e66b2b
color.uda.priority.M=rgb430  # #e4b51c
color.uda.priority.L=rgb034  # #33b5e1

# Tags
color.tag.next=rgb314  # #a363d5
color.tag.none=
color.tagged=

# Due
color.due=rgb430  # #e4b51c
color.due.today=rgb510  # #e66b2b
color.overdue=rgb511  # #ef5253

# Report: burndown
color.burndown.done=gray3 on rgb241  # #18262f on #7cc844
color.burndown.pending=gray3 on rgb511  # #18262f on #ef5253
color.burndown.started=gray3 on rgb430  # #18262f on #e4b51c

# Report: history
color.history.add=gray3 on rgb511  # #18262f on #ef5253
color.history.delete=gray3 on rgb430  # #18262f on #e4b51c
color.history.done=gray3 on rgb241  # #18262f on #7cc844

# Report: summary
color.summary.background=on gray4  # #222e38
color.summary.bar=gray3 on rgb241  # #18262f on #7cc844

# Command: calendar
color.calendar.due=gray3 on rgb430  # #18262f on #e4b51c
color.calendar.due.today=gray3 on rgb510  # #18262f on #e66b2b
color.calendar.holiday=gray3 on rgb314  # #18262f on #a363d5
color.calendar.overdue=gray3 on rgb511  # #18262f on #ef5253
color.calendar.scheduled=gray3 on rgb034  # #18262f on #33b5e1
color.calendar.today=gray3 on rgb143  # #18262f on #52cbb0
color.calendar.weekend=gray11  # #667581
color.calendar.weeknumber=gray11  # #667581

# Command: sync
color.sync.added=rgb241  # #7cc844
color.sync.changed=rgb430  # #e4b51c
color.sync.rejected=rgb511  # #ef5253

# Command: undo
color.undo.after=rgb241  # #7cc844
color.undo.before=rgb511  # #ef5253
