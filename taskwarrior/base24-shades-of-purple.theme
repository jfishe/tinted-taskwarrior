# tinted-taskwarrior
# Scheme name: Shades Of Purple
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-shades-of-purple (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray12  # #7f7f7f
color.label.sort=rgb205  # #6943ff
color.alternate=on gray0  # #000000
color.header=rgb205  # #6943ff
color.footnote=rgb044  # #00c5c7
color.warning=gray3 on rgb115  # #1e1d40 on #6871ff
color.error=rgb400  # #d90429
color.debug=rgb044  # #00c5c7

# Task state
color.completed=gray12  # #7f7f7f
color.deleted=gray12  # #7f7f7f
color.active=gray3 on rgb040  # #1e1d40 on #3ad900
color.recurring=rgb044  # #00c5c7
color.scheduled=rgb205  # #6943ff
color.until=
color.blocked=gray12  # #7f7f7f
color.blocking=gray3 on rgb501  # #1e1d40 on #ff2b70

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb540  # #ffe700
color.uda.priority.M=rgb115  # #6871ff
color.uda.priority.L=rgb205  # #6943ff

# Tags
color.tag.next=rgb501  # #ff2b70
color.tag.none=
color.tagged=

# Due
color.due=rgb115  # #6871ff
color.due.today=rgb540  # #ffe700
color.overdue=rgb400  # #d90429

# Report: burndown
color.burndown.done=gray3 on rgb040  # #1e1d40 on #3ad900
color.burndown.pending=gray3 on rgb400  # #1e1d40 on #d90429
color.burndown.started=gray3 on rgb115  # #1e1d40 on #6871ff

# Report: history
color.history.add=gray3 on rgb400  # #1e1d40 on #d90429
color.history.delete=gray3 on rgb115  # #1e1d40 on #6871ff
color.history.done=gray3 on rgb040  # #1e1d40 on #3ad900

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray3 on rgb040  # #1e1d40 on #3ad900

# Command: calendar
color.calendar.due=gray3 on rgb115  # #1e1d40 on #6871ff
color.calendar.due.today=gray3 on rgb540  # #1e1d40 on #ffe700
color.calendar.holiday=gray3 on rgb501  # #1e1d40 on #ff2b70
color.calendar.overdue=gray3 on rgb400  # #1e1d40 on #d90429
color.calendar.scheduled=gray3 on rgb205  # #1e1d40 on #6943ff
color.calendar.today=gray3 on rgb044  # #1e1d40 on #00c5c7
color.calendar.weekend=gray12  # #7f7f7f
color.calendar.weeknumber=gray12  # #7f7f7f

# Command: sync
color.sync.added=rgb040  # #3ad900
color.sync.changed=rgb115  # #6871ff
color.sync.rejected=rgb400  # #d90429

# Command: undo
color.undo.after=rgb040  # #3ad900
color.undo.before=rgb400  # #d90429
