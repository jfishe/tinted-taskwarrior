# tinted-taskwarrior
# Scheme name: Catppuccin Latte
# Scheme author: https://github.com/catppuccin/catppuccin
# Scheme: tinted8-catppuccin-latte (light)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray15  # #9ca0b0
color.label.sort=rgb015  # #1e66f5
color.alternate=on gray18  # #b6bfd1
color.header=rgb015  # #1e66f5
color.footnote=rgb022  # #179299
color.warning=gray22 on rgb420  # #dce0e8 on #df8e1d
color.error=rgb401  # #d20f39
color.debug=rgb022  # #179299

# Task state
color.completed=gray15  # #9ca0b0
color.deleted=gray15  # #9ca0b0
color.active=gray22 on rgb030  # #dce0e8 on #40a02b
color.recurring=rgb022  # #179299
color.scheduled=rgb015  # #1e66f5
color.until=
color.blocked=gray15  # #9ca0b0
color.blocking=gray22 on rgb205  # #dce0e8 on #8839ef

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb510  # #fe640b
color.uda.priority.M=rgb420  # #df8e1d
color.uda.priority.L=rgb015  # #1e66f5

# Tags
color.tag.next=rgb205  # #8839ef
color.tag.none=
color.tagged=

# Due
color.due=rgb420  # #df8e1d
color.due.today=rgb510  # #fe640b
color.overdue=rgb401  # #d20f39

# Report: burndown
color.burndown.done=gray22 on rgb030  # #dce0e8 on #40a02b
color.burndown.pending=gray22 on rgb401  # #dce0e8 on #d20f39
color.burndown.started=gray22 on rgb420  # #dce0e8 on #df8e1d

# Report: history
color.history.add=gray22 on rgb401  # #dce0e8 on #d20f39
color.history.delete=gray22 on rgb420  # #dce0e8 on #df8e1d
color.history.done=gray22 on rgb030  # #dce0e8 on #40a02b

# Report: summary
color.summary.background=on gray18  # #b6bfd1
color.summary.bar=gray22 on rgb030  # #dce0e8 on #40a02b

# Command: calendar
color.calendar.due=gray22 on rgb420  # #dce0e8 on #df8e1d
color.calendar.due.today=gray22 on rgb510  # #dce0e8 on #fe640b
color.calendar.holiday=gray22 on rgb205  # #dce0e8 on #8839ef
color.calendar.overdue=gray22 on rgb401  # #dce0e8 on #d20f39
color.calendar.scheduled=gray22 on rgb015  # #dce0e8 on #1e66f5
color.calendar.today=gray22 on rgb022  # #dce0e8 on #179299
color.calendar.weekend=gray15  # #9ca0b0
color.calendar.weeknumber=gray15  # #9ca0b0

# Command: sync
color.sync.added=rgb030  # #40a02b
color.sync.changed=rgb420  # #df8e1d
color.sync.rejected=rgb401  # #d20f39

# Command: undo
color.undo.after=rgb030  # #40a02b
color.undo.before=rgb401  # #d20f39
