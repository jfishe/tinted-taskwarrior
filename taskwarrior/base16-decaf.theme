# tinted-taskwarrior
# Scheme name: Decaf
# Scheme author: Alex Mirrington (https://github.com/alexmirrington)
# Scheme: base16-decaf (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray11  # #777777
color.label.sort=rgb234  # #90bee1
color.alternate=on gray5  # #393939
color.header=rgb234  # #90bee1
color.footnote=rgb345  # #bed6ff
color.warning=gray4 on rgb542  # #2d2d2d on #ffd67c
color.error=rgb522  # #ff7f7b
color.debug=rgb345  # #bed6ff

# Task state
color.completed=gray11  # #777777
color.deleted=gray11  # #777777
color.active=gray4 on rgb341  # #2d2d2d on #beda78
color.recurring=rgb345  # #bed6ff
color.scheduled=rgb234  # #90bee1
color.until=
color.blocked=gray11  # #777777
color.blocking=gray4 on rgb535  # #2d2d2d on #efb3f7

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531  # #ffbf70
color.uda.priority.M=rgb542  # #ffd67c
color.uda.priority.L=rgb234  # #90bee1

# Tags
color.tag.next=rgb535  # #efb3f7
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #ffd67c
color.due.today=rgb531  # #ffbf70
color.overdue=rgb522  # #ff7f7b

# Report: burndown
color.burndown.done=gray4 on rgb341  # #2d2d2d on #beda78
color.burndown.pending=gray4 on rgb522  # #2d2d2d on #ff7f7b
color.burndown.started=gray4 on rgb542  # #2d2d2d on #ffd67c

# Report: history
color.history.add=gray4 on rgb522  # #2d2d2d on #ff7f7b
color.history.delete=gray4 on rgb542  # #2d2d2d on #ffd67c
color.history.done=gray4 on rgb341  # #2d2d2d on #beda78

# Report: summary
color.summary.background=on gray5  # #393939
color.summary.bar=gray4 on rgb341  # #2d2d2d on #beda78

# Command: calendar
color.calendar.due=gray4 on rgb542  # #2d2d2d on #ffd67c
color.calendar.due.today=gray4 on rgb531  # #2d2d2d on #ffbf70
color.calendar.holiday=gray4 on rgb535  # #2d2d2d on #efb3f7
color.calendar.overdue=gray4 on rgb522  # #2d2d2d on #ff7f7b
color.calendar.scheduled=gray4 on rgb234  # #2d2d2d on #90bee1
color.calendar.today=gray4 on rgb345  # #2d2d2d on #bed6ff
color.calendar.weekend=gray11  # #777777
color.calendar.weeknumber=gray11  # #777777

# Command: sync
color.sync.added=rgb341  # #beda78
color.sync.changed=rgb542  # #ffd67c
color.sync.rejected=rgb522  # #ff7f7b

# Command: undo
color.undo.after=rgb341  # #beda78
color.undo.before=rgb522  # #ff7f7b
