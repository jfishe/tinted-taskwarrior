# tinted-taskwarrior
# Scheme name: Lumina Rayleigh Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme: base24-lumina-rayleigh-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray4  # #1f364d
color.label.sort=rgb135  # #6fc3ff
color.alternate=on gray2  # #0b2237
color.header=rgb135  # #6fc3ff
color.footnote=rgb344  # #afdee6
color.warning=gray2 on rgb542  # #091d30 on #f1cc79
color.error=rgb411  # #d96d65
color.debug=rgb344  # #afdee6

# Task state
color.completed=gray4  # #1f364d
color.deleted=gray4  # #1f364d
color.active=gray2 on rgb243  # #091d30 on #96d2a2
color.recurring=rgb344  # #afdee6
color.scheduled=rgb135  # #6fc3ff
color.until=
color.blocked=gray4  # #1f364d
color.blocking=gray2 on rgb435  # #091d30 on #bf9ef1

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb532  # #faac77
color.uda.priority.M=rgb542  # #f1cc79
color.uda.priority.L=rgb135  # #6fc3ff

# Tags
color.tag.next=rgb435  # #bf9ef1
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #f1cc79
color.due.today=rgb532  # #faac77
color.overdue=rgb411  # #d96d65

# Report: burndown
color.burndown.done=gray2 on rgb243  # #091d30 on #96d2a2
color.burndown.pending=gray2 on rgb411  # #091d30 on #d96d65
color.burndown.started=gray2 on rgb542  # #091d30 on #f1cc79

# Report: history
color.history.add=gray2 on rgb411  # #091d30 on #d96d65
color.history.delete=gray2 on rgb542  # #091d30 on #f1cc79
color.history.done=gray2 on rgb243  # #091d30 on #96d2a2

# Report: summary
color.summary.background=on gray2  # #0b2237
color.summary.bar=gray2 on rgb243  # #091d30 on #96d2a2

# Command: calendar
color.calendar.due=gray2 on rgb542  # #091d30 on #f1cc79
color.calendar.due.today=gray2 on rgb532  # #091d30 on #faac77
color.calendar.holiday=gray2 on rgb435  # #091d30 on #bf9ef1
color.calendar.overdue=gray2 on rgb411  # #091d30 on #d96d65
color.calendar.scheduled=gray2 on rgb135  # #091d30 on #6fc3ff
color.calendar.today=gray2 on rgb344  # #091d30 on #afdee6
color.calendar.weekend=gray4  # #1f364d
color.calendar.weeknumber=gray4  # #1f364d

# Command: sync
color.sync.added=rgb243  # #96d2a2
color.sync.changed=rgb542  # #f1cc79
color.sync.rejected=rgb411  # #d96d65

# Command: undo
color.undo.after=rgb243  # #96d2a2
color.undo.before=rgb411  # #d96d65
