# tinted-taskwarrior
# Scheme name: Cobalt2
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-cobalt2 (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray10  # #6e6e6e
color.label.sort=rgb014  # #1460d2
color.alternate=on gray0  # #000000
color.header=rgb014  # #1460d2
color.footnote=rgb033  # #00bbbb
color.warning=gray3 on rgb115  # #122637 on #5555ff
color.error=rgb500  # #ff0000
color.debug=rgb033  # #00bbbb

# Task state
color.completed=gray10  # #6e6e6e
color.deleted=gray10  # #6e6e6e
color.active=gray3 on rgb040  # #122637 on #37dd21
color.recurring=rgb033  # #00bbbb
color.scheduled=rgb014  # #1460d2
color.until=
color.blocked=gray10  # #6e6e6e
color.blocking=gray3 on rgb501  # #122637 on #ff005d

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb540  # #fee409
color.uda.priority.M=rgb115  # #5555ff
color.uda.priority.L=rgb014  # #1460d2

# Tags
color.tag.next=rgb501  # #ff005d
color.tag.none=
color.tagged=

# Due
color.due=rgb115  # #5555ff
color.due.today=rgb540  # #fee409
color.overdue=rgb500  # #ff0000

# Report: burndown
color.burndown.done=gray3 on rgb040  # #122637 on #37dd21
color.burndown.pending=gray3 on rgb500  # #122637 on #ff0000
color.burndown.started=gray3 on rgb115  # #122637 on #5555ff

# Report: history
color.history.add=gray3 on rgb500  # #122637 on #ff0000
color.history.delete=gray3 on rgb115  # #122637 on #5555ff
color.history.done=gray3 on rgb040  # #122637 on #37dd21

# Report: summary
color.summary.background=on gray0  # #000000
color.summary.bar=gray3 on rgb040  # #122637 on #37dd21

# Command: calendar
color.calendar.due=gray3 on rgb115  # #122637 on #5555ff
color.calendar.due.today=gray3 on rgb540  # #122637 on #fee409
color.calendar.holiday=gray3 on rgb501  # #122637 on #ff005d
color.calendar.overdue=gray3 on rgb500  # #122637 on #ff0000
color.calendar.scheduled=gray3 on rgb014  # #122637 on #1460d2
color.calendar.today=gray3 on rgb033  # #122637 on #00bbbb
color.calendar.weekend=gray10  # #6e6e6e
color.calendar.weeknumber=gray10  # #6e6e6e

# Command: sync
color.sync.added=rgb040  # #37dd21
color.sync.changed=rgb115  # #5555ff
color.sync.rejected=rgb500  # #ff0000

# Command: undo
color.undo.after=rgb040  # #37dd21
color.undo.before=rgb500  # #ff0000
