# tinted-taskwarrior
# Scheme name: Stranger Theme Tigers
# Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
# Scheme: base16-stranger-theme-tigers (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=rgb121  # #758975
color.label.sort=rgb323  # #b294bb
color.alternate=on gray4  # #2c322c
color.header=rgb323  # #b294bb
color.footnote=rgb234  # #81a2be
color.warning=gray2 on rgb542  # #181e18 on #f0c674
color.error=rgb411  # #cc6666
color.debug=rgb234  # #81a2be

# Task state
color.completed=rgb121  # #758975
color.deleted=rgb121  # #758975
color.active=gray2 on rgb331  # #181e18 on #b5bd68
color.recurring=rgb234  # #81a2be
color.scheduled=rgb323  # #b294bb
color.until=
color.blocked=rgb121  # #758975
color.blocking=gray2 on rgb520  # #181e18 on #ff7f2a

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb421  # #de935f
color.uda.priority.M=rgb542  # #f0c674
color.uda.priority.L=rgb323  # #b294bb

# Tags
color.tag.next=rgb520  # #ff7f2a
color.tag.none=
color.tagged=

# Due
color.due=rgb542  # #f0c674
color.due.today=rgb421  # #de935f
color.overdue=rgb411  # #cc6666

# Report: burndown
color.burndown.done=gray2 on rgb331  # #181e18 on #b5bd68
color.burndown.pending=gray2 on rgb411  # #181e18 on #cc6666
color.burndown.started=gray2 on rgb542  # #181e18 on #f0c674

# Report: history
color.history.add=gray2 on rgb411  # #181e18 on #cc6666
color.history.delete=gray2 on rgb542  # #181e18 on #f0c674
color.history.done=gray2 on rgb331  # #181e18 on #b5bd68

# Report: summary
color.summary.background=on gray4  # #2c322c
color.summary.bar=gray2 on rgb331  # #181e18 on #b5bd68

# Command: calendar
color.calendar.due=gray2 on rgb542  # #181e18 on #f0c674
color.calendar.due.today=gray2 on rgb421  # #181e18 on #de935f
color.calendar.holiday=gray2 on rgb520  # #181e18 on #ff7f2a
color.calendar.overdue=gray2 on rgb411  # #181e18 on #cc6666
color.calendar.scheduled=gray2 on rgb323  # #181e18 on #b294bb
color.calendar.today=gray2 on rgb234  # #181e18 on #81a2be
color.calendar.weekend=rgb121  # #758975
color.calendar.weeknumber=rgb121  # #758975

# Command: sync
color.sync.added=rgb331  # #b5bd68
color.sync.changed=rgb542  # #f0c674
color.sync.rejected=rgb411  # #cc6666

# Command: undo
color.undo.after=rgb331  # #b5bd68
color.undo.before=rgb411  # #cc6666
