# tinted-taskwarrior
# Scheme name: Sequoia Retro Dark
# Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
# Scheme: base16-sequoia-retro-dark (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray6  # #43444d
color.label.sort=rgb123  # #5c87a4
color.alternate=on gray1  # #111216
color.header=rgb123  # #5c87a4
color.footnote=rgb321  # #a27e57
color.warning=gray1 on rgb411  # #0f1014 on #da674b
color.error=rgb233  # #829fa7
color.debug=rgb321  # #a27e57

# Task state
color.completed=gray6  # #43444d
color.deleted=gray6  # #43444d
color.active=gray1 on rgb121  # #0f1014 on #648f68
color.recurring=rgb321  # #a27e57
color.scheduled=rgb123  # #5c87a4
color.until=
color.blocked=gray6  # #43444d
color.blocking=gray1 on rgb411  # #0f1014 on #da674b

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb233  # #829fa7
color.uda.priority.M=rgb411  # #da674b
color.uda.priority.L=rgb123  # #5c87a4

# Tags
color.tag.next=rgb411  # #da674b
color.tag.none=
color.tagged=

# Due
color.due=rgb411  # #da674b
color.due.today=rgb233  # #829fa7
color.overdue=rgb233  # #829fa7

# Report: burndown
color.burndown.done=gray1 on rgb121  # #0f1014 on #648f68
color.burndown.pending=gray1 on rgb233  # #0f1014 on #829fa7
color.burndown.started=gray1 on rgb411  # #0f1014 on #da674b

# Report: history
color.history.add=gray1 on rgb233  # #0f1014 on #829fa7
color.history.delete=gray1 on rgb411  # #0f1014 on #da674b
color.history.done=gray1 on rgb121  # #0f1014 on #648f68

# Report: summary
color.summary.background=on gray1  # #111216
color.summary.bar=gray1 on rgb121  # #0f1014 on #648f68

# Command: calendar
color.calendar.due=gray1 on rgb411  # #0f1014 on #da674b
color.calendar.due.today=gray1 on rgb233  # #0f1014 on #829fa7
color.calendar.holiday=gray1 on rgb411  # #0f1014 on #da674b
color.calendar.overdue=gray1 on rgb233  # #0f1014 on #829fa7
color.calendar.scheduled=gray1 on rgb123  # #0f1014 on #5c87a4
color.calendar.today=gray1 on rgb321  # #0f1014 on #a27e57
color.calendar.weekend=gray6  # #43444d
color.calendar.weeknumber=gray6  # #43444d

# Command: sync
color.sync.added=rgb121  # #648f68
color.sync.changed=rgb411  # #da674b
color.sync.rejected=rgb233  # #829fa7

# Command: undo
color.undo.after=rgb121  # #648f68
color.undo.before=rgb233  # #829fa7
