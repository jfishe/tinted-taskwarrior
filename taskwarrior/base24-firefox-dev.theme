# tinted-taskwarrior
# Scheme name: Firefox Dev
# Scheme author: FredHappyface (https://github.com/fredHappyface)
# Scheme: base24-firefox-dev (dark)
#
# Template: https://github.com/jfishe/tinted-taskwarrior
# Rule set modelled on Taskwarrior's solarized-dark-256.theme
# (Copyright 2006 - 2021, Tomas Babej, Paul Beckingham, Federico Hernandez;
# MIT License, see THIRD-PARTY-NOTICES.md).
#
# Taskwarrior supports at most 256 colors. Each scheme color has been mapped to
# the nearest xterm-256 color (rgbRGB cube or grayN ramp, CIEDE2000); the
# trailing comment on each line gives the original scheme hex. Cube entries
# 16-21 are never used because tinted-shell redefines them.
#
# Usage, in a taskrc:
#   include ~/.local/share/tinted-theming/tinty/tinted-taskwarrior-taskwarrior-file.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=gray7  # #374d53
color.label.sort=rgb035  # #359ddf
color.alternate=on gray3  # #002731
color.header=rgb035  # #359ddf
color.footnote=rgb123  # #4b73a2
color.warning=gray1 on rgb013  # #0e1011 on #006fc0
color.error=rgb501  # #e63853
color.debug=rgb123  # #4b73a2

# Task state
color.completed=gray7  # #374d53
color.deleted=gray7  # #374d53
color.active=gray1 on rgb130  # #0e1011 on #5eb83c
color.recurring=rgb123  # #4b73a2
color.scheduled=rgb035  # #359ddf
color.until=
color.blocked=gray7  # #374d53
color.blocking=gray1 on rgb415  # #0e1011 on #d75cff

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb320  # #a57705
color.uda.priority.M=rgb013  # #006fc0
color.uda.priority.L=rgb035  # #359ddf

# Tags
color.tag.next=rgb415  # #d75cff
color.tag.none=
color.tagged=

# Due
color.due=rgb013  # #006fc0
color.due.today=rgb320  # #a57705
color.overdue=rgb501  # #e63853

# Report: burndown
color.burndown.done=gray1 on rgb130  # #0e1011 on #5eb83c
color.burndown.pending=gray1 on rgb501  # #0e1011 on #e63853
color.burndown.started=gray1 on rgb013  # #0e1011 on #006fc0

# Report: history
color.history.add=gray1 on rgb501  # #0e1011 on #e63853
color.history.delete=gray1 on rgb013  # #0e1011 on #006fc0
color.history.done=gray1 on rgb130  # #0e1011 on #5eb83c

# Report: summary
color.summary.background=on gray3  # #002731
color.summary.bar=gray1 on rgb130  # #0e1011 on #5eb83c

# Command: calendar
color.calendar.due=gray1 on rgb013  # #0e1011 on #006fc0
color.calendar.due.today=gray1 on rgb320  # #0e1011 on #a57705
color.calendar.holiday=gray1 on rgb415  # #0e1011 on #d75cff
color.calendar.overdue=gray1 on rgb501  # #0e1011 on #e63853
color.calendar.scheduled=gray1 on rgb035  # #0e1011 on #359ddf
color.calendar.today=gray1 on rgb123  # #0e1011 on #4b73a2
color.calendar.weekend=gray7  # #374d53
color.calendar.weeknumber=gray7  # #374d53

# Command: sync
color.sync.added=rgb130  # #5eb83c
color.sync.changed=rgb013  # #006fc0
color.sync.rejected=rgb501  # #e63853

# Command: undo
color.undo.after=rgb130  # #5eb83c
color.undo.before=rgb501  # #e63853
